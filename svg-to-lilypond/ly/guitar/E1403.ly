      \vspace #0.88
      \line { \bold "3." \column { "天地之主，萬物之神，" "生命、氣息，賜給萬人；" "年限、疆界，由祂定準，" "要人揣摩，將祂求尋。" "自隱之神，人間之謎；" "不見之神，宇宙之祕。" "此一真理，人人當知，" "宇宙意義始能賞識。" } }
      \vspace #0.88
      \line { \bold "4." \column { "不見之神顯於所見，" "神聖啟示尚非完全；" "神的身位，神的形像，" "還需一人前來表彰。" "耶穌基督，神的愛子，" "降世成為人的樣式；" "神的特性，神的所是，" "全由這人彰顯盡致。" } }
    }
    \left-column {
      \line { \bold "5." \column { "奧祕基督，奇妙救主，" "乃是神在人間顯出。" "原是永遠無限的神，" "竟作時間有限的人。" "奧妙基督，神的化身，" "神人調和，驚人佳音。" "祂是真神，又是真人，" "要進你心，作你福分。" } }
      \vspace #0.88
      \line { \bold "6." \column { "神的神性藏祂裏面，" "神的榮形從祂彰顯。" "前在肉身成功救贖，" "今成那靈與人聯屬。" "神人基督，道成肉身，" "捨命流血，救贖罪人；" "從死復活，化身那靈，" "為進你靈，作你生命。" } }
    }
