\markup {
  \fill-line {
    \left-column {
      \line { \bold "2." \column { "榮耀基督，創造萬有，" "萬有獨一的根源；" "萬有主宰、萬有元首，" "萬有之間祂居先；" "用祂命令托住萬有，" "萬有靠祂而團結；" "神早立祂承受萬有，" "萬有歸祂為基業。" } }
      \vspace #0.88
      \line { \bold "3." \column { "榮耀基督，道成肉身，" "支搭帳幕在人間；" "童女所生正式的人，" "神在肉身的顯現。" "神而人者自甘卑微，" "取了奴僕的形狀，" "是神榮耀所發光輝，" "是神本體的真像。" } }
      \vspace #0.88
      \line { \bold "4." \column { "榮耀基督，釘死十架，" "替我擔罪並成罪，" "受神審判，被神所殺，" "嘗盡死亡的苦味。" "將我舊人一同釘死，" "毀壞撒但和鬼魔，" "使我脫離罪的權勢，" "脫離一切的網羅。" } }
    }
    \left-column {
      \line { \bold "5." \column { "榮耀基督，從死復活，" "成為復活初熟果；" "祂也使我同祂復活，" "將祂生命分給我。" "祂是一粒生命麥種，" "生出我們許多粒，" "成為祂的許多弟兄，" "與祂同是出於一。" } }
      \vspace #0.88
      \line { \bold "6." \column { "榮耀基督，化成聖靈，" "到我靈裡作生命，" "使我有分神的性情，" "與祂同樣的神聖。" "在我裡面長大成形，" "將我變成祂形狀；" "使我享受神的豐盛，" "有祂豐滿的身量。" } }
      \vspace #0.88
      \line { \bold "7." \column { "榮耀基督，升上高天，" "遠超一切的首領，" "得著尊貴、榮耀冠冕，" "並得至高的尊名。" "祂也帶我與祂同升，" "與祂一同坐天上，" "使我分享祂的權柄，" "同祂一樣的高強。" } }
    }
    \left-column {
      \line { \bold "8." \column { "榮耀基督，賜下聖靈，" "召會因此得成立；" "並賜恩賜，各盡功能，" "建造召會作身體。" "祂愛召會，保養、顧惜，" "藉著召會得彰顯；" "召會將祂延長、普及，" "延長、普及宇宙間。" } }
      \vspace #0.88
      \line { \bold "9." \column { "榮耀基督，得國再臨，" "提接、救贖祂聖徒，" "踐踏仇敵，審判萬民，" "憑祂權柄設國度。" "帶著聖徒一同作王，" "執政掌權到地極，" "萬國和平，萬有歌唱，" "全地都得享安息。" } }
      \vspace #0.88
      \line { \bold "10." \column { "榮耀基督，永世中心，" "得著聖城為配偶；" "天地一切全都更新，" "脫盡一切的陳舊。" "神是榮光，祂是明燈，" "神在祂內得彰顯；" "聖城又是祂的顯明，" "由祂充滿到永遠！" } }
    }
  }
