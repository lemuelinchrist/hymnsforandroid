      \line { \bold "2." \column { "復活裏，如母鹿得釋放，" "拿弗他利出嘉美言語；" "滿恩惠，蒙耶和華賜福，" "必得海和南方為業無虞。" "讓我們湧流主生命，" "剛強開拓無畏懼；" "以高品福音人得地，" "憑主大能，照主應許。" } }
      \vspace #0.88
      \line { \bold "3." \column { "看，全地盡是饑餓人羣，" "需你我分賜基督富餘；" "速興起，打開約瑟糧倉，" "答應主的呼召，供人所需。" "主神說，我可差遣誰？" "誰肯為我們前去？" "哦，主阿，是我，我在這裏，" "請差遣我，照你所欲。" } }
      \vspace #0.88
      \line { \bold "4." \column { "得勝者─猶大支派獅子，" "擊敗眾仇敵，建立國度；" "權杖與國杖永不離開，" "直到細羅來到，平安處處。" "讓我們展覽主得勝，" "黑暗權勢盡驅除；" "憑那靈，在生命中作王，" "使全地眾民都蒙福。" } }
    }
    \left-column {
      \line { \bold "5." \column { "約瑟是多結果子樹枝，" "泉源旁結果纍纍下垂；" "無何能限制生命繁殖，" "枝條探出牆外，延展加倍。" "讓我們住在主裏面，" "生命流通益豐沛；" "環境中總將基督顯大，" "常結新果顯主作為。" } }
      \vspace #0.88
      \line { \bold "6." \column { "以薩迦，羊圈間可躺臥，" "得佳美之地，滿享安息；" "帳棚裏，盡情享受快樂；" "低肩背重，獻貢物主所喜。" "讓我們宗教盡脫落，" "享受基督作美地；" "召會中作肢體盡功用，" "生機建造基督身體。" } }
      \vspace #0.88
      \line { \bold "7." \column { "便雅憫，耶和華所親愛，" "爭戰中，如同撕掠的狼；" "滅仇敵，早晨喫所掠奪，" "晚上分所擄獲，得勝剛強。" "主所愛，必與主同居，" "得遮蔽，安息歡暢；" "永世裏，神人同得滿足─" "向此標竿，我們直往！" } }
