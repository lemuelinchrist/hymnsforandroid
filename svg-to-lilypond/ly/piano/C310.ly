      \vspace #0.88
      \line { \bold "4." \column { "如此對手從未得會，" "祂雖告我祂的名字，" "我仍不知所戰為誰，" "只知祂有很大賞賜；" "我就迫祂向我賜福，" "迫祂向我賜福、屈服。" } }
      \vspace #0.88
      \line { \bold "5." \column { "天已黎明難分勝負：" "好像無法、好像無能，" "祂就被迫向我賜福，" "並且稱許，說我得勝，" "說我新名是以色列；" "當我起來，我腿已瘸！" } }
      \vspace #0.88
      \line { \bold "6." \column { "有了微光進我暗心，" "開始照亮使我領會：" "若我有能，為何扭筋？" "若我得勝，為何瘸腿？" "是祂得勝留下記號，" "使我愚昧受了警告。" } }
    }
    \left-column {
      \line { \bold "7." \column { "瞬息之間，光滿我心，" "如同洪流沖破堤防，" "我就看見榮耀無盡，" "迫我敬拜、迫我隱藏；" "我纔知道我的大罪、" "我的不軌、我的污穢。" } }
      \vspace #0.88
      \line { \bold "8." \column { "哎阿，想到：我曾勝過" "造物的主、全能的神！" "荒謬之極，該當有禍！" "該死之至，該死無恩！" "我這雙手竟然背叛，" "強迫主神不得動彈！" } }
      \vspace #0.88
      \line { \bold "9." \column { "你是何等榮耀的神，" "萬軍之主何等顯赫；" "我一認識你是誰人，" "並一看見你是如何，" "我要長號，我要流淚，" "我要懊悔，我要下跪。" } }
      \vspace #0.88
      \line { \bold "10." \column { "怎麼可能！怎麼可以！" "見神的面，與神相持！" "我恨不得有縫入地，" "纔可稍微掩我羞恥：" "為何我不在此以先，" "即已毀滅，離世長眠？" } }
      \vspace #0.88
