      \vspace #0.88
      \line { \bold "13." \column { "我有欲望天來順服，" "我出主張天來安排，" "我有喜好望神讓步，" "我有工作望神領帥，" "我若急切天須趕快，" "那有一次神不失敗！" } }
      \vspace #0.88
      \line { \bold "14." \column { "世界竟有如此邪惡、" "驕傲、頑固、詭詐的人！" "主，你知道我是雅各，" "充滿敗壞，充滿可恨；" "我無可望，只望憐憫，" "你來憐憫敗壞這心。" } }
      \vspace #0.88
