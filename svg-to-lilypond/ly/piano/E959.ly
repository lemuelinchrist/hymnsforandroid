      \line { \bold "2." \column { "Beloved Lord, since the year Thou ascended" "Everything here has been tasteless and dry;" "Often in praying and often in watching," "In every movement, for Thee, Lord, we sigh." } }
      \vspace #0.88
      \line { \bold "3." \column { "Scenes although lovely, yet when will we meet Thee?" "Birds and the flowers fair beauty embrace;" "All are delightsome, but none satisfy me," "For I am longing for Thy loving face." } }
      \vspace #0.88
      \line { \bold "4." \column { "Lord, we’re impatient awaiting Thy coming," "We do not know how much longer ’twill be;" "From every sunrise to every bright sunset" "Hope we each moment Thy coming to see." } }
    }
    \left-column {
      \line { \bold "5." \column { "Whene’er ’tis raining, or strong winds are blowing," "Whene’er the moon shines, or rises the sea," "We ever hope to discover Thy coming;" "How disappointed when no sign of Thee!" } }
      \vspace #0.88
      \line { \bold "6." \column { "If it were not for the bidding Thou gav’st us," "We’d be discouraged, Thy service we’d shirk;" "But Thou dost want us while waiting Thy coming," "For Thee to live and in diligence work." } }
      \vspace #0.88
      \line { \bold "7." \column { "Oh Lord, remember the days have been lengthened" "Since Thou hast promised ere going away;" "We hope and hope and are endlessly hoping," "That Thou wilt come. Canst Thou come e’en today?" } }
