      \line { \bold "5." \column { "你外勞碌總是空，" "如捉影，如捕風，" "多年流落羊群外，" "無你怎能亨通；" "世界情慾快過去，" "豈可再受駕御？" "愛主多年在等候，" "豈可依然猶豫？" } }
      \vspace #0.88
      \line { \bold "6." \column { "晨星將現夜已闌，" "生越過，時越暫，" "立即脫離墮落處，" "重來求你喜歡；" "拒絕世俗和魔鬼，" "再來嘗天滋味，" "愛心已失今再得，" "仍站從前地位。" \translate #'(3.25 . -2.00) "我今再行窄路，" \translate #'(3.25 . -2.00) "虛空世界不顧；" \translate #'(3.25 . -2.00) "前面榮耀快現，" \translate #'(3.25 . -2.00) "我願忠心受苦。" } }
