      \vspace #0.88
      \line { \bold "4." \column { "追想昔日跪主前，" "何滿足，何甘甜，" "應許你說：『從今後，" "我只聽你差遣，" "願意順服失自由，" "在你外，無他求；』" "至今為時並不久，" "此心已歸烏有！" } }
    }
