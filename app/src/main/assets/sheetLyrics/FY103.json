{"hymn":"FY103","parent":"NS111","quality":"adapted","adjust":{"hold":1,"merge":1},"title":"Un évangile aujourd’hui","subtitle":"","syl":{"n2":"Un","n3":["é","i"],"n4":["van","m"],"n5":["gile","t"],"n6":["au","i"],"n7":["jourd’","m"],"n8":["hui","t"],"n10":"Dit","n11":"si","n12":"tu","n13":"crois","n15":"tu","n16":"se‿ras","n17":["sau","i"],"n18":["vé","t"],"n20":["a","i"],"n21":["lors,","t"],"n23":"Tu","n24":["ver","i"],"n25":["ras","t"],"n26":"les","n27":"portes","n28":"de","n29":"perl’s,","n30":"les","n32":"rues","n33":["do","i"],"n34":["ré","m"],"n36":["es,","t"],"n37":"Comme","n38":"au","n39":["pa","i"],"n40":["ra","m"],"n42":["dis.","t","u"],"n43":0,"n44":"Mais","n45":"en","n46":"moi,","n49":"ces","n50":["mots","i"],"n51":["là","t"],"n52":"Ne","n54":["par","i"],"n55":["viennent","t"],"n56":"pas,","n57":"à","n60":["trai","i"],"n61":["ter","t"],"n62":"la","n64":["va","i"],"n65":["ni","m"],"n66":["té.","t"]},"verses":[{"label":"2.","lines":["Mais l’évangile est pour moi,","Le Dieu triun qui prit l’humanité","Me touchant comme l’Esprit, pour être en moi","La seul’ réalité.","Amour méconnu - Bonne nouvelle","Qui ne vieillit pas - Histoire racontée sans fin"]},{"label":"3.","lines":["Les nonant’-neuf Tu laissa","Tu me chercha jusqu’à ce que Tu me trouves","Me porta sur Tes épaules et m’amena","Dans Ton soin tendrement.","Réjouissance - Retrouvée,","Moi petite brebis - Tu as tout laissé pour moi."]},{"label":"4.","lines":["Balayant profondément,","Cherchant mon cœur, Tu alluma la lampe","Sanctifiant mon intérieur, brillant en moi","Exposant mes péchés.","Repentant - Oui je vois","Seigneur Tu m’asperg’ de Ton sang versé pour moi."]},{"label":"5.","lines":["Tu attends impatiemment,","Que je me tourne un petit peu vers Toi.","Bien que ma vie soit en ruin’ Tu courus vers moi","Me prenant dans Tes bras","M’embrassant, affectueus’ment,","Tua le veau pour moi –","« Mangeons et réjouissons-nous »."]}]}