{"hymn":"CS469","parent":"E1241","quality":"exact","adjust":{"hold":0,"merge":0},"title":"歌中之歌乃是描繪","subtitle":"追求與長進","syl":{"n1":"歌","n2":"中","n3":"之","n4":"歌","n5":"乃","n6":"是","n7":"描","n8":"繪,","n9":"神","n10":"生","n11":"命","n12":"與","n13":"建","n15":"造;","n16":"基","n17":"督","n18":"新","n19":"婦","n20":"生","n21":"命","n22":"歷","n23":"程,","n25":"皆","n26":"顯","n27":"明","n28":"於","n29":"表","n31":"號,","n32":"皆","n33":"顯","n34":"明","n35":"於","n36":"表","n38":"號。"},"verses":[{"label":"2.","lines":["她之愛主初如駿馬,","屬世牽連未斷;","奔跑迅捷、力大無匹,","剛強卻是天然,","剛強卻是天然!"]},{"label":"3.","lines":["觀念逐日因主改變,","眼目漸似鴿眼;","無何能與主愛比擬,","惟非她所倚,","惟主是她所羨,","惟主是她所羨!"]},{"label":"4.","lines":["她之於主有如百合,","單純靠主憐憫;","屬地勞苦非她所倚,","惟主是她吸引,","惟主是她吸引!"]},{"label":"5.","lines":["在主面前又如良鴿,","藏身磐石穴中,","享主復活、升天生命,","有愛不知驚恐,","有愛不知驚恐!"]},{"label":"6.","lines":["且成煙柱,立地頂天,","曠野流蕩止息;","意志降服,與主合拍,","馨香之氣盈溢,","馨香之氣盈溢!"]},{"label":"7.","lines":["看哪,竟成主的臥榻,","在這駭人夜間,","供主躺臥,使主安息,","仇敵崩潰逃竄,","仇敵崩潰逃竄!"]},{"label":"8.","lines":["還要成為一乘華轎,","為著將主盛裝;","萬王之王藉她行動,","在她得著彰顯,","在她得著彰顯!"]},{"label":"9.","lines":["利巴嫩木品質高貴,","充滿復活人性;","銀柱支撐─贖穩固,","金底顯神性情,","金底顯神性情!"]},{"label":"10.","lines":["紫色坐墊君尊寶貴-","王權為其座位;","眾女向王所獻愛情,","盡都鋪陳其內,","盡都鋪陳其內!"]},{"label":"11.","lines":["婚娶日近,心中歡喜,","王要得勝凱歸;","得著佳偶作祂榮冕,","與祂全然匹配,","與祂全然匹配。"]},{"label":"12.","lines":["關鎖的園,只為良人","產生寶貴材料;","生命豐盛、美麗芬芳,","更為神聖建造,","更為神聖建造。"]},{"label":"13.","lines":["佳偶屹立猶如京城,","益顯華麗秀美;","又如軍隊展開旌旗,","威武,使敵敗退,","威武,使敵敗退!"]},{"label":"14.","lines":["藉著喫主與祂聯調,","新婦妝飾整齊;","生命變化帶進建造,","成功神聖旨意,","成功神聖旨意。"]}]}