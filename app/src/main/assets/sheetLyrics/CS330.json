{"hymn":"CS330","parent":"NS10001","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"讓我佇立你背後，主","subtitle":"愛慕耶穌","syl":{"n1":"讓","n2":"我","n3":"佇","n4":"立","n5":"你","n6":"背‿後，","n8":"主！","n9":"讓","n10":"我","n11":"挨","n12":"著","n13":"你","n14":"的","n15":"腳","n16":"哭，","n17":"讓","n18":"我","n19":"頭","n21":"髮","n22":"擦","n23":"拭","n24":"你","n25":"足，","n26":"讓","n27":"我","n29":"香","n30":"膏，","n31":"為","n32":"著","n33":"你","n34":"全","n35":"然","n36":"倒","n38":"出。","n40":"我","n41":"愛","n43":"你！","n45":"愛","n46":"你","n47":"主","n48":"耶","n50":"穌！","n52":"為","n53":"你","n54":"甘","n55":"願","n56":"枉","n57":"費，","n58":"一","n60":"無","n61":"所","n63":"顧。","n64":"從","n65":"我","n66":"玉","n67":"瓶","n68":"傾","n70":"倒","n72":"香","n73":"膏，","n74":"為","n75":"你","n76":"身、","n77":"你","n78":"頭、","n80":"你","n81":"腳，","n82":"為","n83":"你─","n84":"摯‿愛","n85":"主，","n86":"我","n87":"愛，","n88":"你","n89":"耶","n90":"穌！"},"verses":[{"label":"2.","lines":["我將貴重膏油取出，","膏抹我所至愛的主；","在你腳前我今俯伏，","膏油芬芳，因著愛，","漫溢四處。","我愛你！愛你主耶穌！","為你甘願枉費，一無所顧。","從我玉瓶傾倒香膏，","為你身、你頭、你腳，","為你─摯愛主，我愛，你耶穌！"]},{"label":"3.","lines":["人說你若凡事知道，","必知是誰在摸你腳；","是的，我罪實不可告，","不配摸你，還妄想","獻上香膏。","但我愛。。。愛你，主耶穌！","愛深是因多得赦罪之故。","從我玉瓶傾倒香膏，","為你身、你頭、你腳，","為你─摯愛主，我愛，你耶穌！"]},{"label":"4.","lines":["我要用我愛洗你足，","你腳前，我己可不顧；","你的價值有誰能述？","我的愛情並全人","都當你屬。","我愛你！愛你，主耶穌！","我愛情我全人都為你，主。","求悅納我和我香膏，","愛主，這是我上好，","為你─摯愛主，我愛，你耶穌！"]}]}