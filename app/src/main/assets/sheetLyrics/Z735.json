{"hymn":"Z735","parent":"E1070","quality":"adapted","adjust":{"hold":1,"merge":1},"title":"前我堕入罪海中","subtitle":"福音－见证","syl":{"n1":"前","n2":"我","n3":"堕","n4":"入","n5":"罪","n6":"海","n7":"中，","n8":"远","n9":"离","n10":"平","n11":"安","n12":"之","n13":"岸，","n16":"受","n17":"尽","n18":"摧","n19":"残","n20":"深","n21":"感","n22":"痛，","n23":"欲","n24":"拔","n25":"不","n26":"能，","n27":"徒","n28":"叹！","n31":"但","n32":"主","n33":"听","n34":"见","n35":"我","n36":"呼","n37":"喊，","n38":"立","n39":"前","n40":"来","n41":"拯","n42":["救，",null,"u"],"n43":0,"n46":"甘","n47":"冒","n48":"风","n49":"险","n50":"施","n51":"救","n52":"援，","n53":"爱","n54":"何","n55":"深","n56":"厚！","n59":"爱","n60":"救","n61":"了","n62":"我！","n65":"爱","n66":"救","n67":"了","n68":"我！","n70":"当","n71":"我","n73":"在","n74":"罪","n75":"中‿落","n76":"泊，","n77":"爱","n78":"救","n79":"了","n80":"我！","n82":"爱","n83":"救","n84":"了","n85":"我！","n88":"爱","n89":"救","n90":"了","n91":"我！","n93":"当","n94":"我","n96":"在","n97":"世","n98":"界","n99":"活，","n100":"爱","n101":"救","n102":"了","n103":"我！"},"verses":[{"label":"2.","lines":["现今我在平安地，","脱离罪恶痛苦，","满了喜乐和安息，","完全属于耶稣。","爱是如此强而真，","配得我的歌讴；","我心、我命、我全人，","永归祂有！"]},{"label":"3.","lines":["苦中罪人，请听信，","耶稣能施拯救；","祂爱奇妙的救恩，","现在就要接受。","祂心渴望拯救你，","等候已经够久；","立即相信，勿犹疑，","就来得救！"]}]}