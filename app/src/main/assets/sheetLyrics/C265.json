{"hymn":"C265","parent":"E308","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"有福的確據，基督屬我","subtitle":"得救的證實與快樂－一般","syl":{"n1":"有","n2":"福","n3":"的","n4":"確","n5":"據，","n6":"基","n7":"督","n8":"屬","n9":"我！","n11":"豫","n12":"嘗","n13":"神","n14":"榮","n15":"耀，","n16":"何","n17":"等","n18":"快","n19":["活！",null,"u"],"n20":0,"n22":"蒙","n23":"寶","n24":"血","n25":"贖","n26":"回，","n27":"領","n28":"受","n29":"恩","n30":"賜；","n32":"由","n33":"聖","n34":"靈","n35":"重","n36":"生，","n37":"作","n38":"神","n39":"後","n40":"嗣。","n42":"這","n43":"是","n44":"我","n45":"見","n46":"證，","n47":"是","n48":"我","n49":"詩","n50":"歌，","n52":"讚","n53":"美","n54":"我","n55":"救","n56":"主，","n57":"口","n58":"唱","n59":"心","n60":"和！","n62":"這","n63":"是","n64":"我","n65":"見","n66":"證，","n67":"是","n68":"我","n69":"詩","n70":"歌，","n72":"讚","n73":"美","n74":"我","n75":"救","n76":"主，","n77":"終","n78":"日","n79":"歡","n80":"樂！"},"verses":[{"label":"2.","lines":["完全的順服，完全甘甜，","被提的景象，顯在眼前；","似乎有聲音，從天而來，","細說主憐憫，柔述主愛。"]},{"label":"3.","lines":["完全的順服，完全安息，","與主時交通，何等福氣；","儆醒且等候，仰望主來，","充滿主甘甜，浸透主愛。"]}]}