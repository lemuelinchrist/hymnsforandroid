{"hymn":"Z417","parent":"C413","quality":"adapted","adjust":{"hold":6,"merge":1},"title":"夜影尚存，晨光未现","subtitle":"经历基督－与祂交通","syl":{"n1":"夜","n2":"影","n3":"尚","n4":"存，","n5":"晨","n6":"光","n7":"未","n8":"现，","n10":"重","n11":"新","n12":"来","n13":"到","n14":"恩","n15":"主","n16":"面","n17":["前；",null,"u"],"n18":0,"n19":"祂","n20":"在","n21":"里","n22":["面",null,"u"],"n23":0,"n24":"放","n25":"明、","n26":"照","n27":["耀，",null,"u"],"n28":0,"n29":"我","n30":"得","n31":"看","n32":"见","n33":["祂",null,"u"],"n34":0,"n36":"的","n37":"荣","n38":"颜。","n39":"向","n40":"我","n41":"发","n42":"言、","n43":"给","n44":"我","n45":"看","n46":"见：","n47":"祂","n48":"的","n49":"丰","n50":"富","n51":"是","n52":"为","n53":"今","n54":"天；","n55":"甜","n57":"美、","n58":["欢",null,"u"],"n59":0,"n60":"乐，","n61":"将","n62":"祂","n63":"享","n64":["受，",null,"u"],"n65":0,"n66":"所","n67":"有","n68":"饥","n69":"饿","n70":"全‿变","n71":"饱","n72":"满。"},"verses":[{"label":"2.","lines":["主灵借话与我交谈，","直到我心发出颂赞，","生命活泉，带着恩力，","在我里面涌流潺潺。","向我发言、给我看见：","祂的丰富是为今天；","清爽、畅快，将祂欢饮，","所有干渴全都消减。"]},{"label":"3.","lines":["当我欢留于祂面光，","祂以温情对付、指点；","用祂神圣、宝贵成分，","浸透全人、供应无限。","向我发言、给我看见：","祂的丰富是为今天；","多方、丰满将祂享受，","所有问题全都逃窜！"]}]}