{"hymn":"Z417","parent":"E554","quality":"adapted","adjust":{"hold":6,"merge":1},"title":"夜影尚存，晨光未现","subtitle":"经历基督－与祂交通","syl":{"n1":"夜","n2":"影","n3":"尚","n4":"存，","n5":"晨","n6":"光","n7":"未","n8":"现，","n10":"重","n11":"新","n12":"来","n14":"到","n15":"恩","n16":"主","n17":"面","n18":["前；",null,"u"],"n19":0,"n20":"祂","n21":"在","n22":"里","n23":"面","n24":"放","n25":"明、","n26":["照",null,"u"],"n27":0,"n28":["耀，",null,"u"],"n29":0,"n30":"我","n31":"得","n32":"看","n33":"见","n34":["祂",null,"u"],"n35":0,"n37":"的","n38":"荣","n39":"颜。","n40":"向","n41":"我","n42":"发","n43":"言、","n44":"给","n45":"我","n46":"看","n47":"见：","n48":"祂","n49":"的","n50":"丰","n51":"富","n52":"是","n53":"为","n55":"今","n56":"天；","n58":"甜","n59":"美、","n60":"欢","n61":"乐，","n62":"将","n63":"祂","n64":["享",null,"u"],"n65":0,"n66":["受，",null,"u"],"n67":0,"n68":"所","n69":"有","n70":"饥","n71":"饿","n72":"全","n73":"变‿饱","n74":"满。"},"verses":[{"label":"2.","lines":["主灵借话与我交谈，","直到我心发出颂赞，","生命活泉，带着恩力，","在我里面涌流潺潺。","向我发言、给我看见：","祂的丰富是为今天；","清爽、畅快，将祂欢饮，","所有干渴全都消减。"]},{"label":"3.","lines":["当我欢留于祂面光，","祂以温情对付、指点；","用祂神圣、宝贵成分，","浸透全人、供应无限。","向我发言、给我看见：","祂的丰富是为今天；","多方、丰满将祂享受，","所有问题全都逃窜！"]}]}