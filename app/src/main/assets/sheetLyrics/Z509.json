{"hymn":"Z509","parent":"E703","quality":"exact","adjust":{"hold":0,"merge":0},"title":"你这奔向荣耀客旅","subtitle":"试炼中的安慰－主的引领","syl":{"n1":"你","n3":"这","n4":"奔","n5":"向","n6":"荣","n8":"耀","n9":"客","n10":"旅，","n11":"疲","n13":"倦","n14":"困","n15":"乏","n16":"心","n18":"迷","n19":"离；","n20":"神","n22":"已","n23":"赐","n24":"你","n25":"宝","n27":"贵","n28":"应","n29":"许：","n30":"『我","n32":"必","n33":"用","n34":"眼","n35":"引","n37":"导","n38":"你。』","n39":"『我","n41":"必","n42":"引","n43":"导，","n44":"我","n46":"必","n47":"引","n48":"导，","n49":"我","n51":"必","n52":"用","n53":"眼","n54":"引","n56":"导","n57":"你；","n58":"你","n60":"这","n61":"奔","n62":"向","n64":"荣","n65":"耀","n66":"客","n67":"旅，","n68":"我","n70":"必","n71":"用","n72":"眼","n73":"引","n75":"导","n76":"你。』"},"verses":[{"label":"2.","lines":["虽然心中常是纷乱，","情绪扰人欲昏迷，","但这应许排解万难：","『我必用眼引导你。』"]},{"label":"3.","lines":["虽然试探几乎得胜，","可靠亲友也远离，","但这应许发出微声：","『我必用眼引导你。』"]},{"label":"4.","lines":["你的隐秘盼望消逝，","埋在年日坟墓里，","让这应许将你支持：","『我必用眼引导你。』"]},{"label":"5.","lines":["生命阴影逐渐加深，","要穿荣耀的身体，","神这应许显为更真：","『我必用眼引导你。』"]},{"label":"6.","lines":["但愿我灵以神为乐，","我心以祂为至宝，","与祂交通一无间隔，","接受祂眼的引导。"]}]}