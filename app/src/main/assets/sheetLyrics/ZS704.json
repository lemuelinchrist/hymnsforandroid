{"hymn":"ZS704","parent":"CS704","quality":"exact","adjust":{"hold":0,"merge":0},"title":"你如今活在召会里","subtitle":"你如今活在召会里","syl":{"n1":"你","n2":"如","n3":"今","n4":"活","n5":"在","n6":"召","n7":"会","n8":"里，","n11":"岂","n12":"不","n13":"令","n14":"你","n15":"欢","n16":"天","n17":"喜","n18":"地！?","n21":"赞","n22":"美","n23":"主，","n24":"实","n25":"在","n26":"是","n28":"荣","n29":"耀，","n31":"我","n32":"们","n33":"终","n34":"于","n35":"找","n36":"着","n37":"目","n38":"标。"},"verses":[{"label":"2.","lines":["从此不再寻寻觅觅，","我们已经回到家里。","弟兄们和睦的同居，","真正天伦之乐无比！"]},{"label":"3.","lines":["这是神拣选的地方，","神荣脸得以常瞻仰；","神的名是摆在这里，","你住些时，就不一样。"]},{"label":"4.","lines":["阿利路亚，别无拣选─","从听见祂声音那天。","自深处我们说：『阿们，","我们乐意，投身其间。』"]}]}