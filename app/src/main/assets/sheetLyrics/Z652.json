{"hymn":"Z652","parent":"C652","quality":"exact","adjust":{"hold":0,"merge":0},"title":"不可等候","subtitle":"事奉－尽本分","syl":{"n1":"不","n2":"可","n3":"等","n4":"候，","n5":"一","n6":"直","n7":"梦","n8":"想","n9":"将","n10":"来","n11":"成","n12":"大","n13":"业，","n14":"不","n15":"可","n16":"等","n17":"候，","n18":"要","n19":"光","n20":"被","n21":"远","n22":"方，","n23":"你","n24":"有","n25":"诸","n26":"般","n27":"目","n28":"前","n29":"本","n30":"分，","n31":"今","n32":"日","n33":"当","n34":"解","n35":"决，","n36":"你","n37":"的","n38":"一","n39":"隅，","n40":"你","n41":"当","n42":"照","n43":"亮。","n44":"你","n45":"的","n46":"一","n47":"隅，","n48":"你","n49":"当","n50":"照","n51":"亮！","n52":"你","n53":"的","n54":"一","n55":"隅，","n56":"你","n57":"当","n58":"照","n59":"亮！","n60":"情","n61":"形","n62":"越","n63":"难，","n64":"圣","n65":"徒","n66":"之","n67":"光","n68":"越","n69":"当","n70":"照","n71":"得","n72":"亮，","n73":"你","n74":"的","n75":"一","n76":"隅，","n77":"你","n78":"当","n79":"照","n80":"亮。"},"verses":[{"label":"2.","lines":["『你们的光当照人前，』","乃是主命令，","你们应当遵从莫掩藏；","一个罪人弃暗就光，","也需人引领，","你的一隅，你当照亮。"]},{"label":"3.","lines":["请看在你旁边","就有信徒在流浪，","何必到处寻找失迷羊，","应当劝勉、挽回、安慰，","体贴主心肠，","你的一隅，你当照亮。"]},{"label":"4.","lines":["应当时时与主交通，","瞻仰主圣容，","才能返照荣耀的明光；","你若热诚爱主事主，","人必受感动，","你的一隅，你当照亮。"]},{"label":"5.","lines":["现今，救主已近，","天上晨星要出现，","主人要来，仆人要得奖；","拯救罪人，挽回信徒，","当趁有今天，","你的一隅，你当照亮。"]}]}