{"hymn":"CS536","parent":"E1258","quality":"exact","adjust":{"hold":0,"merge":0},"title":"何等可愛,哦,何寶貴","subtitle":"教會的異象","syl":{"n1":"何","n2":"等","n3":"可","n5":"愛,","n6":"哦,","n7":"何","n8":"寶","n10":"貴,","n11":"是","n12":"主","n13":"眾","n14":"地","n16":"方","n17":"召","n18":"會!","n19":"我","n20":"魂","n21":"羨","n23":"慕,","n24":"甚","n25":"至","n26":"渴","n28":"想,","n29":"主,","n30":"你","n31":"院","n32":"宇","n33":"極","n35":"華","n36":"美。","n37":"我","n38":"心","n39":"渴","n41":"慕,","n42":"我","n43":"靈","n44":"切","n46":"望","n47":"能","n48":"交","n49":"通","n51":"於","n52":"眾","n54":"召","n55":"會;","n56":"為","n58":"此","n59":"我","n61":"向","n62":"活","n64":"神","n66":"呼","n69":"籲,","n70":"我","n71":"心、","n72":"我","n74":"命","n75":"不","n76":"別","n77":"歸。"},"verses":[{"label":"2.","lines":["心中想往錫安大道,","如此之人為有福;","必因我主行走有力,","終日頌讚與稱祝。","召會生活時有樂歌,","因靠我神勝險阻;","雖經巴迦流淚之谷,","卻使成為泉源處。"]},{"label":"3.","lines":["在你召會住留一日,","勝似別處住千日;","我主乃是日頭、盾牌,","至微肢體亦得恃。","恩典、榮耀從主傾注,","無一好處祂不賜;","如此安居召會之中,","必蒙祝福永無止。"]}]}