{"hymn":"ZS855","parent":"E1124","quality":"exact","adjust":{"hold":0,"merge":0},"title":"岂能不高声颂扬","subtitle":"事奉与福音","syl":{"n1":"岂","n2":"能","n3":"不","n4":"高","n5":"声","n6":"颂","n7":"扬?","n8":"岂","n9":"能","n10":"不","n11":"徧","n12":"传","n13":"四","n14":"方?","n15":"宝","n16":"血","n17":"洗","n18":"罪","n19":"有","n20":"功","n21":"效,","n22":"罪","n23":"人","n24":"速","n25":"速","n26":"来","n27":"投","n28":"靠！"},"verses":[{"label":"2.","lines":["远比祭牲血更美,","带来救恩福全备;","羔羊无瑕、血无疵,","不见朽坏到永世。"]},{"label":"3.","lines":["听哪！宝血在发声,","闻于神前显权能;","在宝座前为我言,","功效绝佳永不变。"]},{"label":"4.","lines":["前我良心有亏欠,","时有控告无平安;","所有玷污尽显露,","叹息、痛苦不止住。"]},{"label":"5.","lines":["岂知宝血洗罪污,","神前功效永充足;","罪案全销,得近神,","借血罪人蒙神恩！"]},{"label":"6.","lines":["无须祭牲血再洒,","无须凭“死行”脱罚;","无何能使神喜悦,","诸天惟听主宝血。"]},{"label":"7.","lines":["因祂流血我得赎,","罪得全赦,享永福;","先民不过将罪遮,","我得洁净,唱乐歌。"]},{"label":"8.","lines":["进入平安,何稳妥,","良心无亏,罪污脱;","不再羞愧,无重担,","与神和好,心安然。"]},{"label":"9.","lines":["阿利路亚！深难测！","宝血价值我寻得！","故当歌唱,再歌唱,","祂血永是我保障！"]}]}