{"hymn":"ZS458","parent":"CS458","quality":"exact","adjust":{"hold":0,"merge":0},"title":"我本世人与你为敌","subtitle":"追求与长进","syl":{"n1":"我","n2":"本","n3":"世","n4":"人","n6":"与","n7":"你","n8":"为","n9":"敌,","n10":"弃","n11":"绝","n12":"你","n13":"恩","n14":"漠","n15":"视","n17":"你","n18":"意,","n19":"有","n20":"人","n21":"对","n22":"我","n23":"讲","n24":"你","n26":"心","n27":"肠,","n28":"要","n29":"我","n30":"归","n31":"回","n32":"满","n33":"你","n34":"切","n35":"望,","n36":"而","n37":"我","n38":"总","n39":"是","n40":"置","n41":"之","n43":"不","n44":"理,","n45":"引","n46":"我","n47":"回","n48":"家,","n50":"真","n51":"是","n53":"不","n54":"易。"},"verses":[{"label":"2.","lines":["等我归来得见你面,","才知救恩如此完全:","如虫世人成为信徒,","不过与你和好初步,","直到你我联调为一,","才是与你和好极地。"]},{"label":"3.","lines":["一重幔子我已经过,","欢然来到你的圣所,","二重幔子虽已裂开,","我的经历仍是不逮,","但你却要引我进入,","至圣所在,享你供输。"]},{"label":"4.","lines":["和好还是完全分别,","离弃不法,除去不洁,","肉身和灵一切污秽,","需你荣光如同雨沛,","尽都洗去,洗得尽净,","每一部分完全成圣。"]},{"label":"5.","lines":["拯救之日,悦纳时候,","要我与你和好无隔,","我愿竭力靠你大能,","奔这“完全和好”路程,","你的恩典不致徒受,","你的救恩我能全得。"]},{"label":"6.","lines":["当我看见你的心意,","你所要我到达境地,","我又羡慕,我又惊惧,","依我能力我怎能及?","求你作工用你恩典,","使我不住,不住向前。"]}]}