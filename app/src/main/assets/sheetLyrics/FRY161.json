{"hymn":"FRY161","parent":"E543","quality":"hand","adjust":{"hold":0,"merge":0},"title":"Je Te donne mon cœur","subtitle":"","syl":{"n1":"Je","n2":"Te","n3":["don","i"],"n4":["ne","t"],"n5":"mon","n6":"cœur,","n7":["Jé","i"],"n8":["sus,","t"],"n9":"tant","n10":["re","i"],"n11":["cher","m"],"n12":["ché;","t"],"n13":"Car","n14":"Tu","n15":"m'as","n16":["pré","i"],"n17":["sen","m"],"n18":["té","t"],"n19":"Ton","n20":"cœur","n21":"Pour","n22":"mon","n24":"cœur","n25":["ral","i"],"n26":["lu","m"],"n27":["mer.","t"]},"verses":[{"label":"","lines":["Dans nos cœurs Tu avances,","De nos cœurs Tu T'éprends.","Je T'aimerais comm' Tu m'aimes,","Jésus, tant recherché."]},{"label":"2.","lines":["Quelle précieuse offrande","Puis-je Te présenter ?","Car Tu descendis dans ce monde,","En tant qu’un homme fus né.","« Mon fils, donn’-moi ton cœur » :","Tu l’as capté, Seigneur.","Je T’aimerais comme Tu m’aimes,","Jésus, tant recherché."]},{"label":"3.","lines":["Grand ouvert est Ton cœur,","Pour m’offrir Ton amour,","Je trouve en Toi une demeure,","À jamais mon séjour.","Ton amour si brûlant,","Me force à Te le rendre.","Je T’aimerais comme Tu m’aimes,","Jésus, tant recherché."]},{"label":"4.","lines":["Voici je me détends,","Dans un repos ancré ;","La forc’ de l’amour le défend,","En Toi, Roché frappé.","Tu entoures mon cœur","Dans le fort de Ton cœur ;","Je T’aimerais comme Tu m’aimes,","Jésus, tant recherché."]}]}