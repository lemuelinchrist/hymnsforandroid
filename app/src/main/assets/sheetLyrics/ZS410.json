{"hymn":"ZS410","parent":"E1191","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"从我灵里深处","subtitle":"主，我宝贝这生命的流","syl":{"n1":"从","n2":"我","n3":"灵","n4":"里","n5":"深","n6":"处，","n7":"有","n8":"生","n9":"命","n10":"水","n11":"涌","n12":"流，","n13":"是","n14":"三","n15":"一‿神","n16":"在","n17":"我","n18":"里","n19":"面","n20":"流。","n22":"父","n23":"神","n24":"乃","n25":"是","n26":"源","n27":"头，","n28":"主","n29":"基","n30":"督","n31":"乃","n32":"是","n33":"河，","n34":"灵","n35":"是","n36":"流，","n37":"分","n38":"赐","n39":"生","n40":"命","n41":"给","n42":"我。","n44":"主，","n45":"我","n46":"宝","n47":"贝","n48":"这","n49":"生","n50":"命","n51":"的","n52":"流，","n54":"我","n55":"的","n56":"魂","n57":"生","n58":"命","n59":"不","n60":"再","n61":"保","n62":"留；","n64":"哦","n65":"主，","n66":"加","n67":"深","n68":"这","n69":"生","n70":"命","n71":"的","n72":"流，","n74":"愿","n75":"你","n76":"来","n77":"时","n78":"我","n79":"生","n80":"命","n81":"成","n82":"熟。"},"verses":[{"label":"2.","lines":["在鲜嫩草地上，","在可安歇水边，","跟羊群的脚踪享受主。","不用勉强挣扎，","徒然自讨苦吃，","在流里我就全然蒙福！"]},{"label":"3.","lines":["借着血我坦然","进前到至圣所，","活在祂面前─联于源头。","阿利路亚，祂说，","切不可离开我，","当住我里头─一直交流。"]}]}