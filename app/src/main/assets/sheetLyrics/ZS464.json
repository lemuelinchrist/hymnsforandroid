{"hymn":"ZS464","parent":"CS464","quality":"exact","adjust":{"hold":0,"merge":0},"title":"当遇难处使我踌躇","subtitle":"追求与长进","syl":{"n1":"当","n2":"遇","n3":"难","n4":"处","n5":"使","n6":"我","n7":"踌","n9":"躇,","n10":"属","n11":"天","n12":"异","n13":"象","n14":"渐","n15":"糢","n16":"糊,","n17":"四","n18":"围","n19":"充","n20":"满","n21":"艰","n22":"辛","n23":"拦","n25":"阻,","n26":"似","n27":"乎","n28":"无","n29":"力","n30":"再","n31":"随","n32":"主;","n34":"但","n35":"主","n36":"告","n37":"我","n38":"祂","n39":"曾","n40":"历","n41":"世","n42":"途,","n43":"经","n44":"忧","n45":"患","n46":"无","n47":"枕","n48":"首","n49":"处,","n51":"被","n52":"挂","n53":"木","n54":"上","n55":"尝","n56":"苦","n57":"胆","n58":"酸","n59":"醋,","n60":"忧","n61":"苦","n62":"祂","n63":"已","n64":"担","n65":"负。"},"verses":[{"label":"2.","lines":["灵中听主题醒嘱咐,","需要凭信走窄路;","祂的患难要我补足,","经历十架学顺服。","祂话内住,时将我鼓舞,","使我得力再举步,","欢然随主历短暂苦楚,","永远荣耀在目。"]},{"label":"3.","lines":["看见建造异象蓝图,","放胆前行无旁骛;","所有境遇是为帮助,","信徒生命早成熟。","何等荣耀,有分神建筑,","金、银、宝石非草、木,","让神安居,且成主新妇,","主的再临催促。"]},{"label":"4.","lines":["等我行完此生路途,","我要迎见亲爱主,","且与众圣同声欢呼,","此路原来不孤独。","“好！你这良善忠信奴仆”─","公义的主要宣布;","主人快乐得欢然进入,","才识你恩丰足。"]}]}