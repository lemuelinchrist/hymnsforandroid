{"hymn":"CS756","parent":"E1246","quality":"adapted","adjust":{"hold":0,"merge":4},"title":"我們今樂意跟隨眾召會","subtitle":"教會的生活","syl":{"n1":"我","n2":"們","n3":"今","n4":"樂","n5":"意","n6":"跟","n7":"隨","n8":"眾","n9":"召","n10":"會,","n11":"主","n12":"裏","n13":"是‿一,","n14":"顯","n15":"無","n16":"遺;","n17":"在","n18":"眾","n19":"召","n20":"會","n21":"中,","n22":"主","n23":"今","n24":"正","n25":"行","n26":"動,","n27":"堅","n28":"定","n29":"跟‿隨,","n30":"眾","n31":"如","n32":"一。","n33":"跟","n34":"隨!","n35":"跟","n36":"隨","n37":"主","n38":"聖","n39":"靈,","n40":"單","n41":"純","n42":"跟‿隨,","n43":"莫","n44":"遲","n45":"誤!","n47":"跟","n48":"隨!","n49":"憑","n50":"靈","n51":"中","n52":"羔","n53":"羊,","n54":"絕","n55":"對","n56":"跟‿隨,","n57":"憑","n58":"基","n59":"督!"},"verses":[{"label":"2.","lines":["我們今學習跟隨眾從者,","流中往前無己意;","時刻轉向靈,絕不望領頭,","首位惟歸主自己。"]},{"label":"3.","lines":["我們今歡然跟羊羣腳蹤,","享受牧者的照應;","在眾召會中,主今正引領,","祂的發言當聆聽。"]},{"label":"4.","lines":["我們今全然獻給主基督,","緊緊跟隨不他依;","不管何遭遇,隨羔羊前行,","無論何往不稍離。"]},{"label":"5.","lines":["一路緊跟隨,宜到進國度,","羔羊婚筵樂有分;","今縱有逼迫、痛苦和試煉,","不過促我享主恩。"]},{"label":"6.","lines":["在眾召會中,主今正召喚,","忠信從者來得賞;","我們願答應,全人都拚上,","神旨成功不延宕。"]}]}