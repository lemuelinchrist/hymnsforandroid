{"hymn":"ZS148","parent":"NS10060","quality":"adapted","adjust":{"hold":0,"merge":3},"title":"子同著父并凭著灵而来","subtitle":"灵与生命","syl":{"n1":"子","n2":"同","n3":"着","n4":"父","n5":"并","n7":"凭","n8":"着","n9":"灵","n10":"而","n11":"来,","n12":"哦","n13":"这","n14":"是","n15":"何","n16":"等‿奥","n17":"秘！","n19":"神","n20":"格","n21":"一","n22":"切","n23":"的","n25":"丰‿满","n26":"都","n27":"有‿形","n28":"有","n30":"体","n31":"住","n32":"在","n33":"祂","n34":"里。","n35":"神","n36":"是","n37":"三","n38":"一,","n39":"不","n40":"是","n41":"为","n42":"道","n43":"理;","n44":"神","n45":"是","n46":"三","n47":"一,","n48":"分","n49":"赐","n50":"祂","n51":"自","n52":"己。","n53":"分","n54":"赐","n55":"永","n56":"不","n57":"停","n58":"息,","n60":"我","n61":"们","n62":"可","n63":"经","n64":"历,","n65":"尽","n66":"享","n67":"祂","n68":"的","n69":"自","n70":"己。"},"verses":[{"label":"2.","lines":["子同着父并凭着灵而来,","由童女怀孕所生;","耶稣基督奇妙的神人,","在他,神、人成一身。"]},{"label":"3.","lines":["祂的生活将父完全彰显,","是人却凭神生命;","祂是神无罪羔羊,","罪、世界、撒但不能得逞。"]},{"label":"4.","lines":["祂虽无罪却有分血肉之体,","这使撒但中计;","肉体罪撒但","与祂同钉一起,","哦何等清理！"]},{"label":"5.","lines":["在基督的复活里,","这位奇妙三一成为那灵;","如今三一之神己成那灵,","作祂终极完成。"]},{"label":"6.","lines":["这奇妙人子在升天里,","仍是一人在神右边;","神已将人子升高至极,","使祂作王并掌权。"]},{"label":"7.","lines":["经过种种过程,主今已登","宝座,万有祂治理;","作生命之灵分赐给人,","接受产生祂身体。"]}]}