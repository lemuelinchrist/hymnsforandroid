{"hymn":"C384","parent":"E509","quality":"exact","adjust":{"hold":0,"merge":0},"title":"一棵果樹、一道水河","subtitle":"經歷基督－作食物","syl":{"n1":"一","n2":"棵","n3":"果","n4":"樹、","n5":"一","n6":"道","n7":"水","n8":"河，","n11":"二","n12":"者","n13":"乃","n14":"是","n16":"樂","n17":"園","n18":"特","n19":"色，","n22":"供","n23":"人","n24":"飲","n25":"食、","n26":"解","n27":"人","n28":"飢","n29":"渴，","n32":"使","n33":"人","n34":"神","n35":"前","n37":"活","n38":"著。","n41":"神","n42":"在","n43":"基","n44":"督","n45":"裡","n46":"作","n47":"人","n48":"食","n49":"糧，","n52":"基","n53":"督","n54":"成","n55":"為","n56":"靈","n57":"供","n58":"人","n59":"營","n60":"養；","n63":"這","n64":"無","n65":"限","n66":"之","n67":"靈","n68":"給","n69":"我","n70":"飽","n71":"嘗，","n74":"我","n75":"就","n76":"將","n77":"神","n79":"全","n80":"享。"},"verses":[{"label":"2.","lines":["果樹乃指榮耀基督，","來作人的生命食物，","使人享受神的豐富，","人就得到滿足。"]},{"label":"3.","lines":["水河乃指無限之靈，","來作人的靈性供應，","使人飽嘗神的豐盛，","人就成為神聖。"]},{"label":"4.","lines":["榮耀基督作我生命，","成為那靈活在我靈，","使我調進神的性情，","有分神的榮形。"]},{"label":"5.","lines":["榮耀基督我肯尊崇，","無限之靈我肯順從，","我就顯出神的光榮，","恩榮世世無窮！"]}]}