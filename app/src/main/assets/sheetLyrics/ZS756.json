{"hymn":"ZS756","parent":"E1246","quality":"adapted","adjust":{"hold":0,"merge":4},"title":"我们今乐意跟随众召会","subtitle":"教会的生活","syl":{"n1":"我","n2":"们","n3":"今","n4":"乐","n5":"意","n6":"跟","n7":"随","n8":"众","n9":"召","n10":"会,","n11":"主","n12":"里","n13":"是‿一,","n14":"显","n15":"无","n16":"遗;","n17":"在","n18":"众","n19":"召","n20":"会","n21":"中,","n22":"主","n23":"今","n24":"正","n25":"行","n26":"动,","n27":"坚","n28":"定","n29":"跟‿随,","n30":"众","n31":"如","n32":"一。","n33":"跟","n34":"随！","n35":"跟","n36":"随","n37":"主","n38":"圣","n39":"灵,","n40":"单","n41":"纯","n42":"跟‿随,","n43":"莫","n44":"迟","n45":"误！","n47":"跟","n48":"随！","n49":"凭","n50":"灵","n51":"中","n52":"羔","n53":"羊,","n54":"绝","n55":"对","n56":"跟‿随,","n57":"凭","n58":"基","n59":"督！"},"verses":[{"label":"2.","lines":["我们今学习跟随众从者,","流中往前无己意;","时刻转向灵,绝不望领头,","首位惟归主自己。"]},{"label":"3.","lines":["我们今欢然跟羊群脚踪,","享受牧者的照应;","在众召会中,主今正引领,","祂的发言当聆听。"]},{"label":"4.","lines":["我们今全然献给主基督,","紧紧跟随不他依;","不管何遭遇,随羔羊前行,","无论何往不稍离。"]},{"label":"5.","lines":["一路紧跟随,宜到进国度,","羔羊婚筵乐有分;","今纵有逼迫、痛苦和试炼,","不过促我享主恩。"]},{"label":"6.","lines":["在众召会中,主今正召唤,","忠信从者来得赏;","我们愿答应,全人都拼上,","神旨成功不延宕。"]}]}