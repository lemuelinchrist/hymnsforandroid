{"hymn":"CS470","parent":"E817","quality":"exact","adjust":{"hold":0,"merge":0},"title":"神聖真理深廣無邊","subtitle":"追求與長進","syl":{"n1":"神","n2":"聖","n3":"真","n4":"理","n5":"深","n6":"廣","n7":"無","n8":"邊,","n9":"人","n10":"智","n11":"豈","n12":"能","n13":"侷","n14":"限?","n15":"一","n16":"己","n17":"殘","n18":"見,","n19":"囿","n20":"於","n21":"時","n22":"空,","n23":"勿","n24":"將","n25":"天","n27":"光","n28":"遮","n29":"掩。","n30":"嶄","n31":"新","n32":"亮","n33":"光,","n34":"更","n35":"美","n36":"盼","n37":"望,","n38":"惟","n39":"願","n40":"人","n41":"心","n42":"能","n43":"見:","n44":"主","n45":"話","n46":"真","n47":"光","n48":"越","n49":"照","n50":"越","n51":"明,","n52":"釋","n53":"放","n54":"真","n55":"理","n56":"無","n57":"限。"},"verses":[{"label":"2.","lines":["天來聖諭普賜萬邦,","歷代人當稱羨;","誰竟擅用無知言語,","阻擋神聖意念?","如同宇宙闊長高深,","浩瀚洋海無邊:","主話真光越照越明,","釋放真理無限。"]},{"label":"3.","lines":["先聖邁開追尋旅程,","暗中摸索而前;","晨光乍顯,旭輝漸明,","直至如日中天。","榮耀太陽,願你顯身,","輝煌光線盡現。","主話真光越照越明,","釋放真理無限。"]},{"label":"4.","lines":["幽谷已過,昂首上行,","直攻真理之巔;","前人肩上極目一覽,","始識主智深遠;","清明空中,天樂得聆,","纔知主富綿延:","主話真光越照越明,","釋放真理無限。"]},{"label":"5.","lines":["哦願父神藉靈運行,","基督安家心間,","好使眾聖能同領畧,","神聖大愛艱言;","如此神聖實際得以","日日加增不斷:","主話真光越照越明,","釋放真理無限。"]}]}