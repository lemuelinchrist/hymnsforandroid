{"hymn":"CS851","parent":"E903","quality":"exact","adjust":{"hold":0,"merge":0},"title":"求主發言,教導我舌","subtitle":"事奉與福音","syl":{"n1":"求","n2":"主","n3":"發","n4":"言,","n5":"教","n7":"導","n8":"我","n10":"舌,","n11":"使","n12":"我","n13":"能","n14":"言,","n15":"照","n16":"你","n17":"心","n18":"意;","n19":"尋","n20":"回","n21":"愚","n22":"蒙","n23":"並","n25":"失","n26":"迷","n28":"者,","n29":"像","n30":"你","n31":"愛","n32":"中","n33":"細","n35":"細","n36":"尋","n37":"覓。"},"verses":[{"label":"2.","lines":["求主引導,使我有光,","領浪蕩者歸回正途;","供我飲食,使我有糧,","餧養飢渴之徒無數。"]},{"label":"3.","lines":["求主加力,使我得以","穩踏基督磐石之上,","且能伸出愛的膀臂,","風暴海中救援喪亡。"]},{"label":"4.","lines":["求主教我如何將你","寶貴救恩向人陳述,","使我言辭如有雙翼,","及於人心,觸人深處。"]},{"label":"5.","lines":["賜我以你甜美安息,","使我言語應時如你,","能施安撫,復甦、加力,","使疲乏者都得再起。"]},{"label":"6.","lines":["用你豐富充滿我心,","直至滿溢恩典美辭:","述說你愛,頌揚你恩,","分賜生命、亮光不止。"]},{"label":"7.","lines":["我雖不堪,願主使用,","隨時、隨處照你喜悅;","直至見你,榮耀之中,","同享安息,喜樂不絕。"]}]}