{"hymn":"ZS459","parent":"CS459","quality":"exact","adjust":{"hold":0,"merge":0},"title":"主,你旨意我愿凭","subtitle":"追求与长进","syl":{"n1":"主,","n2":"你","n3":"旨","n4":"意","n5":"我","n7":"愿","n8":"凭,","n9":"主,","n10":"你","n11":"圣","n12":"言","n13":"我","n14":"听,","n15":"不","n16":"让","n17":"闲","n18":"话","n19":"漏","n21":"生","n22":"命,","n23":"不","n24":"让","n25":"俗","n27":"务","n29":"扰","n30":"灵。","n31":"求","n32":"你","n33":"向","n34":"我","n35":"多","n36":"吸","n38":"引,","n39":"使","n40":"我","n41":"与","n42":"你","n43":"更","n44":"亲,","n45":"让","n46":"我","n47":"常","n48":"见","n49":"你","n51":"荣","n52":"形,","n53":"紧","n54":"紧","n55":"跟","n57":"随","n59":"你","n60":"行。"},"verses":[{"label":"2.","lines":["主,你道路我愿走,","不管风狂雨骤,","虽然有忧也有愁,","主恩却更深厚。","我今追求虽不够,","有时会贪优游,","求你仍把我收留,","用爱把我浸透。"]},{"label":"3.","lines":["主,你十架我愿负,","面向你的国度,","虽然流泪虽然苦,","你手却常搀扶。","前面路程已不长,","属天家乡在望,","有朝,父怀我安躺,","我就喜乐欢畅。"]},{"label":"4.","lines":["主,你荣耀快显现,","这是我心所羡,","你的应许不改变,","你来将不迟延。","求主使我能自勉,","不向世界流连,","我眼能常望着天,","心能向你恋恋。"]}]}