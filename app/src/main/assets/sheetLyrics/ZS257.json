{"hymn":"ZS257","parent":"CS257","quality":"exact","adjust":{"hold":0,"merge":0},"title":"求主赐我启示的灵","subtitle":"享受基督","syl":{"n1":"求","n2":"主","n3":"赐","n4":"我","n5":"启","n6":"示","n7":"的","n8":"灵,","n9":"认","n10":"识","n11":"复","n12":"活","n13":"的","n14":"大","n15":"能,","n16":"这","n17":"大","n18":"能","n19":"在","n20":"基","n21":"督","n22":"身","n23":"上,","n24":"运","n25":"行","n26":"不","n27":"息","n28":"时","n29":"加","n30":"增。","n31":"不","n32":"单","n33":"叫","n34":"祂","n35":"从","n36":"死","n37":"复","n38":"活,","n39":"更","n40":"叫","n41":"我","n42":"因","n43":"祂","n44":"得","n45":"生;","n46":"浩","n47":"大","n48":"能","n49":"力","n50":"借","n51":"信","n52":"经","n53":"历,","n54":"使","n55":"我","n56":"活","n57":"在","n58":"属","n59":"天","n60":"层。"},"verses":[{"label":"2.","lines":["复活乃是信徒经历,","非仅历史一事实;","坟墓虽已千年空置,","复活大能仍运施。","这个大能不是神学,","不仅是理论而已;","它使信徒天天实际,","联于复活主自己。"]},{"label":"3.","lines":["复活带进新造领域,","使我脱离旧自我;","非如拉撒路之神迹,","苟延旧造并重活。","我所需要不是任何","起死回生的经过,","亦非任何工作能力,","乃让复活将我摸。"]},{"label":"4.","lines":["一切死亡阴间经历,","皆为复活启生机;","生借死亡发动运行,","肉体治死灵奋起。","死亡所设千万防线,","基督走过何容易;","畅游阴间乐园深渊,","从未恐慌或逃离。"]},{"label":"5.","lines":["死亡对人最大威胁,","无非惧怕与捆绑;","当主打破死亡门槛,","粉碎限制与惊惶。","天然生命不再缠扰,","复活生命得显扬;","最后仇敌既被吞灭,","有何能将生命挡?"]},{"label":"6.","lines":["基督人性借着复活,","已被拔高并标出;","从此堕落人类生命,","可望与主同前途。","经历基督全备救恩,","不仅那日体得赎,","人性更被拯救、拔高,","提升等同复活主。"]},{"label":"7.","lines":["复活并不改良旧造,","减轻旧造的折腾;","也不加强旧造生命,","使之能以自逞能。","基督虽曾肉体痛哭,","灵里却是倚靠神;","复活不求改变环境,","只在环境显效能。"]},{"label":"8.","lines":["神借旧造产生新造,","此为极大的奥秘;","罪、死虽然污染肉体,","经死一笔全清洗。","主将伊甸所造人性,","给予重整赋新机;","复活原则永不改变─","新造取材旧造里。"]},{"label":"9.","lines":["基督复活生为长子,","人性拔高至神性;","大衞后裔今日被生,","此为真正的福音。","从此人类新生有望,","复活产生新族群─","同父同胎同命同性,","同一源头同命运。"]},{"label":"10.","lines":["复活大能使我重生,","得有神圣诸供备;","使我有权成为儿女,","从神而生属神类─","生命性情与神一样,","只与神格无分位。","第一神人我们长兄,","作我原型并原胚。"]},{"label":"11.","lines":["我与基督已经联合,","祂我生命已接枝;","复活生命天天交流,","时时相调永无止。","祂更成了赐生命灵,","作神终极的显出,","带来神性人性丰富,","使我活出子基督。"]},{"label":"12.","lines":["我们成了基督肢体,","与主成为一单元;","祂的经历成我履历,","我的一切祂成全。","复活早晨新生男孩,","乃是宇宙新生族;","这是神人互住父家,","又是生机葡萄树。"]},{"label":"13.","lines":["复活实际-生命之灵,","今已住在我灵中;","使我天天经历复活,","与我同活同行动;","永远胜过罪与死律,","作王生命来居衷;","最终漫溢必死身体,","使我贱身与祂同。"]},{"label":"14.","lines":["在复活里与祂同长,","活出生命的新样,","一举一动结出义果,","主观称义得显彰。","水浸埋葬旧人自己,","灵浸引我奔义路;","在此赛程不偏左右,","直至我被义构成。"]},{"label":"15.","lines":["复活彰显在我事奉,","发芽枯杖作仲裁;","只凭复活生命建造,","召会必成杏树台。","木草禾稭烧尽去净,","只用复活作建材;","圣城撒冷神人合一,","作我工作的赏赉。"]},{"label":"16.","lines":["但愿我能深切认识,","何谓复活的大能,","天天模成十架模型,","单凭复活度此生;","认识复活人位基督,","在那灵中时加增,","直到见主被提时刻,","杰出复活展上腾。"]}]}