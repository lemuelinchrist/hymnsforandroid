{"hymn":"FRY27","parent":"NS40","quality":"hand","adjust":{"hold":0,"merge":0},"title":"Attir’-moi, Jésus, un peu plus près","subtitle":"","syl":{"n1":["At","i"],"n2":["tir’-","m"],"n3":["moi,","t"],"n4":["Jé","i"],"n5":["sus,","t"],"n6":"un","n7":"peu","n8":"plus","n9":"près,","n10":["Sauve","i"],"n11":["moi","t"],"n12":"d’où","n13":"je","n14":"me","n15":"trouve.","n16":"Je","n20":["suis",null,"u"],"n21":0,"n22":["i","i"],"n23":["ci","t"],"n24":"de‿puis","n25":"bien","n26":"trop","n29":["long","i"],"n30":"temps:","n31":["Dé","i"],"n32":["place","m"],"n33":["moi,","t"],"n34":"Tu","n35":"le","n36":"peux!"},"verses":[{"label":"2.","lines":["J’entends Ton doux murmure, Seigneur,","Qui brûl’ sans fin dans mon cœur.","Puisse Ta sérénité me calmer,","Pour que je lis’ Ta pensée."]},{"label":"3.","lines":["Retire, Seigneur, de mon cœur mort,","Toutes mes pensées impures,","Lave-moi dans une eau pur’, de cristal,","Dispense en moi plus de vie."]},{"label":"4.","lines":["Tant de rocs enfouis bloqu’nt ma vision :","Rocs de fierté, d’ambition.","Seigneur, que Ton regard intensifié","Les expose et les consume."]},{"label":"5.","lines":["Ajoute encore Ta gloire en moi,","Que Ton Esprit me transforme.","Qu’aucunes choses ne soient gaspillées :","Qu’ell’s œuvrent pour me sauver."]},{"label":"6.","lines":["Combien j’ai besoin de Toi, Seigneur,","Merci d’être toujours là.","En tout temps, Tu es présent dans le Corps,","Là, je Te cherch’rai toujours."]}]}