{"hymn":"FRY36","parent":"E426","quality":"hand","adjust":{"hold":0,"merge":0},"title":"Dévoile-moi Seigneur","subtitle":"","syl":{"n1":["Dé","i"],"n2":["voi","m"],"n3":["le","m"],"n4":["moi","t"],"n5":["Sei","i"],"n6":["gneur","t"],"n7":"Que","n8":"je","n9":"voie","n10":"Ta","n11":["lu","i"],"n12":["mière","t"],"n13":"Et","n14":"ne","n15":"sois","n16":"plus","n17":["trom","i"],"n18":["pé,","t"],"n19":"Mais","n20":"voie","n21":"tout","n22":["clai","i"],"n23":["re","m"],"n24":["ment.","t"],"n25":"Que","n26":"Ta","n27":["lu","i"],"n28":["miè","m"],"n29":["re","t"],"n30":["vi","i"],"n31":["vante","t"],"n32":["Dis","i"],"n33":["perse","t"],"n34":["tou","i"],"n35":["te","t"],"n36":"ma","n37":"nuit,","n38":"Et","n39":"rende","n40":"tout","n41":["bril","i"],"n42":["lant,","t"],"n43":["Sei","i"],"n44":["gneur,","t"],"n45":"Je","n46":"Te","n47":"prie","n48":"pour","n49":["ce","i"],"n50":["la.","t"]},"verses":[{"label":"2.","lines":["Je me connais à peine.","Par ma fierté trompé,","Je crois avoir raison","Et me crois satisfait."]},{"label":"3.","lines":["Je Te connais si peu,","Et Ta Parole … moins.","Je manque du réel","Dévoilement divin."]},{"label":"4.","lines":["Quant à Ta vie en moi,","Dans ma nuit aveuglé,","Je ne sais distinguer","L’esprit d’avec la chair."]},{"label":"5.","lines":["Suivant Ta voie, Seigneur,","Je suis souvent perdu.","Du sentier je dévie","Envers la réclusion."]},{"label":"6.","lines":["A peine je connais,","Ta volonté parfaite.","Je la remplace par","La mienne et me rebelle."]},{"label":"7.","lines":["Il me faut pour l’église","Plus de révélation,","Pour percevoir Ton Corps,","Ta sagesse explorer."]},{"label":"8.","lines":["Dévoile-moi, je Te prie.","Je veux être éclairé,","Ne plus être trompé,","Ni joint à mon orgueil."]}]}