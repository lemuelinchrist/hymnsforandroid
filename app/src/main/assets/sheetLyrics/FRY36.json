{"hymn":"FRY36","parent":"E426","quality":"hand","adjust":{"hold":0,"merge":0},"title":"Dévoile-moi Seigneur","subtitle":"","syl":{"n1":["Dé","i"],"n2":["voile","m"],"n3":["moi","t"],"n4":["Sei","i"],"n5":["gneur","t"],"n6":"Que","n7":["je",null,"u"],"n8":0,"n9":["voi","i"],"n10":["e","t"],"n11":"Ta","n12":["lu","i"],"n13":["mi","i"],"n14":["ère","t"],"n15":"Et","n16":"ne","n17":"sois","n18":"plus","n19":["trom","i"],"n20":["pé,","t","u"],"n21":0,"n22":"Mais","n23":"voie‿tout","n24":"clai‿rement.","n25":"Que‿Ta","n26":"lu‿mière","n27":"vi‿vante","n28":["Dis","i"],"n29":["per","m"],"n30":["se","t","u"],"n31":0,"n32":"toute","n33":"ma","n34":"nuit,","n35":"Et","n36":["ren","i"],"n37":["de","t"],"n38":["tout",null,"u"],"n39":0,"n40":["bril","i"],"n41":["lant,","t"],"n42":["Sei","i"],"n43":["gneur,","t","u"],"n44":0,"n45":"Je","n46":["Te",null,"u"],"n47":0,"n48":["pri","i"],"n49":["e‿pour","t"],"n50":"ce‿la."},"verses":[{"label":"2.","lines":["Je me connais à peine.","Par ma fierté trompé,","Je crois avoir raison","Et me crois satisfait."]},{"label":"3.","lines":["Je Te connais si peu,","Et Ta Parole … moins.","Je manque du réel","Dévoilement divin."]},{"label":"4.","lines":["Quant à Ta vie en moi,","Dans ma nuit aveuglé,","Je ne sais distinguer","L’esprit d’avec la chair."]},{"label":"5.","lines":["Suivant Ta voie, Seigneur,","Je suis souvent perdu.","Du sentier je dévie","Envers la réclusion."]},{"label":"6.","lines":["A peine je connais,","Ta volonté parfaite.","Je la remplace par","La mienne et me rebelle."]},{"label":"7.","lines":["Il me faut pour l’église","Plus de révélation,","Pour percevoir Ton Corps,","Ta sagesse explorer."]},{"label":"8.","lines":["Dévoile-moi, je Te prie.","Je veux être éclairé,","Ne plus être trompé,","Ni joint à mon orgueil."]}]}