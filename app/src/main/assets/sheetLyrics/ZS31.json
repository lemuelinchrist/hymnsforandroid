{"hymn":"ZS31","parent":"E1104","quality":"exact","adjust":{"hold":0,"merge":0},"title":"哦主,你是平安祭","subtitle":"赞美的话","syl":{"n1":"哦","n2":"主,","n3":"你","n4":"是","n5":"平","n6":"安","n7":"祭,","n8":"我","n9":"们","n10":"按","n11":"手","n12":"于","n13":"你;","n14":"你","n15":"的","n16":"事","n17":"实","n18":"我","n19":"经","n20":"历,","n21":"因","n22":"为","n23":"你","n24":"我","n25":"是","n26":"一。","n27":"众","n28":"圣","n29":"欢","n30":"聚","n31":"会","n32":"幕","n33":"里,","n34":"以","n35":"你","n36":"向","n37":"神","n38":"献","n39":"祭;","n40":"同","n41":"父","n42":"吃","n43":"喝","n44":"享","n45":"受","n46":"你,","n47":"丰","n48":"富","n49":"有","n50":"何","n51":"能","n52":"比。","n53":"赞","n54":"美","n55":"基","n56":"督","n57":"是","n58":"平","n59":"安","n60":"祭,","n61":"使","n62":"神","n63":"与","n64":"人","n65":"满","n66":"意;","n67":"距","n68":"离","n69":"全","n70":"去,","n71":"交","n72":"通","n73":"甜","n74":"蜜,","n75":"平","n76":"安","n77":"永","n78":"远","n79":"坚","n80":"立！"},"verses":[{"label":"2.","lines":["血洒于坛何有能,","神圣平安得成;","宝血功效永坚定,","神前我享安宁。","我们放胆齐颂称","“和平借血己成！”","仇敌闻之惊又恐,","我们昂然夸胜。"]},{"label":"3.","lines":["燔祭馨香使神喜,","素祭叫人满意,","据此再献平安祭─","全是基督自己。","救主人性何柔细,","我们吃喝不已;","如此享受真可喜,","每逢我们聚集。"]},{"label":"4.","lines":["内脏、脂油最甘美,","当先归神回味;","摇祭的胸何宝贝,","全体祭司受惠;","无酵饼同举祭腿,","纯全有能宝贵,","供职祭司受无愧,","福分拔尖全备。"]},{"label":"5.","lines":["胸作摇祭何丰富,","豫表复活基督,","以爱围绕且照护,","使我超越脱俗。","腿作举祭何充足,","描绘升天救主,","使我有能历世途,","活出他命无误。"]},{"label":"6.","lines":["得洁众圣聚一堂,","基督爱筵饱尝;","如此享受真无双,","带来交通无量。","心存感恩来歌唱,","因主恩典深广;","为使主旨得显彰,","愿将全人献上。"]}]}