{"hymn":"Z722","parent":"E1043","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"飘渺人生何短暂","subtitle":"福音－劝导","syl":{"n1":"飘","n2":"渺","n3":"人","n4":"生","n5":"何","n6":"短","n7":"暂，","n8":"好","n9":"似","n10":"浮","n11":"云","n12":"现","n13":"即","n14":"散，","n15":"又","n16":"似","n17":"幻","n18":"梦","n19":"醒","n20":"就","n22":"完：","n23":"要","n24":"及","n25":"时！","n26":"时","n27":"日","n28":"飞","n29":"逝","n30":"在","n31":"宣","n32":"言：","n33":"转","n34":"瞬","n35":"就","n36":"到","n37":"死","n38":"亡","n40":"线，","n41":"再","n42":"迟","n43":"必","n44":"在","n45":"地","n46":"狱","n48":"间：","n49":"要","n50":"及","n51":"时！","n52":"要","n53":"及","n54":"时！","n55":"要","n57":"及","n58":"时！","n59":"当","n60":"今","n61":"耶","n62":"稣","n63":"在","n64":"召","n65":["唤：",null,"u"],"n66":0,"n67":"要","n68":"及","n69":"时！","n70":"若","n71":"在","n72":"罪","n73":"中","n74":"仍","n75":"流","n76":"连，","n77":"只","n78":"怕","n79":"恩","n80":"门","n81":"向","n82":"你","n84":"关，","n85":"那","n86":"时","n87":"呼","n88":"救","n89":"已","n90":"太","n92":"晚：","n93":"要","n94":"及","n95":"时！"},"verses":[{"label":"2.","lines":["谁是智者，该想看：","鲜花朝艳暮凋残，","英年要去何能挽？","要及时！","哦，我求你早打算，","免得过了死亡线，","全人丧在地狱间：","要及时！"]},{"label":"3.","lines":["圣灵仍在把你感，","时常与你来争战，","何不降服得平安？","要及时！","救主等候赐恩典，","愿意救你免悲惨；","你若踌躇何愚顽！","要及时！"]},{"label":"4.","lines":["罪人，请听我忠言，","莫把救恩视等闲，","速把救主来拣选：","要及时！","来投耶稣怀里面，","来接基督进心间，","来就救主趁今天：","要及时！"]}]}