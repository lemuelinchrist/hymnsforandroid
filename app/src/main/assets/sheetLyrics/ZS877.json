{"hymn":"ZS877","parent":"NS10066","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"甚么使你为我舍命","subtitle":"事奉与福音","syl":{"n1":"甚","n2":"么","n3":"使","n4":"你","n5":"为","n6":"我","n7":"舍","n8":"命?","n10":"为","n11":"何","n12":"救","n13":"我?","n14":"我","n15":"是","n17":"你","n18":"仇","n19":["敌。",null,"u"],"n20":0,"n22":"你","n23":"上","n24":"十","n25":"架,","n26":"为","n27":"作","n29":"我","n30":"代","n32":"替;","n33":"你","n34":"受","n37":"咒","n39":"诅,","n41":"我","n43":"享","n45":"福","n46":"气。","n48":"我","n49":"原","n50":"是","n51":"你","n52":"仇","n53":"敌,","n55":"竟","n56":"也","n57":"能","n58":"归","n59":"服","n60":"你;","n62":"因","n63":"你","n64":"眷","n65":"临,","n66":"爱","n67":"里","n68":"寻","n69":"觅。","n71":"是","n72":"你","n73":"爱","n74":"和","n75":"怜","n76":"悯,","n78":"征","n79":"服","n80":"顽","n81":"梗","n82":"刚","n83":"愎;","n85":"昔","n86":"日","n87":"仇","n88":"敌,","n89":"今","n90":"愿","n91":"服","n92":"你。"},"verses":[{"label":"2.","lines":["未曾想到,你如此行;","温柔、怜恤,全向我洋溢。","为何你爱?我罪大恶极;","但你爱我─你的仇敌。"]},{"label":"3.","lines":["你之爱我,从永远起;","你爱恒久、坚定不稍移。","虽我言语,冒犯得罪你;","但你等候,代求不息。"]},{"label":"4.","lines":["我是罪人,犯罪不已;","活在罪中,行不法不义。","我的恶心,反判又悖逆;","但你慈心,感我衷里。"]},{"label":"5.","lines":["我一转身,就遇见你;","你正等我,怀圣别爱意。","我怎忍心,再与你为敌?","耶稣,我今降服归你。"]}]}