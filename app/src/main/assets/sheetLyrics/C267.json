{"hymn":"C267","parent":"E342","quality":"exact","adjust":{"hold":0,"merge":0},"title":"多年過著虛妄的生活","subtitle":"得救的證實與快樂－一般","syl":{"n1":"多","n2":"年","n3":"過","n4":"著","n5":"虛","n6":"妄","n7":"的","n8":"生","n9":"活，","n10":"不","n11":"理","n12":"我","n13":"主","n14":"如","n15":"何","n16":"被","n17":"釘","n18":"戳，","n19":"不","n20":"知","n21":"祂","n22":"死","n23":"原","n24":"是","n25":"為","n26":"著","n27":"我，","n28":"在","n29":"加","n30":"略","n31":"山。","n33":"廣","n34":"大","n35":"憐","n36":"憫，","n37":"白","n38":"白","n39":"的","n40":"恩","n41":"典；","n42":"眾","n43":"多","n44":"罪","n45":"愆","n46":"我","n47":"全","n48":"得","n49":"赦","n50":"免，","n51":"得","n52":"著","n53":"釋","n54":"放","n55":"脫","n56":"去","n57":"了","n58":"重","n59":"擔，","n60":"在","n61":"加","n62":"略","n63":"山。"},"verses":[{"label":"2.","lines":["蒙神光照，得知我罪愆，","恐懼戰兢，在律法跟前，","直到我心完全的回轉，","向加略山。"]},{"label":"3.","lines":["今將一切，全都獻給主，","甘心樂意作祂的奴僕，","永遠不忘祂所受的苦，","在加略山。"]},{"label":"4.","lines":["哦！愛何大，","計畫了救恩！","哦！恩何豐，","將此帶給人！","哦！力何強，","帶我歸向神，","在加略山。"]}]}