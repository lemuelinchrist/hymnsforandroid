{"hymn":"ZS875","parent":"CS875","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"西布伦,出外可以欢喜","subtitle":"事奉与福音","syl":{"n1":"西","n2":"布","n3":"伦,","n5":"出","n6":"外","n7":"可","n8":"以","n9":"欢","n10":"喜,","n11":"随","n12":"圣","n13":"灵","n14":"大","n15":"风","n16":"扬","n17":"帆","n18":"起","n19":"行;","n20":"福","n21":"音","n22":"船","n24":"满","n25":"载","n26":"基","n27":"督","n28":"丰","n29":"富,","n31":"传","n32":"扬","n33":"基","n34":"督","n35":"复","n36":"活,","n37":"作","n38":"祂","n39":"见","n40":"证。","n41":"我","n42":"们","n43":"是","n44":"主","n45":"的","n46":"见","n47":"证","n48":"人,","n49":"将","n50":"祂","n51":"繁","n52":"殖","n53":"达","n54":"四","n55":"境;","n56":"使","n57":"万","n58":"民","n60":"归","n61":"顺","n62":"主","n63":"门","n64":"徒,","n65":"执","n66":"行","n67":"我","n68":"主","n69":"伟","n70":"大","n71":["使",null,"u"],"n72":0,"n73":"命。"},"verses":[{"label":"2.","lines":["复活里,如母鹿得释放,","拿弗他利出嘉美言语;","满恩惠,蒙耶和华赐福,","必得海和南方为业无虞。","让我们涌流主生命,","刚强开拓无畏惧;","以高品福音人得地,","凭主大能,照主应许。"]},{"label":"3.","lines":["看,全地尽是饥饿人群,","需你我分赐基督富余;","速兴起,打开约瑟粮仓,","答应主的呼召,供人所需。","主神说,我可差遣谁?","谁肯为我们前去?","哦,主阿,是我,我在这里,","请差遣我,照你所欲。"]},{"label":"4.","lines":["得胜者─犹大支派狮子,","击败众仇敌,建立国度;","权杖与国杖永不离开,","直到细罗来到,平安处处。","让我们展览主得胜,","黑暗权势尽驱除;","凭那灵,在生命中作王,","使全地众民都蒙福。"]},{"label":"5.","lines":["约瑟是多结果子树枝,","泉源旁结果累累下垂;","无何能限制生命繁殖,","枝条探出墙外,延展加倍。","让我们住在主里面,生命流通益丰沛;","环境中总将基督显大,","常结新果显主作为。"]},{"label":"6.","lines":["以萨迦,羊圈间可躺卧,","得佳美之地,满享安息;","帐棚里,尽情享受快乐;","低肩背重,献贡物主所喜。","让我们宗教尽脱落,","享受基督作美地;","召会中作肢体尽功用,","生机建造基督身体。"]},{"label":"7.","lines":["便雅悯,耶和华所亲爱,","争战中,如同撕掠的狼;","灭仇敌,早晨吃所掠夺,","晚上分所掳获,得胜刚强。","主所爱,必与主同居,","得遮蔽,安息欢畅;","永世里,神人同得满足─","向此标竿,我们直往！"]}]}