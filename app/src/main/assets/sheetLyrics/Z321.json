{"hymn":"Z321","parent":"E423","quality":"exact","adjust":{"hold":0,"merge":0},"title":"祢这神的隐藏的爱","subtitle":"羡慕－安息","syl":{"n1":"祢","n2":"这","n3":"神","n4":"的","n6":"隐","n7":"藏","n9":"的","n10":"爱！","n11":"长","n12":"阔","n13":"高","n14":"深","n15":"无","n16":"人","n18":"知","n19":"悉，","n20":"远","n21":"远","n22":"我","n23":"见","n25":"祢","n26":"的","n28":"光","n29":"彩，","n30":"我","n31":"就","n32":"叹","n33":"息","n34":"望","n35":"得","n37":"安","n38":"息，","n39":"我","n40":"心","n41":"痛","n42":"苦，","n43":"不","n44":"能","n45":"安","n46":"息，","n47":"除","n48":"非","n49":"我","n50":"心","n51":"安","n52":"息","n53":"于","n54":"祢。"},"verses":[{"label":"2.","lines":["祢的声音，仍然隐招","我来负祢甜美的轭；","我虽几乎前来应召，","但是惧怕前途阻隔；","我志虽定，我情却离，","我欲向祢，反而背祢。"]},{"label":"3.","lines":["全是恩典！使祢吸引","我心向祢追求安息；","我虽追求，不能亲近，","流荡的我无所凭倚；","哦，要何时不再流荡，","所有脚踪向祢而往？"]},{"label":"4.","lines":["日下有无甚么东西，","与祢相争来分我心？","呀，我求祢把它割弃，","让祢作王无人与竞；","我心才会不再拘泥，","当它借祢得了安息。"]},{"label":"5.","lines":["哦，我求祢埋藏这己，","使主(非我)从我而活！","恶欲邪情钉死绝迹，","不私留一宝贝罪恶；","除祢之外，在凡事上，","使我无求，使我无望！"]},{"label":"6.","lines":["哦主，给我无上之助，","救我脱离无用之虑；","赶出己意离我心府，","离我全人隐密之域；","使我作个顺命的人，","不断称颂，时常感恩。"]},{"label":"7.","lines":["求祢使我时刻离地，","谦卑等候听祢吩咐；","求祢对我时常题起：","『我是祢爱、祢命、","祢主；』","来听祢声，来觉祢力，","来尝祢爱，是我所期。"]}]}