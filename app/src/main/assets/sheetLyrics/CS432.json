{"hymn":"CS432","parent":"E564","quality":"exact","adjust":{"hold":0,"merge":0},"title":"奇妙秘訣我已學會","subtitle":"追求與長進","syl":{"n1":"奇","n2":"妙","n3":"秘","n4":"訣","n5":"我","n6":"已","n7":"學","n8":"會,","n9":"就","n10":"是","n11":"住","n12":"在","n13":"主","n14":"裏","n15":"面;","n16":"在","n17":"此","n18":"暢","n19":"飲","n20":"生","n21":"命","n22":"純","n23":"泉,","n24":"日","n25":"日","n26":"飽","n27":"嚐","n28":"祂","n29":"聖","n30":"言;","n31":"在","n32":"祂","n33":"有","n34":"能","n35":"寶","n36":"血","n37":"底","n38":"下,","n39":"我","n40":"得","n41":"加","n42":"力","n43":"享","n44":"肥","n45":"甘;","n46":"敗","n47":"壞","n48":"的『","n49":"己』","n50":"日","n51":"漸","n52":"消","n53":"逝,","n54":"當","n55":"我","n56":"浸","n57":"沒","n58":"祂","n59":"裏","n60":"面。","n61":"我","n62":"今","n63":"住","n64":"在","n65":"主","n66":"裏","n67":"面,","n68":"相","n69":"信","n70":"祂","n71":"可","n72":"靠","n73":"聖","n74":"言;","n75":"甜","n76":"美、","n77":"安","n78":"息,","n79":"隱","n80":"藏","n81":"祂","n82":"愛","n83":"胸","n84":"懷","n85":"間。","n87":"是","n88":"的,","n89":"住","n90":"在","n91":"主","n92":"裏","n93":"面,","n94":"相","n95":"信","n96":"祂","n97":"可","n98":"靠","n99":"聖","n100":"言、","n101":"甜","n102":"美、","n103":"安","n104":"息,","n105":"隱","n106":"藏","n107":"祂","n108":"愛","n109":"胸","n110":"懷","n111":"間。"},"verses":[{"label":"2.","lines":["我與基督已經同釘,","祂今與我同生活;","我已停下一切掙扎,","今是祂,不再是我。","當我意志降服於祂,","祂靈掌權我心內,","祂的救贖、拯救有能,","使我潔淨並脫罪。"]},{"label":"3.","lines":["我將疾病帶來歸祂,","由祂一一都擔去;","我告祂以輭弱、憂、懼,","祂使我一無罣慮。","我的力量取自基督,","生活行動祂指點;","祂賜我以生命、信、愛,","使我活出祂意念。"]},{"label":"4.","lines":["我以祂智作我言、語","憑祂靈力而作工;","祂的同在作我道路,","不住保衛、引導我。","祂是無窮喜樂泉源,","作我永分藏心房-","是我救主、聖別、醫治、","榮耀主、永世君王。"]}]}