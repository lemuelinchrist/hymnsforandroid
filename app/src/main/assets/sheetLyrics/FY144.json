{"hymn":"FY144","parent":"E1310","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Le Seigneur désire l’Épouse","subtitle":"","syl":{"n1":"Le","n2":["Sei","i"],"n3":["gneur","t"],"n4":["dé","i"],"n5":["si","m"],"n6":["re","t"],"n7":["l’É","i"],"n8":["pouse","t"],"n9":"Sa","n10":"gloire","n11":"en","n12":"elle","n13":["a","i"],"n14":["bonde.","t"],"n15":"Son","n16":"cœur","n17":["se","i"],"n18":["ra","t"],"n19":["sa","i"],"n20":["tis","m"],"n21":["fait","t"],"n22":"quand","n23":["El","i"],"n24":["le","t"],"n25":"Lui","n26":["cor","i"],"n27":["res","m"],"n28":["ponde.","t"]},"verses":[{"label":"2.","lines":["La Parole rend Son église","Sainte et pure comm’ Lui,","Les taches et les rides enlevées,","Une Épouse pour Lui."]},{"label":"3.","lines":["Il faut racheter ces jours d’or,","Sa Parole mangeant,","En priant et disant « amen »,","Pour Lui nous nous parons."]},{"label":"4.","lines":["Cette parole pénètre et,","Divise esprit et âme ;","Afin de traiter les pensées","Qui sont cachées dans l’âme."]},{"label":"5.","lines":["Seigneur, combien Ta Parole est","Vivante et efficace.","Marchons en elle et T’attendons,","Nous allons voir Ta face."]},{"label":"6.","lines":["Seigneur, nous hâtons Ton retour,","Ta Parole mangeant ;","Fais de nous Ta contrepartie","Ton cœur satisfaisant."]}]}