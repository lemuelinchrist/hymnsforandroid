{"hymn":"ZS469","parent":"E1241","quality":"exact","adjust":{"hold":0,"merge":0},"title":"歌中之歌乃是描绘","subtitle":"追求与长进","syl":{"n1":"歌","n2":"中","n3":"之","n4":"歌","n5":"乃","n6":"是","n7":"描","n8":"绘,","n9":"神","n10":"生","n11":"命","n12":"与","n13":"建","n15":"造;","n16":"基","n17":"督","n18":"新","n19":"妇","n20":"生","n21":"命","n22":"历","n23":"程,","n25":"皆","n26":"显","n27":"明","n28":"于","n29":"表","n31":"号,","n32":"皆","n33":"显","n34":"明","n35":"于","n36":"表","n38":"号。"},"verses":[{"label":"2.","lines":["她之爱主初如骏马,","属世牵连未断;","奔跑迅捷、力大无匹,","刚强却是天然,","刚强却是天然！"]},{"label":"3.","lines":["观念逐日因主改变,","眼目渐似鸽眼;","无何能与主爱比拟,","惟非她所倚,","惟主是她所羡,","惟主是她所羡！"]},{"label":"4.","lines":["她之于主有如百合,","单纯靠主怜悯;","属地劳苦非她所倚,","惟主是她吸引,","惟主是她吸引！"]},{"label":"5.","lines":["在主面前又如良鸽,","藏身磐石穴中,","享主复活、升天生命,","有爱不知惊恐,","有爱不知惊恐！"]},{"label":"6.","lines":["且成烟柱,立地顶天,","旷野流荡止息;","意志降服,与主合拍,","馨香之气盈溢,","馨香之气盈溢！"]},{"label":"7.","lines":["看哪,竟成主的卧榻,","在这骇人夜间,","供主躺卧,使主安息,","仇敌崩溃逃窜,","仇敌崩溃逃窜！"]},{"label":"8.","lines":["还要成为一乘华轿,","为着将主盛装;","万王之王借她行动,","在她得着彰显,","在她得着彰显！"]},{"label":"9.","lines":["利巴嫩木品质高贵,","充满复活人性;","银柱支撑─赎稳固,","金底显神性情,","金底显神性情！"]},{"label":"10.","lines":["紫色坐垫君尊宝贵-","王权为其座位;","众女向王所献爱情,","尽都铺陈其内,","尽都铺陈其内！"]},{"label":"11.","lines":["婚娶日近,心中欢喜,","王要得胜凯归;","得着佳偶作祂荣冕,","与祂全然匹配,","与祂全然匹配。"]},{"label":"12.","lines":["关锁的园,只为良人","产生宝贵材料;","生命丰盛、美丽芬芳,","更为神圣建造,","更为神圣建造。"]},{"label":"13.","lines":["佳偶屹立犹如京城,","益显华丽秀美;","又如军队展开旌旗,","威武,使敌败退,","威武,使敌败退！"]},{"label":"14.","lines":["借着吃主与祂联调,","新妇妆饰整齐;","生命变化带进建造,","成功神圣旨意,","成功神圣旨意。"]}]}