{"hymn":"CS333","parent":"E546","quality":"exact","adjust":{"hold":0,"merge":0},"title":"我愛我主,非用天然之愛","subtitle":"愛慕耶穌","syl":{"n1":"我","n2":"愛","n3":"我","n4":"主,","n5":"非","n6":"用","n7":"天","n8":"然","n9":"之","n10":"愛;","n11":"我","n12":"無","n13":"可","n14":"以","n15":"給","n16":"你。","n17":"主,","n18":"我","n19":"愛","n20":"你,","n21":"這","n22":"愛","n23":"全","n24":"然","n25":"屬","n26":"你,","n27":"使","n28":"我","n29":"活","n30":"在","n31":"你","n32":"裏。","n33":"我","n34":"一","n35":"無","n36":"所","n37":"有,","n38":"卻","n39":"歡","n40":"然","n41":"經","n42":"歷,","n43":"倒","n44":"空,","n45":"消","n46":"失,","n47":"浸","n48":"沒","n49":"在","n50":"你","n51":"愛","n52":"裏。"},"verses":[{"label":"2.","lines":["我主,惟你是我一切所需,","我心別無所願;","住在你裏,經歷祝福江河,","從你湧流無間。","飲生命活泉,享你作恩典,","作我中心、居所、祝福之源。"]}]}