{"hymn":"ZS253","parent":"E1164","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"基督美地,包罗万有-","subtitle":"享受基督","syl":{"n1":"基","n2":"督","n3":"美","n4":"地,","n5":"包","n6":"罗","n7":"万","n8":"有-","n9":"祂","n10":"是","n11":"我","n12":"的","n13":"一","n14":"切:","n16":"源、","n17":"泉、","n18":"河","n19":"川,","n20":"清","n21":"新","n22":"明","n23":"透,","n24":"日","n25":"夜","n26":"涌","n27":"流","n29":"不","n30":"歇;","n33":"谷","n34":"中","n35":"山","n36":"上","n37":"流","n38":"出","n39":"水","n40":"来,","n41":"润","n42":"我","n43":"心","n44":"田,","n45":"满","n46":"溢","n47":"充","n48":"盈;","n49":"何","n50":"等","n51":"荣","n52":"耀,","n53":"活","n54":"水","n55":"澎","n56":"湃─","n57":"作","n58":"我","n59":"生‿命！"},"verses":[{"label":"2.","lines":["神成肉身,忍辱受死,","繁增如同小麦;","死而复活,生命分赐,","初熟如同大麦;","无花果树,甘甜满足,","葡萄产酒,神、人喜悦;","如此供应,全在基督─","有祂无缺！"]},{"label":"3.","lines":["基督还是真石榴树,","生命丰美充足;","是橄榄树,新油产出,","膏抹永不缺如;","流奶与蜜,美善甘甜,","供我滋养,加我能力;","祂的丰富,如此完全─","基督美地！"]},{"label":"4.","lines":["在这美地不缺食物,","我们一无所缺;","祂是如此丰饶富庶,","我们颂赞不绝;","上好美地,广大无边,","应有尽有,齐备完全;","今在我心还要扩展─","无量无限！"]},{"label":"5.","lines":["这地石头如铁之坚,","山内可以挖铜;","权柄如铁,凭以争战,","仇敌不能得逞;","再经苦难,渣滓全去,","炼净明亮,如铜显出;","有铁有铜,应付所需─","全是基督！"]},{"label":"6.","lines":["为这美地我们颂赞:","主,你何其包罗！","吃喝饱足,让你充满,","丰富岂能尽说！","求使我们经营不辍,","美地实际增长不已;","我的喜乐,我的生活─","基督美地！"]}]}