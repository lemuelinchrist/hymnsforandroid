{"hymn":"ZS342","parent":"CS342","quality":"exact","adjust":{"hold":0,"merge":0},"title":"愿你用口与我亲嘴","subtitle":"爱慕耶稣","syl":{"n1":"愿","n2":"你","n4":"用","n5":"口","n7":"与","n8":"我","n10":"亲","n11":"嘴,","n12":"因","n13":"你","n14":"爱","n15":"情","n16":"比","n18":"酒","n19":"美;","n22":"我","n24":"虽","n26":"然","n27":"黑,","n29":"却","n30":"是","n31":"秀","n32":"美,","n33":"哪","n34":"哒","n35":"香","n36":"膏","n37":"满","n38":"香","n39":"味。","n42":"我","n43":"尝","n44":"甘","n45":"甜,","n46":"我","n47":"享","n48":"筵","n49":"宴,","n51":"你","n52":"的","n53":"呼","n54":"召","n55":"我","n57":"听","n58":"见;","n61":"唤","n63":"我","n64":"起","n65":"来","n67":"同","n68":"你","n69":"往","n71":"前,","n72":"我","n73":"何","n74":"愚","n75":"昧","n77":"竟","n79":"迟","n80":"延。","n83":"主","n85":"阿,","n86":"在","n87":"你","n88":"与","n89":"我","n90":"爱","n91":"的","n92":"交","n93":"通","n94":"里,","n95":"你","n96":"天","n97":"天","n98":"吸","n99":"引,","n100":"呼","n101":"召","n102":"我","n103":"脱","n104":"自","n105":"己;","n106":"要","n107":"我","n108":"凡","n109":"事","n110":"与","n111":"你","n112":"是","n113":"一,","n116":"与","n117":"你","n118":"同","n119":"工","n120":"等","n121":"候","n122":"被","n123":"提。"},"verses":[{"label":"2.","lines":["蓦然醒悟,失去你面,","身体里将你寻见;","我爱作你华轿坐垫,","我成你喜乐冠冕。","你召我上真理山岭,","同你活在升天境;","我心答应,我目送情,","甘心作你园、泉、井。"]},{"label":"3.","lines":["听见柔声,要我开门,","上前,你竟已转身;","当我述说可爱良人,","真实同在又满魂。","作你佳偶,全因你恩,","且带盼望如清晨;","书拉密女与所罗门,","神人调和永不分。"]},{"label":"4.","lines":["起来与你同往田间,","清晨流连葡萄园;","风茄见证你我相联,","我结果佳美新鲜。","为你旨意,爱你所爱,","豫备新妇趁现在;","殷勤劳苦,盼望等待,","良人哪,愿你快来。"]}]}