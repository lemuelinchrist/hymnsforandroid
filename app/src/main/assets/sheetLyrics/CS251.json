{"hymn":"CS251","parent":"E1144","quality":"exact","adjust":{"hold":0,"merge":0},"title":"在聖經開始,神已經啟示","subtitle":"享受基督","syl":{"n1":"在","n2":"聖","n3":"經","n4":"開","n5":"始,","n6":"神","n7":"已","n8":"經","n9":"啟","n10":"示,","n11":"人","n12":"是","n13":"按","n14":"著","n15":"祂","n16":"形","n17":"像","n18":"造","n19":"成;","n20":"為","n21":"要","n22":"彰","n23":"顯","n24":"祂,","n25":"並","n26":"且","n27":"代","n28":"表","n29":"祂,","n30":"征","n31":"服","n32":"全","n33":"地","n34":"帶","n35":"進","n36":"祂","n37":"權","n38":"能。","n39":"喫","n40":"喝,","n41":"喫","n42":"喝─","n43":"沒","n44":"有","n45":"一","n46":"件","n47":"事","n48":"比","n49":"此","n50":"重","n51":"要","n52":"喫","n53":"喝,","n54":"喫","n55":"喝─","n56":"迎","n57":"接","n58":"新","n59":"郎","n60":"帶","n61":"進","n62":"神","n63":"榮","n64":"耀。"},"verses":[{"label":"2.","lines":["祂沒有立下任何的律法,","只說園中果子隨意喫;","但是善惡樹,萬不可接觸,","喫了知識果子必定死。"]},{"label":"3.","lines":["在伊甸樂園,擺在人面前,","有生命樹代表神自己;","但是那毒蛇,詭詐又邪惡,","藉著知識使人心偏離。"]},{"label":"4.","lines":["主耶穌基督就是生命樹,","神成肉身,滿足神要求;","祂救贖我們,又重生我們,","現今成了我們的珍饈。"]},{"label":"5.","lines":["主不是要搞我們的頭腦,","知識只叫人自高自大;","祂來的目的乃是作筵席,","不重研究乃在喫喝祂。"]},{"label":"6.","lines":["越多喫喝祂,越不斷長大,","生命、人數必加增不已;","我們要清楚神今天恢復,","基督不是宗教,是筵席。"]},{"label":"7.","lines":["今天的道路是喫喝基督,","沒有一件事比此重要;","召會藉著喫,新婦得妝飾,","迎接新郎帶進神榮耀。"]}]}