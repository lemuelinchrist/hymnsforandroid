{"hymn":"ZS754","parent":"E1267","quality":"exact","adjust":{"hold":0,"merge":0},"title":"为主见证移民开展","subtitle":"教会的生活","syl":{"n1":"为","n3":"主","n4":"见","n5":"证","n6":"移","n8":"民","n9":"开","n10":"展,","n11":"谁","n13":"愿","n14":"蒙","n15":"恩","n16":"向","n18":"前","n19":"走?","n21":"何","n22":"时?","n23":"何","n24":"处?","n26":"照","n27":"主","n28":"差","n29":"遣,","n31":"恩","n32":"主","n33":"面","n34":"光","n35":"当","n36":"寻","n37":"求。"},"verses":[{"label":"2.","lines":["为将圣殿、圣城建立,","扩展神国及全地;","背判征服,混乱消弭,","同心合意众如一。"]},{"label":"3.","lines":["父乃源头,子作管道,","那灵涌流为凭借;","站住立场,灵中相调,","此乃得胜的秘诀。"]},{"label":"4.","lines":["主所筹画伟大、完全,","激动我们全奉献;","好让圣灵浸透、充满,","神圣定旨得实现。"]},{"label":"5.","lines":["今日在此学习多方:","配搭建造、灵刚强;","那日前往各城、各邦,","建立灯台显荣光。"]},{"label":"6.","lines":["诸天掌权需“滩头堡”─","地方召会─先建立;","求主兴起各地建造,","实现国度为目的。"]},{"label":"7.","lines":["那时,全地荣耀归你,","失败、羞辱归仇敌;","万民称颂你名不已,","国度掌权达至极。"]},{"label":"8.","lines":["有福之日不久就到,","荣耀经纶得成就;","喜乐、赞美达到至高,","神圣管治徧万有。"]},{"label":"9.","lines":["赞美圣父,阿利路亚,","赞美圣子,阿利路,","赞美圣灵,阿利路亚,","神旨得成,阿利路。"]},{"label":"10.","lines":["召会荣耀,阿利路亚,","众圣美善,阿利路,","聚会美善,阿利路亚,","谁不受感来归服?"]},{"label":"11.","lines":["阿利路亚,阿利路亚,","阿利路亚,高声唱,","阿利路亚,阿利路亚,","阿利路亚,赞我王！"]}]}