{"hymn":"CS758","parent":"E1280","quality":"exact","adjust":{"hold":0,"merge":0},"title":"藉著救主復活大能","subtitle":"教會的生活","syl":{"n1":"藉","n2":"著","n3":"救","n4":"主","n5":"復","n6":"活","n7":"大","n8":"能,","n9":"我","n10":"們","n11":"已","n12":"成","n13":"祂","n14":"弟","n15":"兄─","n16":"祂","n17":"心","n18":"所","n19":"愛,","n20":"復","n21":"活","n22":"所","n23":"生,","n25":"同","n26":"祂","n27":"得","n28":"勝,","n29":"同","n30":"高","n31":"升。","n32":"耶","n33":"穌","n34":"基","n35":"督,","n36":"滿","n37":"有","n38":"那","n39":"靈,","n40":"宗","n41":"教","n42":"之","n43":"外","n44":"神","n45":"顯","n46":"明;","n47":"死","n48":"而","n49":"復","n50":"活,","n51":"衝","n52":"破","n53":"幽","n54":"冥,","n55":"神","n56":"眾","n57":"子","n58":"中","n59":"作","n60":"長","n61":"兄。","n62":"作","n63":"祂","n64":"召","n65":"會,","n66":"我","n67":"們","n68":"聚","n69":"集,","n70":"老","n71":"套","n72":"規","n73":"條","n74":"已","n75":"全","n76":"棄;","n77":"長","n78":"兄","n79":"榮","n80":"面,","n81":"我","n82":"們","n83":"所","n84":"喜,","n85":"祂","n86":"作","n87":"中","n88":"心","n89":"和","n90":"目","n91":"的。"},"verses":[{"label":"2.","lines":["長兄復起,我們亦同,","歡喜聚集復活中;","天然生命,惟願消蹤,","使主喜樂並得榮。"]},{"label":"3.","lines":["禱讀聖言,享受不已,","天天遇見主自己;","靈裏火熱,同來聚集,","被主充滿且洋溢!"]},{"label":"4.","lines":["每逢聚集都是赴席,","喫主喝主,樂無比;","祂作活糧,無量供給,","滋養、滿足且加力。"]},{"label":"5.","lines":["新鮮基督獻作“佳餚”,","使主滿足、得榮耀;","各人所獻儘管微小,","卻叫眾人得建造。"]},{"label":"6.","lines":["聚會非為傳講道理,","乃為與主同聚集;","祂的同在有何能比?","長兄榮美真無匹!"]}]}