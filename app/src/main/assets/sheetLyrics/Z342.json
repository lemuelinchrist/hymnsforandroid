{"hymn":"Z342","parent":"E456","quality":"exact","adjust":{"hold":0,"merge":0},"title":"活著为耶稣","subtitle":"奉献－为主而活","syl":{"n1":"活","n2":"着","n3":"为","n4":"耶","n5":"稣，","n6":"只","n7":"望","n8":"能","n9":"单","n10":"纯，","n12":"所","n13":"有","n14":"的","n15":"一","n16":"切","n17":"都","n18":"求","n19":"祂","n20":"喜","n21":"悦，","n23":"自","n24":"动","n25":"并","n26":"乐","n27":"意","n28":"来","n29":"向","n30":"祂","n31":"投","n32":"顺，","n34":"这","n35":"是","n36":"我","n37":"蒙","n38":"神","n39":"赐","n40":"福","n41":"的","n42":"秘","n43":"诀。","n44":"耶","n45":"稣","n46":"我","n47":"主，","n48":"我","n49":"救","n50":"主，","n51":"我","n52":"将","n53":"自","n54":"己","n55":"给","n56":"你，","n57":"因","n58":"你","n59":"为","n60":"我","n61":"代","n62":"死","n63":"时，","n64":"给","n65":"的","n66":"是","n67":"你","n68":"自","n69":"己；","n70":"从","n71":"此，","n72":"我","n73":"无","n74":"别","n75":"的","n76":"主，","n77":"我","n78":"心","n79":"是","n80":"你","n81":"宝","n82":"座，","n83":"我","n84":"的","n85":"一","n86":"生","n87":"一","n88":"世，","n89":"基","n90":"督，","n91":"只","n92":"要","n93":"为","n94":"你","n95":"生","n96":"活。"},"verses":[{"label":"2.","lines":["活着为耶稣，","祂为我缘故，","在十字架上担当罪与羞；","这爱激励我答应祂招呼，","恭敬向着祂奉献我所有。"]},{"label":"3.","lines":["活着为耶稣，","无论在何处，","我为祂缘故，","作成祂事务，","甘愿来承受损失或痛苦，","看每个试炼是十架一部。"]},{"label":"4.","lines":["活着为耶稣，","时间已短促，","祂的笑脸是我宝贵秘密，","寻找失丧者，","祂死所救赎，","带领疲倦者，","享受祂安息。"]}]}