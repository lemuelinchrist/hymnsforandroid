{"hymn":"ZS449","parent":"E1203","quality":"exact","adjust":{"hold":0,"merge":0},"title":"神的作为公义、公平","subtitle":"追求与长进","syl":{"n1":"神","n2":"的","n3":"作","n4":"为","n5":"公","n6":"义、","n7":"公","n9":"平,","n10":"道","n11":"路、","n12":"法","n13":"则","n14":"皆","n15":"完","n17":"备;","n18":"祂","n19":"的","n20":"行","n21":"动","n22":"全","n23":"然","n24":"正","n26":"直,","n27":"配","n28":"得","n29":"我","n30":"们","n31":"的","n32":"赞","n34":"美。","n35":"祂","n36":"的","n37":"定","n39":"罪、","n40":"祂","n41":"的","n42":"要","n44":"求,","n45":"无","n46":"一","n47":"不","n48":"显","n49":"祂","n50":"公","n51":"义;","n52":"律","n53":"法","n54":"已","n55":"将","n56":"我","n57":"们","n58":"判","n60":"罪,","n61":"审","n62":"判","n64":"座","n67":"前","n68":"谁","n69":"能","n71":"立?"},"verses":[{"label":"2.","lines":["律法虽定我们死罪,","神爱始终未遗弃;","公义审判归神儿子,","因祂作了我代替。","阿利路亚！我们今享","基督救赎的功绩:","买回我们归神自己,","甚至成为祂的义。"]},{"label":"3.","lines":["神的性情圣别超凡,","祂之所是乃至圣;","祂要圣化我们全人,","使其合乎祂性情。","从我灵中向外扩展,","祂要安家我心房;","直到全人内里各部,","尽得更新像祂样。"]},{"label":"4.","lines":["生机拯救过程奇妙,","全由生命来效力;","每日每时都可经历,","主的救恩何实际。","时常思念那灵的事,","心思就成为生命;","主在我里得着地位,","我得变化成神圣。"]},{"label":"5.","lines":["荣耀乃是神的彰显,","祂之所是显无尽;","也是救赎终极一步,","具体显明于我身。","荣耀乃是神圣生命","圣别过程的完成;","也是生命供应目的─","身体变像显殊荣。"]},{"label":"6.","lines":["为此,我们热切等待","得赎、被提、得荣耀;","神的丰满显明于地,","耶稣见证全显照。","我们就要完全像主,","永远彰显祂荣形;","神的众子显于荣耀,","宇宙万有共欢腾。"]},{"label":"7.","lines":["因神怜悯,蒙神选召,","荣耀定命得有分;","非借人的定意奔跑,","全是神主宰怜悯。","野橄榄枝竟得联于","栽种橄榄的丰富;","生机联结,分享肥汁,","长成荣耀的国度。"]},{"label":"8.","lines":["在这美妙过程之中,","日日因生命成圣;","满心感谢祂所赐与,","召会生活的供应。","在此全享神的自己,","实际、真切、又富饶;","同作众子,同为后嗣,","召会生活何荣耀！"]}]}