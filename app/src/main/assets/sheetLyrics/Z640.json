{"hymn":"Z640","parent":"E880","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"我对撒但总是说","subtitle":"属灵的争战－顺服","syl":{"n1":"我","n2":"对","n3":"撒","n4":"但","n5":"总","n6":"是","n7":"说：","n8":["『不，』",null,"u"],"n9":0,"n11":"我","n12":"对","n13":"父","n14":"神","n15":"就","n16":"说：『","n17":"是！』","n19":"好","n20":"叫","n21":"我","n22":"主","n23":"所","n24":"有","n25":"部","n27":"署，","n29":"全","n30":"得","n31":"成","n32":"功","n33":"不","n34":"受","n35":"阻。","n36":"当","n37":"我","n38":"这","n39":"样","n40":"听","n41":"主","n42":"号","n43":"令，","n44":"求","n45":"主","n46":"赐","n47":"给","n48":"我","n49":"权","n50":"柄，","n51":"使","n52":"我","n53":"满","n54":"有","n55":"能","n56":"力","n57":"圣","n58":"灵，","n59":"成","n60":"功","n61":"主","n62":"永","n63":"远","n64":"定","n65":"命。"},"verses":[{"label":"2.","lines":["我对撒但总是说：","『不，』","我对父神就说：『是！』","这个是我永远态度，","求神施恩加保护。","不然当我实行顺服，","撒但就要拦去路；","当我正在听你吩咐，","主耶稣，求你看顾！"]},{"label":"3.","lines":["我对撒但总是说：","『不，』","我对父神就说：『是！』","我愿完全绝对顺服，","不论将受如何苦。","当我与主同前时候，","主若肯拯救保守，","无论甚么威胁、引诱，","不会使我一回头。"]}]}