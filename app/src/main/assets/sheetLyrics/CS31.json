{"hymn":"CS31","parent":"E1104","quality":"exact","adjust":{"hold":0,"merge":0},"title":"哦主,你是平安祭","subtitle":"讚美的話","syl":{"n1":"哦","n2":"主,","n3":"你","n4":"是","n5":"平","n6":"安","n7":"祭,","n8":"我","n9":"們","n10":"按","n11":"手","n12":"於","n13":"你;","n14":"你","n15":"的","n16":"事","n17":"實","n18":"我","n19":"經","n20":"歷,","n21":"因","n22":"為","n23":"你","n24":"我","n25":"是","n26":"一。","n27":"眾","n28":"聖","n29":"歡","n30":"聚","n31":"會","n32":"幕","n33":"裏,","n34":"以","n35":"你","n36":"向","n37":"神","n38":"獻","n39":"祭;","n40":"同","n41":"父","n42":"喫","n43":"喝","n44":"享","n45":"受","n46":"你,","n47":"豐","n48":"富","n49":"有","n50":"何","n51":"能","n52":"比。","n53":"讚","n54":"美","n55":"基","n56":"督","n57":"是","n58":"平","n59":"安","n60":"祭,","n61":"使","n62":"神","n63":"與","n64":"人","n65":"滿","n66":"意;","n67":"距","n68":"離","n69":"全","n70":"去,","n71":"交","n72":"通","n73":"甜","n74":"蜜,","n75":"平","n76":"安","n77":"永","n78":"遠","n79":"堅","n80":"立!"},"verses":[{"label":"2.","lines":["血灑於壇何有能,","神聖平安得成;","寶血功效永堅定,","神前我享安寧。","我們放膽齊頌稱","“和平藉血己成!”","仇敵聞之驚又恐,","我們昂然誇勝。"]},{"label":"3.","lines":["燔祭馨香使神喜,","素祭叫人滿意,","據此再獻平安祭─","全是基督自己。","救主人性何柔細,","我們喫喝不已;","如此享受真可喜,","每逢我們聚集。"]},{"label":"4.","lines":["內臟、脂油最甘美,","當先歸神回味;","搖祭的胸何寶貝,","全體祭司受惠;","無酵餅同舉祭腿,","純全有能寶貴,","供職祭司受無愧,","福分拔尖全備。"]},{"label":"5.","lines":["胸作搖祭何豐富,","豫表復活基督,","以愛圍繞且照護,","使我超越脫俗。","腿作舉祭何充足,","描繪升天救主,","使我有能歷世途,","活出他命無誤。"]},{"label":"6.","lines":["得潔眾聖聚一堂,","基督愛筵飽嘗;","如此享受真無雙,","帶來交通無量。","心存感恩來歌唱,","因主恩典深廣;","為使主旨得顯彰,","願將全人獻上。"]}]}