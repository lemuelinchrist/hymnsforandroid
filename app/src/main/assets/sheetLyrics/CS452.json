{"hymn":"CS452","parent":"E1285","quality":"exact","adjust":{"hold":0,"merge":0},"title":"寶貴信仰已經一次","subtitle":"追求與長進","syl":{"n1":"寶","n2":"貴","n3":"信","n4":"仰","n6":"已","n8":"經","n9":"一","n10":"次","n11":"永","n12":"遠","n13":"交","n14":"付","n16":"聖","n18":"徒,","n19":"持","n20":"守","n21":"信","n22":"仰、","n24":"竭","n26":"力","n27":"爭","n28":"辯","n29":"乃","n30":"是","n31":"我","n32":"們","n34":"託","n36":"付。","n37":"我","n38":"們","n39":"深","n40":"知","n41":"所","n42":"信","n43":"的","n44":"是","n45":"誰,","n46":"並","n47":"且","n48":"憑","n49":"信、","n50":"愛、","n51":"藉","n52":"內","n53":"住","n54":"聖","n55":"靈,","n56":"保","n57":"守","n58":"那","n59":"美","n60":"好","n61":"的","n62":"託","n63":"付─","n64":"健","n65":"康","n66":"話","n67":"語","n68":"的","n69":"規","n70":"範。"},"verses":[{"label":"2.","lines":["美好託付務必持守,","絕不稍微偏離;","這是神經綸的標的,","是主恢復目的。"]},{"label":"3.","lines":["當用清潔無虧良心,","持守信仰奧祕;","行事為人莊重、聖別,","只活聖別無比!"]},{"label":"4.","lines":["健康話語善美規範,","憑信和愛持守;","不同教訓、虛空言談,","棄絕,一概不留!"]},{"label":"5.","lines":["傳講健康純全教訓─","合乎敬虔真理;","保守託付,持守信仰,","生求得主歡喜。"]},{"label":"6.","lines":["主,使我們忠於所託,","殷勤教導、傳揚;","言語、為人、愛、信、純潔,","都作信徒榜樣。"]}]}