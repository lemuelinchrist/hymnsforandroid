{"hymn":"C735","parent":"E1070","quality":"adapted","adjust":{"hold":1,"merge":2},"title":"前我墮入罪海中","subtitle":"福音－見證","syl":{"n1":"前","n2":"我","n3":"墮","n4":"入","n5":"罪","n6":"海","n7":"中，","n8":"遠","n9":"離","n10":"平","n11":"安","n12":"之","n13":"岸，","n16":"受","n17":"盡","n18":"摧","n19":"殘","n20":"深","n21":"感","n22":"痛，","n23":"欲","n24":"拔","n25":"不","n26":"能，","n27":"徒","n28":"歎！","n31":"但","n32":"主","n33":"聽","n34":"見","n35":"我","n36":"呼","n37":"喊，","n38":"立","n39":"前","n40":"來","n41":"拯","n42":["救，",null,"u"],"n43":0,"n46":"甘","n47":"冒","n48":"風","n49":"險","n50":"施","n51":"救","n52":"援，","n53":"愛","n54":"何","n55":"深","n56":"厚！","n59":"愛","n60":"救","n61":"了","n62":"我！","n65":"愛","n66":"救","n67":"了","n68":"我！","n70":"當","n71":"我","n73":"在","n74":"罪","n75":"中‿落","n76":"泊，","n77":"愛","n78":"救","n79":"了","n80":"我！","n82":"愛","n83":"救","n84":"了","n85":"我！","n88":"愛","n89":"救","n90":"了","n91":"我！","n93":"當","n94":"我","n96":"在","n97":"世","n98":"界‿活","n99":"著，","n100":"愛","n101":"救","n102":"了","n103":"我！"},"verses":[{"label":"2.","lines":["現今我在平安地，","脫離罪惡痛苦，","滿了喜樂和安息，","完全屬於耶穌。","愛是如此強而真，","配得我的歌謳；","我心、我命、我全人，","永歸祂有！"]},{"label":"3.","lines":["苦中罪人，請聽信，","耶穌能施拯救；","祂愛奇妙的救恩，","現在就要接受。","祂心渴望拯救你，","等候已經彀久；","立即相信，勿猶疑，","就來得救！"]}]}