{"hymn":"FR206","parent":"E1068","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Le bon Berger si tendre","subtitle":"","syl":{"n1":"Le","n2":"bon","n3":["Ber","i"],"n4":["ger","t"],"n5":"si","n6":["ten","i"],"n7":["dre","t"],"n8":"Me","n9":["cher","i"],"n10":["cha,","t"],"n11":"me","n12":["sai","i"],"n13":["sit,","t"],"n15":"Me","n16":"prit","n17":"sur","n18":"Ses","n19":["é","i"],"n20":["pau","m"],"n21":["les,","t"],"n22":["M'a","i"],"n23":["me","m"],"n24":["na","t"],"n25":"aux","n26":["bre","i"],"n27":["bis.","t"],"n29":"Aux","n30":"cieux,","n31":"les","n32":["an","i"],"n33":["ges","t"],"n34":"crient","n35":"de","n36":"joie,","n37":["Lorsqu","i"],"n38":["'un","t"],"n39":["pé","i"],"n40":["cheur","t"],"n41":"en","n42":["Jé","i"],"n43":["sus","t"],"n44":"croit!","n46":"Son","n47":["a","i"],"n48":["mour","t"],"n49":"me","n50":["cher","i"],"n51":["che","t"],"n52":"Et","n53":"Son","n54":"sang","n55":"me","n56":["la","i"],"n57":["ve.","t"],"n58":"Au","n59":["trou","i"],"n60":["peau","t"],"n61":"Sa","n62":["grâ","i"],"n63":["ce","t"],"n64":"m'a","n65":["con","i"],"n66":["duit,","t"],"n68":"Au","n69":["trou","i"],"n70":["peau","t"],"n71":"Sa","n72":["grâ","i"],"n73":["ce","t"],"n74":"m'a","n75":["con","i"],"n76":["duit.","t"]},"verses":[{"label":"2.","lines":["Il soigne mes blessures,","Versant l'huile et le vin.","Paisible, Il me murmure :","« N'aie crainte, tu es Mien ! »","Enfin, Sa douce voix j'entends,","Qui réjouit mon cœur souffrant."]},{"label":"3.","lines":["Il montre Ses blessures,","Le sang qu'Il a versé.","Ému, je vois Sa tête,","D'épines couronnée.","Par quoi, en moi, fut-Il saisi,","Pour endurer telle agonie ?"]},{"label":"4.","lines":["Assis dans Sa présence,","J'admire Sa beauté.","De Lui je m'émerveille,","Retrace Ses bontés.","Aurais-je dans l'éternité,","Assez de temps pour Le louer ?"]},{"label":"5.","lines":["Dès lors, je me repose,","Sa paix réside en moi.","Bientôt Il va paraître,","Mon Bien-aimé, mon Roi !","Il reviendra pour enlever","Sa chère épouse préparée."]}]}