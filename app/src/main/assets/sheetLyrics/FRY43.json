{"hymn":"FRY43","parent":"E204","quality":"hand","adjust":{"hold":0,"merge":0},"title":"Rassemblés en Ton nom, Jésus","subtitle":"","syl":{"n1":["Ras","i"],"n2":["sem","m"],"n3":["blés","t"],"n4":"en‿Ton","n5":"nom,","n6":"Jé‿sus,","n7":["Ne‿voy","i"],"n8":["ant‿plus","t"],"n10":["ri","i"],"n11":["en","t","u"],"n12":0,"n13":["que",null,"u"],"n15":0,"n16":"Toi,","n18":"Ta","n20":["pré","i"],"n21":["sence","t"],"n22":"est","n23":["dou","i"],"n24":["ce","t"],"n25":"à","n26":"nos","n27":"cœurs,","n29":"Et","n30":"les‿mène","n31":"à","n32":"Toi","n33":["Sei","i"],"n34":["gneur!","t","u"],"n35":0},"verses":[{"label":"2.","lines":["Aimés d’un amour infini,","L’amour du Père envers Toi,","Seigneur, nos cœurs affectionnent","Toutes Ses pensées pour Toi."]},{"label":"3.","lines":["Son repos, Sa joie, Son plaisir,","Ses délices sont en Toi.","Seigneur, seul Ton cœur peut saisir","Le bonheur du Père en Toi."]},{"label":"4.","lines":["Il versa Son amout sur Toi,","T’appela Son Bien-aimé ;","Pour nous, Il ne T’épargna pas,","Par Ta mort Il nous gagna."]},{"label":"5.","lines":["Nous Te verrons face à face,","Nous serons semblables à Toi ;","Ton nom toujours apportera","L’allégresse au cœur de Dieu."]},{"label":"6.","lines":["Chants de joie et d’allégresse,","Au milieu de l’assemblée","Monteront, se multiplieront :","Gloire à Dieu pour l’éternité."]}]}