{"hymn":"Z672","parent":"E987","quality":"exact","adjust":{"hold":0,"merge":0},"title":"一日","subtitle":"福音－救主","syl":{"n1":"一","n2":"日，","n3":"当","n4":"天","n5":"上","n6":"充","n7":"满","n8":"赞","n9":"美","n10":"之","n11":"声，","n12":"一","n13":"日，","n14":"当","n15":"罪","n16":"恶","n17":"深","n18":"染","n19":"全","n20":"人","n21":"类，","n23":"耶","n24":"稣","n25":"就","n26":"降","n27":"世，","n28":"为","n29":"一","n30":"童","n31":"女","n32":"所","n33":"生，","n34":"住","n35":"在","n36":"人","n37":"中","n38":"间，","n39":"显","n40":"出","n41":"神","n42":"光","n43":"辉！","n45":"降","n46":"生，","n47":"为","n48":"爱","n49":"我；","n50":"受","n51":"死，","n52":"为","n53":"救","n54":"我；","n55":"埋","n56":"葬，","n57":"为","n58":"带","n59":"去","n60":"我","n61":"一","n62":"切","n63":"罪","n64":"过；","n66":"复","n67":"活，","n68":"为","n69":"白","n70":"白","n71":"的","n72":"永","n73":"远","n74":"称","n75":"义","n76":"我；","n77":"一","n78":"日，","n79":"祂","n80":"要","n81":"来，","n82":"哦，","n83":"荣","n84":"日","n85":"接","n86":"我！"},"verses":[{"label":"2.","lines":["一日，","人将祂带到加略山上，","一日，","人把祂钉木上剪除；","祂备尝痛苦，","被神击打、压伤，","担当我罪过，","作我救赎主！"]},{"label":"3.","lines":["一日，","人撇祂独自在那园中，","一日，","祂安息，息了诸痛苦；","天使从天来，","夜间守祂墓洞；","无望者之望，","乃是我救主！"]},{"label":"4.","lines":["一日，","那坟墓不能将祂留藏，","一日，","那大石辊开不封堵；","祂已复活了，","祂已胜过死亡，","升到高天上，","永远作我主！"]},{"label":"5.","lines":["一日，号筒响，","传报祂从天来，","一日，","祂荣光满天都照出；","奇妙的日子，","带来我的心爱；","荣耀的救主，","就是我耶稣！"]}]}