{"hymn":"ZS858","parent":"E1292","quality":"exact","adjust":{"hold":0,"merge":0},"title":"高品福音,无上福祉","subtitle":"事奉与福音","syl":{"n1":"高","n2":"品","n3":"福","n4":"音,","n5":"无","n6":"上","n7":"福","n8":"祉,","n9":"应","n10":"当","n11":"传","n12":"扬,","n13":"无","n14":"畏","n15":"无","n16":"愧;","n17":"人","n18":"得","n19":"重","n20":"生,","n21":"成","n22":"神","n23":"儿","n24":"子,","n25":"成","n26":"全","n27":"神","n28":"旨,","n29":"至","n30":"高","n31":"至","n32":"贵;","n33":"不","n34":"仅","n35":"出","n36":"死,","n37":"脱","n38":"离","n39":"罪","n40":"罚,","n41":"更","n42":"得","n43":"成","n44":"为","n45":"圣","n46":"别","n47":"族","n48":"类;","n49":"如","n50":"此","n51":"喜","n52":"信,","n53":"超","n54":"凡","n55":"绝","n56":"佳,","n57":"地","n58":"上","n59":"万","n60":"人","n61":"都","n62":"当","n63":"来","n64":"归。"},"verses":[{"label":"2.","lines":["长兄基督,神所立定,","万有归祂承受管理;","我们与祂同性、同命,","同作后嗣荣耀无匹。","创世以前,蒙神拣选,","我们得享殊荣无比;","如此基督,如此恩典,","谁能不受吸引归依?"]},{"label":"3.","lines":["同蒙天召圣别弟兄,","身分崇高,非人能及,","且与兄长定命与共─","如此佳音,谁不称奇?","荣耀基督天上执政,","我们竟得与祂是一,","如此呼召超绝神圣,","谁竟愚顽,弃而不理?"]}]}