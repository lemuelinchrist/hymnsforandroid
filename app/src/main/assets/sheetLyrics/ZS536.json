{"hymn":"ZS536","parent":"E1258","quality":"exact","adjust":{"hold":0,"merge":0},"title":"何等可爱,哦,何宝贵","subtitle":"教会的异象","syl":{"n1":"何","n2":"等","n3":"可","n5":"爱,","n6":"哦,","n7":"何","n8":"宝","n10":"贵,","n11":"是","n12":"主","n13":"众","n14":"地","n16":"方","n17":"召","n18":"会！","n19":"我","n20":"魂","n21":"羡","n23":"慕,","n24":"甚","n25":"至","n26":"渴","n28":"想,","n29":"主,","n30":"你","n31":"院","n32":"宇","n33":"极","n35":"华","n36":"美。","n37":"我","n38":"心","n39":"渴","n41":"慕,","n42":"我","n43":"灵","n44":"切","n46":"望","n47":"能","n48":"交","n49":"通","n51":"于","n52":"众","n54":"召","n55":"会;","n56":"为","n58":"此","n59":"我","n61":"向","n62":"活","n64":"神","n66":"呼","n69":"吁,","n70":"我","n71":"心、","n72":"我","n74":"命","n75":"不","n76":"别","n77":"归。"},"verses":[{"label":"2.","lines":["心中想往锡安大道,","如此之人为有福;","必因我主行走有力,","终日颂赞与称祝。","召会生活时有乐歌,","因靠我神胜险阻;","虽经巴迦流泪之谷,","却使成为泉源处。"]},{"label":"3.","lines":["在你召会住留一日,","胜似别处住千日;","我主乃是日头、盾牌,","至微肢体亦得恃。","恩典、荣耀从主倾注,","无一好处祂不赐;","如此安居召会之中,","必蒙祝福永无止。"]}]}