{"hymn":"ZS134","parent":"CS134","quality":"exact","adjust":{"hold":0,"merge":0},"title":"神子耶稣为我离宝座","subtitle":"永活救主","syl":{"n2":"神","n3":"子","n4":"耶","n5":"稣","n7":"为","n8":"我","n9":"离","n10":"宝","n11":"座，","n13":"降","n14":"世","n15":"为","n16":"人，","n18":"历","n19":"尽","n20":"忧","n21":"苦；","n23":"舍","n24":"了","n25":"自","n26":"己，","n28":"流","n29":"血","n30":"救","n31":"赎","n32":"我，","n34":"从","n35":"死","n36":"复","n37":"活，","n38":"化","n39":"身","n40":"那","n41":"灵，","n42":"作","n43":"我","n44":"拯","n45":"救","n46":"主。","n48":"永","n49":"活","n50":"救","n51":"主，","n53":"是","n54":"我","n55":"荣","n56":"耀","n57":"盼","n58":"望，","n60":"点","n61":"活","n62":"我","n63":"灵，","n65":"圣","n66":"化","n67":"我","n68":"情；","n70":"安","n71":"家","n72":"我","n73":"心","n75":"房，","n76":"使","n77":"我","n78":"有","n79":"力","n80":"量，","n82":"同","n83":"众","n84":"圣","n85":"享","n86":"主","n87":"大","n88":"爱，","n89":"神","n90":"丰","n91":"满","n92":"显","n93":"明。"},"verses":[{"label":"2.","lines":["在主里面我获得新生，","旧事已过，全都更新；","爱中生活，新造何光明；","生机拯救来自那灵，","救恩何丰盛。"]},{"label":"3.","lines":["主，我爱你，","愿跟随你行，","奔跑赛程，讨你欢心；","使我忠诚，紧联于你灵，","直到路终，完全得胜，","与你永相亲。"]}]}