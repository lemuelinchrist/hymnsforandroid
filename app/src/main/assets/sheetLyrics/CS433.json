{"hymn":"CS433","parent":"E396","quality":"exact","adjust":{"hold":0,"merge":0},"title":"我今上行,毫不遲疑","subtitle":"追求與長進","syl":{"n1":"我","n2":"今","n3":"上","n4":"行,","n5":"毫","n6":"不","n7":"遲","n8":"疑,","n9":"每","n10":"日","n11":"邁","n12":"向","n13":"更","n14":"高","n15":"之","n16":"地;","n17":"前","n18":"行","n19":"途","n20":"中,","n21":"禱","n22":"告","n23":"不","n24":"息:","n25":"“主","n26":"使","n27":"我","n28":"立","n29":"更","n30":"高","n31":"之","n32":"地。”","n33":"主,","n34":"加","n35":"我","n36":"力,","n37":"將","n38":"我","n39":"舉","n40":"起,","n41":"使","n42":"我","n43":"踏","n44":"上","n45":"更","n46":"高","n47":"之","n48":"地;","n49":"更","n50":"高","n51":"境","n52":"地,","n53":"憑","n54":"信","n55":"站","n56":"立;","n57":"主,","n58":"使","n59":"我","n60":"立","n61":"更","n62":"高","n63":"之","n64":"地。"},"verses":[{"label":"2.","lines":["我心不願徘徊舊地,","疑惑四起,恐懼來襲;","人雖寧願姑且安逸,","我心卻在更高之地。"]},{"label":"3.","lines":["雖有惡者火箭攻擊,","我要安坐諸天界裏;","信心聽見樂歌洋溢,","發自最美,最高之地。"]},{"label":"4.","lines":["登上山巔,只看見你,","榮光將我心眼開啟;","安息在望,仍要求祈:","“主,領我往更高之地。”"]}]}