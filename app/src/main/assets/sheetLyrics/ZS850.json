{"hymn":"ZS850","parent":"E463","quality":"exact","adjust":{"hold":0,"merge":0},"title":"我爱,我爱我恩主","subtitle":"事奉与福音","syl":{"n1":"我","n2":"爱,","n3":"我","n4":"爱","n5":"我","n6":"恩","n7":"主,","n8":"不","n9":"愿","n10":"自","n11":"由","n12":"外","n13":"出;","n14":"因","n15":"祂","n16":"是","n17":"我","n18":"救","n19":"赎","n20":"主,","n21":"为","n22":"我","n23":"赎","n24":"价","n25":"已","n26":"付。","n27":"爱","n28":"祂、","n29":"事","n30":"祂","n31":"永","n32":"不","n33":"离,","n34":"何","n35":"其","n36":"甘","n37":"甜、","n38":"蒙","n39":"福;","n40":"虽","n41":"然","n42":"有","n43":"时","n44":"会","n45":"困","n46":"倦,","n47":"祂","n48":"赐","n49":"安","n50":"息","n51":"稳","n52":"固。"},"verses":[{"label":"2.","lines":["我主舍命流宝血,","重价买我归属;","救我脱离罪权势,","脱离己的束缚。","祂既召我来事奉,","我愿甘心顺服;","如此永享真自由─","爱中作祂奴仆。"]},{"label":"3.","lines":["全心事奉不半途,","惟有祂是我主;","祂是爱我将命舍,","我愿永远祂属。","我心感戴、灵欢腾,","口中高歌不住:","我爱,我爱我恩主,","不愿自由外出。"]}]}