{"hymn":"Z665","parent":"E922","quality":"adapted","adjust":{"hold":2,"merge":0},"title":"去向亡世供应基督","subtitle":"传扬福音－供应基督","syl":{"n1":"去","n2":"向","n3":"亡","n4":"世","n5":"供","n6":"应","n7":"基","n8":"督，","n9":"非","n10":"仅","n11":"借","n12":"话","n13":"之","n15":"所","n16":"云。","n17":"更","n18":"借","n19":"生","n20":"活","n21":"分","n22":"出","n24":"基","n25":"督，","n26":"供","n27":"应","n28":"可","n29":"怜","n30":"的","n31":"人","n32":["群。",null,"u"],"n33":0,"n34":"去","n35":"向","n36":"亡","n37":"世","n38":"供","n39":"应","n40":"基","n41":"督，","n42":"使","n43":"祂","n44":"显","n45":"于","n46":"你","n47":"生","n48":["活；",null,"u"],"n49":0,"n50":"凭","n51":"祂","n52":"活","n53":"着，","n54":"将","n56":"祂","n57":"分","n58":"出，","n59":"使","n60":"人","n61":"与","n62":"你","n63":"同","n65":"得","n66":"着。"},"verses":[{"label":"2.","lines":["去向亡世供应基督-","你所有的宝贵主；","将你基督分给亲人，","作其成功与财富。"]},{"label":"3.","lines":["去向亡世供应基督-","你所享受的基督；","将你基督分给朋友，","作其夸耀与鸿福。"]},{"label":"4.","lines":["去向亡世供应基督，","祂是你命并一切；","将你基督分给众人，","带人来尝祂超越。"]}]}