{"hymn":"CS917","parent":"E893","quality":"exact","adjust":{"hold":0,"merge":0},"title":"今日爭戰兇猛","subtitle":"盼望與豫備","syl":{"n1":"今","n2":"日","n3":"爭","n4":"戰","n5":"兇","n6":"猛,","n7":"撒","n8":"但","n9":"尚","n10":"未","n11":"退","n12":"敗;","n13":"戰","n14":"場","n15":"傳","n16":"來","n17":"呼","n18":"喊","n19":"之","n21":"聲,","n22":"比","n23":"前","n24":"更","n25":"加","n26":"澎","n27":"湃;","n28":"陰","n29":"府","n30":"背","n31":"叛","n32":"喧","n33":"囂,","n34":"雖","n35":"仍","n36":"強","n37":"悍","n38":"不","n39":"衰;","n40":"請","n41":"聽","n42":"夜","n43":"半","n44":"主","n45":"發","n46":"呼","n47":"聲:","n48":"“看","n49":"哪,","n50":"我","n51":"必","n52":"快","n53":"來!”"},"verses":[{"label":"2.","lines":["雖有更苦試煉,","爭戰不斷接連;","黑暗權勢如同軍隊,","集聚進逼無間,","正當儆醒等候,","正逢艱苦試驗;","卻聞歌聲喜樂、甘甜:","我主已快顯現!"]},{"label":"3.","lines":["當在末後年日,","持守見證不移;","撒但無所不用其極,","我們仍需站立;","應當重新得力,","纔能勝過仇敵;","直到見主,何等歡喜,","歎息全都止息。"]},{"label":"4.","lines":["誰願奮力進前,","靠主能力遮蓋?","誰願堅定為主爭戰,","直到那日奏凱?","得勝歡呼號聲,","至終必定傳開;","何等喜樂,已先聽見,","“看哪,我必快來!”"]},{"label":"5.","lines":["誰願走上窄路,","將神旨意揀選?","歷經風暴,通過考驗,","絕不退後、心變?","誰願忠勇進前,","忍受痛苦、凶險?","眾得勝者彷彿看見,","“我主已快顯現!”"]},{"label":"6.","lines":["應當加緊腳步,","儘管黑暗四佈;","期待那日被提之福,","榮耀輝煌奪目;","終將撒但征服,","迎接再臨基督;","得勝者阿,揚聲歡呼:","“看哪!耶穌,我主!”"]}]}