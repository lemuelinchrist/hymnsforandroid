{"hymn":"ZS924","parent":"E1322","quality":"exact","adjust":{"hold":0,"merge":0},"title":"今在灵里,在召会中","subtitle":"盼望与豫备","syl":{"n1":"今","n2":"在","n3":"灵","n4":"里,","n6":"在","n8":"召","n9":"会","n10":"中,","n11":"得","n12":"见","n13":"异","n14":"象,","n16":"高、","n17":"深、","n18":"长、","n19":"阔:","n20":"我","n21":"们","n22":"定","n23":"命","n25":"卓","n26":"越","n28":"超","n30":"凡,","n32":"前","n33":"所","n34":"未","n35":"见,","n37":"超","n38":"人","n40":"能","n41":"度。"},"verses":[{"label":"2.","lines":["非仅道理,乃是启示","基督自己奇妙、奥秘;","远超心思所能领畧,","但在灵中都成实际。"]},{"label":"3.","lines":["祂是丰富、无限、深奥,","无法测度、超绝美妙;","竟需我们得着救恩,","同为后嗣显祂荣耀。"]},{"label":"4.","lines":["神已计划,也来创造,","还要作出新造无穷;","祂已立子作祂后嗣,","执掌祂的神圣行政。"]},{"label":"5.","lines":["但在神的经纶之中,","并非仅有一子得荣;","乃是长子率众弟兄,","同作后嗣,定命与共。"]},{"label":"6.","lines":["为着够格作神后嗣,","我们必须长大成熟,","好与基督同得荣耀,","承受神的所是所有。"]},{"label":"7.","lines":["作神后嗣,随同长兄,","承受万有,丰富无缺;","更是同伙,一同经营","“基督、召会”宇宙大业。"]},{"label":"8.","lines":["今在灵里,在召会中,","得见我们呼召、盼望:","并非遥望,等“上天堂”,","乃是在地与主同王。"]},{"label":"9.","lines":["贫寒如我,竟成君王,","有分宝座,承受国度;","凡神所是并祂所有,","全地、万有无不我属。"]}]}