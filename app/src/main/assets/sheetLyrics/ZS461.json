{"hymn":"ZS461","parent":"CS461","quality":"exact","adjust":{"hold":0,"merge":0},"title":"你竟独行这条十架窄路","subtitle":"追求与长进","syl":{"n1":"你","n2":"竟","n3":"独","n4":"行","n5":"这","n6":"条","n7":"十","n8":"架","n9":"窄","n10":"路,","n12":"客","n13":"西","n14":"马","n15":"尼,","n16":"别","n17":"后","n18":"成","n19":"殊","n20":"途。","n22":"羊","n23":"群","n24":"逃","n25":"散,","n26":"牧","n27":"人","n28":"独","n29":"蹒","n30":"跚,","n32":"幽","n33":"暗","n34":"掌","n35":"权,","n36":"炭","n37":"火","n38":"添","n39":"冷","n40":"淡。","n41":"去","n42":"罢！","n43":"属","n44":"地","n45":"的","n46":"贿","n47":"赂！","n49":"去","n50":"罢！","n51":"虚","n52":"假","n53":"的","n54":"祝","n55":"福！","n57":"这","n58":"条","n59":"古","n60":"老","n61":"的","n62":"十","n63":"架","n64":"窄","n65":"路,","n66":"主","n67":"爱","n68":"你","n69":"的","n70":"人","n71":"当","n72":"同","n73":"赴。"},"verses":[{"label":"2.","lines":["你何独行这条十架窄路?","前说恩言,今被人厌诅！","叹息声灭,欺凌却暴烈,","神的爱子,何竟遭天绝！"]},{"label":"3.","lines":["你终独行这条十架窄路,","各各他山,罪愆独背负。","钉痕的手,困我似囚牢?","无力脱开,枪扎的怀抱?"]},{"label":"4.","lines":["与你同行这条十架窄路,","断绝世界,今生葬泥土。","“你爱我吗?”是的我爱你！","不再别依,随你脚踪起。"]}]}