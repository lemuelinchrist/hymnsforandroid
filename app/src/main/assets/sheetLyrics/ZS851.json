{"hymn":"ZS851","parent":"E903","quality":"exact","adjust":{"hold":0,"merge":0},"title":"求主发言,教导我舌","subtitle":"事奉与福音","syl":{"n1":"求","n2":"主","n3":"发","n4":"言,","n5":"教","n7":"导","n8":"我","n10":"舌,","n11":"使","n12":"我","n13":"能","n14":"言,","n15":"照","n16":"你","n17":"心","n18":"意;","n19":"寻","n20":"回","n21":"愚","n22":"蒙","n23":"并","n25":"失","n26":"迷","n28":"者,","n29":"像","n30":"你","n31":"爱","n32":"中","n33":"细","n35":"细","n36":"寻","n37":"觅。"},"verses":[{"label":"2.","lines":["求主引导,使我有光,","领浪荡者归回正途;","供我饮食,使我有粮,","喂养饥渴之徒无数。"]},{"label":"3.","lines":["求主加力,使我得以","稳踏基督磐石之上,","且能伸出爱的膀臂,","风暴海中救援丧亡。"]},{"label":"4.","lines":["求主教我如何将你","宝贵救恩向人陈述,","使我言辞如有双翼,","及于人心,触人深处。"]},{"label":"5.","lines":["赐我以你甜美安息,","使我言语应时如你,","能施安抚,复苏、加力,","使疲乏者都得再起。"]},{"label":"6.","lines":["用你丰富充满我心,","直至满溢恩典美辞:","述说你爱,颂扬你恩,","分赐生命、亮光不止。"]},{"label":"7.","lines":["我虽不堪,愿主使用,","随时、随处照你喜悦;","直至见你,荣耀之中,","同享安息,喜乐不绝。"]}]}