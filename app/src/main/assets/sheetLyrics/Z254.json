{"hymn":"Z254","parent":"E322","quality":"exact","adjust":{"hold":0,"merge":0},"title":"多年疲惫","subtitle":"得救的证实与快乐－因基督得满足","syl":{"n1":"多","n2":"年","n3":"疲","n4":"惫，","n5":"未","n6":"能","n7":"寻","n8":"到","n9":"一","n10":"泉","n11":"源-","n12":"永","n13":"不","n14":"干","n15":"涸","n16":"的","n17":"活","n18":"泉；","n20":"地","n21":"上","n22":"一","n23":"切","n24":"全","n25":"都","n26":"未","n27":"能","n28":"如","n29":"我","n30":"愿-","n31":"无","n32":"何","n33":"能","n34":"使","n35":"我","n36":"心","n37":"满。","n39":"我","n40":"今","n41":"饮","n42":"于","n43":"永","n44":"不","n45":"干","n46":"涸","n47":"的","n48":"活","n49":"泉，","n50":"我","n51":"今","n52":"饮","n53":"于","n54":"生","n55":"命","n56":"活","n57":"水","n58":"泉","n59":"源；","n60":"甜","n61":"美、","n62":"喜","n63":"乐、","n64":"欢","n65":"畅，","n66":"何","n67":"其","n68":"无","n69":"限","n70":"无","n71":"量，","n72":"我","n73":"今","n74":"饮","n75":"于","n76":"生","n77":"命","n78":"活","n79":"水","n80":"泉","n81":"源。"},"verses":[{"label":"2.","lines":["永远不在罪的野地再流荡，","我已寻到活水泉；","我的喜乐之杯满溢而流淌，","基督已使我心满。"]},{"label":"3.","lines":["在此所得满足越过越甜美，","在此得主的安息；","在此所受安慰越过越加倍，","在此受主的福气。"]},{"label":"4.","lines":["在此得到永无止境的供应，","在此恩中永沐浴；","向这医治活泉，我心必全倾，","直到永世不稍渝。"]}]}