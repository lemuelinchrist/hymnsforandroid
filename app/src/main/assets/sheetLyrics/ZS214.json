{"hymn":"ZS214","parent":"E1273","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"主曾召你我得救","subtitle":"得胜借着吃基督","syl":{"n1":"主","n2":"曾","n3":"召","n4":"你","n5":"我","n6":"得","n7":"救，","n8":"祂","n9":"再","n10":"召","n11":"你","n12":"我","n13":"得","n14":"胜。","n15":"对","n16":"主","n17":"呼","n18":"召","n19":"说『","n20":"阿","n22":"们』─","n23":"要","n24":"得","n25":"胜！","n26":"召","n27":"会","n28":"光","n29":"景","n30":"堕","n31":"落","n32":"了，","n33":"许","n34":"多","n35":"道","n36":"理","n37":"都","n38":"知","n40":"道，","n41":"生","n42":"命","n43":"却","n44":"是","n45":"摸","n46":"不","n47":"着─","n49":"要","n50":"得","n51":"胜！","n52":"要","n53":"得","n54":"胜！","n55":"要","n57":"得","n58":"胜！","n59":"胜","n60":"过","n61":"死","n62":"沉","n63":"的","n64":"宗","n65":"教，","n66":"要","n67":"得","n68":["胜！",null,"u"],"n69":0,"n70":"放","n71":"下","n72":"所","n73":"有","n74":"的","n75":"辛","n76":"劳，","n77":"脱","n78":"离","n79":"一","n80":"切","n81":"的","n82":"老","n84":"套，","n85":"只","n86":"管","n87":"单","n88":"单","n89":"来","n90":"吃","n92":"主─","n93":"要","n94":"得","n95":"胜！"},"verses":[{"label":"2.","lines":["神原命定人来吃，","吃是今日的恢复，","吃是得胜的道路─","要得胜！","快来享受生命树，","脱去道理的束缚，","得胜借着吃基督─","要得胜！"]},{"label":"3.","lines":["教训不能变化魂，","叫神旨意受亏损，","吃主搆上神标准─","要得胜！","若要得胜就要吃，","无论聚集或独处，","吃到全人得饱足─","要得胜！"]},{"label":"4.","lines":["速速催促主再来，","借着吃喝产男孩，","现在吃祂，","一直吃─要得胜！","为着主的金灯台，","为着得胜的男孩，","为着新妇祂所爱─","要得胜！"]}]}