{"hymn":"CS877","parent":"NS10066","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"甚麼使你為我捨命","subtitle":"事奉與福音","syl":{"n1":"甚","n2":"麼","n3":"使","n4":"你","n5":"為","n6":"我","n7":"捨","n8":"命?","n10":"為","n11":"何","n12":"救","n13":"我?","n14":"我","n15":"是","n17":"你","n18":"仇","n19":["敵。",null,"u"],"n20":0,"n22":"你","n23":"上","n24":"十","n25":"架,","n26":"為","n27":"作","n29":"我","n30":"代","n32":"替;","n33":"你","n34":"受","n37":"咒","n39":"詛,","n41":"我","n43":"享","n45":"福","n46":"氣。","n48":"我","n49":"原","n50":"是","n51":"你","n52":"仇","n53":"敵,","n55":"竟","n56":"也","n57":"能","n58":"歸","n59":"服","n60":"你;","n62":"因","n63":"你","n64":"眷","n65":"臨,","n66":"愛","n67":"裏","n68":"尋","n69":"覓。","n71":"是","n72":"你","n73":"愛","n74":"和","n75":"憐","n76":"憫,","n78":"征","n79":"服","n80":"頑","n81":"梗","n82":"剛","n83":"愎;","n85":"昔","n86":"日","n87":"仇","n88":"敵,","n89":"今","n90":"願","n91":"服","n92":"你。"},"verses":[{"label":"2.","lines":["未曾想到,你如此行;","溫柔、憐恤,全向我洋溢。","為何你愛?我罪大惡極;","但你愛我─你的仇敵。"]},{"label":"3.","lines":["你之愛我,從永遠起;","你愛恆久、堅定不稍移。","雖我言語,冒犯得罪你;","但你等候,代求不息。"]},{"label":"4.","lines":["我是罪人,犯罪不已;","活在罪中,行不法不義。","我的惡心,反判又悖逆;","但你慈心,感我衷裏。"]},{"label":"5.","lines":["我一轉身,就遇見你;","你正等我,懷聖別愛意。","我怎忍心,再與你為敵?","耶穌,我今降服歸你。"]}]}