{"hymn":"C207","parent":"E263","quality":"exact","adjust":{"hold":0,"merge":0},"title":"神賜祂的能力","subtitle":"聖靈的豐滿－火","syl":{"n1":"神","n2":"賜","n3":"祂","n4":"的","n5":"能","n6":"力","n7":"在","n8":"我","n9":"窮","n10":"苦","n11":"心","n12":"內，","n13":"時","n14":"刻","n15":"保","n16":"守","n17":"提","n18":"挈，","n19":"灌","n20":"以","n21":"必","n22":"需","n23":"恩","n24":"惠，","n25":"藉","n26":"靈","n27":"住","n28":"我","n29":"裡","n30":"面，","n31":"掌","n32":"管","n33":"我","n34":"的","n35":"全","n36":"人，","n37":"用","n38":"愛","n39":"發","n40":"出","n41":"火","n42":"焰，","n43":"在","n44":"我","n45":"心","n46":"內","n47":"直","n48":"焚。","n49":"焚","n50":"燒","n51":"在","n52":"我","n53":"心","n54":"內，","n55":"焚","n56":"燒","n57":"在","n58":"我","n59":"心","n60":"內；","n61":"愛","n62":"焰","n63":"自","n64":"天","n65":"傾","n66":"下，","n67":"焚","n68":"燒","n69":"在","n70":"我","n71":"心","n72":"內！","n73":"聖","n74":"靈","n75":"已","n76":"來","n77":"保","n78":"惠，","n79":"主","n80":"名","n81":"應","n82":"當","n83":"讚","n84":"美，","n85":"愛","n86":"焰","n87":"自","n88":"天","n89":"傾","n90":"下，","n91":"焚","n92":"燒","n93":"在","n94":"我","n95":"心","n96":"內！"},"verses":[{"label":"2.","lines":["我在架下低頭，","我在壇上奉獻，","此生一切所有，","都呈我主腳前；","祂為我付贖價，","祂召我得安息，","祂使天火降下，","悅納我的活祭。"]},{"label":"3.","lines":["我無任何功行，","惟有神的應許；","我藉愛子受刑，","蒙恩作神兒女。","榮耀歸於我神，","阿利路亞，阿們；","這愛激勵至深，","如火內心在焚。"]}]}