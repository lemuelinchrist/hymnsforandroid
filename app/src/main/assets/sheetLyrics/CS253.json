{"hymn":"CS253","parent":"E1164","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"基督美地,包羅萬有-","subtitle":"享受基督","syl":{"n1":"基","n2":"督","n3":"美","n4":"地,","n5":"包","n6":"羅","n7":"萬","n8":"有-","n9":"祂","n10":"是","n11":"我","n12":"的","n13":"一","n14":"切:","n16":"源、","n17":"泉、","n18":"河","n19":"川,","n20":"清","n21":"新","n22":"明","n23":"透,","n24":"日","n25":"夜","n26":"湧","n27":"流","n29":"不","n30":"歇;","n33":"谷","n34":"中","n35":"山","n36":"上","n37":"流","n38":"出","n39":"水","n40":"來,","n41":"潤","n42":"我","n43":"心","n44":"田,","n45":"滿","n46":"溢","n47":"充","n48":"盈;","n49":"何","n50":"等","n51":"榮","n52":"耀,","n53":"活","n54":"水","n55":"澎","n56":"湃─","n57":"作","n58":"我","n59":"生‿命!"},"verses":[{"label":"2.","lines":["神成肉身,忍辱受死,","繁增如同小麥;","死而復活,生命分賜,","初熟如同大麥;","無花果樹,甘甜滿足,","葡萄產酒,神、人喜悅;","如此供應,全在基督─","有祂無缺!"]},{"label":"3.","lines":["基督還是真石榴樹,","生命豐美充足;","是橄欖樹,新油產出,","膏抹永不缺如;","流奶與蜜,美善甘甜,","供我滋養,加我能力;","祂的豐富,如此完全─","基督美地!"]},{"label":"4.","lines":["在這美地不缺食物,","我們一無所缺;","祂是如此豐饒富庶,","我們頌讚不絕;","上好美地,廣大無邊,","應有盡有,齊備完全;","今在我心還要擴展─","無量無限!"]},{"label":"5.","lines":["這地石頭如鐵之堅,","山內可以挖銅;","權柄如鐵,憑以爭戰,","仇敵不能得逞;","再經苦難,渣滓全去,","煉淨明亮,如銅顯出;","有鐵有銅,應付所需─","全是基督!"]},{"label":"6.","lines":["為這美地我們頌讚:","主,你何其包羅!","喫喝飽足,讓你充滿,","豐富豈能盡說!","求使我們經營不輟,","美地實際增長不已;","我的喜樂,我的生活─","基督美地!"]}]}