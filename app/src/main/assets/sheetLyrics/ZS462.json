{"hymn":"ZS462","parent":"CS462","quality":"exact","adjust":{"hold":0,"merge":0},"title":"大哉！敬虔奥秘！神显于肉体","subtitle":"追求与长进","syl":{"n1":"大","n2":"哉！","n3":"敬","n4":"虔","n5":"奥","n6":"秘！","n7":"神","n8":"显","n9":"于","n10":"肉","n11":"体,","n12":"支","n13":"搭","n14":"帐","n15":"幕,","n16":"丰","n17":"满","n18":"恩","n19":"典","n20":"何","n21":"实","n22":"际;","n23":"神","n24":"圣","n25":"奥","n26":"秘","n27":"三","n28":"一,","n29":"今","n30":"在","n31":"我","n32":"们","n33":"里,","n34":"基","n35":"督","n36":"奥","n37":"秘","n38":"身","n39":"体","n40":"彰","n41":"显","n42":"神","n43":"自","n44":"己。","n45":"何","n46":"神","n47":"圣！","n48":"何","n49":"奥","n50":"秘！","n51":"三","n52":"一","n53":"竟","n54":"可","n55":"进","n56":"入。","n57":"何","n58":"荣","n59":"耀！","n60":"何","n61":"有","n62":"福！","n63":"得","n64":"享","n65":"一","n66":"切","n67":"丰","n68":"富。","n69":"那","n70":"灵","n71":"充","n72":"满","n73":"浸","n74":"透","n75":"全","n76":"人","n77":"每","n78":"一","n79":"部,","n80":"直","n81":"到","n82":"长","n83":"大","n84":"成","n85":"熟,","n86":"作","n87":"荣","n88":"美","n89":"新","n90":"妇。"},"verses":[{"label":"2.","lines":["神已经过过程又终极完成,","成为复合那灵,眷临赐生命;","神圣膏油涂抹─神性调人性,","我们得祂分赐,有分神性情。"]},{"label":"3.","lines":["我们今蒙怜悯,出宗教营外,","跟随基督,不致退缩遭毁坏;","享受那灵运行,和围绕云彩,","经历调和,将身体建造起来。"]},{"label":"4.","lines":["基督生机身体,是父神的家,","我们互为肢体,调和又配搭;","基督乃是生命、人位和彰显,","神圣奥秘范围,现今得扩大。"]},{"label":"5.","lines":["我们得着生命,有父神性情,","且借达到圣别,成为一见证;","今在父荣耀里,将三一显明,","至终达到圣城-新耶路撒冷。"]}]}