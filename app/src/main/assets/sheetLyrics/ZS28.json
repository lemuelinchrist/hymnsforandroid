{"hymn":"ZS28","parent":"E285","quality":"exact","adjust":{"hold":0,"merge":0},"title":"来与我同欢唱","subtitle":"赞美的话","syl":{"n1":"来","n2":"与","n3":"我","n4":"同","n5":"欢","n6":"唱！","n7":"我","n8":"心","n9":"曾","n10":"经","n11":"匮","n12":"乏,","n13":"如","n14":"今","n15":"寻","n16":"得","n17":"爱","n18":"的","n19":"宝","n20":"藏,","n21":"供","n22":"应","n24":"丰","n25":"富","n26":"无","n27":"差。"},"verses":[{"label":"2.","lines":["来与我同欢唱！","我原病弱无望,","喜遇救主知我景况,","并赐医治良方。"]},{"label":"3.","lines":["来与我同欢唱！","困倦疲惫如我,","欢然投靠大能臂膀,","加力、扶持无辍。"]},{"label":"4.","lines":["来与我同欢唱！","我原偏行己路,","今由慈牧领回身旁,","祂里安然居住。"]},{"label":"5.","lines":["来与我同欢唱！","孤独乖僻如我,","竟得一友知我心肠,","用爱将我紧握。"]},{"label":"6.","lines":["从前未识祂爱,","但祂早已爱上;","这爱深厚、坚定、","实在,既温柔又坚刚。"]},{"label":"7.","lines":["我乐听祂慈声,","引我日日向上;","祂爱既是如此丰盛,","我岂能不欢唱?"]}]}