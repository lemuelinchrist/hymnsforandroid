{"hymn":"Z383","parent":"E505","quality":"adapted","adjust":{"hold":7,"merge":1},"title":"荣耀之中有一位","subtitle":"经历基督－作生命","syl":{"n1":"荣","n2":"耀","n3":"之","n4":"中","n5":"有","n6":"一","n7":"位，","n8":"乃","n9":"是","n11":"神","n12":"而","n13":"人；","n15":["圣",null,"u"],"n16":0,"n17":"洁、","n18":"公","n19":["义",null,"u"],"n21":0,"n22":"又","n23":"智","n24":"慧，","n25":["光",null,"u"],"n26":0,"n27":"明","n28":"且","n29":"慈","n30":"仁；","n31":"祂","n32":"曾","n33":"为","n34":"我","n36":"舍","n37":"生","n38":"命，","n41":"成","n42":"功","n44":"神","n45":["救",null,"u"],"n46":0,"n47":"法，","n48":"使","n49":"我","n51":["能",null,"u"],"n53":0,"n55":"有","n56":["祂",null,"u"],"n58":0,"n59":["性",null,"u"],"n60":0,"n61":"情，","n62":"使","n63":"我","n65":"能‿像","n66":"祂。"},"verses":[{"label":"2.","lines":["荣耀之中有一位，","乃是得胜王；","黑暗权势祂摧毁，","撒但祂击伤，","冲破阴府升天庭，","远超诸执政，","使我与祂同高升，","与祂同夸胜。"]},{"label":"3.","lines":["荣耀之中有一位，","祂是我生命；","时刻住在我心内，","管理并引领，","使祂圣洁的性情，","成形在我心，","使祂荣耀的生命，","彰显于我身。"]},{"label":"4.","lines":["荣耀之中有一位，","祂是我盼望；","不久从天必归回，","接我到天上，","用祂荣耀的大能，","改变我形状，","使我变成祂荣形，","与祂永相像。"]}]}