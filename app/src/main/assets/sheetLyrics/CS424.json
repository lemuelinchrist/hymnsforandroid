{"hymn":"CS424","parent":"E1206","quality":"adapted","adjust":{"hold":3,"merge":0},"title":"我們有當跑的路","subtitle":"一路跑盡","syl":{"n1":"我","n2":"們","n3":"有","n4":"當","n5":"跑","n6":"的","n7":"路，","n8":"阿","n9":"利","n10":"路","n11":"亞！","n12":"當","n13":"一","n14":"路","n15":"跑","n16":"盡，","n17":"莫","n18":"停","n19":["下！",null,"u"],"n20":0,"n21":"對","n22":"所","n23":"有","n24":"在","n25":"跑","n26":"的","n27":"人，","n28":"阿","n29":"利","n30":"路","n31":"亞！","n32":"神","n33":"說：","n34":"『當","n35":"望","n36":"斷","n37":"及","n38":"於","n39":["祂！』",null,"u"],"n40":0,"n41":"當","n42":"望","n43":"斷","n45":"以","n46":"及","n47":"於","n48":"祂！","n49":"一","n50":"路","n51":"跑","n52":"盡，","n53":"莫","n54":"停","n55":"下！","n56":"望","n57":"斷","n58":"一","n59":"切","n60":"身","n61":"外","n62":"物，","n63":"注","n64":"視","n65":"耶","n66":"穌，","n67":"當","n68":"望","n69":"斷","n70":"一","n71":"切","n72":"及","n73":"於","n74":["祂！",null,"u"],"n75":0},"verses":[{"label":"2.","lines":["望斷周遭的事物，","阿利路亞！","當望斷擾嚷與掙扎；","專一注視安息主，","阿利路亞！","當望斷一切及於祂！"]},{"label":"3.","lines":["望斷起伏的心緒，","阿利路亞！","別管你自己好或差；","專一注視那標竿，","阿利路亞！","當望斷一切及於祂！"]},{"label":"4.","lines":["望斷背後的一切，","阿利路亞！","好或壞完全不管它；","持守那位活的主，","阿利路亞！","當望斷一切及於祂！"]},{"label":"5.","lines":["專一注視祂榮臉，","阿利路亞！","祂是阿拉法、俄梅嘎；","領受恩典向前跑，","阿利路亞！","當望斷一切及於祂！"]}]}