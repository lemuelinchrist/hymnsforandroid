{"hymn":"CS30","parent":"E1102","quality":"exact","adjust":{"hold":0,"merge":0},"title":"耶和華對我主說","subtitle":"讚美的話","syl":{"n1":"耶","n2":"和","n3":"華","n4":"對","n5":"我","n7":"主","n8":"說,","n9":"“你","n10":"坐","n11":"在","n13":"我","n14":"右","n15":"邊,","n16":"等","n17":"我","n18":"使","n19":"你","n20":"眾","n22":"仇","n23":"敵","n24":"作","n25":"腳","n26":"凳","n27":"伏","n28":"你","n29":"前。”","n30":"耶","n31":"和","n32":"華","n33":"必","n34":"從","n35":"錫","n37":"安","n38":"伸","n39":"出","n40":"你","n41":"大","n42":"能","n43":"仗:","n44":"列","n46":"國","n47":"必","n48":"歸","n49":"你","n50":"管","n52":"治,","n53":"直","n54":"到","n55":"永","n57":"世","n58":"無","n59":"疆。"},"verses":[{"label":"2.","lines":["當你爭戰的日子,","你民獻上自己;","甘心奉獻為彩飾,","榮美有何能比!","暢爽、滋潤如甘露,","新鮮,孕於清晨,","少年人分別歸你,","於你如寶如珍。"]},{"label":"3.","lines":["耶和華必不後悔,","祂已明確起誓:","“照麥基洗德等次,","你必永為祭司。","你既無時日之始,","也無生命之終;","憑你代求供聖職,","我們受恩無窮。"]},{"label":"4.","lines":["在神右邊你是主,","列邦受你審判;","當你發怒傷列王,","敵權盡都潰散。","路旁河水供你飲,","你必抬頭勝敵;","我們如此解你渴,","同你收復全地。"]},{"label":"5.","lines":["哦主,你已升高天,","登極安坐神右;","神已使你將敵剿,","萬有之上居首。","你是君王施權柄,","又是祭司代求,","且是榮耀得勝者,","配得我們所有。"]}]}