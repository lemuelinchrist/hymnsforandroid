{"hymn":"ZS470","parent":"E817","quality":"exact","adjust":{"hold":0,"merge":0},"title":"神圣真理深广无边","subtitle":"追求与长进","syl":{"n1":"神","n2":"圣","n3":"真","n4":"理","n5":"深","n6":"广","n7":"无","n8":"边,","n9":"人","n10":"智","n11":"岂","n12":"能","n13":"局","n14":"限?","n15":"一","n16":"己","n17":"残","n18":"见,","n19":"囿","n20":"于","n21":"时","n22":"空,","n23":"勿","n24":"将","n25":"天","n27":"光","n28":"遮","n29":"掩。","n30":"崭","n31":"新","n32":"亮","n33":"光,","n34":"更","n35":"美","n36":"盼","n37":"望,","n38":"惟","n39":"愿","n40":"人","n41":"心","n42":"能","n43":"见:","n44":"主","n45":"话","n46":"真","n47":"光","n48":"越","n49":"照","n50":"越","n51":"明,","n52":"释","n53":"放","n54":"真","n55":"理","n56":"无","n57":"限。"},"verses":[{"label":"2.","lines":["天来圣谕普赐万邦,","历代人当称羡;","谁竟擅用无知言语,","阻挡神圣意念?","如同宇宙阔长高深,","浩瀚洋海无边:","主话真光越照越明,","释放真理无限。"]},{"label":"3.","lines":["先圣迈开追寻旅程,","暗中摸索而前;","晨光乍显,旭辉渐明,","直至如日中天。","荣耀太阳,愿你显身,","辉煌光线尽现。","主话真光越照越明,","释放真理无限。"]},{"label":"4.","lines":["幽谷已过,昂首上行,","直攻真理之巅;","前人肩上极目一览,","始识主智深远;","清明空中,天乐得聆,","才知主富绵延:","主话真光越照越明,","释放真理无限。"]},{"label":"5.","lines":["哦愿父神借灵运行,","基督安家心间,","好使众圣能同领畧,","神圣大爱艰言;","如此神圣实际得以","日日加增不断:","主话真光越照越明,","释放真理无限。"]}]}