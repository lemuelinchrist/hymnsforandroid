{"hymn":"CS256","parent":"E1176","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"復活的大能,神已經顯明","subtitle":"享受基督","syl":{"n1":"復","n2":"活","n3":"的","n4":"大","n5":"能,","n6":"神","n7":"已","n8":"經","n9":"顯","n10":"明,","n11":"使","n12":"祂","n13":"的","n14":"兒","n15":"子","n16":"從","n17":"死‿復","n19":"生;","n20":"因","n21":"此","n22":"見","n23":"大","n24":"能,","n25":"我","n26":"們","n27":"得","n28":"加","n29":"力,","n30":"復","n31":"活","n32":"生","n33":"命","n34":"裏","n35":"昂","n36":"然","n37":"誇","n38":"勝。","n39":"大","n40":"能","n41":"大","n42":"能,","n43":"復","n44":"活","n45":"生","n46":"命","n47":"大","n48":"能─","n49":"內","n50":"裏","n51":"運","n52":"行,","n53":"時","n54":"時","n55":"加","n56":"添‿能","n57":"力;","n58":"大","n59":"能","n60":"大","n61":"能,","n62":"復","n63":"活","n64":"生","n65":"命","n66":"大","n67":"能─","n68":"裏","n69":"面","n70":"的","n71":"人","n72":"時","n73":"時","n74":"得","n75":"加","n76":"力!"},"verses":[{"label":"2.","lines":["超越的大能使基督高升,","坐在神右邊,遠超萬有:","執政掌權者,有能主治者,","因基督大名無不拜叩。","大能大能,超越一切大能─","內裏運行,使人離地上騰;","大能大能,超越一切大能─","裏面的人離地得上騰。"]},{"label":"3.","lines":["征服的大能使萬有歸服,","悖逆盡消弭,基督為大;","作祂的身體,分享祂能力,","有何不踏在我們腳下?","大能大能,征服一切大能─","內裏運行,處處施行管治;","大能大能,征服一切大能─","裏面的人處處施管治。"]},{"label":"4.","lines":["歸一的大能使基督居首,","向著召會作萬有的頭;","大能的輸供成功主身體,","作祂的豐滿神旨成就。","大能大能,掌管萬有大能─","裏裏外外,一切盡都歸順;","大能大能,掌管萬有大能─","裏面的人率先來歸順。"]}]}