{"hymn":"ZS859","parent":"E1295","quality":"exact","adjust":{"hold":0,"merge":0},"title":"福音的交通,我们同有分","subtitle":"事奉与福音","syl":{"n1":"福","n2":"音","n3":"的","n4":"交","n5":"通,","n6":"我","n7":"们","n8":"同","n9":"有","n10":"分,","n11":"从","n12":"头","n13":"一","n14":"天","n15":"至","n16":"今;","n18":"为","n19":"推","n20":"广","n21":"福","n22":"音,","n23":"众","n24":"人","n25":"如","n26":"一","n27":"人,","n28":"主","n29":"话","n30":"徧","n31":"传","n32":"远","n33":"近。","n35":"辩","n36":"护","n37":"且","n38":"证","n39":"实,","n40":"我","n41":"们","n42":"活","n43":"福","n44":"音,","n45":"在","n46":"此","n47":"同","n48":"享","n49":"主","n51":"恩;","n53":"主","n54":"既","n55":"动","n56":"善","n57":"工,","n58":"必","n59":"成","n60":"全","n61":"无","n62":"逊,","n63":"直","n64":"至","n65":"荣","n66":"中","n67":"降","n68":"临。"},"verses":[{"label":"2.","lines":["每日的境遇,无论苦或甜,","都为福音进展;","为福音、死活,使主显人前,","生活在地如天。","笃信无畏惧,灵中常放胆,","讲说神的圣言;","在爱里行事,凭大能争战,","与主联结无间。"]},{"label":"3.","lines":["凡事能放胆,不怕仇敌阻,","主灵供应充足;","基督常显大,无论何事故,","生死都不在乎。","无一事羞愧,我们只切慕,","活着就是基督─","惟祂作人位,从我们活出,","事事处处无误。"]},{"label":"4.","lines":["行事并为人与福音是一,","无论何事临及;","在一个灵里,为福音站立,","同魂一起努力。","让我们宣扬福音的奥秘,","使主称心如意;","基督作生命,召会为身体,","传遍居人之地。"]}]}