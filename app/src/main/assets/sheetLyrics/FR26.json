{"hymn":"FR26","parent":"E142","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Couronnez-Le d'honneur","syl":{"n1":["Cou","i"],"n2":["ron","m"],"n3":["nez","m"],"n4":["Le","t"],"n5":["d'hon","i"],"n6":["neur!","t"],"n7":["Lui,",null],"n8":["l'A","i"],"n9":["gneau","t"],"n10":["sur",null],"n11":["le",null],"n12":["trône,",null],"n13":["En","i"],"n14":["ton","m"],"n15":["nez","t"],"n16":["de",null],"n17":["tout",null],"n18":["vo","i"],"n19":["tre","t"],"n21":["cœur,",null],"n22":["Les",null],"n23":["hym","i"],"n24":["nes","t"],"n25":["du",null],"n26":["roy","i"],"n27":["aume.","t"],"n28":["Ré","i"],"n29":["veil","m"],"n30":["le","m"],"n31":["toi","t"],"n32":["mon",null],"n33":["âme,",null],"n34":["Pour",null],"n35":["chan","i"],"n36":["ter","t"],"n37":["ton",null],"n38":["Sau","i"],"n39":["veur!","t"],"n40":["Ton",null],"n41":["Roi",null],"n42":["in","i"],"n43":["com","m"],"n44":["pa","m"],"n45":["rable","t"],"n46":["ac","i"],"n47":["clame,","t"],"n48":["Lui,",null],"n49":["le",null],"n50":["Tri","i"],"n51":["om","m"],"n52":["pha","m"],"n53":["teur.","t"]},"verses":[{"label":"2.","lines":["Couronnez-Le de gloire !","Lui, Fils né d'une femme,","Vois la couronne de victoire,","Qui Son triomphe acclame.","Voyez le Victorieux,","Présentant le trophée.","Il l'acquit par Son sang précieux","Et en est couronné."]},{"label":"3.","lines":["Couronnez le Seigneur !","Lui, qui nous a aimés,","Fut brisé comme un malfaiteur","Puis par Dieu élevé.","Les anges dans les cieux","Ne saisiront jamais,","L'amour profond et mystérieux","Qui nous a rachetés."]},{"label":"4.","lines":["Couronnez le Seigneur !","Le prince de la paix,","Puissant, Il règne avec splendeur,","Soumet toute la terre,","Pour que les guerres cessent,","S'achève Son dessein","Et que Son royaume apparaisse.","Il n'aura pas de fin."]},{"label":"5.","lines":["Couronnez le Seigneur !","Voyez l'Ancien des jours,","De l'univers le Créateur,","Souverain pour toujours !","Nous T'acclamons, Sauveur,","Pour Ton si grand amour,","À Toi la louange et l'honneur !","Toi, notre Rédempteur."]}]}