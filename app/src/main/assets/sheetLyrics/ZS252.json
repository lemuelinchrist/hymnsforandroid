{"hymn":"ZS252","parent":"E754","quality":"exact","adjust":{"hold":0,"merge":0},"title":"神圣应许甘甜无比","subtitle":"享受基督","syl":{"n1":"神","n2":"圣","n3":"应","n4":"许","n5":"甘","n6":"甜","n7":"无","n8":"比:","n9":"人","n10":"若","n11":"敬","n12":"畏","n13":"耶","n14":"和","n15":"华","n16":"名,","n17":"必","n18":"见","n19":"公","n20":"义","n21":"日","n22":"头","n23":"升","n24":"起,","n25":"其","n26":"翼","n27":"能","n28":"医","n29":"罪、","n30":"病。"},"verses":[{"label":"2.","lines":["救主满带医治大能,","信祂名者祂必不弃;","痛悔之心速来投诚,","藏身医治圣翼。"]},{"label":"3.","lines":["公义救主如日展翅;","我若纠缠罪中不离,","怎能得祂抚摸、医治,","安歇于祂圣翼?"]},{"label":"4.","lines":["妙哉祂已毁伤蛇头,","毒螫消解苦痛全去;","爱的胸臆我当紧投,","医治翼下无虞。"]},{"label":"5.","lines":["医治翼下我得安息,","满心乐极,高歌颂称:","公义日头今已升起,","其翼能医罪、病。"]}]}