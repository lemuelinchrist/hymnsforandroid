{"hymn":"C572","parent":"E787","quality":"exact","adjust":{"hold":0,"merge":0},"title":"我所有苦況","subtitle":"禱告－告訴主","syl":{"n1":"我","n2":"所","n3":"有","n4":"苦","n5":"況，","n6":"必","n7":"須","n8":"告","n9":"訴","n10":"主，","n11":"我","n12":"不","n13":"能","n14":"獨","n15":"自","n16":"擔","n17":"此","n18":"憂","n19":"鬱；","n22":"我","n23":"在","n24":"患","n25":"難","n26":"中，","n27":"惟","n28":"主","n29":"能","n30":"安","n31":"撫，","n32":"擦","n33":"去","n34":"我","n35":"眼","n36":"淚，","n37":"將","n38":"我","n39":"體","n40":"恤。","n43":"我","n44":"必","n45":"須","n46":"告","n47":"訴，","n48":"必","n49":"須","n50":"告","n51":"訴","n52":"主，","n53":"將","n54":"我","n55":"的","n56":"心","n57":"事","n58":"向","n59":"主","n60":"傾","n61":"吐；","n64":"我","n65":"必","n66":"須","n67":"告","n68":"訴，","n69":"必","n70":"須","n71":"告","n72":"訴","n73":"主，","n74":"惟","n75":"主","n76":"知","n77":"我","n78":"心，","n79":"樂","n80":"於","n81":"安","n82":"撫。"},"verses":[{"label":"2.","lines":["我所有困難，","必須告訴主，","我不能獨自對付遭遇；","我一切事務，","惟主能擔負，","使我得安息，","慰我情緒。"]},{"label":"3.","lines":["我所有缺乏，","必須告訴主，","我不能獨自卸去憂慮；","我所有需要，","惟主能滿足，","使我享豐富，","綽綽有餘。"]},{"label":"4.","lines":["我所有軟弱，","必須告訴主，","我不能獨自勝過私慾；","我所有捆綁，","惟主能幫助，","使我得釋放，","脫離罪律。"]},{"label":"5.","lines":["我所有試探，","必須告訴主，","我不能獨自抵擋鬼魔；","主所受試探，","與我毫無殊，","惟主能救我脫離兇惡。"]}]}