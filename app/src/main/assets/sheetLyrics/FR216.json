{"hymn":"FR216","parent":"E1","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Gloire à notre Dieu, le Père","subtitle":"","syl":{"n1":"Gloire","n2":"à","n3":["no","i"],"n4":["tre","t"],"n5":"Dieu,","n6":"le","n7":["Pè","i"],"n8":["re,","t"],"n9":"Gloire","n10":"à","n11":"Christ,","n12":"le","n13":"Fils,","n14":["Saint","i"],"n15":["Es","m"],"n16":["prit,","t"],"n17":"à","n18":"Toi","n19":"la","n20":"gloire–","n21":"Seul","n22":"Dieu","n23":["vi","i"],"n25":["vant!","t"]},"verses":[{"label":"2.","lines":["L’œuvre de Tes mains est vaste ;","Nous la contemplons ;","En nous jaillit la louange :","Nous T’adorons !"]},{"label":"3.","lines":["Mais, cher Père, Tu désires","Que de nombreux fils,","Dans le Fils, Te louent ensemble","Prouvant l’amour !"]},{"label":"4.","lines":["Tu as révélé aux hommes","Ta sainte pensée,","Les secrets de Ta tendresse,","De Ton amour."]},{"label":"5.","lines":["Par la rédemption en Christ – Oui :","Le mal est vaincu –","Tu as engendré de nombreux","Adorateurs !"]},{"label":"6.","lines":["Gloire à notre Dieu, le Père,","Gloire à Christ, le Fils,","Saint-Esprit, à Toi la gloire –","Seul Dieu Vivant !"]}]}