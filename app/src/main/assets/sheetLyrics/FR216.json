{"hymn":"FR216","parent":"E1","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Gloire à notre Dieu, le Père","syl":{"n1":["Gloire",null],"n2":["à",null],"n3":["no","i"],"n4":["tre","t"],"n5":["Dieu,",null],"n6":["le",null],"n7":["Pè","i"],"n8":["re,","t"],"n9":["Gloire",null],"n10":["à",null],"n11":["Christ,",null],"n12":["le",null],"n13":["Fils,",null],"n14":["Saint","i"],"n15":["Es","m"],"n16":["prit,","t"],"n17":["à",null],"n18":["Toi",null],"n19":["la",null],"n20":["gloire–",null],"n21":["Seul",null],"n22":["Dieu",null],"n23":["vi","i"],"n25":["vant!","t"]},"verses":[{"label":"2.","lines":["L’œuvre de Tes mains est vaste ;","Nous la contemplons ;","En nous jaillit la louange :","Nous T’adorons !"]},{"label":"3.","lines":["Mais, cher Père, Tu désires","Que de nombreux fils,","Dans le Fils, Te louent ensemble","Prouvant l’amour !"]},{"label":"4.","lines":["Tu as révélé aux hommes","Ta sainte pensée,","Les secrets de Ta tendresse,","De Ton amour."]},{"label":"5.","lines":["Par la rédemption en Christ – Oui :","Le mal est vaincu –","Tu as engendré de nombreux","Adorateurs !"]},{"label":"6.","lines":["Gloire à notre Dieu, le Père,","Gloire à Christ, le Fils,","Saint-Esprit, à Toi la gloire –","Seul Dieu Vivant !"]}]}