{"hymn":"C214","parent":"E256","quality":"exact","adjust":{"hold":0,"merge":0},"title":"哦主，向我吹風","subtitle":"聖靈的豐滿－風","syl":{"n1":"哦","n2":"主，","n3":"向","n4":"我","n5":"吹","n6":"風，","n7":"我","n8":"們","n9":"在","n10":"此","n11":"等","n12":"候；","n13":"用","n14":"你","n15":"大","n16":"風","n17":"來","n18":"吹，","n19":"帶","n20":"給","n21":"我","n22":"們","n23":"自","n24":"由；","n25":"吹","n26":"到","n27":"我","n28":"們","n29":"眾","n30":"人","n31":"無","n32":"不","n33":"復","n34":"興","n35":"得","n36":"透；","n37":"哦","n38":"主，","n39":"求","n40":"你","n41":"向","n42":"我","n43":"吹","n44":"風！","n46":"哦","n47":"主，","n48":"現","n49":"在","n51":"將","n52":"我","n53":"來","n54":"吹！","n56":"吹","n57":"去","n58":"所","n59":"有","n60":"鬆","n61":"懶","n62":"沉","n63":"睡！","n65":"願","n66":"你","n67":"大","n68":"風","n69":"來","n70":"臨，","n71":"將","n72":"我","n73":"退","n74":"落","n75":"吹","n76":"盡！","n77":"哦","n78":"主，","n79":"求","n80":"你","n81":"向","n82":"我","n83":"吹","n84":"風。"},"verses":[{"label":"2.","lines":["哦主，用愛來吹，","吹熱冰冷的心；","將那屬天之氣，","吹到我的全魂；","吹到我們眾人","毫無冷淡留存；","哦主，求你向我吹風！"]},{"label":"3.","lines":["哦主，用力來吹，","吹起死沉的靈；","吹到我們復甦，","充滿復活生命；","吹到我們眾人","無不剛強有能；","哦主，求你向我吹風！"]}]}