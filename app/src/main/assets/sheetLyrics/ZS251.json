{"hymn":"ZS251","parent":"E1144","quality":"exact","adjust":{"hold":0,"merge":0},"title":"在圣经开始,神已经启示","subtitle":"享受基督","syl":{"n1":"在","n2":"圣","n3":"经","n4":"开","n5":"始,","n6":"神","n7":"已","n8":"经","n9":"启","n10":"示,","n11":"人","n12":"是","n13":"按","n14":"着","n15":"祂","n16":"形","n17":"像","n18":"造","n19":"成;","n20":"为","n21":"要","n22":"彰","n23":"显","n24":"祂,","n25":"并","n26":"且","n27":"代","n28":"表","n29":"祂,","n30":"征","n31":"服","n32":"全","n33":"地","n34":"带","n35":"进","n36":"祂","n37":"权","n38":"能。","n39":"吃","n40":"喝,","n41":"吃","n42":"喝─","n43":"没","n44":"有","n45":"一","n46":"件","n47":"事","n48":"比","n49":"此","n50":"重","n51":"要","n52":"吃","n53":"喝,","n54":"吃","n55":"喝─","n56":"迎","n57":"接","n58":"新","n59":"郎","n60":"带","n61":"进","n62":"神","n63":"荣","n64":"耀。"},"verses":[{"label":"2.","lines":["祂没有立下任何的律法,","只说园中果子随意吃;","但是善恶树,万不可接触,","吃了知识果子必定死。"]},{"label":"3.","lines":["在伊甸乐园,摆在人面前,","有生命树代表神自己;","但是那毒蛇,诡诈又邪恶,","借着知识使人心偏离。"]},{"label":"4.","lines":["主耶稣基督就是生命树,","神成肉身,满足神要求;","祂救赎我们,又重生我们,","现今成了我们的珍馐。"]},{"label":"5.","lines":["主不是要搞我们的头脑,","知识只叫人自高自大;","祂来的目的乃是作筵席,","不重研究乃在吃喝祂。"]},{"label":"6.","lines":["越多吃喝祂,越不断长大,","生命、人数必加增不已;","我们要清楚神今天恢复,","基督不是宗教,是筵席。"]},{"label":"7.","lines":["今天的道路是吃喝基督,","没有一件事比此重要;","召会借着吃,新妇得妆饰,","迎接新郎带进神荣耀。"]}]}