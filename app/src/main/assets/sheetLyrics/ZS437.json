{"hymn":"ZS437","parent":"E804","quality":"exact","adjust":{"hold":0,"merge":0},"title":"哦主,你话如同粮仓","subtitle":"追求与长进","syl":{"n1":"哦","n2":"主,","n3":"你","n4":"话","n5":"如","n6":"同","n7":"粮","n8":"仓,","n9":"供","n10":"应","n11":"充","n12":"足、","n13":"多","n14":"方;","n15":"凡","n16":"饥","n17":"饿","n18":"者","n19":"都","n20":"可","n21":"来","n22":"此","n23":"荣","n24":"耀,","n25":"丰","n26":"富","n27":"饱","n28":"尝。","n29":"你","n30":"话","n31":"又","n32":"如","n33":"深","n34":"处","n35":"宝","n36":"矿,","n37":"稀","n38":"有","n39":"珍","n40":"物","n41":"尽","n42":"藏;","n44":"凡","n45":"寻","n46":"求","n47":"者","n48":"来","n49":"此","n50":"挖","n51":"掘,","n52":"必","n53":"得","n54":"至","n55":"宝","n56":"无","n57":"上。"},"verses":[{"label":"2.","lines":["你话犹如众星发亮,","光芒四射辉煌;","天程旅客在此光中","属天,家乡直往。","你话又如军器库房,","收藏全备军装;","争战虽长,终必奏凯,","因有供备无量。"]},{"label":"3.","lines":["愿我宝爱你的圣言,","尽享矿藏富源;","愿我取用荣耀丰富","光中,生活无间。","愿我寻得话中兵器,","靠此夸胜敌前;","挥动那灵可靠的剑,","为主权益争战。"]},{"label":"4.","lines":["哦,永活神生命的话,","你是神的光辉;","得你,我就得神自己","并脱,属地缠累。","求主赐我正直的灵,","话中得你智慧;","犹如孩童心中单纯,","转向属天恩惠。"]}]}