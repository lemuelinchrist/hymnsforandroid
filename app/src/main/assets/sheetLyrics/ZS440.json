{"hymn":"ZS440","parent":"E1135","quality":"exact","adjust":{"hold":0,"merge":0},"title":"哦主,圣化我们,加添你的自己","subtitle":"追求与长进","syl":{"n1":"哦","n2":"主,","n3":"圣","n4":"化","n5":"我","n6":"们,","n7":"加","n8":"添","n9":"你","n10":"的","n11":"自","n12":"己;","n13":"愿","n14":"你","n15":"宝","n16":"贵","n17":"人","n18":"位","n19":"扩","n20":"展","n21":"在","n22":"我","n23":"衷","n24":"里,","n25":"使","n26":"你","n27":"荣","n28":"耀","n29":"召","n30":"会","n31":"在","n32":"此","n33":"显","n34":"为","n35":"实","n36":"际;","n37":"哦","n38":"主,","n39":"求","n40":"你","n41":"加","n42":"添","n43":"自","n44":"己。","n46":"哦","n47":"主,","n48":"今","n49":"日","n51":"运","n52":"行","n53":"我","n54":"身,","n56":"妆","n57":"饰","n58":"新","n59":"妇","n60":"迎","n61":"你","n62":"再","n63":"临。","n65":"愿","n66":"你","n67":"开","n68":"展","n69":"扩","n70":"充,","n71":"召","n72":"会","n73":"荣","n74":"上","n75":"加","n76":"荣,","n77":"哦","n78":"主,","n79":"今","n80":"日","n81":"荣","n82":"化","n83":"我","n84":"们。"},"verses":[{"label":"2.","lines":["哦主,洁净我们,向我们心说话;","洗涤我们全人,直至圣别无瑕。","愿你活话扩长,来将我们圣化;","哦主,求你洁净圣化。"]},{"label":"3.","lines":["哦主,滋养我们,惟你是真食物;","只需吃饱喝足,变化自然显出。","惟有得你喂养;我们才真满足;","哦主,求你滋养眷顾。"]},{"label":"4.","lines":["哦主,顾惜我们,以你柔爱养育;","借你温情抚慰,眷顾我们所需。","輭化刚硬石心,好来施情占据;","哦主,今日顾惜我们。"]},{"label":"5.","lines":["哦主,荣化我们,借你内里运行;","非为个人明亮,乃为召会得荣。","愿你得着新妇,成就你爱经营;","哦主,求你在我运行。"]}]}