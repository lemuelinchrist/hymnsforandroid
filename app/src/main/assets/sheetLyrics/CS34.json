{"hymn":"CS34","parent":"E1130","quality":"adapted","adjust":{"hold":0,"merge":3},"title":"來向基督讚美歌頌","subtitle":"讚美的話","syl":{"n1":"來","n2":"向","n3":"基","n4":"督","n5":"讚","n6":"美","n7":"歌","n8":"頌,","n9":"神","n11":"使","n12":"救","n13":"恩","n14":"藉‿祂","n16":"成","n17":"功;","n18":"得","n19":"救","n20":"惟","n21":"靠","n22":"神","n23":"聖","n24":"生","n25":"命,","n26":"律","n28":"法","n29":"規","n30":"條","n31":"一‿無","n33":"所","n34":"成;","n35":"人","n36":"雖","n37":"努","n38":"力","n39":"不","n40":"能","n41":"得","n42":"勝,","n43":"神","n44":"聖","n45":"生","n46":"命","n47":"纔","n48":"有","n49":"大","n50":"能;","n51":"將","n52":"人","n53":"改","n54":"變","n55":"帶‿來","n57":"重","n58":"生。"},"verses":[{"label":"2.","lines":["藉祂賜下生命能力,","祂將信徒整救到底;","神聖生命注入人裏,","供應救恩時刻不息;","人雖失喪祂來臨及,","拯救罪人脫離仇敵;","帶領眾子進榮耀裏。"]},{"label":"3.","lines":["祂是祭司為神所立,","賜人生命帶來實際;","神的生命就在祂裏,","拯救世人脫罪勝己;","永遠生命不朽不已,","所施救恩全備無比;","讚美我主完全能力。"]},{"label":"4.","lines":["祂的生命足能擔保,","帶領我們達到榮耀;","若非祂曾得勝宣告,","我們有何可以信靠。","祂受試驗屹立不搖,","終於十架始於馬槽;","不受死亡陰間纏繞。"]},{"label":"5.","lines":["祂作憑質供人接受,","擔保信徒完全得救;","全備供應包羅萬有,","親自成全終能成就;","屬人生命失敗、老舊,","惟祂生命堅定永久;","祂作生命完全拯救。"]},{"label":"6.","lines":["基督今日高過諸天,","忠信代求直到永遠;","不受輭弱、死亡阻攔,","祭司職分無需更換;","長遠活著,立於神前,","代求滿足神、人心願;","祂已高升遠超諸天。"]},{"label":"7.","lines":["來到神前,靠主寶血,","絶不退縮而遭毁壞;","來到神前,得著生命,","各盡功用不作嬰孩;","來到神前,享受生命,","作祂子民,蒙祂所愛;","生命作王,死亡不在。"]}]}