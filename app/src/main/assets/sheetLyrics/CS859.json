{"hymn":"CS859","parent":"E1295","quality":"exact","adjust":{"hold":0,"merge":0},"title":"福音的交通,我們同有分","subtitle":"事奉與福音","syl":{"n1":"福","n2":"音","n3":"的","n4":"交","n5":"通,","n6":"我","n7":"們","n8":"同","n9":"有","n10":"分,","n11":"從","n12":"頭","n13":"一","n14":"天","n15":"至","n16":"今;","n18":"為","n19":"推","n20":"廣","n21":"福","n22":"音,","n23":"眾","n24":"人","n25":"如","n26":"一","n27":"人,","n28":"主","n29":"話","n30":"徧","n31":"傳","n32":"遠","n33":"近。","n35":"辯","n36":"護","n37":"且","n38":"證","n39":"實,","n40":"我","n41":"們","n42":"活","n43":"福","n44":"音,","n45":"在","n46":"此","n47":"同","n48":"享","n49":"主","n51":"恩;","n53":"主","n54":"既","n55":"動","n56":"善","n57":"工,","n58":"必","n59":"成","n60":"全","n61":"無","n62":"遜,","n63":"直","n64":"至","n65":"榮","n66":"中","n67":"降","n68":"臨。"},"verses":[{"label":"2.","lines":["每日的境遇,無論苦或甜,","都為福音進展;","為福音、死活,使主顯人前,","生活在地如天。","篤信無畏懼,靈中常放膽,","講說神的聖言;","在愛裏行事,憑大能爭戰,","與主聯結無間。"]},{"label":"3.","lines":["凡事能放膽,不怕仇敵阻,","主靈供應充足;","基督常顯大,無論何事故,","生死都不在乎。","無一事羞愧,我們只切慕,","活著就是基督─","惟祂作人位,從我們活出,","事事處處無誤。"]},{"label":"4.","lines":["行事並為人與福音是一,","無論何事臨及;","在一個靈裏,為福音站立,","同魂一起努力。","讓我們宣揚福音的奧祕,","使主稱心如意;","基督作生命,召會為身體,","傳遍居人之地。"]}]}