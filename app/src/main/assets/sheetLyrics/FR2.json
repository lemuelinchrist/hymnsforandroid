{"hymn":"FR2","parent":"E12","quality":"exact","adjust":{"hold":0,"merge":0},"title":"O Père, source de la vie","subtitle":"","syl":{"n1":"Ô","n2":["Pè","i"],"n3":["re,","t"],"n4":["sour","i"],"n5":["ce","t"],"n6":"de","n8":"la","n9":"vie,","n10":"Ton","n11":["cou","i"],"n13":["rant","t"],"n14":"nous","n15":"est","n16":"cher!","n17":"Eau","n18":["vi","i"],"n19":["ve","t"],"n20":"qui","n22":"coule","n23":"et","n25":["jail","i"],"n26":["lit","t"],"n27":["Jusqu","i"],"n28":["'en","t"],"n30":["é","i"],"n31":["ter","m"],"n32":["ni","m"],"n33":["té!","t"]},"verses":[{"label":"2.","lines":["Coulant, par amour, dans le Fils,","Tu T'approchas de nous.","Tu coules par l'Esprit aussi,","Avec Ta grâce en nous."]},{"label":"3.","lines":["Alors que dans l'iniquité","Nous avons fui Ta face,","Dans le Fils Tu nous as sauvés,","Nous donnant vie et grâce."]},{"label":"4.","lines":["Souvent T'avons-nous dédaigné","Attristant Ton Esprit.","Dans l'Esprit Tu es arrivé","Pour nous donner la vie."]},{"label":"5.","lines":["En tant qu' Esprit et dans le Fils,","Tu es la sainte onction.","Ton être entier nous est transmis","En pleine communion."]},{"label":"6.","lines":["L'amour de Dieu nous a donné","La grâce de Son Fils,","Nous pouvons donc participer","À Dieu par Son Esprit."]},{"label":"7.","lines":["Ô Père, Fils et Saint-Esprit :","Tu prends bien soin de nous.","Nous chantons Ton amour béni,","T'adorons pour toujours !"]}]}