{"hymn":"Z711","parent":"E1040","quality":"exact","adjust":{"hold":0,"merge":0},"title":"听阿，救主叩门，叩门","subtitle":"福音－主的叩门","syl":{"n1":"听","n2":"阿，","n3":"救","n4":"主","n5":"叩","n6":"门，","n8":"叩","n9":"门，","n11":"不","n12":"住","n13":"叩","n14":"心","n15":"门！","n17":"为","n18":"何","n19":"你","n20":"仍","n21":"硬","n22":"心，","n24":"硬","n25":"心，","n27":"不","n28":"理","n29":"这","n30":"声","n31":"音？","n33":"火","n34":"速","n35":"起","n36":"来","n37":"开","n38":"心","n39":"门，","n40":"火","n41":"速","n42":"请","n43":"祂","n44":"进；","n46":"祂","n47":"要","n48":"进","n49":"入","n50":"你","n51":"心，","n53":"你","n54":"心，","n56":"赐","n57":"给","n58":"你","n59":"救","n60":"恩。","n62":"请","n63":"主","n64":"进！","n65":"请","n66":"主","n67":"进！","n68":"祂","n69":"在","n70":"心","n71":"外","n73":"叩","n74":"门；","n76":"请","n77":"主","n78":"进！","n79":"哦，","n80":"请","n81":"主","n82":"进！","n83":"祂","n84":"必","n85":"进","n86":"你","n87":"心。"},"verses":[{"label":"2.","lines":["请听祂说：","『罪人，罪人，","就我得安息；","我曾为你舍身，舍身，","死在髑髅地；","为要使你蒙恩宠，","流血将你买；","你罪虽像朱红，朱红，","也能变雪白。』"]},{"label":"3.","lines":["为何你仍犹豫，犹豫，","让主等门外？","要知机会一去，一去，","永远不再来！","祂既对你满恩情，","莫把祂心伤；","祂愿赐你生命，生命，","何必等死亡？"]},{"label":"4.","lines":["如果你仍迟延，迟延，","终必有一天，","懊悔为时已晚，已晚，","哀呼主眷怜；","那时恩门已经关，","哀呼必徒然！","为何不趁今天，今天，","请主进心间？"]}]}