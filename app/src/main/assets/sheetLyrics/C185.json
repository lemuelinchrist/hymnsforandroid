{"hymn":"C185","parent":"E222","quality":"exact","adjust":{"hold":0,"merge":0},"title":"為著這餅我感謝你","subtitle":"讚美主－對祂的記念","syl":{"n1":"為","n3":"著","n4":"這","n5":"餅","n6":"我","n7":"感","n9":"謝","n11":"你，","n12":"這","n13":"是","n15":"神","n16":"聖","n18":"表","n19":"記；","n20":"藉","n21":"此，","n22":"恩","n23":"主，","n24":"我","n25":"得","n27":"看","n29":"見","n30":"神","n31":"計","n33":"畫","n34":"的","n36":"奧","n37":"祕。"},"verses":[{"label":"2.","lines":["這餅指明你的身體，","你為我們捨棄，","使我有分你的生命，","並得你的自己。"]},{"label":"3.","lines":["你的身體為我裂開，","為將自己分授，","使我能得你作生命，","成為你的配偶。"]},{"label":"4.","lines":["如此，這餅也是指明","你那奧祕身體；","我們是祂活的肢體，","與你完全合一。"]},{"label":"5.","lines":["我們雖是許多子粒，","卻都成為一餅；","在此這樣將你記念，","從你得到供應。"]},{"label":"6.","lines":["藉著這餅我們交通，","使你心滿意足；","同眾聖徒如此交通，","見證你的豐富。"]}]}