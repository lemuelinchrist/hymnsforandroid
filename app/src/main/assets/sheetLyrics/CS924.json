{"hymn":"CS924","parent":"E1322","quality":"exact","adjust":{"hold":0,"merge":0},"title":"今在靈裏,在召會中","subtitle":"盼望與豫備","syl":{"n1":"今","n2":"在","n3":"靈","n4":"裏,","n6":"在","n8":"召","n9":"會","n10":"中,","n11":"得","n12":"見","n13":"異","n14":"象,","n16":"高、","n17":"深、","n18":"長、","n19":"闊:","n20":"我","n21":"們","n22":"定","n23":"命","n25":"卓","n26":"越","n28":"超","n30":"凡,","n32":"前","n33":"所","n34":"未","n35":"見,","n37":"超","n38":"人","n40":"能","n41":"度。"},"verses":[{"label":"2.","lines":["非僅道理,乃是啟示","基督自己奇妙、奧祕;","遠超心思所能領畧,","但在靈中都成實際。"]},{"label":"3.","lines":["祂是豐富、無限、深奧,","無法測度、超絕美妙;","竟需我們得著救恩,","同為後嗣顯祂榮耀。"]},{"label":"4.","lines":["神已計畫,也來創造,","還要作出新造無窮;","祂已立子作祂後嗣,","執掌祂的神聖行政。"]},{"label":"5.","lines":["但在神的經綸之中,","並非僅有一子得榮;","乃是長子率眾弟兄,","同作後嗣,定命與共。"]},{"label":"6.","lines":["為著彀格作神後嗣,","我們必須長大成熟,","好與基督同得榮耀,","承受神的所是所有。"]},{"label":"7.","lines":["作神後嗣,隨同長兄,","承受萬有,豐富無缺;","更是同夥,一同經營","“基督、召會”宇宙大業。"]},{"label":"8.","lines":["今在靈裏,在召會中,","得見我們呼召、盼望:","並非遙望,等“上天堂”,","乃是在地與主同王。"]},{"label":"9.","lines":["貧寒如我,竟成君王,","有分寶座,承受國度;","凡神所是並祂所有,","全地、萬有無不我屬。"]}]}