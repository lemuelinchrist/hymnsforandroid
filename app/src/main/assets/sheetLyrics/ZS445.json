{"hymn":"ZS445","parent":"E1188","quality":"exact","adjust":{"hold":0,"merge":0},"title":"耶稣基督已登宝座","subtitle":"追求与长进","syl":{"n1":"耶","n2":"稣","n3":"基","n4":"督","n5":"已","n6":"登","n7":"宝","n8":"座,","n9":"我","n10":"们","n11":"与","n12":"祂","n13":"同","n14":"坐;","n15":"世","n16":"界、","n17":"撒","n18":"但、","n19":"罪、","n20":"己","n21":"脱","n22":"落,","n23":"不","n24":"能","n25":"再","n26":"将","n27":"我","n28":"迫！","n29":"基","n30":"督","n31":"一","n32":"次","n33":"永","n34":"远","n35":"受","n36":"死,","n37":"救","n38":"赎","n39":"大","n40":"工","n41":"完","n42":"成;","n44":"可","n45":"怜","n46":"罪","n47":"奴","n48":"得","n49":"新","n50":"地","n51":"位,","n52":"与","n53":"祂","n54":"同","n55":"命","n56":"共","n57":"荣。"},"verses":[{"label":"2.","lines":["欢然安居活神家中-","荣耀召会生活;","坦然昂首进至圣所,","不再下沉退缩！","魂的旷野不再留恋,","圣所已在身后;","至圣之处永远住留,","全人被神浸透。"]},{"label":"3.","lines":["更美之约己经立定,","荣耀遗赠有三:","生命之律大能高超,","将我变化完全;","我作祂民,祂作我神,","神圣福分无穷;","对神认识深刻主观,","惟凭内里生命。"]},{"label":"4.","lines":["此外神已忘记我罪,","不义一概宽恕;","皆因救主十架代死,","我罪全都清除;","罪案全勾,不再追究,","罪过都己消踪;","生命之律灵中引我,","救恩路上直行。"]},{"label":"5.","lines":["加略妙死双重功绩,","为神经纶效力:","生命之律运行无碍,","罪的拦阻绝迹！","大工完成住入安息,","主今安坐天上;","新约遗赠我们全享,","凭祂代祷馨香。"]},{"label":"6.","lines":["惟愿弃绝老旧观念,","取用遗赠丰富;","主说成了我们享用,","天天赞美不住！","听大祭司幔内呼召-","“前进！”直到路终:","直至达成终极目标,","荣耀圣城撒冷！"]}]}