{"hymn":"ZS753","parent":"E853","quality":"exact","adjust":{"hold":0,"merge":0},"title":"主,我爱你国度","subtitle":"教会的生活","syl":{"n1":"主,","n2":"我","n3":"爱","n4":"你","n5":"国","n7":"度,","n8":"就","n10":"是","n11":"你","n13":"的","n14":"住","n15":"处;","n16":"是","n17":"你","n18":"召","n19":"会,","n20":"你","n21":"血","n22":"所","n23":"赎,","n24":"你","n25":"将","n26":"重","n28":"价","n29":"已","n30":"付。"},"verses":[{"label":"2.","lines":["神,我爱你召会,","她与世俗分别;","是你眼中惟一至美,","手中惟一宝贝。"]},{"label":"3.","lines":["为她祷告不歇,","为她昼夜流泪;","补满基督患难缺欠,","直至与你相会。"]},{"label":"4.","lines":["她的属天行径,","是我珍爱歌颂:","相交甘甜,相许贞坚,","爱戴、赞美无终。"]},{"label":"5.","lines":["正如你的真理,","必定屹立不已;","那日锡安必得荣耀,","光辉无比、至极。"]}]}