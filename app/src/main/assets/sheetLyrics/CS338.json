{"hymn":"CS338","parent":"NS211","quality":"adapted","adjust":{"hold":8,"merge":0},"title":"主耶穌，我是真愛你，願意單純","subtitle":"愛慕耶穌","syl":{"n1":"主","n2":"耶","n3":"穌，","n4":"我","n5":"是","n6":"真","n7":"愛","n8":"你，","n9":"願","n10":"意","n11":"單","n12":"純，","n13":"贖","n14":"回","n15":"我","n16":"所","n17":"有","n20":["的",null,"u"],"n21":0,"n22":"光","n23":"陰，","n24":"享","n25":"你","n26":["愛",null,"u"],"n27":0,"n28":["恩。",null,"u"],"n29":0,"n30":"喔","n31":"看","n32":"那！","n33":"我","n34":"能","n35":"在","n36":"今","n37":"天","n38":"全","n39":"然","n40":"奉","n41":"獻，","n42":"是","n43":"因","n44":"你","n46":"始","n47":"終","n48":"的","n49":"恩","n50":"眷，","n51":"奇","n52":"妙","n53":"成","n54":["全。",null,"u"],"n55":0,"n56":"求","n57":"你","n58":"開","n59":"通","n60":"我","n61":"耳，","n62":"在","n63":"你","n64":"這","n65":"神","n66":"家","n67":"的","n68":"門，","n69":"當","n71":"你","n72":"發","n73":"出","n74":"呼","n75":"聲，","n76":"我","n77":"願","n78":"意","n79":"永","n80":"遠","n81":"向","n82":"你","n83":"忠","n84":"誠。","n85":"把","n86":"我","n87":"印","n88":"在","n89":"你","n90":"心，","n91":"以","n92":"你","n93":["愛",null,"u"],"n94":0,"n96":"甚","n97":"至","n98":"你","n99":"嫉","n100":["恨；",null,"u"],"n101":0,"n102":"讓","n103":"我","n104":"一","n105":"生","n106":"作","n107":"你","n108":"瘋","n109":["狂",null,"u"],"n110":0,"n111":"愛","n112":["人。",null,"u"],"n113":0},"verses":[{"label":"2.","lines":["榮耀神，今願在這裡，向你屈膝，","賜我們智慧啟示靈，得見奧秘。","這一生只願投身你神聖經綸，","只為你永遠的心意︰基督身體。","在我調和靈裡，帶我進身體實際；","享你加強救恩，使我們成耶穌的見證。","主阿！願你快來！照著你所曾經答應；","我們唯一羨慕是你再臨。"]}]}