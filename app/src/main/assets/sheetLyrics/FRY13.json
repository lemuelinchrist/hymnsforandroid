{"hymn":"FRY13","parent":"E600","quality":"hand","adjust":{"hold":0,"merge":0},"title":"Mon Dieu, mon tout et mon amour","subtitle":"","syl":{"n1":"Mon","n2":"Dieu,","n3":"mon","n4":"tout","n5":"et‿mon","n6":["a","i"],"n7":["mour,‿Ma","t"],"n8":["por","i"],"n9":"tion‿pour","n10":["tou","i"],"n11":["jours,‿Je","t"],"n12":"n'ai","n13":["per","i"],"n14":["sonne","t"],"n16":"que‿Toi","n17":"seul","n18":"Sur","n19":["ter","i"],"n20":["re","t","u"],"n21":0,"n22":["et",null,"u"],"n23":0,"n24":["dans",null,"u"],"n26":0,"n27":"les","n28":"cieux.","n29":"Sur","n30":"terre","n32":"et","n33":"dans","n34":"les","n35":["ci","i"],"n36":["eux.","t","u"],"n37":0},"verses":[{"label":"","lines":["Que valent l’horizon, la terre ?","Poussière et vanité !","Rien ne mérite ici mes joies,","Rien n’est semblable à Toi."]},{"label":"2.","lines":["Je Te dois tout : biens et amis,","Ma santé, mon abri.","Mais ces bénédictions ne peuvent","Jamais Te remplacer.","Quel vains plaisirs l’or, les palais,","Quand à Toi comparés !","Que valent ma sécurité,","Ma vie ou mes amis ?"]},{"label":"3.","lines":["Si mienne était toute la terre,","Et sa voûte étoilée,","Je serais misérable et las,","Sans Ta grâce et sans Toi.","Je laisse à d’autres les efforts,","D’atteindre leurs trésors,","Car les visites de Ta grâce,","Sont bien mon plus grand gain."]}]}