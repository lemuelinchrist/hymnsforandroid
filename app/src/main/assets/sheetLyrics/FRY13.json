{"hymn":"FRY13","parent":"E600","quality":"hand","adjust":{"hold":0,"merge":0},"title":"Mon Dieu, mon tout et mon amour","subtitle":"","syl":{"n1":"Mon","n2":"Dieu,","n3":"mon","n4":"tout","n5":"et","n6":"mon","n7":["a","i"],"n8":["mour,","t"],"n9":"Ma","n10":["por","i"],"n11":["tion","t"],"n12":"pour","n13":["tou","i"],"n14":["jours,","t"],"n16":"Je","n17":"n'ai","n18":["per","i"],"n19":["son","m"],"n20":["ne","t"],"n21":"que","n22":"Toi","n23":"seul","n24":"Sur","n26":["ter","i"],"n27":["re‿et","t"],"n28":"dans","n29":"les","n30":"cieux.","n32":"Sur","n33":["ter","i"],"n34":["re‿et","t"],"n35":"dans","n36":"les","n37":"cieux."},"verses":[{"label":"","lines":["Que valent l’horizon, la terre ?","Poussière et vanité !","Rien ne mérite ici mes joies,","Rien n’est semblable à Toi."]},{"label":"2.","lines":["Je Te dois tout : biens et amis,","Ma santé, mon abri.","Mais ces bénédictions ne peuvent","Jamais Te remplacer.","Quel vains plaisirs l’or, les palais,","Quand à Toi comparés !","Que valent ma sécurité,","Ma vie ou mes amis ?"]},{"label":"3.","lines":["Si mienne était toute la terre,","Et sa voûte étoilée,","Je serais misérable et las,","Sans Ta grâce et sans Toi.","Je laisse à d’autres les efforts,","D’atteindre leurs trésors,","Car les visites de Ta grâce,","Sont bien mon plus grand gain."]}]}