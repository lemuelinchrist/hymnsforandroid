{"hymn":"ZS435","parent":"E621","quality":"adapted","adjust":{"hold":2,"merge":0},"title":"耶稣十架阴影下","subtitle":"追求与长进","syl":{"n1":"耶","n2":"稣","n3":"十","n4":"架","n5":"阴","n6":"影","n7":"下,","n8":"我","n9":"今","n10":"欢","n11":"然","n12":"站","n13":"立;","n14":"如","n15":"在","n16":"炎","n17":"热","n18":"疲","n19":"乏","n20":"之","n21":"地,","n22":"寻","n23":"得","n24":"磐","n25":"石","n26":"荫","n27":"蔽。","n28":"旷","n29":"野","n30":"之","n31":"中","n32":"安","n33":"居","n34":"无","n35":"虞,","n36":"途","n37":"中","n38":"亦","n39":"享","n40":"安","n41":"息;","n42":"日","n43":"间","n44":"暑","n45":"溽,","n46":"操","n47":"烦","n48":"重","n49":["压",null,"u"],"n50":0,"n51":"都","n52":"不","n53":"能","n54":"将","n55":"我","n56":["袭。",null,"u"],"n57":0},"verses":[{"label":"2.","lines":["此避难所经试验─","稳妥、可悦、甘甜！","天来恩爱、至上公义","在此竟可两全。","如同先祖梦中所见,","梯子立地顶天,","借我救主钉死木架,","人竟与天结联。"]},{"label":"3.","lines":["阴间虽扩张其欲,","开口噬人无数,","在我却已尽失权势,","因有十架隔阻。","如同儆夫把守险途,","十架居间耸立,","伸展双臂施行拯救,","永死诅咒消弭。"]},{"label":"4.","lines":["自从我眼得看见,","耶稣木上流血,","忍辱、受死全是为我,","此景难以磨灭。","痛悔之心顿生感赞,","希奇天来恩惠:","荣耀之爱何竟临及,","我这如蛆之辈。"]},{"label":"5.","lines":["哦,十字架阴影下,","我得永远安居;","恩主面光我所欣羡,","其他亮光无需。","今世荣华任其消逝,","得失于我无差;","羞惭舍却罪恶、自己,","惟夸荣耀十架。"]}]}