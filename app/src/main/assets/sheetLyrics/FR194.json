{"hymn":"FR194","parent":"E996","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Jésus, Fils de Dieu, Sauveur","subtitle":"","syl":{"n1":["Jé","i"],"n2":["sus,","t"],"n3":"Fils","n4":"de","n5":"Dieu,","n6":["Sau","i"],"n7":["veur,","t"],"n8":"Tu","n9":"pris","n10":"le","n11":"poids","n13":"du","n14":["pé","i"],"n15":["cheur,","t"],"n16":["Bri","i"],"n17":["sant","t"],"n18":"du","n19":["cap","i"],"n20":["tif","t"],"n21":"les","n22":"liens,","n23":["Sup","i"],"n24":["pri","m"],"n25":["mant","t"],"n26":"Ses","n27":"maux","n28":["an","i"],"n29":["ciens.","t"]},"verses":[{"label":"2.","lines":["Les pécheurs T'ont mis à mort,","Sur Toi, Tu pris notre tort,","En Ta chair, Tu fus percé,","Tous nos péchés T'ont blessé."]},{"label":"3.","lines":["Tu deviens notre Garant,","En nous sauvant par Ton sang.","Nos péchés sont effacés,","Plus rien ne reste payer !"]},{"label":"4.","lines":["Plus rien ne reste à porter,","Pour nous, rien à partager,","Si ce n'est Ton grand pardon,","Ton amour, Ta paix, Ton don !"]},{"label":"5.","lines":["Maintenant pour Toi je vis !","Te contemplant, je guéris !","Quand je suis tourné vers Toi,","Tu ,.éclaires, fais ma joie."]},{"label":"6.","lines":["Jésus, Fils de Dieu, Sauveur,","Tu pris le poids du pécheur.","Maintenant, tous devant Toi,","Nous T'adorons avec joie !"]}]}