{"hymn":"CS852","parent":"E920","quality":"exact","adjust":{"hold":0,"merge":0},"title":"興起!角聲發出,喜信傳佈","subtitle":"事奉與福音","syl":{"n1":"興","n2":"起!","n3":"角","n4":"聲","n5":"發","n6":"出,","n7":"喜","n8":"信","n9":"傳","n10":"佈;","n11":"宣","n12":"揚","n13":"萬","n14":"主","n15":"之","n16":"主─","n17":"救","n18":"主","n19":"耶","n20":"穌;","n21":"述","n22":"說","n23":"祂","n24":"名","n25":"寶","n26":"貴,","n27":"高","n28":"舉","n29":"祂","n30":"的","n31":"尊","n32":"位,","n33":"好","n34":"使","n35":"萬","n36":"眾","n37":"來","n38":"歸─","n40":"耶","n41":"穌","n42":"是","n43":"主!"},"verses":[{"label":"2.","lines":["誰願為祂前去?誰願興起?","地愛迷人難拒,為祂全棄:","鄙視屬地榮華,萬事看為卑下,","惟誇救主十架;誰願興起?"]},{"label":"3.","lines":["得賞之日不遠,奮勇向前;","晨星快要出現,不再遲延。","高舉十架救恩,征服偶像、判民;","惟盼有福之晨,與主相見。"]},{"label":"4.","lines":["請聽勝利角聲,耶穌為王!","基督登極執政,無能違抗:","全地復歸祂有,惟祂居高為首,","座前無不拜叩─耶穌為王!"]}]}