{"hymn":"FR227","parent":"E204","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Rassemblés en Ton nom, Jésus","subtitle":"","syl":{"n1":["Ras","i"],"n2":["sem","m"],"n3":["blés","t"],"n4":"en","n5":"Ton","n6":"nom,","n7":["Jé","i"],"n8":["sus,","t"],"n10":"Ne","n11":["voy","i"],"n12":["ant","t"],"n13":"plus","n15":"rien","n16":"que","n18":"Toi,","n20":"Ta","n21":["pré","i"],"n22":["sence","t"],"n23":"est","n24":"douce","n25":"à","n26":"nos","n27":"cœurs,","n29":"Et","n30":"les","n31":"mène","n32":"à","n33":"Toi","n34":["Sei","i"],"n35":["gneur!","t"]},"verses":[{"label":"2.","lines":["Aimés d’un amour infini,","L’amour du Père envers Toi,","Seigneur, nos cœurs affectionnent","Toutes Ses pensées pour Toi."]},{"label":"3.","lines":["Son repos, Sa joie, Son plaisir,","Ses délices sont en Toi.","Seigneur, seul Ton cœur peut saisir","Le bonheur du Père en Toi."]},{"label":"4.","lines":["Il versa Son amour sur Toi,","T’appela Son Bien-aimé ;","Pour nous, Il ne T’épargna pas,","Par Ta mort Il nous gagna."]},{"label":"5.","lines":["Nous Te verrons face à face,","Nous serons semblables à Toi ;","Ton nom toujours apportera","L’allégresse au cœur de Dieu."]},{"label":"6.","lines":["Chants de joie et d’allégresse,","Au milieu de l’assemblée","Monteront, se multiplieront :","Gloire à Dieu pour l’éternité !"]}]}