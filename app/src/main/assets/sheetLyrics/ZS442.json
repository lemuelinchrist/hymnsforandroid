{"hymn":"ZS442","parent":"E1161","quality":"exact","adjust":{"hold":0,"merge":0},"title":"基督要使寻求祂者","subtitle":"追求与长进","syl":{"n1":"基","n2":"督","n3":"要","n4":"使","n5":"寻","n6":"求","n7":"祂","n8":"者,","n9":"成","n10":"为","n11":"烟","n12":"柱","n13":"和","n14":"卧","n15":"榻,","n16":"且","n17":"成","n18":"华","n19":"轿、","n20":"荣","n21":"耀","n22":"冠","n23":"冕,","n24":"主","n25":"必","n26":"作","n27":"成","n28":"绝","n29":"无","n30":"差。","n31":"祂","n32":"的","n33":"佳","n34":"偶,","n35":"祂","n36":"心","n37":"所","n38":"爱,","n39":"富","n40":"有","n41":"吸","n42":"引,","n43":"祂","n44":"喜","n45":"悦;","n46":"夺","n47":"得","n48":"祂","n49":"心,","n50":"怡","n51":"悦","n52":"祂","n53":"意,","n54":"在","n55":"祂","n56":"眼","n57":"中","n58":"何","n59":"超","n60":"绝。"},"verses":[{"label":"2.","lines":["然而黑影尚未飞逝,","基督尚未全满足;","祂要得着生长园子,","成为祂所爱新妇。"]},{"label":"3.","lines":["园中石榴、上好果子、","凤仙、哪哒、番红花、","菖蒲、肉桂、没药、沉香,","各种香料全归祂。"]},{"label":"4.","lines":["基督进到自己园中,","采了没药和香料,","尝了蜂蜜,饮了酒奶,","丰富享受,何美好！"]},{"label":"5.","lines":["佳美园子产生材料,","经过变化被建造,","成为圣城使神满意,","且使仇敌全窜逃。"]},{"label":"6.","lines":["“我的佳偶,美如得撒,","秀美如耶路撒冷。”","美妙、绝佳,令人赞赏,","主的心意得完成。"]}]}