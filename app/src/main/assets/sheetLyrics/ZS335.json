{"hymn":"ZS335","parent":"E547","quality":"exact","adjust":{"hold":0,"merge":0},"title":"人的心哪,你爱甚么","subtitle":"爱慕耶稣","syl":{"n1":"人","n2":"的","n3":"心","n4":"哪,","n5":"你","n6":"爱","n7":"甚","n8":"么?","n9":"若","n10":"非","n11":"基","n13":"督,","n14":"无","n15":"安","n16":"息。","n18":"哦,","n19":"主,","n20":"求","n21":"你","n22":"悦","n23":"纳","n24":"我","n25":"心,","n26":"上","n27":"好","n28":"之","n30":"爱,","n31":"来","n32":"爱","n33":"你。"},"verses":[{"label":"2.","lines":["今将世界全都抛弃,","我主耶稣最美丽;","你是可爱、甘甜、柔细,","怜悯、恩典全洋溢。"]},{"label":"3.","lines":["你的荣脸,明亮辉煌,","发光照耀永无已;","最美事物也无可比,","惟你使我心欢喜。"]},{"label":"4.","lines":["主！是你爱先来临及,","流血拯救你仇敌;","你之爱我,永不止息,","我心岂可不爱你?"]},{"label":"5.","lines":["保守我心忠诚向你,","使我同你藏神里,","在世一切所经所历,","让你荣耀留足迹。"]}]}