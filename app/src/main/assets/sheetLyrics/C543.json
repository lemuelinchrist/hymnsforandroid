{"hymn":"C543","parent":"E747","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"聖殿深處是至聖所","subtitle":"裡面生命的各方面－分辨靈","syl":{"n1":"聖","n2":"殿","n3":"深","n4":"處","n5":"是","n6":"至","n7":"聖","n8":["所，",null,"u"],"n9":0,"n10":"內","n11":"有","n13":"約","n14":"櫃","n15":"並","n16":"施","n18":"恩","n19":"座，","n21":"其","n22":"上","n24":"有","n25":"神","n26":"榮","n27":"耀","n29":"同","n30":"在，","n31":"在","n33":"此","n34":"神","n35":"給","n36":"祭","n38":"司","n39":"遇","n40":"著。"},"verses":[{"label":"2.","lines":["我今乃是神的聖殿，","靈是其中的至聖所，","神和基督在此居住，","那靈在此與我同活。"]},{"label":"3.","lines":["在此，在我最深之處，","神在主裡作我一切；","在此，那靈使主基督","作我實際，取用不竭。"]},{"label":"4.","lines":["在此，我在我靈裡面，","和主接觸，與主同在；","在此，我也藉著我靈，","與神交通，向神敬拜。"]},{"label":"5.","lines":["在此，基督如同美地，","我居其中，享其豐富；","也當在此進攻仇敵，","運用權柄對付陰府。"]},{"label":"6.","lines":["我當追求對靈認識，","永遠將靈從魂分開，","並且活在這至聖所，","享受神與主的同在。"]},{"label":"7.","lines":["我當永遠拒絕我魂，","努力進入神的安息，","使我豐滿得著基督，","成全神的永遠旨意。"]}]}