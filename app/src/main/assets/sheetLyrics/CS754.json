{"hymn":"CS754","parent":"E1267","quality":"exact","adjust":{"hold":0,"merge":0},"title":"為主見證移民開展","subtitle":"教會的生活","syl":{"n1":"為","n3":"主","n4":"見","n5":"證","n6":"移","n8":"民","n9":"開","n10":"展,","n11":"誰","n13":"願","n14":"蒙","n15":"恩","n16":"向","n18":"前","n19":"走?","n21":"何","n22":"時?","n23":"何","n24":"處?","n26":"照","n27":"主","n28":"差","n29":"遣,","n31":"恩","n32":"主","n33":"面","n34":"光","n35":"當","n36":"尋","n37":"求。"},"verses":[{"label":"2.","lines":["為將聖殿、聖城建立,","擴展神國及全地;","背判征服,混亂消弭,","同心合意眾如一。"]},{"label":"3.","lines":["父乃源頭,子作管道,","那靈湧流為憑藉;","站住立場,靈中相調,","此乃得勝的祕訣。"]},{"label":"4.","lines":["主所籌畫偉大、完全,","激動我們全奉獻;","好讓聖靈浸透、充滿,","神聖定旨得實現。"]},{"label":"5.","lines":["今日在此學習多方:","配搭建造、靈剛強;","那日前往各城、各邦,","建立燈臺顯榮光。"]},{"label":"6.","lines":["諸天掌權需“灘頭堡”─","地方召會─先建立;","求主興起各地建造,","實現國度為目的。"]},{"label":"7.","lines":["那時,全地榮耀歸你,","失敗、羞辱歸仇敵;","萬民稱頌你名不已,","國度掌權達至極。"]},{"label":"8.","lines":["有福之日不久就到,","榮耀經綸得成就;","喜樂、讚美達到至高,","神聖管治徧萬有。"]},{"label":"9.","lines":["讚美聖父,阿利路亞,","讚美聖子,阿利路,","讚美聖靈,阿利路亞,","神旨得成,阿利路。"]},{"label":"10.","lines":["召會榮耀,阿利路亞,","眾聖美善,阿利路,","聚會美善,阿利路亞,","誰不受感來歸服?"]},{"label":"11.","lines":["阿利路亞,阿利路亞,","阿利路亞,高聲唱,","阿利路亞,阿利路亞,","阿利路亞,讚我王!"]}]}