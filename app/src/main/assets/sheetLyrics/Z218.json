{"hymn":"Z218","parent":"E268","quality":"exact","adjust":{"hold":0,"merge":0},"title":"我已得蒙宝血洗净","subtitle":"圣灵的丰满－充满","syl":{"n1":"我","n2":"已","n3":"得","n4":"蒙","n5":"宝","n6":"血","n7":"洗","n8":"净，","n9":"充","n10":"满","n11":"天","n12":"上","n13":"的","n14":"喜","n15":"乐；","n16":"我","n17":"已","n18":"得","n19":"着","n20":"永","n21":"远","n22":"生","n23":"命，","n24":"成","n25":"为","n26":"活","n27":"水","n28":"的","n29":"运","n30":"河。","n31":"我","n32":"愿","n33":"作","n34":"主","n35":"活","n36":"水","n37":"运","n38":"河，","n39":"充","n40":"满","n41":"生","n42":"命","n43":"的","n44":"圣","n45":"灵，","n46":"灌","n47":"输","n48":"生","n49":"命，","n50":"解","n51":"人","n52":"干","n53":"渴，","n54":"涌","n55":"流","n56":"活","n57":"水","n58":"无","n59":"止","n60":"境。"},"verses":[{"label":"2.","lines":["奇妙救恩，甜美、丰盛，","满足我心如我意；","我愿天天作此见证，","吸引多人来归依。"]},{"label":"3.","lines":["主，你使我完全成圣，","作你贵重的器皿，","充满恩典，充满生命，","供应饥渴的人群。"]},{"label":"4.","lines":["将我倒空，将我充满，","愿我全人你占有；","活水江河洋溢、泛滥，","涌流生命到永久。"]}]}