{"hymn":"FR67","parent":"E373","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Je veux Seigneur, en Toi demeurer","subtitle":"","syl":{"n1":"Je","n2":"veux","n3":["Sei","i"],"n4":["gneur,","t"],"n5":"en","n6":"Toi","n7":["de","i"],"n8":["meu","m"],"n9":["rer,","t"],"n10":"Ta","n11":["gloi","i"],"n12":["re","t"],"n13":["con","i"],"n14":["tem","m"],"n15":["pler,","t"],"n16":"Te","n17":["lais","i"],"n18":["ser","t"],"n19":"me","n20":["par","i"],"n21":["ler","t"],"n22":"Et","n23":"en","n24":"Toi","n25":"me","n26":["ca","i"],"n27":["cher.","t"],"n28":"Tu","n29":"es","n30":"à","n31":"moi,","n32":"je","n33":"suis","n34":"à","n35":"Toi."},"verses":[{"label":"2.","lines":["Je veux Seigneur, en Toi demeurer,","Qu'en moi Ta douce voix,","Dirige tous mes choix.","Elle est ma paix, ma joie.","Tu es à moi, je suis à Toi."]},{"label":"3.","lines":["Je veux Seigneur, en Toi demeurer,","Je ne veux être pris","Par la vie, ses soucis,","Le monde qui me lie.","Tu es à moi, je suis à Toi."]},{"label":"4.","lines":["Je veux Seigneur, en Toi demeurer,","Pardonne mes péchés,","Chasse mes anxiétés,","Qui veulent me troubler.","Tu es à moi, je suis à Toi."]},{"label":"5.","lines":["Je veux Seigneur, en Toi demeurer,","Ta lumière a jailli,","Elle a chassé ma nuit","Et règne dans ma vie.","Tu es à moi, je suis à Toi."]},{"label":"6.","lines":["Je veux Seigneur, en Toi demeurer,","Que mes yeux soient fixés,","Sur Toi mon bien-aimé.","En Toi je marcherai.","Tu es à moi, je suis à Toi."]},{"label":"7.","lines":["Je veux Seigneur, en Toi demeurer,","La face dévoilée,","Je serai transformé,","Pour Ton retour paré.","Tu es à moi, je suis à Toi."]}]}