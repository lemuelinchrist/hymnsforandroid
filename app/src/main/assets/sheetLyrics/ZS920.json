{"hymn":"ZS920","parent":"E1304","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"荣耀新妇主所期,喜乐婚筵祂备齐","subtitle":"盼望与豫备","syl":{"n1":"荣","n2":"耀","n3":"新","n4":"妇","n5":"主","n6":"所","n7":"期,","n8":"喜","n9":"乐","n10":"婚","n11":"筵","n12":"祂","n13":"备","n14":"齐;","n15":"穿","n16":"上","n17":"洁","n18":"净","n19":"细","n20":"麻","n22":"衣─","n23":"要","n24":"及","n25":"时！","n26":"经","n27":"过","n28":"苦","n29":"难","n30":"与","n31":"死","n32":"地,","n33":"基","n34":"督","n35":"生","n36":"命","n37":"紧","n38":"凭","n40":"倚,","n41":"活","n42":"出","n43":"之","n44":"义","n45":"成","n46":"所","n48":"披─","n49":"要","n50":"及","n51":"时！","n52":"要","n53":"及","n54":"时！","n55":"要","n57":"及","n58":"时！","n59":"羔","n60":"羊","n61":"婚","n62":"筵","n63":"今","n64":"在","n65":["即,",null,"u"],"n66":0,"n67":"要","n68":"及","n69":"时！","n70":"魂","n71":"的","n72":"生","n73":"命","n74":"肯","n75":"离","n76":"弃,","n77":"让","n78":"灵","n79":"浸","n80":"透","n81":"且","n82":"漫","n84":"溢,","n85":"就","n86":"必","n87":"够","n88":"格","n89":"来","n90":"坐","n92":"席─","n93":"要","n94":"及","n95":"时！"},"verses":[{"label":"2.","lines":["精明童女主所期,豫备新油当积极,","切莫轻忽神心意─要及时！","买油代价不容易,必须我们对付己,","器皿充满且洋溢─要及时！"]},{"label":"3.","lines":["忠信奴仆主所期,运用恩赐作生意,","莫因懒惰被撇弃─要及时！","一他连得不藏匿,克服松懒的己意,","凭主事奉不乏力─要及时！"]},{"label":"4.","lines":["成熟麦子主所期,初熟部分先被提,","大体庄稼仍在地─要及时！","勿向世界再寻觅,属地水分不留遗,","生命成熟讨主喜─要及时！"]},{"label":"5.","lines":["得胜信徒主所期,为祂万事不足惜,","起初的爱总不弃─要及时！","与主联结成为一,胜过所有的死寂,","奔向标竿尽全力─要及时！"]},{"label":"6.","lines":["看哪,基督要来地,属天国度将临及,","服主权柄莫迟疑─要及时！","悖逆的己须脱离,顺服功课当学习,","让主掌权登至极─要及时！"]}]}