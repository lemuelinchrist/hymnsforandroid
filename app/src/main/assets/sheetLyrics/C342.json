{"hymn":"C342","parent":"E456","quality":"exact","adjust":{"hold":0,"merge":0},"title":"活著為耶穌","subtitle":"奉獻－為主而活","syl":{"n1":"活","n2":"著","n3":"為","n4":"耶","n5":"穌，","n6":"只","n7":"望","n8":"能","n9":"單","n10":"純，","n12":"所","n13":"有","n14":"的","n15":"一","n16":"切","n17":"都","n18":"求","n19":"祂","n20":"喜","n21":"悅，","n23":"自","n24":"動","n25":"並","n26":"樂","n27":"意","n28":"來","n29":"向","n30":"祂","n31":"投","n32":"順，","n34":"這","n35":"是","n36":"我","n37":"蒙","n38":"神","n39":"賜","n40":"福","n41":"的","n42":"祕","n43":"訣。","n44":"耶","n45":"穌","n46":"我","n47":"主，","n48":"我","n49":"救","n50":"主，","n51":"我","n52":"將","n53":"自","n54":"己","n55":"給","n56":"你，","n57":"因","n58":"你","n59":"為","n60":"我","n61":"代","n62":"死","n63":"時，","n64":"給","n65":"的","n66":"是","n67":"你","n68":"自","n69":"己；","n70":"從","n71":"此，","n72":"我","n73":"無","n74":"別","n75":"的","n76":"主，","n77":"我","n78":"心","n79":"是","n80":"你","n81":"寶","n82":"座，","n83":"我","n84":"的","n85":"一","n86":"生","n87":"一","n88":"世，","n89":"基","n90":"督，","n91":"只","n92":"要","n93":"為","n94":"你","n95":"生","n96":"活。"},"verses":[{"label":"2.","lines":["活著為耶穌，","祂為我緣故，","在十字架上擔當罪與羞；","這愛激勵我答應祂招呼，","恭敬向著祂奉獻我所有。"]},{"label":"3.","lines":["活著為耶穌，","無論在何處，","我為祂緣故，","作成祂事務，","甘願來承受損失或痛苦，","看每個試煉是十架一部。"]},{"label":"4.","lines":["活著為耶穌，","時間已短促，","祂的笑臉是我寶貴祕密，","尋找失喪者，","祂死所救贖，","帶領疲倦者，","享受祂安息。"]}]}