{"hymn":"CS139","parent":"E1116","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"沒藥與香肉桂,香菖蒲與桂皮─","subtitle":"靈與生命","syl":{"n1":"沒","n2":"藥","n3":"與","n4":"香","n5":"肉","n6":"桂,","n7":"香","n8":"菖","n9":"蒲","n10":"與","n11":"桂","n12":"皮─","n13":"你","n14":"成","n15":"分","n16":"何","n17":"包","n18":"羅,","n19":"耶","n20":"穌","n21":"我","n22":"主!","n23":"橄","n24":"欖","n25":"油","n26":"中","n27":"相","n28":"調,","n29":"分","n30":"量","n31":"完","n32":"整","n33":"奇","n34":"妙─","n35":"寶","n36":"貴","n37":"膏","n38":"油","n39":"塗","n40":"抹,","n41":"供","n42":"應","n43":"豐","n44":"富!","n45":"香","n46":"料","n47":"加","n48":"上","n49":"油,","n50":"四","n51":"調","n52":"和","n53":"於","n54":"一,","n55":"終","n56":"成","n57":"複","n58":"合","n59":"之","n60":"靈;","n62":"基","n63":"督","n64":"之","n65":"死","n67":"甜","n68":"美,","n69":"基","n70":"督‿復","n71":"活‿馨","n73":"香,","n74":"複","n75":"合","n76":"成","n77":"為","n78":"膏","n79":"油,","n80":"流","n81":"進","n82":"我","n83":"靈!"},"verses":[{"label":"2.","lines":["蘇合香與香螺,白松香與乳香─","你成分何包羅,耶穌我主!","生命產生眾子,救贖使罪脫落,","驅逐死亡鬼魔,功效全足!","分量各相等,復活裏調和,","加鹽製成香物;","搗細置 於櫃前, 供神聖火焚燒,","至純至聖之香,耶穌我主!"]},{"label":"3.","lines":["膏油是為我們,馨香完全為神,","人神同享基督,榮耀豐富!","膏油流至我們,帶來福分全備,","馨香升達寶座,使神滿足!","先塗抹膏油,後焚燒馨香,","如此經歷基督;","禱告讚 美高舉, 出自我們經歷,","珍貴蒙神悅納─全是基督!"]}]}