{"hymn":"FR5","parent":"E30","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Cher Père, Tu nous as aimés","subtitle":"","syl":{"n1":"Cher","n2":["Pè","i"],"n3":["re,","t"],"n4":"Tu","n5":"nous","n6":"as","n7":["ai","i"],"n8":["més","t"],"n9":"D'un","n10":["a","i"],"n11":["mour","t"],"n12":"si","n13":["pro","i"],"n14":["fond,","t"],"n15":"Nos","n16":"cœurs","n17":["re","i"],"n18":["con","m"],"n19":["nais","m"],"n20":["sants","t"],"n21":"Te","n22":"louent,","n23":"Nous","n24":["é","i"],"n25":["le","m"],"n26":["vons","t"],"n27":"Ton","n28":"nom!"},"verses":[{"label":"2.","lines":["Tu nous as révélé Ton cœur,","Ton dessein bienveillant.","Tu vins dans Ton Fils bien-aimé,","Pour accomplir Ton plan."]},{"label":"3.","lines":["Ton Fils unique Tu livras.","La mort Il accepta,","Pour faire de nombreux pécheurs","Beaucoup de fils pour Toi."]},{"label":"4.","lines":["Nous sommes, Père, Tes enfants,","Tu nous as engendrés.","Ta vie divine nous avons,","À nous Tu T'es donné."]},{"label":"5.","lines":["L' Esprit du Fils dans notre esprit","« Abba cher Père ! » crie.","Scellés de Lui, nous jouissons","Du gage de l'Esprit."]},{"label":"6.","lines":["De gloire en gloire par l'Esprit,","Nous sommes transformés","Et à l'image de Ton Fils,","Tu vas nous conformer."]},{"label":"7.","lines":["Quand dans la gloire Tu auras","Conduit les rachetés,","Ton but alors sera atteint,","Ton désir satisfait."]},{"label":"8.","lines":["Cher Père, Tu nous as aimés.","Nous magnifions Ton nom.","Nos cœurs Te sont reconnaissants.","Combien nous T'adorons !"]}]}