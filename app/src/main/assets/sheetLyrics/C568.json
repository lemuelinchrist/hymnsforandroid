{"hymn":"C568","parent":"E784","quality":"exact","adjust":{"hold":0,"merge":0},"title":"禱告與主來往交通","subtitle":"禱告－與主交通","syl":{"n1":"禱","n2":"告","n3":"與","n4":"主","n5":"來","n6":"往","n7":"交","n8":"通，","n10":"祂","n11":"面","n12":"靈","n13":"裡","n14":"來","n15":"尋","n16":"求；","n18":"祂","n19":"前","n20":"求","n21":"問","n22":"並","n23":"且","n24":"靜","n25":"聽，","n27":"隱","n28":"密","n29":"之","n30":"處","n31":"來","n32":"等","n33":"候。","n35":"禱","n36":"告","n37":"與","n38":"主","n39":"來","n40":"往","n41":"交","n42":"通，","n44":"祂","n45":"面","n46":"靈","n47":"裡","n48":"來","n49":"尋","n50":"求；","n52":"祂","n53":"前","n54":"求","n55":"問","n56":"並","n57":"且","n58":"靜","n59":"聽，","n61":"隱","n62":"密","n63":"之","n64":"處","n65":"來","n66":"等","n67":"候。"},"verses":[{"label":"2.","lines":["禱告與主來往交通，","從你裡面全敞開；","敞著臉面將祂瞻仰，","單一、純潔又實在。"]},{"label":"3.","lines":["禱告與主來往交通，","憑信將祂來尋求；","學習來摸祂這活靈，","恭敬、仰望並等候。"]},{"label":"4.","lines":["禱告與主來往交通，","以靈、以真為祕訣；","總要憑靈禱告、求問，","照著裡面的感覺。"]},{"label":"5.","lines":["禱告與主來往交通，","誠懇靜聽祂所言；","讓祂心意印刻於你，","使你成全祂心願。"]},{"label":"6.","lines":["禱告與主來往交通，","沐浴在祂面光中；","讓祂榮美將你浸透，","使你返照祂面容。"]}]}