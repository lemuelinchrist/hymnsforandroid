{"hymn":"ZS541","parent":"E1296","quality":"exact","adjust":{"hold":0,"merge":0},"title":"神造万有美好、有序","subtitle":"教会的异象","syl":{"n1":"神","n2":"造","n3":"万","n4":"有","n5":"美","n6":"好、","n7":"有","n8":"序,","n9":"徧","n10":"布","n11":"天、","n12":"地、","n13":"空","n14":"中;","n15":"仇","n16":"敌","n17":"竟","n18":"来","n19":"败","n20":"坏、","n21":"占","n22":"据,","n23":"阻","n24":"挠","n25":"神","n26":"旨","n27":"完","n28":"成。","n29":"那","n30":"权","n31":"能","n32":"者","n33":"恣","n34":"意","n35":"背","n36":"判,","n37":"先","n38":"来","n39":"将","n40":"地","n41":"篡","n42":"夺;","n43":"又","n44":"在","n45":"空","n46":"中","n47":"蓄","n48":"势","n49":"争","n50":"战,","n51":"建","n52":"立","n53":"黑","n54":"暗","n55":"之","n56":"国。"},"verses":[{"label":"2.","lines":["神的心意是要在地","建立祂的国度,","好使祂能掌权治理,","显明祂智丰足。","地虽荒废,渊面黑暗,","神来恢复、再造,","且按祂的神圣意念,","造人与祂相肖。"]},{"label":"3.","lines":["恶者撒但又将人骗,","诱离神恩源头;","亚伯拉罕见神显现,","蒙召族类起首。","神领选民脱离埃及,","经过红海、野疆,","进入迦南应许美地,","神国在此彰显。"]},{"label":"4.","lines":["以色列民竟弃神治,","属地君主依恃;","神国彰显再次丧失,","直至大衞之时;","借他神得执政道路,","神国重新恢复;","百姓终究仍是失误,","被掳,失去国度。"]},{"label":"5.","lines":["人虽不堪,神不失败,","亲来成为肉身;","向人宣告“:应当悔改！","因为国度临近。”","神人耶稣,完美绝佳,","为神权柄执掌;","撒但将祂钉死十架,","不过显其愚妄。"]},{"label":"6.","lines":["妙哉,耶稣救赎成就,","复活胜过死亡,","为要使地得蒙拯救,","脱离撒但捆绑;","且成那灵进入人里,","召会借此建立─","生命洋溢,混乱消弭,","神旨通行于地。"]},{"label":"7.","lines":["如今召会在地显明,","神国丰满实际;","神圣权柄尽得通行,","使地归神管理。","我们在此为神执政,","撒但只能逃遁;","如此召会作神见证,","国度不再藏隐。"]}]}