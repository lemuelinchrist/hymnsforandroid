{"hymn":"ZS852","parent":"E920","quality":"exact","adjust":{"hold":0,"merge":0},"title":"兴起！角声发出,喜信传布","subtitle":"事奉与福音","syl":{"n1":"兴","n2":"起！","n3":"角","n4":"声","n5":"发","n6":"出,","n7":"喜","n8":"信","n9":"传","n10":"布;","n11":"宣","n12":"扬","n13":"万","n14":"主","n15":"之","n16":"主─","n17":"救","n18":"主","n19":"耶","n20":"稣;","n21":"述","n22":"说","n23":"祂","n24":"名","n25":"宝","n26":"贵,","n27":"高","n28":"举","n29":"祂","n30":"的","n31":"尊","n32":"位,","n33":"好","n34":"使","n35":"万","n36":"众","n37":"来","n38":"归─","n40":"耶","n41":"稣","n42":"是","n43":"主！"},"verses":[{"label":"2.","lines":["谁愿为祂前去?谁愿兴起?","地爱迷人难拒,为祂全弃:","鄙视属地荣华,万事看为卑下,","惟夸救主十架;谁愿兴起?"]},{"label":"3.","lines":["得赏之日不远,奋勇向前;","晨星快要出现,不再迟延。","高举十架救恩,征服偶像、判民;","惟盼有福之晨,与主相见。"]},{"label":"4.","lines":["请听胜利角声,耶稣为王！","基督登极执政,无能违抗:","全地复归祂有,惟祂居高为首,","座前无不拜叩─耶稣为王！"]}]}