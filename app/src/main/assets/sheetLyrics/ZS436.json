{"hymn":"ZS436","parent":"E641","quality":"exact","adjust":{"hold":0,"merge":0},"title":"基督所赐丰满福分","subtitle":"追求与长进","syl":{"n1":"基","n2":"督","n4":"所","n5":"赐","n6":"丰","n7":"满","n8":"福","n9":"分,","n10":"是","n11":"否","n13":"渴","n14":"慕","n16":"能","n18":"得","n19":"着?","n20":"主","n21":"所","n23":"命","n24":"定","n25":"得","n26":"胜","n27":"生","n28":"活,","n29":"秘","n30":"诀","n32":"是","n33":"否","n34":"已","n36":"掌","n38":"握?","n39":"答","n40":"案","n42":"明","n43":"示","n44":"于","n45":"祂","n46":"圣","n47":"言:","n48":"“基","n49":"督","n51":"是","n52":"我","n53":"们","n54":"生","n56":"命;”","n57":"只","n58":"要","n60":"向","n61":"祂","n62":"敞","n63":"开","n64":"心","n65":"怀,","n66":"凭","n67":"信","n69":"取","n70":"用","n72":"祂","n73":"丰","n75":"盛。"},"verses":[{"label":"2.","lines":["基督受死将你救赎,","且要居衷掌王权;","在你里外显祂能力,","日复一日时加添。","在你不能,在祂都能─","祂灵要作工你身;","“不再是我,乃是基督”─","你要见证此深恩。"]},{"label":"3.","lines":["神的丰满住祂里面,","你在祂里得丰盛;","起来,取用儿子名分,","切勿辜负父恩情。","全是恩典,绝不迟误,","只要赞美来领受;","神圣供备永无不足,","凭祂而活何饶优。"]},{"label":"4.","lines":["主我前来,单纯信靠,","你的圣言永不变,","信你救赎洗罪有能,","信你得胜、得荣冕。","但愿你那无穷生命","带爱从我流不息,","临及暗中无望人群,","引领多人来归依。"]}]}