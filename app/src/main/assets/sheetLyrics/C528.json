{"hymn":"C528","parent":"E727","quality":"exact","adjust":{"hold":0,"merge":0},"title":"暗過必明亮","subtitle":"試煉中的安慰－受苦得益","syl":{"n1":"暗","n2":"過","n3":"必","n4":"明","n6":"亮，","n7":"苦","n8":"過","n9":"必","n10":"甜；","n11":"弱","n12":"過","n13":"必","n14":"剛","n16":"強，","n17":"難","n18":"過","n19":"必","n20":"安；","n21":"損","n22":"過","n23":"必","n24":"有","n26":"益，","n27":"風","n28":"過","n29":"必","n30":"靜；","n31":"勞","n32":"過","n33":"必","n34":"安","n36":"息，","n37":"雨","n38":"過","n39":"必","n40":"晴。"},"verses":[{"label":"2.","lines":["壓過必高升，","憂過必樂；","死過必復生，","失過必得；","累過必輕鬆，","困過必蘇；","迫過必從容，","貧過必富。"]},{"label":"3.","lines":["蕩過必安居，","孤過有伴，","與主再無距，","直到相見，","十架變冠冕，","歎息變讚，","信望變眼見，","再無疑難。"]}]}