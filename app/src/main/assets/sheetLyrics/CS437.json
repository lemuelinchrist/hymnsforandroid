{"hymn":"CS437","parent":"E804","quality":"exact","adjust":{"hold":0,"merge":0},"title":"哦主,你話如同糧倉","subtitle":"追求與長進","syl":{"n1":"哦","n2":"主,","n3":"你","n4":"話","n5":"如","n6":"同","n7":"糧","n8":"倉,","n9":"供","n10":"應","n11":"充","n12":"足、","n13":"多","n14":"方;","n15":"凡","n16":"飢","n17":"餓","n18":"者","n19":"都","n20":"可","n21":"來","n22":"此","n23":"榮","n24":"耀,","n25":"豐","n26":"富","n27":"飽","n28":"嘗。","n29":"你","n30":"話","n31":"又","n32":"如","n33":"深","n34":"處","n35":"寶","n36":"礦,","n37":"稀","n38":"有","n39":"珍","n40":"物","n41":"盡","n42":"藏;","n44":"凡","n45":"尋","n46":"求","n47":"者","n48":"來","n49":"此","n50":"挖","n51":"掘,","n52":"必","n53":"得","n54":"至","n55":"寶","n56":"無","n57":"上。"},"verses":[{"label":"2.","lines":["你話猶如眾星發亮,","光芒四射輝煌;","天程旅客在此光中","屬天,家鄉直往。","你話又如軍器庫房,","收藏全備軍裝;","爭戰雖長,終必奏凱,","因有供備無量。"]},{"label":"3.","lines":["願我寶愛你的聖言,","盡享礦藏富源;","願我取用榮耀豐富","光中,生活無間。","願我尋得話中兵器,","靠此誇勝敵前;","揮動那靈可靠的劍,","為主權益爭戰。"]},{"label":"4.","lines":["哦,永活神生命的話,","你是神的光輝;","得你,我就得神自己","並脫,屬地纏累。","求主賜我正直的靈,","話中得你智慧;","猶如孩童心中單純,","轉向屬天恩惠。"]}]}