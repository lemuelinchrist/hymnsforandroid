{"hymn":"FR79","parent":"E445","quality":"adapted","adjust":{"hold":5,"merge":0},"title":"Prends ma vie, que tout entier","syl":{"n1":["Prends",null],"n2":["ma",null],"n3":["vi","i"],"n5":["e,","t","u"],"n7":0,"n8":["que",null,"u"],"n9":0,"n10":["tout",null],"n11":["en","i"],"n12":["ti","m"],"n14":["er","t","u"],"n16":0,"n17":["À",null,"u"],"n19":0,"n20":["Toi",null],"n21":["je",null],"n22":["sois",null],"n24":["con","i"],"n25":["sa","m"],"n26":["cré!","t","u"],"n28":0,"n29":["Prends",null],"n30":["mes",null],"n31":["jours,",null],"n32":["prends",null],"n34":["chaque",null],"n36":["ins","i"],"n38":["tant,","t"],"n39":["Que",null],"n40":["je",null],"n41":["vive",null],"n42":["en",null],"n44":["Te",null],"n45":["lou","i"],"n46":["ant.","t"]},"verses":[{"label":"2.","lines":["Prends mes mains, fais-les servir","Ton dessein et Ton désir.","Prends mes pieds pour annoncer,","L'évangile de Ta paix."]},{"label":"3.","lines":["Prends ma voix, fais-la chanter,","Que mon Roi soit exalté !","Prends mes lèvres, que par Toi","Elles parles de ma foi."]},{"label":"4.","lines":["Prends mon or et prends mes biens,","Car, Seigneur, tout T'aapartient.","Prends tous mes raisonnements,","Qu'ils Te soient obéissants."]},{"label":"5.","lines":["Prends pour Toi ma volonté,","Oui, je veux Te la céder.","Prends mon cœur, car il est Tien,","Qu'il devienne un bon terrain !"]},{"label":"6.","lines":["Prends, Seigneur, tout mon amour,","Qu'il augmente chaque jour !","Prends mon être tout entier,","Et que je sois consacré !"]}]}