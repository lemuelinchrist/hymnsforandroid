{"hymn":"C387","parent":"E533","quality":"exact","adjust":{"hold":0,"merge":0},"title":"無論罪惡如何深劇","subtitle":"經歷基督－作一切","syl":{"n1":"無","n2":"論","n3":"罪","n4":"惡","n5":"如","n6":"何","n7":"深","n8":"劇，","n9":"無","n10":"論","n11":"道","n12":"路","n13":"如","n14":"何","n15":"崎","n16":"嶇，","n17":"無","n18":"論","n19":"境","n20":"遇","n21":"如","n22":"何","n23":"可","n24":"慮，","n25":"主，","n26":"你","n27":"總","n28":"是","n30":"彀","n31":"用！"},"verses":[{"label":"2.","lines":["遇到試煉，無論大小，","有了罣慮，無論多少，","即使腳步盡都跌倒，","主，你總是彀用！"]},{"label":"3.","lines":["屬地事物悅意稱心，","光天化日路途平順，","安逸竟成遮光之雲，","主，你當然彀用！"]},{"label":"4.","lines":["即使憂苦終日為患，","失望、灰心、前途黑暗，","心麻、靈木、欲禱無言，","主，你仍是彀用！"]},{"label":"5.","lines":["不論我的環境如何，","你手都在將我托著，","使我經歷你之於我，","乃是全足之主！"]}]}