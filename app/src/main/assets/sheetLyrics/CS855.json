{"hymn":"CS855","parent":"E1124","quality":"exact","adjust":{"hold":0,"merge":0},"title":"豈能不高聲頌揚","subtitle":"事奉與福音","syl":{"n1":"豈","n2":"能","n3":"不","n4":"高","n5":"聲","n6":"頌","n7":"揚?","n8":"豈","n9":"能","n10":"不","n11":"徧","n12":"傳","n13":"四","n14":"方?","n15":"寶","n16":"血","n17":"洗","n18":"罪","n19":"有","n20":"功","n21":"效,","n22":"罪","n23":"人","n24":"速","n25":"速","n26":"來","n27":"投","n28":"靠!"},"verses":[{"label":"2.","lines":["遠比祭牲血更美,","帶來救恩福全備;","羔羊無瑕、血無疵,","不見朽壞到永世。"]},{"label":"3.","lines":["聽哪!寶血在發聲,","聞於神前顯權能;","在寶座前為我言,","功效絕佳永不變。"]},{"label":"4.","lines":["前我良心有虧欠,","時有控告無平安;","所有玷污盡顯露,","歎息、痛苦不止住。"]},{"label":"5.","lines":["豈知寶血洗罪污,","神前功效永充足;","罪案全銷,得近神,","藉血罪人蒙神恩!"]},{"label":"6.","lines":["無須祭牲血再灑,","無須憑“死行”脫罰;","無何能使神喜悅,","諸天惟聽主寶血。"]},{"label":"7.","lines":["因祂流血我得贖,","罪得全赦,享永福;","先民不過將罪遮,","我得潔淨,唱樂歌。"]},{"label":"8.","lines":["進入平安,何穩妥,","良心無虧,罪污脫;","不再羞愧,無重擔,","與神和好,心安然。"]},{"label":"9.","lines":["阿利路亞!深難測!","寶血價值我尋得!","故當歌唱,再歌唱,","祂血永是我保障!"]}]}