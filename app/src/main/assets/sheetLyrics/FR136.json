{"hymn":"FR136","parent":"E745","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Tu es l'Esprit, Seigneur Jésus","syl":{"n1":["Tu",null],"n2":["es",null],"n3":["l'Es","i"],"n4":["prit,","t"],"n5":["Sei","i"],"n6":["gneur","t"],"n7":["Jé","i"],"n8":["sus,","t"],"n9":["Tu",null],"n10":["vis",null],"n11":["dans",null],"n12":["mon",null],"n13":["es","i"],"n14":["prit.","t"],"n15":["Les",null],"n16":["deux",null],"n17":["es","i"],"n18":["prits","t"],"n19":["ne",null],"n20":["for","i"],"n21":["ment","t"],"n22":["qu'un,",null],"n23":["À",null],"n24":["Toi,",null],"n25":["je",null],"n26":["suis",null],"n27":["u","i"],"n28":["ni.","t"]},"verses":[{"label":"2.","lines":["L'Esprit témoigne en mon esprit,","Que je suis né de Lui.","Enfant de Dieu, Son héritier,","Je prends part à Sa vie."]},{"label":"3.","lines":["Tu es l'Esprit de vie, Seigneur,","Qui se dispense en nous.","Tu es si riche en notre esprit,","Toi seul es notre tout."]},{"label":"4.","lines":["Tu nous conduis, Seigneur Esprit,","Nous demeurons en Toi.","Nos deux esprits sont mélangés,","Nous marchons selon Toi."]},{"label":"5.","lines":["Tu es l'Esprit dans notre esprit,","Qui toujours nous soutient.","Nous T'adorons et Te servons.","Un avec tous les saints."]},{"label":"6.","lines":["Par nos prières et nos soupirs,","Dans notre esprit, Tu pries,","Tu intercèdes auprès de Dieu,","Pour Ton économie."]},{"label":"7.","lines":["Nous revenons à notre esprit,","Tu coules abondamment.","Dans Ton Esprit, nous recevons","L'approvisionnement."]},{"label":"8.","lines":["Quelle glorieuse union, Seigneur !","Indissociable lien !","Ton Esprit vit dans mon esprit,","Le mien vit dans le Tien."]}]}