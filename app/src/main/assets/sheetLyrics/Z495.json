{"hymn":"Z495","parent":"E697","quality":"adapted","adjust":{"hold":2,"merge":0},"title":"路途遥远，负担沉著","subtitle":"试炼中的安慰－主的看顾","syl":{"n1":"路","n2":"途","n3":"遥","n4":"远，","n5":"负","n6":"担","n7":"沉","n8":"着，","n9":"力","n10":"尽","n11":"身","n12":"疲","n13":"要","n14":"倒","n15":"下；","n16":"请","n17":"听","n18":"主","n19":"声，","n20":"柔","n21":"然","n22":"轻","n23":"说：","n24":"重","n25":"担","n26":"当","n27":"托","n28":"耶","n29":"和","n30":"华。","n31":"重","n32":"担","n33":"当","n34":"托","n35":"耶","n36":"和","n37":"华，","n38":"重","n39":"担","n40":"当","n41":"托","n42":"耶","n43":"和","n44":"华，","n45":"主","n46":"会","n47":"安","n48":"慰","n49":["你，",null,"u"],"n50":0,"n51":"又","n52":"会","n53":"坚","n54":"固","n55":["你，",null,"u"],"n56":0,"n57":"重","n58":"担","n59":"当","n60":"托","n61":"耶","n62":"和","n63":"华。"},"verses":[{"label":"2.","lines":["双脚已软，双手已酸，","灯火将灭目又花，","眼见就要心灰气短，","重担当托耶和华。"]},{"label":"3.","lines":["亲友离散，遭遇凄凉，","忧心难解常悬罣，","一身难受如此创伤，","重担当托耶和华。"]},{"label":"4.","lines":["孤单软弱，无所傍倚，","心绪起落乱如麻，","都是因为我们忘记","重担当托耶和华。"]},{"label":"5.","lines":["祂会安慰，祂会坚固，","祂要使你力有加，","祂要使你心境安舒，","重担当托耶和华。"]}]}