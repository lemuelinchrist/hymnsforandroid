{"hymn":"CS340","parent":"NS10065","quality":"exact","adjust":{"hold":0,"merge":0},"title":"主,我愛你逐日益深摯","subtitle":"愛慕耶穌","syl":{"n2":"主,","n3":"我","n4":"愛","n5":"你","n6":"逐","n7":"日","n9":"益","n11":"深","n12":"摯,","n14":"主,","n15":"我","n16":"愛","n17":"你","n18":"今","n19":"日","n21":"勝","n23":"昨","n24":"日。","n26":"我","n27":"不","n28":"能","n29":"再","n30":"活","n31":"無","n33":"你","n35":"之","n36":"處,","n38":"我","n39":"不","n40":"能","n41":"重","n42":"步","n43":"往","n44":"日","n47":"行","n48":"徑。","n50":"哦,","n51":"在","n52":"往","n53":"昔","n54":"無","n55":"你","n57":"歲","n59":"月","n60":"中,","n62":"當","n63":"我","n64":"失","n65":"喪,","n66":"你","n67":"來","n69":"施","n71":"拯","n72":"救。","n74":"我","n75":"每","n76":"憶","n77":"過","n78":"往","n79":"其","n81":"餘","n83":"年","n84":"日,","n86":"虛","n87":"空","n88":"心","n89":"痛","n90":"並","n91":"潸","n92":"然","n95":"淚","n96":"流。","n98":"主,","n99":"我","n100":"真","n101":"愛","n102":"你,","n104":"日","n105":"益","n106":"深","n107":"摯。","n109":"主,","n110":"我","n111":"真","n112":"愛","n113":"你,","n114":"歷","n115":"久","n116":"彌","n117":"新","n118":"無","n119":"止。"},"verses":[{"label":"3.","lines":["哦乾渴吞噬我心深處,","驅使我尋求以得滿足。","哦我曾嘗試許多事物,","卻仍乾渴且不得滿足。"]},{"label":"4.","lines":["主你充滿我全人深處,","豐美甘甜最令人滿足。","你是那靈,作我的一切,","你靈與我靈洋溢不住。"]},{"label":"5.","lines":["追尋新事物總無止境,","惟你纔是我終日渴求。","我前盲目且汲汲營營,","直至飲你作活水源頭。"]},{"label":"6.","lines":["何感謝!主,你進入我靈,","今在我裡你不斷擴展。","何寶貝!主安家我心房,","將我裡面各部分充滿。"]}]}