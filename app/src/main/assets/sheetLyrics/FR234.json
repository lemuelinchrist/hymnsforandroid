{"hymn":"FR234","parent":"E600","quality":"adapted","adjust":{"hold":4,"merge":0},"title":"Mon Dieu, mon tout et Inonamour","subtitle":"","syl":{"n1":"Mon","n2":"Dieu,","n3":"mon","n4":"tout","n5":"et","n6":"mon","n7":["a","i"],"n8":["mour,","t"],"n9":"Ma","n10":["por","i"],"n11":["tion","t"],"n12":"pour","n13":["tou","i"],"n14":["jours,","t"],"n16":"Je","n17":"n’ai","n18":["per","i"],"n19":["son","m"],"n20":["ne","t"],"n21":"que","n22":"Toi","n23":"seul","n24":"Sur","n26":["ter","i"],"n27":["re","t","u"],"n28":0,"n29":["et",null,"u"],"n30":0,"n32":["dans",null,"u"],"n33":0,"n34":"les","n35":["ci","i"],"n36":["eux.","t","u"],"n37":0},"verses":[{"label":"2.","lines":["Que valent l’horizon, la terre ?","Poussière et vanité !","Rien ne mérite ici mes joies,","Rien n’est semblable à Toi."]},{"label":"3.","lines":["Je Te dois tout : biens et amis,","Ma santé, mon abri.","Mais ces bénédictions ne peuvent","Jamais Te remplacer."]},{"label":"4.","lines":["Quel vains plaisirs l’or, les palais,","Quand à Toi comparés !","Que valent ma sécurité,","Ma vie ou mes amis ?"]},{"label":"5.","lines":["Si mienne était toute la terre","Et sa voûte étoilée,","Je serais misérable et las,","Sans Ta grâce et sans Toi."]},{"label":"6.","lines":["Je laisse à d’autres les efforts","D’atteindre leurs trésors,","Car les visites de Ta grâce,","Sont bien mon plus grand gain."]}]}