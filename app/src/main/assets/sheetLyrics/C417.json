{"hymn":"C417","parent":"C413","quality":"adapted","adjust":{"hold":6,"merge":1},"title":"夜影尚存，晨光未現","subtitle":"經歷基督－與祂交通","syl":{"n1":"夜","n2":"影","n3":"尚","n4":"存，","n5":"晨","n6":"光","n7":"未","n8":"現，","n10":"重","n11":"新","n12":"來","n13":"到","n14":"恩","n15":"主","n16":"面","n17":["前；",null,"u"],"n18":0,"n19":"祂","n20":"在","n21":"裡","n22":["面",null,"u"],"n23":0,"n24":"放","n25":"明、","n26":"照","n27":["耀，",null,"u"],"n28":0,"n29":"我","n30":"得","n31":"看","n32":"見","n33":["祂",null,"u"],"n34":0,"n36":"的","n37":"榮","n38":"顏。","n39":"向","n40":"我","n41":"發","n42":"言、","n43":"給","n44":"我","n45":"看","n46":"見：","n47":"祂","n48":"的","n49":"豐","n50":"富","n51":"是","n52":"為","n53":"今","n54":"天；","n55":"甜","n57":"美、","n58":["歡",null,"u"],"n59":0,"n60":"樂，","n61":"將","n62":"祂","n63":"享","n64":["受，",null,"u"],"n65":0,"n66":"所","n67":"有","n68":"飢","n69":"餓","n70":"全‿變","n71":"飽","n72":"滿。"},"verses":[{"label":"2.","lines":["主靈藉話與我交談，","直到我心發出頌讚，","生命活泉，帶著恩力，","在我裡面湧流潺潺。","向我發言、給我看見：","祂的豐富是為今天；","清爽、暢快，將祂歡飲，","所有乾渴全都消減。"]},{"label":"3.","lines":["當我歡留於祂面光，","祂以溫情對付、指點；","用祂神聖、寶貴成分，","浸透全人、供應無限。","向我發言、給我看見：","祂的豐富是為今天；","多方、豐滿將祂享受，","所有問題全都逃竄！"]}]}