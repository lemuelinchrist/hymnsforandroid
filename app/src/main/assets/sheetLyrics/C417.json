{"hymn":"C417","parent":"E554","quality":"adapted","adjust":{"hold":6,"merge":1},"title":"夜影尚存，晨光未現","subtitle":"經歷基督－與祂交通","syl":{"n1":"夜","n2":"影","n3":"尚","n4":"存，","n5":"晨","n6":"光","n7":"未","n8":"現，","n10":"重","n11":"新","n12":"來","n14":"到","n15":"恩","n16":"主","n17":"面","n18":["前；",null,"u"],"n19":0,"n20":"祂","n21":"在","n22":"裡","n23":"面","n24":"放","n25":"明、","n26":["照",null,"u"],"n27":0,"n28":["耀，",null,"u"],"n29":0,"n30":"我","n31":"得","n32":"看","n33":"見","n34":["祂",null,"u"],"n35":0,"n37":"的","n38":"榮","n39":"顏。","n40":"向","n41":"我","n42":"發","n43":"言、","n44":"給","n45":"我","n46":"看","n47":"見：","n48":"祂","n49":"的","n50":"豐","n51":"富","n52":"是","n53":"為","n55":"今","n56":"天；","n58":"甜","n59":"美、","n60":"歡","n61":"樂，","n62":"將","n63":"祂","n64":["享",null,"u"],"n65":0,"n66":["受，",null,"u"],"n67":0,"n68":"所","n69":"有","n70":"飢","n71":"餓","n72":"全","n73":"變‿飽","n74":"滿。"},"verses":[{"label":"2.","lines":["主靈藉話與我交談，","直到我心發出頌讚，","生命活泉，帶著恩力，","在我裡面湧流潺潺。","向我發言、給我看見：","祂的豐富是為今天；","清爽、暢快，將祂歡飲，","所有乾渴全都消減。"]},{"label":"3.","lines":["當我歡留於祂面光，","祂以溫情對付、指點；","用祂神聖、寶貴成分，","浸透全人、供應無限。","向我發言、給我看見：","祂的豐富是為今天；","多方、豐滿將祂享受，","所有問題全都逃竄！"]}]}