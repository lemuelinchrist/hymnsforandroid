"a","i"],"n142":["me","m"],"n143":["nant!","t"]},"verses":[{"label":"2.","lines":["Dans cet endroit où Dieu bénit,","Là Dieu et l’homme sont unis,","Demeurant dans ce bon pays,","Délectant l’Esprit promis.","Quel privilége, chérissons !","Son Corps organique, bâtissons !","Le Christ glorieux, manifestons !","Son témoignage, propageons !"]},{"label":"3.","lines":["Dans le pic de révélations,","Avec joie et fardeau pesant,","Je veux être dynamisé,","Que ma vie soit restaurée !","En tout temps marcher par l’Esprit,","En tout lieu semer pour l’Esprit,","Tout comme le Seigneur l’établit,","Un modèle corporatif !"]},{"label":"4.","lines":["À soi mourant ; à Dieu vivant,","Par l’esprit mélangé marchant,","Le vieil homme est enterré,","Mort au monde et au péché.","Seigneur, je veux être un vainqueur,","Te poursuivant de tout mon cœur,","La vie corporative d’hommes-Dieu","Exprimée au royaum’ de Dieu."]}]}