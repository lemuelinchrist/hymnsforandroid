{"hymn":"Z394","parent":"E513","quality":"adapted","adjust":{"hold":1,"merge":0},"title":"前要的是祝福","subtitle":"经历基督－作一切","syl":{"n1":"前","n2":"要","n3":"的","n4":"是","n5":"祝","n6":"福，","n7":"今","n8":"要","n9":"主","n10":"自","n11":"己；","n14":"前","n15":"要","n16":"的","n17":"是","n18":"医","n19":"治，","n20":"今","n21":"要","n22":"主","n23":"而","n24":"已；","n27":"前","n28":"我","n29":"贪","n30":"求","n31":"恩","n32":"赐，","n33":"今","n34":"要","n35":"赐","n36":"恩","n37":"者；","n40":"前","n41":"我","n42":"寻","n43":"求","n44":"能","n45":"力，","n46":"今","n47":"要","n48":"全","n49":"能","n50":"者。","n53":"永","n54":"远","n55":"举","n56":"起","n57":"耶","n58":"稣，","n59":"赞","n60":"美","n61":"主","n63":"不","n64":"歇；","n67":"一","n68":"切","n69":"在","n70":"于","n71":"基","n73":"督，","n74":"主","n75":"是","n76":"我","n77":"一","n78":["切。",null,"u"],"n79":0},"verses":[{"label":"2.","lines":["前常用手抓主，","今主手牵我；","前常无所适从，","今抛锚稳妥；","前是宝贵感觉，","今凭主口说；","前是频频苦试，","今完全信托。"]},{"label":"3.","lines":["前是忙于打算，","今则靠祈求；","前是悬切罣虑，","今则主担忧；","前随我之所欲，","今听主支配；","前不住的讨问，","今不断赞美。"]},{"label":"4.","lines":["前我欲利用主，","今则主用我；","前是我的事业，","今为主工作；","前欲得人称赞，","今求主欢喜；","前不过半得救，","今被救到底。"]},{"label":"5.","lines":["前羡慕得着主，","今知主属我；","前我灯将熄灭，","今则光炳烁；","前所望的是死，","今等候被提；","我所有的一切，","都在主自己。"]}]}