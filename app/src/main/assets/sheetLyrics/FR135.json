{"hymn":"FR135","parent":"E744","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"Pour en tout temps venir à Dieu","syl":{"n1":["Pour",null],"n2":["en",null],"n3":["tout",null],"n4":["temps",null],"n5":["ve","i"],"n6":["nir","t"],"n7":["à",null],"n8":["Dieu,",null],"n9":["Un",null],"n10":["cœur",null],"n11":["pur",null],"n12":["est",null],"n13":["pré","i"],"n14":["cieux,","t"],"n15":["Pour",null],"n16":["qu'à",null],"n17":["nous",null],"n18":["tou","i"],"n19":["tes","t"],"n20":["Ses",null],"n21":["ri","i"],"n22":["chesses,","t"],"n23":["Soi","i"],"n24":["ent‿don","m"],"n25":["né‿es,","t"],"n26":["dans",null],"n27":["Sa",null],"n28":["grâce.",null]},"verses":[{"label":"2.","lines":["Change mon cœur qui n'est pas droit,","Éclaire mes pensées,","Pour discerner Tes intentions,","Saisir Ta volonté."]},{"label":"3.","lines":["Seigneur, Tu veux un cœur fervent,","Un cœur brulant d'amour,","Pour Toi, rempli de sentiments,","Désirant Ton retour."]},{"label":"4.","lines":["Tu veux un cœur obéissant :","Soumets ma volonté,","Adoucis-là, mais rends-moi fort,","Pour Ton plan, Bien-aimé !"]},{"label":"5.","lines":["Mon cœur ne doit pas mépriser,","Mais en tout chercher Dieu.","Et la conscience est purifiée,","Par le sang si précieux."]},{"label":"6.","lines":["En moi, Seigneur, mets un tel cœur,","Toujours tourné vers Toi !","Pour y graver Ta sainteté","Et T'exprimer par moi !"]}]}