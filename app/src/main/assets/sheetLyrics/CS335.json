{"hymn":"CS335","parent":"E547","quality":"exact","adjust":{"hold":0,"merge":0},"title":"人的心哪,你愛甚麼","subtitle":"愛慕耶穌","syl":{"n1":"人","n2":"的","n3":"心","n4":"哪,","n5":"你","n6":"愛","n7":"甚","n8":"麼?","n9":"若","n10":"非","n11":"基","n13":"督,","n14":"無","n15":"安","n16":"息。","n18":"哦,","n19":"主,","n20":"求","n21":"你","n22":"悅","n23":"納","n24":"我","n25":"心,","n26":"上","n27":"好","n28":"之","n30":"愛,","n31":"來","n32":"愛","n33":"你。"},"verses":[{"label":"2.","lines":["今將世界全都拋棄,","我主耶穌最美麗;","你是可愛、甘甜、柔細,","憐憫、恩典全洋溢。"]},{"label":"3.","lines":["你的榮臉,明亮輝煌,","發光照耀永無已;","最美事物也無可比,","惟你使我心歡喜。"]},{"label":"4.","lines":["主!是你愛先來臨及,","流血拯救你仇敵;","你之愛我,永不止息,","我心豈可不愛你?"]},{"label":"5.","lines":["保守我心忠誠向你,","使我同你藏神裏,","在世一切所經所歷,","讓你榮耀留足迹。"]}]}