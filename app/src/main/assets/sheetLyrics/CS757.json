{"hymn":"CS757","parent":"E1247","quality":"exact","adjust":{"hold":0,"merge":0},"title":"緊緊跟隨救主耶穌","subtitle":"教會的生活","syl":{"n1":"緊","n2":"緊","n3":"跟","n4":"隨","n5":"救","n6":"主","n7":"耶","n8":"穌,","n9":"靈","n10":"中","n11":"生","n12":"活","n13":"不","n14":"遲","n15":"誤;","n16":"作","n17":"得","n18":"勝","n19":"者,","n20":"聽","n21":"主","n22":"招","n23":"呼,","n24":"心","n25":"靠","n26":"恩","n27":"典","n28":"得","n29":"堅","n30":"固。","n31":"跟","n32":"隨","n33":"耶","n34":"穌,","n35":"作","n36":"得","n37":"勝","n38":"者,","n39":"靈","n40":"中","n41":"行","n42":"事","n43":"不","n44":"憑","n45":"己;","n46":"跟","n47":"隨","n48":"耶","n49":"穌,","n50":"每","n51":"時","n52":"每","n53":"刻─","n54":"主,","n55":"領","n56":"我","n57":"們","n58":"跟","n59":"隨","n60":"你。"},"verses":[{"label":"2.","lines":["緊緊跟隨主內弟兄,","同心合意齊建造;","互作肢體,生命流通,","聯絡、結合精而牢。","跟隨弟兄,同心建造,","不再單獨來事奉;","跟隨弟兄,彼此相調,","守住等次盡功用。"]},{"label":"3.","lines":["緊緊跟隨地方召會,","為主恢復全奉獻;","取得全地歸主支配,","國度應許必實現。","跟隨召會,獻上所有,","同心為著主恢復;","跟隨召會,投身水流,","直到帶進主國度。"]},{"label":"4.","lines":["主的聖言歡喜聆聽,","必使我們得加力;","惟主、召會、弟兄是從,","羊羣腳蹤不偏離。","跟隨耶穌、召會、弟兄,","跟隨聖靈的水流;","“阿們”主話,永不力窮,","神旨必定得成就。"]}]}