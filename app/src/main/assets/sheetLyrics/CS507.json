{"hymn":"CS507","parent":"E1251","quality":"adapted","adjust":{"hold":0,"merge":1},"title":"聚集在耶路撒冷","subtitle":"聚集在耶路撒冷","syl":{"n1":"聚","n2":"集","n3":"在","n4":"耶","n5":"路","n6":"撒","n7":"冷，","n8":"完","n9":"全","n10":"脫","n11":"離","n12":"巴","n13":"比","n14":"倫，","n15":"我","n16":"們","n17":"作","n18":"合","n19":"一","n20":"見","n21":"證，","n22":"哦，","n23":"願","n24":"榮","n25":"耀","n26":"歸‿給","n27":"神！","n28":"摒","n29":"棄","n30":"各","n31":"樣","n32":"的","n33":"教","n34":"訓，","n35":"放","n36":"下","n37":"一","n38":"切","n39":"的","n40":"異","n41":"議，","n42":"竭","n43":"力","n44":"保","n45":"守","n46":"靈","n47":"合","n48":"一，","n49":"在","n50":"眾","n51":"地","n52":"方","n53":"召","n54":"會","n55":"裡。","n56":"阿","n57":"利","n58":"路","n59":"亞！","n60":"阿","n61":"利","n62":"路","n63":"亞！","n64":"我","n65":"們","n66":"都","n67":"同","n68":"心","n69":"合","n70":"意，","n71":"建","n72":"造","n73":"基","n74":"督","n75":"的","n76":"身","n77":"體。","n78":"阿","n79":"利","n80":"路","n81":"亞！","n82":"阿","n83":"利","n84":"路","n85":"亞！","n86":"我","n87":"們","n88":"如","n89":"今","n90":"活","n91":"在","n92":"地","n93":"方","n94":"召","n95":"會","n96":"裡。"},"verses":[{"label":"2.","lines":["為使恢復能繼續，","祭司體系乃所需，","惟此纔蒙神稱許，","哦，願榮耀歸給神！","祭司神前過生活，","完全被主浸透過，","如此建造神居所，","在眾地方召會裡。"]},{"label":"3.","lines":["我們眼睛須開啟，","看見君王的治理，","神聖權柄得建立，","哦，願榮耀歸給神！","為使召會得益處，","先決條件要守住─","完全向聖靈順服，","在眾地方召會裡。"]},{"label":"4.","lines":["我們須就近祭壇，","將一切全都奉獻，","如此事奉理當然，","哦，願榮耀歸給神！","對此我們無爭辯，","絕對擺上心甘願，","召會合一得實現，","在眾地方召會裡。"]},{"label":"5.","lines":["現今根基已立定！","哦，何等榮耀顯明！","我們都快樂高興，","哦，願榮耀歸給神！","讓我們大聲歡呼，","將聲音傳到遠處，","並將仇敵全滅除，","在眾地方召會裡。"]}]}