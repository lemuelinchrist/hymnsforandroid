{"hymn":"CS430","parent":"E434","quality":"exact","adjust":{"hold":0,"merge":0},"title":"主,你得勝,我今服矣","subtitle":"追求與長進","syl":{"n1":"主,","n2":"你","n3":"得","n4":"勝,","n5":"我","n6":"今","n7":"服","n8":"矣;","n10":"恩","n11":"典","n12":"迫","n13":"使","n14":"我","n15":"心","n16":"決","n18":"意,","n20":"奉","n22":"獻","n24":"一","n26":"切","n27":"於","n28":"你;","n29":"你","n30":"的","n31":"可","n33":"畏","n34":"我","n36":"能","n38":"久","n40":"抗,","n41":"但","n42":"你","n43":"大","n45":"愛","n46":"有","n48":"誰","n50":"能","n52":"擋?","n54":"愛","n55":"大,","n56":"我","n58":"無","n59":"能","n60":"力。"},"verses":[{"label":"2.","lines":["即使你命萬鈞雷霆,","轟擊我魂向我施刑,","我仍固執不悔;","但你憐憫征服我心,","當我見主流血情景,","我今恨惡我罪!"]},{"label":"3.","lines":["主,我羨慕只屬於你;","速來釋放我這容器,","完全歸你佔有;","撒但暴政我既得脫,","就願全人向你而活,","服事你到永久。"]}]}