{"hymn":"ZS535","parent":"E1229","quality":"exact","adjust":{"hold":0,"merge":0},"title":"基督圣心深爱慕","subtitle":"教会的异象","syl":{"n1":"基","n2":"督","n3":"圣","n4":"心","n5":"深","n6":"爱","n7":"慕,","n8":"无","n9":"他,","n10":"惟","n11":"有","n12":"召","n13":"会;","n14":"言","n15":"语、","n16":"计","n17":"划","n18":"并","n19":"行","n20":"动,","n21":"皆","n22":"以","n23":"她","n24":"为","n25":"依","n26":"归。","n27":"此","n28":"情","n29":"此","n30":"意","n31":"永","n32":"坚","n33":"定,","n34":"无","n35":"何","n36":"能","n37":"以","n38":"摇","n39":"撼;","n40":"召","n41":"会","n42":"萦","n43":"绕","n44":"祂","n45":"心","n46":"头,","n47":"远","n48":"在","n49":"创","n50":"世","n51":"之","n52":"前。"},"verses":[{"label":"2.","lines":["万有尚都未开始,","祂已筹划全备,","要得祂心所钟爱,","与祂喜悦匹配。","万物受造虽奇妙,","并非祂所专注;","深藏祂心难追测,","乃一荣耀新妇。"]},{"label":"3.","lines":["赢得佳偶相与共,","是祂所最心许;","美哉,此情永不移,","此意始终不渝。","人虽被罪深诱害,","无助、无望、无倚;","祂心所望从未弃,","恋慕之情依依。"]},{"label":"4.","lines":["祂爱何广难估量,","借祂怜悯临及;","亲自施恩来找寻,","深哉,智慧无匹。","倾注爱情得她心,","此爱惟神尽知;","倾倒祂命作祭物,","馨香上扬不止。"]},{"label":"5.","lines":["今在复活荣耀里,","与她亲近无距,","祂的笑脸时显露,","情深,难以言喻。","日近一日,祂新妇","单单将祂注视,","浸沐新郎荣耀中,","等条被提之时。"]}]}