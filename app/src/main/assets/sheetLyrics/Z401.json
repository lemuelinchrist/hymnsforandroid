{"hymn":"Z401","parent":"E540","quality":"exact","adjust":{"hold":0,"merge":0},"title":"我今得著何等自由","subtitle":"经历基督－作释放者","syl":{"n1":"我","n2":"今","n3":"得","n4":"着","n5":"何","n6":"等","n7":"自","n8":"由，","n9":"基","n10":"督","n11":"已","n12":"经","n13":"释","n14":"放","n15":"我！","n16":"罪","n17":"的","n18":"权","n19":"势、","n20":"死","n21":"的","n22":"毒","n23":"钩，","n24":"从","n25":"我","n26":"身","n27":"上","n28":"全","n29":"脱","n30":"落！","n31":"基","n32":"督","n33":"使","n34":"我","n35":"得","n36":"胜","n37":"有","n38":"余，","n39":"仗","n40":"祂","n41":"十","n42":"架","n43":"我","n44":"夸","n45":"胜！","n46":"生","n47":"命","n48":"大","n49":"能、","n50":"圣","n51":"灵","n52":"的","n53":"律，","n54":"使","n55":"我","n56":"刚","n57":"强","n58":"而","n59":"有","n60":"能！"},"verses":[{"label":"2.","lines":["基督使我脱离律法，","永远向着律法死；","完全活在恩典之下，","不受律法的挟制。"]},{"label":"3.","lines":["基督已经定罪了罪，","除掉罪恶的权势；","罪在我身再无地位，","我从罪里得开释。"]},{"label":"4.","lines":["基督已经将死废去，","显出不坏的生命；","胜过死亡顽强禁拘，","彰显复活的大能。"]},{"label":"5.","lines":["基督已经毁坏撒但，","审判世界和邪灵；","使我脱离黑暗、死权，","进入光明与生命。"]},{"label":"6.","lines":["基督赐我够用恩典，","用祂能力覆庇我；","在我软弱显得完全，","使我喜欢夸软弱。"]}]}