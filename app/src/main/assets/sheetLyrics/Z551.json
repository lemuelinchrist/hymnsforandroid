{"hymn":"Z551","parent":"E763","quality":"exact","adjust":{"hold":0,"merge":0},"title":"主是祷告的阿拉法","subtitle":"祷告－意义","syl":{"n1":"主","n2":"是","n3":"祷","n4":"告","n6":"的","n7":"阿","n8":"拉","n9":"法，","n10":"祂","n11":"灵","n12":"教","n13":"自","n14":"我","n15":"灵；","n16":"我","n17":"们","n18":"不","n19":"知","n21":"如","n22":"何","n23":"祷","n24":"告，","n25":"除","n26":"非","n27":"祂","n28":"在","n30":"带","n31":"领。"},"verses":[{"label":"2.","lines":["主是祷告的俄梅嘎，","神的最大『阿们，』","在我祷告停息之时，","发出同感声音。"]},{"label":"3.","lines":["但在首尾两端之间，","祂让我们接联，","用那不清似吃话语，","译出祂所欲言。"]},{"label":"4.","lines":["哦主，你这首先、末后，","使我所有祷告","与你心愿完全结合，","说出你之所要。"]},{"label":"5.","lines":["我们不能道出之祈，","全有你作其始；","我们简短不清之祷，","其终愿你也是！"]}]}