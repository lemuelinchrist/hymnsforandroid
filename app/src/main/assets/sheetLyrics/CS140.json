{"hymn":"CS140","parent":"E1123","quality":"exact","adjust":{"hold":0,"merge":0},"title":"出於聖靈,由靈而生─","subtitle":"靈與生命","syl":{"n1":"出","n2":"於","n3":"聖","n5":"靈,","n6":"由","n7":"靈","n8":"而","n10":"生─","n11":"神","n12":"人","n13":"耶","n14":"穌","n15":"何","n17":"神","n18":"聖;","n19":"充","n20":"滿","n21":"那","n23":"靈,","n24":"全","n25":"是","n26":"那","n28":"靈─","n29":"祂","n30":"的","n31":"素","n33":"質","n34":"就","n35":"是","n36":"靈。","n37":"死","n38":"而","n39":"復","n40":"活,","n41":"成","n42":"為","n43":"那","n45":"靈,","n46":"如","n47":"今","n49":"主","n50":"就","n51":"是","n53":"那","n54":"靈;","n55":"是","n56":"靈","n57":"在","n59":"靈、","n60":"憑","n61":"靈","n62":"眷","n64":"臨,","n65":"我","n66":"們","n67":"與","n69":"祂","n70":"成","n71":"一","n72":"靈。"},"verses":[{"label":"2.","lines":["我們受浸歸入聖靈,","浸於靈中,飲於靈;","召會全然出於那靈,","宗教、規條盡除摒。","活在靈裏,照靈而行,","信條、儀文勿倚憑;","召會實際全在於靈,","故當操練活靈中。"]},{"label":"3.","lines":["在此所享神聖交通,","乃是那靈的交通;","我們所顧惟有那靈,","此外無何可依從。","那靈今已加強七倍,","神聖經綸來完成;","眾召會中,那靈發聲,","凡有耳者當聆聽。"]},{"label":"4.","lines":["來罷!那靈、新婦呼召:","“生命活水可白喝!”","召會那靈發聲如一─","終極、完滿的聯合。","今日務要實際操練,","“照靈而行”為原則;","眾召會中惟有那靈,","是主恢復的獨特。"]}]}