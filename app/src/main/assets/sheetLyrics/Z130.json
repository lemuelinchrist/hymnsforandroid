{"hymn":"Z130","parent":"E152","quality":"exact","adjust":{"hold":0,"merge":0},"title":"哦主，祢爱何等深广","subtitle":"赞美主－祂的爱","syl":{"n1":"哦","n2":"主，","n5":"祢","n6":"爱","n7":"何","n8":"等","n11":"深","n13":"广！","n14":"过","n15":"于","n18":"我","n20":"所","n21":"能","n23":"测","n24":"度！","n25":"祢","n26":"爱","n29":"深","n30":"广，","n31":"远","n32":"超","n35":"海","n37":"洋！","n38":"这","n39":"爱","n42":"竟","n44":"然","n45":"临","n47":"及","n48":"我！","n49":"祢","n50":"爱","n53":"叫","n54":"祢","n55":"舍","n56":"了","n59":"自","n60":"己，","n61":"为","n62":"要","n65":"叫","n66":"我","n67":"得","n68":"着","n71":"祢，","n72":"祢","n73":"爱","n76":"叫","n77":"祢","n78":"与","n79":"我","n82":"合","n84":"一，","n85":"叫","n86":"我","n89":"成","n91":"为","n92":"祢","n94":"肢","n95":"体。"},"verses":[{"label":"2.","lines":["祢爱所给、所作太多！","过于我所能述说！","最大乃是与我联合，","并且与我相调和。","祢爱叫祢成为我的，","作我一切的供应；","叫我享受祢的自己，","时时以祢为生命。"]},{"label":"3.","lines":["祢爱就是祢的自己-","祢那神圣的自己，","作了我的人生意义，","使我活着就是祢。","祢是我的生命、力量，","祢爱给我所经历；","我是祢的恩、爱对象，","所经、所历全是祢。"]},{"label":"4.","lines":["甚么能使祢我分离？","祢爱就必爱到底！","祢必与我永远合一，","祢爱刚强无可比！","这爱使我感激不已，","是我赞美的目的！","祢成为我，","我成为祢，","这是祢爱的至极！"]}]}