{"hymn":"Z132","parent":"C132","quality":"exact","adjust":{"hold":0,"merge":0},"title":"长似东西无终点","subtitle":"赞美主－祂的爱","syl":{"n1":"长","n2":"似","n3":"东","n4":"西","n5":"无","n6":"终","n7":"点，","n8":"阔","n9":"似","n10":"宇","n11":"宙","n12":"无","n13":"边","n14":"岸，","n15":"高","n16":"似","n17":"高","n18":"天","n19":"无","n21":"限","n22":"量，","n23":"深","n24":"似","n25":"深","n26":"海","n27":"无","n29":"底","n30":"疆，","n31":"基","n32":"督","n33":"大","n34":"爱！","n37":"大","n38":"哉，","n39":"大","n40":"哉，","n41":"大","n42":"哉，","n43":"基","n44":"督","n45":"大","n46":"爱！","n49":"长、","n50":"阔、","n51":"高、","n52":"深","n53":"不","n54":"能","n55":"度，","n56":"丰","n57":"满、","n58":"优","n59":"厚","n60":"临","n61":"及","n62":"我，","n63":"直","n64":"到","n65":"万","n66":"代！"},"verses":[{"label":"2.","lines":["长得使祂来舍身，","阔得使祂成救恩，","高得使祂将我升，","深得使祂临我生，","基督大爱！"]},{"label":"3.","lines":["长得使我得赦免，","阔得使我蒙恩典，","高得使我天上坐，","深得在我里面活，","基督大爱！"]},{"label":"4.","lines":["长、阔，并非何尺度，","高、深，也非何事物；","『长、』『阔，』","二形乃是指，","『高、』『深，』","二者也都是，","基督大爱！"]}]}