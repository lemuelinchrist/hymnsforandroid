{"hymn":"CS923","parent":"E1314","quality":"adapted","adjust":{"hold":0,"merge":2},"title":"主,你必快顯現","subtitle":"盼望與豫備","syl":{"n1":"主,","n2":"你","n3":"必","n4":"快","n5":"顯","n6":"現,","n7":"那","n8":"日","n9":"如","n10":"在","n11":"眼","n12":"前,","n13":"我","n14":"們","n15":"所","n16":"慕","n17":"惟","n19":"你“","n20":"同","n21":"在”!","n22":"我","n23":"主、","n24":"我","n25":"命、‿我","n27":"愛,","n28":"你","n29":"外","n30":"無","n31":"可","n33":"替‿代,","n34":"良","n35":"人","n36":"耶","n37":"穌,","n38":"願","n39":"你","n40":"快","n41":"來!"},"verses":[{"label":"2.","lines":["被提時刻臨近,","儆醒聽你聲音,","切盼與你榮中相見。","惟當你顯榮身,","在那婚娶之晨,","纔識你愛超絕無限。"]},{"label":"3.","lines":["時日飛逝如箭,","不久要見你面─","阿們,我主,願你快回!","只盼早日見你,","並且永遠偕你-","我們全心別無所歸。"]},{"label":"4.","lines":["是的,再過片時,","新郎不再延遲,","就要迎娶所愛新婦。","祈求終變感讚,","渴望盡成眼見,","主,你也必心滿意足。"]}]}