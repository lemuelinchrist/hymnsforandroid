{"hymn":"FR23","parent":"E132","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Dans les cieux, un homme règne","subtitle":"","syl":{"n1":"Dans","n3":"les","n4":"cieux,","n5":"un","n6":["hom","i"],"n8":["me","t"],"n9":["rè","i"],"n10":["gne,","t"],"n11":"C'est","n13":["Jé","i"],"n14":["sus","m"],"n15":["Christ,","t"],"n16":"le","n18":["Sei","i"],"n19":["gneur!","t"],"n20":["Cou","i"],"n22":["ron","m"],"n23":["né","t"],"n24":"par","n25":"Dieu","n27":"le","n28":["Pè","i"],"n29":["re,","t"],"n30":"Il","n32":["re","i"],"n33":["çoit","t"],"n34":"gloire","n35":"et","n36":["hon","i"],"n37":["neur.","t"]},"verses":[{"label":"2.","lines":["Dieu devint un jour un homme,","Jésus mourut pour Son plan.","Mais Son corps quitta la tombe,","Christ aux cieux monta vivant."]},{"label":"3.","lines":["Quand Jésus vint sur la terre,","Dieu en Lui s'est abaissé,","Élevé au ciel en gloire,","L'homme en Lui fut exalté."]},{"label":"4.","lines":["Il est Dieu uni à l'homme,","Dieu en Lui s'est incarné,","Dieu en l'homme se révèle,","L'homme en Dieu est glorifié."]},{"label":"5.","lines":["Dans le ciel, le Fils en gloire","Envoya l'Esprit de vie","Qui proclame Sa Personne","Et ce qu'Il a accompli."]},{"label":"6.","lines":["Au Fils qui est sur le trône","L'église est identifiée.","Par l'Esprit du Fils de l'homme,","Tous les saints sont édifiés."]},{"label":"7.","lines":["Dans les cieux un homme règne,","C'est Jésus-Christ, le Sauveur.","À jamais empreint de gloire,","Il est couronné Seigneur."]}]}