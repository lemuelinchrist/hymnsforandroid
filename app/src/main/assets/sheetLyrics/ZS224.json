{"hymn":"ZS224","parent":"CS224","quality":"exact","adjust":{"hold":0,"merge":0},"title":"一呼一吸我吸主","subtitle":"一呼一吸我吸主","syl":{"n1":"一","n2":"呼","n3":"一","n4":"吸","n5":"我","n6":"吸","n7":"主，","n8":"阿","n9":"们！","n10":"阿","n11":"们！","n12":"一","n13":"呼","n14":"一","n15":"吸","n16":"我","n17":"就","n18":"活，","n19":"阿","n20":"们！","n21":"阿","n22":"们！","n23":"哦，","n25":"祂","n26":"呼","n27":"出","n29":"而","n30":"我","n31":"吸","n32":"入，","n33":"祂","n34":"生","n35":"命","n36":"从","n38":"我","n39":"里","n40":"流","n41":"出，","n42":"因","n43":"为","n44":"我","n45":"已","n46":"学","n47":"会","n48":"深","n49":"深","n50":"吸","n51":"入","n52":"主。"},"verses":[{"label":"2.","lines":["约翰第三章","是指外面空气，","风在外面吹呀吹，","随意而吹。","并不知它来自何方，","并不知它吹往何处，","凡从圣灵生的，","也都是如此。"]},{"label":"3.","lines":["约翰二十章","是指里面空气，","主耶稣所呼出的","生命之气，","只要我们接受这气─","不必思虑，只要呼吸；","我们经历生命","是借着这气。"]},{"label":"4.","lines":["无论在那里都有","空气，空气！","它包围笼罩我们，","随时、随地！","白白赐给，丰富便利，","我们生活丰盛无比；","所以弟兄姊妹，","同来吸这气。"]},{"label":"5.","lines":["只要来呼喊祂名，","哦主！哦主！","祂就成我们气息，","哦主！哦主！","从最深处吸入祂名，","直到我们充满生命，","这位耶稣是","何等生命供应！"]}]}