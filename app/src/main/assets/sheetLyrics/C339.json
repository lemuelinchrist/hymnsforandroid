{"hymn":"C339","parent":"E1359","quality":"exact","adjust":{"hold":0,"merge":0},"title":"主，你得著我一生","subtitle":"奉獻－全都獻主","syl":{"n1":"主，","n2":"你","n3":"得","n4":"著","n5":"我","n6":"一","n7":"生，","n9":"使","n10":"它","n11":"歸","n12":"你","n13":"成","n14":"為","n15":"聖；","n17":"得","n18":"著","n19":"我","n20":"日","n21":"與","n22":"我","n23":"時，","n25":"歸","n26":"你","n27":"使","n28":"用","n29":"永","n30":"無","n31":"止。","n33":"為","n34":"我","n35":"荊","n36":"棘","n37":"冠","n38":"冕","n39":"你","n40":"肯","n41":"戴，","n43":"為","n44":"我","n45":"釘","n46":"死","n47":"苦","n48":"架","n49":"你","n50":"受","n51":"害；","n53":"為","n54":"你","n55":"我","n56":"願","n57":"獻","n58":"上","n59":"我","n60":"命","n61":"與","n62":"我","n63":"愛，","n64":"事","n65":"你、","n66":"愛","n67":"你","n68":"到","n69":"萬","n70":"代。"},"verses":[{"label":"2.","lines":["得著我手與我足，","勤作你工，奔你路；","得著我口與我舌，","傳揚你話，頌你德。"]},{"label":"3.","lines":["得著我金與我銀，","分文不由我留存；","得著我才與我智，","運用全照你指示。"]},{"label":"4.","lines":["得著我心與我意，","全歸於你不他依；","得著我愛與我情，","全注於你不別傾。"]},{"label":"5.","lines":["主，你得著我一切，","我願與你永聯結，","愛你、念你、事奉你，","永遠失去在你裡。"]}]}