{"hymn":"FR120","parent":"E597","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Je sais qu'Il vit, mon Rédempteur","subtitle":"","syl":{"n1":"Je","n2":"sais","n3":"qu'Il","n5":"vit,","n6":"mon","n7":["Ré","i"],"n9":["demp","m"],"n10":["teur,","t"],"n11":["Tou","i"],"n12":["jours","t"],"n14":"pour","n16":"moi","n18":"Il","n19":"prie.","n20":["L'a","i"],"n21":["mour","t"],"n22":"de","n24":"Dieu","n25":["scel","i"],"n26":["la","t"],"n27":"mon","n28":"cœur,","n29":"En","n30":"Christ,","n31":"Il","n32":["m'af","i"],"n34":["fran","m"],"n35":["chit.","t"]},"verses":[{"label":"2.","lines":["Je sais qu'Il vit, mon Rédempteur,","Il est l'Esprit de vie.","En moi vivant, toujours vainqueur,","Sa grâce est infinie !"]},{"label":"3.","lines":["Je sais qu'Il est mon grand salut,","Sans cesse Il vit en moi.","Bientôt Il vient, en Lui j'ai cru,","Tout oeil l'admirera."]},{"label":"4.","lines":["Je sais qu'Il veut ma sainteté,","Pourquoi Lui résister ?","Sa grâce en moi va opérer,","Selon Sa volonté."]},{"label":"5.","lines":["Je sais que Sa parole est vraie,","Mon cœur peut s'y fier.","Quand Il viendra, mon nom, je sais,","Demeurera gravé."]}]}