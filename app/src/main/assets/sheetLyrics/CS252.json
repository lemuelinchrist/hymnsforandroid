{"hymn":"CS252","parent":"E754","quality":"exact","adjust":{"hold":0,"merge":0},"title":"神聖應許甘甜無比","subtitle":"享受基督","syl":{"n1":"神","n2":"聖","n3":"應","n4":"許","n5":"甘","n6":"甜","n7":"無","n8":"比:","n9":"人","n10":"若","n11":"敬","n12":"畏","n13":"耶","n14":"和","n15":"華","n16":"名,","n17":"必","n18":"見","n19":"公","n20":"義","n21":"日","n22":"頭","n23":"升","n24":"起,","n25":"其","n26":"翼","n27":"能","n28":"醫","n29":"罪、","n30":"病。"},"verses":[{"label":"2.","lines":["救主滿帶醫治大能,","信祂名者祂必不棄;","痛悔之心速來投誠,","藏身醫治聖翼。"]},{"label":"3.","lines":["公義救主如日展翅;","我若糾纏罪中不離,","怎能得祂撫摸、醫治,","安歇於祂聖翼?"]},{"label":"4.","lines":["妙哉祂已毁傷蛇頭,","毒螫消解苦痛全去;","愛的胸臆我當緊投,","醫治翼下無虞。"]},{"label":"5.","lines":["醫治翼下我得安息,","滿心樂極,高歌頌稱:","公義日頭今已升起,","其翼能醫罪、病。"]}]}