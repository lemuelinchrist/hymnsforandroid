{"hymn":"C492","parent":"E565","quality":"exact","adjust":{"hold":0,"merge":0},"title":"在祂翼下","subtitle":"試煉中的安慰－主的同在","syl":{"n1":"在","n2":"祂","n3":"翼","n4":"下，","n5":"平","n6":"安","n7":"穩","n8":"妥","n9":"我","n10":"居","n11":"住，","n12":"不","n13":"管","n14":"夜","n15":"色","n16":"多","n17":"深，","n18":"且","n19":"有","n20":"風","n21":"雨；","n22":"但","n23":"我","n24":"能","n25":"信","n26":"靠，","n27":"我","n28":"知","n29":"祂","n30":"必","n31":"眷","n32":"顧，","n33":"因","n34":"祂","n35":"已","n36":"救","n37":"我，","n38":"我","n39":"是","n40":"祂","n41":"兒","n42":"女。","n43":"在","n44":"祂","n45":"翼","n46":"下，","n47":"在","n48":"祂","n49":"翼","n50":"下，","n51":"誰","n52":"能","n53":"使","n54":"我","n56":"離","n57":"祂","n58":"愛！","n61":"在","n62":"祂","n63":"翼","n64":"下，","n65":"這","n66":"是","n67":"我","n68":"的","n69":"家，","n70":"我","n71":"必","n72":"與","n73":"主","n75":"永","n76":"同","n77":"在。"},"verses":[{"label":"2.","lines":["在祂翼下，","我能躲過我憂傷，","我心滿足，","我能在此安歇，","世上並無膏油","可治我病創，","在此我得祝福，","我得慰藉。"]},{"label":"3.","lines":["在祂翼下，","何等寶貴的享受！","一生在此，","直到試煉過去；","有主保護蔭庇，","無何再添愁，","安息於主，","我是永遠無虞。"]}]}