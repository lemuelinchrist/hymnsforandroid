{"hymn":"CS541","parent":"E1296","quality":"exact","adjust":{"hold":0,"merge":0},"title":"神造萬有美好、有序","subtitle":"教會的異象","syl":{"n1":"神","n2":"造","n3":"萬","n4":"有","n5":"美","n6":"好、","n7":"有","n8":"序,","n9":"徧","n10":"佈","n11":"天、","n12":"地、","n13":"空","n14":"中;","n15":"仇","n16":"敵","n17":"竟","n18":"來","n19":"敗","n20":"壞、","n21":"佔","n22":"據,","n23":"阻","n24":"撓","n25":"神","n26":"旨","n27":"完","n28":"成。","n29":"那","n30":"權","n31":"能","n32":"者","n33":"恣","n34":"意","n35":"背","n36":"判,","n37":"先","n38":"來","n39":"將","n40":"地","n41":"篡","n42":"奪;","n43":"又","n44":"在","n45":"空","n46":"中","n47":"蓄","n48":"勢","n49":"爭","n50":"戰,","n51":"建","n52":"立","n53":"黑","n54":"暗","n55":"之","n56":"國。"},"verses":[{"label":"2.","lines":["神的心意是要在地","建立祂的國度,","好使祂能掌權治理,","顯明祂智豐足。","地雖荒廢,淵面黑暗,","神來恢復、再造,","且按祂的神聖意念,","造人與祂相肖。"]},{"label":"3.","lines":["惡者撒但又將人騙,","誘離神恩源頭;","亞伯拉罕見神顯現,","蒙召族類起首。","神領選民脫離埃及,","經過紅海、野疆,","進入迦南應許美地,","神國在此彰顯。"]},{"label":"4.","lines":["以色列民竟棄神治,","屬地君主依恃;","神國彰顯再次喪失,","直至大衞之時;","藉他神得執政道路,","神國重新恢復;","百姓終究仍是失誤,","被擄,失去國度。"]},{"label":"5.","lines":["人雖不堪,神不失敗,","親來成為肉身;","向人宣告“:應當悔改!","因為國度臨近。”","神人耶穌,完美絕佳,","為神權柄執掌;","撒但將祂釘死十架,","不過顯其愚妄。"]},{"label":"6.","lines":["妙哉,耶穌救贖成就,","復活勝過死亡,","為要使地得蒙拯救,","脫離撒但捆綁;","且成那靈進入人裏,","召會藉此建立─","生命洋溢,混亂消弭,","神旨通行於地。"]},{"label":"7.","lines":["如今召會在地顯明,","神國豐滿實際;","神聖權柄盡得通行,","使地歸神管理。","我們在此為神執政,","撒但只能逃遁;","如此召會作神見證,","國度不再藏隱。"]}]}