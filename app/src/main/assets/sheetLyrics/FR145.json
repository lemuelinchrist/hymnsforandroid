{"hymn":"FR145","parent":"E812","quality":"exact","adjust":{"hold":0,"merge":0},"title":"Je viens à Toi, Seigneur","subtitle":"","syl":{"n1":"Je","n2":"viens","n3":"à","n4":"Toi,","n5":["Sei","i"],"n6":["gneur,","t"],"n7":"J'ai","n8":"faim,","n9":"j'ai","n10":"soif","n11":"de","n12":"Toi.","n13":"Sois","n14":"mes","n15":["dé","i"],"n16":["li","m"],"n17":["ces,","t"],"n18":"mon","n19":["fes","i"],"n20":["tin,","t"],"n21":["De","i"],"n22":["viens","t"],"n24":"la","n25":"joie","n26":"en","n27":"moi."},"verses":[{"label":"2.","lines":["Te contempler, Seigneur,","C'est mon ardent désir.","Je veux de Toi me rassasier,","Me réjouir de Ta vie."]},{"label":"3.","lines":["Je veux Te voir, Seigneur,","Là, dans le lieu Très Saint,","Pour Ton visage contempler,","En Toi rester enfin."]},{"label":"4.","lines":["Dans cette communion,","Ta grâce coule en moi.","L'esprit, le cœur, de joie remplis,","Je me repose en Toi."]},{"label":"5.","lines":["Auprès de Toi Seigneur,","Mon âme veut rester,","Pour que Tu puisses par l'Esprit,","Mon être saturer."]}]}