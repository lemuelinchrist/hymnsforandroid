{"hymn":"C509","parent":"E703","quality":"exact","adjust":{"hold":0,"merge":0},"title":"你這奔向榮耀客旅","subtitle":"試煉中的安慰－主的引領","syl":{"n1":"你","n3":"這","n4":"奔","n5":"向","n6":"榮","n8":"耀","n9":"客","n10":"旅，","n11":"疲","n13":"倦","n14":"困","n15":"乏","n16":"心","n18":"迷","n19":"離；","n20":"神","n22":"已","n23":"賜","n24":"你","n25":"寶","n27":"貴","n28":"應","n29":"許：","n30":"『我","n32":"必","n33":"用","n34":"眼","n35":"引","n37":"導","n38":"你。』","n39":"『我","n41":"必","n42":"引","n43":"導，","n44":"我","n46":"必","n47":"引","n48":"導，","n49":"我","n51":"必","n52":"用","n53":"眼","n54":"引","n56":"導","n57":"你；","n58":"你","n60":"這","n61":"奔","n62":"向","n64":"榮","n65":"耀","n66":"客","n67":"旅，","n68":"我","n70":"必","n71":"用","n72":"眼","n73":"引","n75":"導","n76":"你。』"},"verses":[{"label":"2.","lines":["雖然心中常是紛亂，","情緒擾人欲昏迷，","但這應許排解萬難：","『我必用眼引導你。』"]},{"label":"3.","lines":["雖然試探幾乎得勝，","可靠親友也遠離，","但這應許發出微聲：","『我必用眼引導你。』"]},{"label":"4.","lines":["你的隱祕盼望消逝，","埋在年日墳墓裡，","讓這應許將你支持：","『我必用眼引導你。』"]},{"label":"5.","lines":["生命陰影逐漸加深，","要穿榮耀的身體，","神這應許顯為更真：","『我必用眼引導你。』"]},{"label":"6.","lines":["但願我靈以神為樂，","我心以祂為至寶，","與祂交通一無間隔，","接受祂眼的引導。"]}]}