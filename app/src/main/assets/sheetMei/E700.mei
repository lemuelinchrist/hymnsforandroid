<staff n="2"><layer n="1"><note xml:id="v118" dur="2" dots="1" pname="g" oct="3" accid.ges="s"/></layer><layer n="2"><note xml:id="v119" dur="2" dots="1" pname="e" oct="3"/></layer></staff>
