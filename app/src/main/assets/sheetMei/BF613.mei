<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
<meiHead><fileDesc><titleStmt><title type="main">Oh to see You, not just hear!</title>
</titleStmt><pubStmt><identifier type="hymn">BF613</identifier><identifier type="number"></identifier><identifier type="kind">chords</identifier><identifier type="source">Chords: songbase.life</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="2f" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Oh</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>see</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>not</syl></verse></note><note xml:id="c1_6" dur="4" pname="b" oct="4"><verse n="1"><syl>just</syl></verse></note><note xml:id="c1_7" dur="4" pname="b" oct="4"><verse n="1"><syl>hear!</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="1">B♭</harm><harm staff="1" place="above" tstamp="5">E♭</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>With</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>eyes</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c2_6" dur="4" pname="b" oct="4"><verse n="1"><syl>heart</syl></verse></note><note xml:id="c2_7" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c2_8" dur="4" pname="b" oct="4"><verse n="1"><syl>draw</syl></verse></note><note xml:id="c2_9" dur="4" pname="b" oct="4"><verse n="1"><syl>near.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">B♭</harm><harm staff="1" place="above" tstamp="6">Gm</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Remove</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>all</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl>that’s</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">bet</syl></verse></note><note xml:id="c3_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ween</syl></verse></note><note xml:id="c3_6" dur="4" pname="b" oct="4"><verse n="1"><syl>us</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">E♭</harm><harm staff="1" place="above" tstamp="5">B♭</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>That</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>may</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>see</syl></verse></note><note xml:id="c4_5" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c4_6" dur="4" pname="b" oct="4"><verse n="1"><syl>face.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">Cm</harm><harm staff="1" place="above" tstamp="6">F</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>turn</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>heart</syl></verse></note><note xml:id="c5_6" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c5_7" dur="4" pname="b" oct="4"><verse n="1"><syl>You.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">Gm</harm><harm staff="1" place="above" tstamp="5">E♭</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>believe</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Word</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c6_6" dur="4" pname="b" oct="4"><verse n="1"><syl>true:</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">B♭</harm><harm staff="1" place="above" tstamp="4">Gm</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>When</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl>heart</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>turns</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c7_6" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c7_7" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">E♭</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>veil</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>taken</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl>away.</syl></verse></note><note xml:id="c8_6" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="2">F</harm><harm staff="1" place="above" tstamp="5">B♭</harm><harm staff="1" place="above" tstamp="6">B♭7</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>There’s</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl>nothing</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl>more</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c9_1">Chorus</dir></measure>
<measure n="10" metcon="false"><staff n="1"><layer n="1"><note xml:id="c10_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Precious</syl></verse></note><note xml:id="c10_2" dur="4" pname="b" oct="4"><verse n="1"><syl>than</syl></verse></note><note xml:id="c10_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">be</syl></verse></note><note xml:id="c10_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">holding</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">E♭</harm><harm staff="1" place="above" tstamp="4">F</harm></measure>
<measure n="11" metcon="false"><staff n="1"><layer n="1"><note xml:id="c11_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c11_2" dur="4" pname="b" oct="4"><verse n="1"><syl>face</syl></verse></note><note xml:id="c11_3" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c11_4" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c11_5" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="5">B♭</harm></measure>
<measure n="12" metcon="false"><staff n="1"><layer n="1"><note xml:id="c12_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Each</syl></verse></note><note xml:id="c12_2" dur="4" pname="b" oct="4"><verse n="1"><syl>turn</syl></verse></note><note xml:id="c12_3" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c12_4" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c12_5" dur="4" pname="b" oct="4"><verse n="1"><syl>heart</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="5">A♭2</harm></measure>
<measure n="13" metcon="false"><staff n="1"><layer n="1"><note xml:id="c13_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Makes</syl></verse></note><note xml:id="c13_2" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c13_3" dur="4" pname="b" oct="4"><verse n="1"><syl>love</syl></verse></note><note xml:id="c13_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Him</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">E♭/G</harm></measure>
<measure n="14" metcon="false"><staff n="1"><layer n="1"><note xml:id="c14_1" dur="4" pname="b" oct="4"><verse n="1"><syl>All</syl></verse></note><note xml:id="c14_2" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c14_3" dur="4" pname="b" oct="4"><verse n="1"><syl>more.</syl></verse></note><note xml:id="c14_4" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="3">Fsus4</harm><harm staff="1" place="above" tstamp="4">F</harm></measure>
<measure n="15" metcon="false"><staff n="1"><layer n="1"><note xml:id="c15_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Enjoying</syl></verse></note><note xml:id="c15_2" dur="4" pname="b" oct="4"><verse n="1"><syl>His</syl></verse></note><note xml:id="c15_3" dur="4" pname="b" oct="4"><verse n="1"><syl>presence</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">E♭</harm></measure>
<measure n="16" metcon="false"><staff n="1"><layer n="1"><note xml:id="c16_1" dur="4" pname="b" oct="4"><verse n="1"><syl>With</syl></verse></note><note xml:id="c16_2" dur="4" pname="b" oct="4"><verse n="1"><syl>an</syl></verse></note><note xml:id="c16_3" dur="4" pname="b" oct="4"><verse n="1"><syl>unveiled</syl></verse></note><note xml:id="c16_4" dur="4" pname="b" oct="4"><verse n="1"><syl>face,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">F</harm></measure>
<measure n="17" metcon="false"><staff n="1"><layer n="1"><note xml:id="c17_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Living</syl></verse></note><note xml:id="c17_2" dur="4" pname="b" oct="4"><verse n="1"><syl>one</syl></verse></note><note xml:id="c17_3" dur="4" pname="b" oct="4"><verse n="1"><syl>with</syl></verse></note><note xml:id="c17_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Him.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">B♭</harm><harm staff="1" place="above" tstamp="3">F</harm><harm staff="1" place="above" tstamp="4">Gm</harm></measure>
<measure n="18" metcon="false"><staff n="1"><layer n="1"><note xml:id="c18_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Christ</syl></verse></note><note xml:id="c18_2" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c18_3" dur="4" pname="b" oct="4"><verse n="1"><syl>in</syl></verse></note><note xml:id="c18_4" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c18_5" dur="4" pname="b" oct="4"><verse n="1"><syl>spirit!</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="5">E♭</harm></measure>
<measure n="19" metcon="false"><staff n="1"><layer n="1"><note xml:id="c19_1" dur="4" pname="b" oct="4"><verse n="1"><syl>His</syl></verse></note><note xml:id="c19_2" dur="4" pname="b" oct="4"><verse n="1"><syl>face</syl></verse></note><note xml:id="c19_3" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c19_4" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c19_5" dur="4" pname="b" oct="4"><verse n="1"><syl>treasure</syl></verse></note><note xml:id="c19_6" dur="4" pname="b" oct="4"><verse n="1"><syl>within.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">Fsus4</harm><harm staff="1" place="above" tstamp="5">F</harm><harm staff="1" place="above" tstamp="6">B♭</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Just by looking unto Him</l><l>We experience a change deep within.</l><l>Beholding and reflecting,</l><l>We thus express the Lord.</l><l>Daily keeping Him in view,</l><l>With His riches we’re renewed.</l><l>Seeing God is gaining God;</l><l>By gazing we are transformed.</l></lg>
</div>
</back></music></mei>
