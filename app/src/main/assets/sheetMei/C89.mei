<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
<meiHead><fileDesc><titleStmt><title type="main">主，你的愛竟然不辭</title>
<title type="subordinate">讚美主－祂的受苦</title>
</titleStmt><pubStmt><identifier type="hymn">C89</identifier><identifier type="number">C89</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="1s" meter.count="6" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1">
<note xml:id="n1" pname="d" oct="4" dur="4">
<verse n="1"><label>1.</label><syl>主，</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">G</harm>
</measure>
<measure n="2"><staff n="1"><layer n="1">
<note xml:id="n2" pname="b" oct="4" dur="2">
<verse n="1"><syl>你</syl></verse></note>
<note xml:id="n3" pname="a" oct="4" dur="4">
<verse n="1"><syl>的</syl></verse></note>
<note xml:id="n4" pname="c" oct="5" dur="4">
<verse n="1"><syl>愛</syl></verse></note>
<note xml:id="n5" pname="b" oct="4" dur="4"/>
<note xml:id="n6" pname="a" oct="4" dur="4">
<verse n="1"><syl>竟</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="4" place="above">C</harm>
<slur startid="#n4" endid="#n5"/>
</measure>
<measure n="3"><staff n="1"><layer n="1">
<note xml:id="n7" pname="g" oct="4" dur="4">
<verse n="1"><syl>然</syl></verse></note>
<note xml:id="n8" pname="f" oct="4" dur="4"/>
<note xml:id="n9" pname="e" oct="4" dur="4">
<verse n="1"><syl>不</syl></verse></note>
<note xml:id="n10" pname="d" oct="4" dur="2">
<verse n="1"><syl>辭</syl></verse></note>
<note xml:id="n11" pname="d" oct="4" dur="4">
<verse n="1"><syl>為</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">D7</harm>
<harm staff="1" tstamp="4" place="above">G</harm>
<slur startid="#n7" endid="#n8"/>
</measure>
<measure n="4"><staff n="1"><layer n="1">
<note xml:id="n12" pname="d" oct="4" dur="2">
<verse n="1"><syl>我</syl></verse></note>
<note xml:id="n13" pname="g" oct="4" dur="4">
<verse n="1"><syl>忍</syl></verse></note>
<note xml:id="n14" pname="f" oct="4" dur="4">
<verse n="1"><syl>辱</syl></verse></note>
<note xml:id="n15" pname="g" oct="4" dur="4"/>
<note xml:id="n16" pname="e" oct="4" dur="4">
<verse n="1"><syl>受</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="4" place="above">A7</harm>
<slur startid="#n14" endid="#n15"/>
</measure>
<sb/>
<measure n="5"><staff n="1"><layer n="1">
<note xml:id="n17" pname="e" oct="4" dur="2" dots="1">
<verse n="1"><syl>死！</syl></verse></note>
<note xml:id="n18" pname="d" oct="4" dur="2"/>
<note xml:id="n19" pname="d" oct="4" dur="4">
<verse n="1"><syl>好</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">D</harm>
<harm staff="1" tstamp="4" place="above">D7</harm>
<slur startid="#n17" endid="#n18"/>
</measure>
<measure n="6"><staff n="1"><layer n="1">
<note xml:id="n20" pname="b" oct="4" dur="2">
<verse n="1"><syl>叫</syl></verse></note>
<note xml:id="n21" pname="d" oct="5" dur="4">
<verse n="1"><syl>我</syl></verse></note>
<note xml:id="n22" pname="d" oct="5" dur="4">
<verse n="1"><syl>們</syl></verse></note>
<note xml:id="n23" pname="c" oct="5" dur="4"/>
<note xml:id="n24" pname="b" oct="4" dur="4">
<verse n="1"><syl>勝</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">G</harm>
<harm staff="1" tstamp="4" place="above">G/B</harm>
<slur startid="#n22" endid="#n23"/>
</measure>
<measure n="7"><staff n="1"><layer n="1">
<note xml:id="n25" pname="a" oct="4" dur="2">
<verse n="1"><syl>過</syl></verse></note>
<note xml:id="n26" pname="c" oct="5" dur="4">
<verse n="1"><syl>罪</syl></verse></note>
<note xml:id="n27" pname="c" oct="5" dur="4">
<verse n="1"><syl>世，</syl></verse></note>
<note xml:id="n28" pname="b" oct="4" dur="4"/>
<note xml:id="n29" pname="a" oct="4" dur="4">
<verse n="1"><syl>並</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">Am</harm>
<harm staff="1" tstamp="4" place="above">D7</harm>
<slur startid="#n27" endid="#n28"/>
</measure>
<measure n="8"><staff n="1"><layer n="1">
<note xml:id="n30" pname="g" oct="4" dur="4">
<verse n="1"><syl>那</syl></verse></note>
<note xml:id="n31" pname="f" oct="4" dur="4"/>
<note xml:id="n32" pname="g" oct="4" dur="4">
<verse n="1"><syl>壯</syl></verse></note>
<note xml:id="n33" pname="b" oct="4" dur="2">
<verse n="1"><syl>士</syl></verse></note>
<note xml:id="n34" pname="a" oct="4" dur="4">
<verse n="1"><syl>權</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">Em</harm>
<harm staff="1" tstamp="4" place="above">D/F♯</harm>
<slur startid="#n30" endid="#n31"/>
</measure>
<measure n="9" right="end"><staff n="1"><layer n="1">
<note xml:id="n35" pname="g" oct="4" dur="2" dots="1">
<verse n="1"><syl>勢。</syl></verse></note>
<note xml:id="n36" pname="g" oct="4" dur="2"/>
<rest xml:id="r37" dur="4"/>
</layer></staff>
<harm staff="1" tstamp="1" place="above">G</harm>
<harm staff="1" tstamp="3" place="above">C/G</harm>
<harm staff="1" tstamp="4" place="above">G</harm>
<tie startid="#n35" endid="#n36"/>
</measure>
</section></score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>哦，你的擔何等的重！</l><l>何等難於背負！</l><l>人的罪惡、鬼的譏諷、</l><l>加上神的忿怒。</l></lg>
<lg label="3."><l>圍困你的狂怒風波，</l><l>今已永遠平靜；</l><l>因之我們得著歡樂，</l><l>你得超絕的名。</l></lg>
<lg label="4."><l>我們不久你前被提，</l><l>要唱新歌讚你；</l><l>但在這裡－你死的地，</l><l>我們要先唱起。</l></lg>
</div>
</back>
</music></mei>
