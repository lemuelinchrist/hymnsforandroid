<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
<meiHead><fileDesc><titleStmt><title type="main">Lord, I want to know You</title>
</titleStmt><pubStmt><identifier type="hymn">BF597</identifier><identifier type="number"></identifier><identifier type="kind">chords</identifier><identifier type="source">Chords: songbase.life</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="1s" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>want</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>know</syl></verse></note><note xml:id="c1_6" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="1">G</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>In</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>a</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>deep</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>subjective</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl>way,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">D/F♯</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Inwardly,</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>in</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl>spirit.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">Am</harm><harm staff="1" place="above" tstamp="3">C</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Save</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>from</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>this</syl></verse></note><note xml:id="c4_5" dur="4" pname="b" oct="4"><verse n="1"><syl>godless</syl></verse></note><note xml:id="c4_6" dur="4" pname="b" oct="4"><verse n="1"><syl>age.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">D</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Knowing</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>by</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>seeing</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Not</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>just</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>hearing</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c6_6" dur="4" pname="b" oct="4"><verse n="1"><syl>ear,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">D/F♯</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Gaining</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">re</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ceiving,</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>feeding</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">Am</harm><harm staff="1" place="above" tstamp="4">C</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>On</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>Word</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>so</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl>dear</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D</harm><harm staff="1" place="above" tstamp="5">D7</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>’Till</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">ap</syl></verse></note><note xml:id="c9_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="m">pe</syl></verse></note><note xml:id="c9_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ar,</syl></verse></note><note xml:id="c9_6" dur="4" pname="b" oct="4"><verse n="1"><syl>’till</syl></verse></note><note xml:id="c9_7" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c9_8" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">ap</syl></verse></note><note xml:id="c9_9" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">pear.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">C</harm><harm staff="1" place="above" tstamp="5">Em</harm><harm staff="1" place="above" tstamp="9">D</harm></measure>
<measure n="10" metcon="false"><staff n="1"><layer n="1"><note xml:id="c10_1" dur="4" pname="b" oct="4"><verse n="1"><syl>O</syl></verse></note><note xml:id="c10_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c10_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">ap</syl></verse></note><note xml:id="c10_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="m">pe</syl></verse></note><note xml:id="c10_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ar,</syl></verse></note><note xml:id="c10_6" dur="4" pname="b" oct="4"><verse n="1"><syl>O</syl></verse></note><note xml:id="c10_7" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c10_8" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">ap</syl></verse></note><note xml:id="c10_9" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">pear!</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">C</harm><harm staff="1" place="above" tstamp="5">Em</harm><harm staff="1" place="above" tstamp="9">D</harm></measure>
<measure n="11" metcon="false"><staff n="1"><layer n="1"><note xml:id="c11_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c11_2" dur="4" pname="b" oct="4"><verse n="1"><syl>want</syl></verse></note><note xml:id="c11_3" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c11_4" dur="4" pname="b" oct="4"><verse n="1"><syl>see</syl></verse></note><note xml:id="c11_5" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c11_1">Chorus</dir><harm staff="1" place="above" tstamp="4">C</harm><harm staff="1" place="above" tstamp="5">Em</harm></measure>
<measure n="12" metcon="false"><staff n="1"><layer n="1"><note xml:id="c12_1" dur="4" pname="b" oct="4"><verse n="1"><syl>And</syl></verse></note><note xml:id="c12_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">en</syl></verse></note><note xml:id="c12_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">joy</syl></verse></note><note xml:id="c12_4" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note><note xml:id="c12_5" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">G</harm><harm staff="1" place="above" tstamp="5">D/F♯</harm></measure>
<measure n="13" metcon="false"><staff n="1"><layer n="1"><note xml:id="c13_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Partake</syl></verse></note><note xml:id="c13_2" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c13_3" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c13_4" dur="4" pname="b" oct="4"><verse n="1"><syl>divine</syl></verse></note><note xml:id="c13_5" dur="4" pname="b" oct="4"><verse n="1"><syl>nature,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">Am</harm><harm staff="1" place="above" tstamp="5">C</harm></measure>
<measure n="14" metcon="false"><staff n="1"><layer n="1"><note xml:id="c14_1" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Every</syl></verse></note><note xml:id="c14_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="m">da</syl></verse></note><note xml:id="c14_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">y.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="3">D/F♯</harm></measure>
<measure n="15" metcon="false"><staff n="1"><layer n="1"><note xml:id="c15_1" dur="4" pname="b" oct="4"><verse n="1"><syl>So</syl></verse></note><note xml:id="c15_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">consti</syl></verse></note><note xml:id="c15_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">tute</syl></verse></note><note xml:id="c15_4" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c15_5" dur="4" pname="b" oct="4"><verse n="1"><syl>with</syl></verse></note><note xml:id="c15_6" dur="4" pname="b" oct="4"><verse n="1"><syl>Christ,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">Am</harm><harm staff="1" place="above" tstamp="6">C</harm></measure>
<measure n="16" metcon="false"><staff n="1"><layer n="1"><note xml:id="c16_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Fill</syl></verse></note><note xml:id="c16_2" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c16_3" dur="4" pname="b" oct="4"><verse n="1"><syl>with</syl></verse></note><note xml:id="c16_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Spirit,</syl></verse></note><note xml:id="c16_5" dur="4" pname="b" oct="4"><verse n="1"><syl>love,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">G</harm><harm staff="1" place="above" tstamp="5">B7</harm></measure>
<measure n="17" metcon="false"><staff n="1"><layer n="1"><note xml:id="c17_1" dur="4" pname="b" oct="4"><verse n="1"><syl>And</syl></verse></note><note xml:id="c17_2" dur="4" pname="b" oct="4"><verse n="1"><syl>light,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">Em</harm></measure>
<measure n="18" metcon="false"><staff n="1"><layer n="1"><note xml:id="c18_1" dur="4" pname="b" oct="4"><verse n="1"><syl>To</syl></verse></note><note xml:id="c18_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">ex</syl></verse></note><note xml:id="c18_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">press</syl></verse></note><note xml:id="c18_4" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c18_5" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="3">Am</harm><harm staff="1" place="above" tstamp="5">D</harm></measure>
<measure n="19" metcon="false"><staff n="1"><layer n="1"><note xml:id="c19_1" dur="4" pname="b" oct="4"><verse n="1"><syl>On</syl></verse></note><note xml:id="c19_2" dur="4" pname="b" oct="4"><verse n="1"><syl>earth</syl></verse></note><note xml:id="c19_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">tod</syl></verse></note><note xml:id="c19_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ay.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">G</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>It is God’s good pleasure,</l><l>The desire of His heart,</l><l>That we would express Him</l><l>By the life that He imparts.</l><l>You are my Creator,</l><l>You’re the sovereign One, I AM,</l><l>Triune God dispensing</l><l>Your divine life into man.</l><l>Carry out Your plan,</l><l>Carry out Your plan,</l><l>Your eternal plan,</l><l>Your eternal plan.</l></lg>
</div>
</back></music></mei>
