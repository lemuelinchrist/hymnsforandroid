<meiHead><fileDesc><titleStmt><title type="main">We rest on Thee, our Shield and our Defender (New Tune)</title>
<title type="subordinate">Spiritual Warfare—In Faith</title>
</titleStmt><pubStmt><identifier type="hymn">BF473</identifier><identifier type="number">881</identifier><identifier type="source">Hymns For Android</identifier></pubStmt></fileDesc></meiHead>
