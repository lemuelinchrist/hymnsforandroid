<measure n="25"><staff n="1"><layer n="1"><note xml:id="n45" dur="2" dots="1" pname="d" oct="4"/><note xml:id="n46" dur="4" pname="d" oct="4"><verse n="1"><syl>So</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm></measure>
<measure n="26"><staff n="1"><layer n="1"><note xml:id="n47" dur="2" pname="c" oct="5"><verse n="1"><syl>lost</syl></verse></note><note xml:id="n48" dur="4" pname="c" oct="5"><verse n="1"><syl>in</syl></verse></note><note xml:id="n49" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">C</harm></measure>
