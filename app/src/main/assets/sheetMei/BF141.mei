<measure n="30"><staff n="1"><layer n="1"><note xml:id="n57" dur="2" pname="c" oct="5"><verse n="1"><syl>Lord</syl></verse></note><note xml:id="n58" dur="4" pname="c" oct="5"><verse n="1"><syl>draw</syl></verse></note><note xml:id="n59" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">Am</harm></measure>
