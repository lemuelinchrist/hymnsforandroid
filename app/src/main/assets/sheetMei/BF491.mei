<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>mouth,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">A</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>For</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>have</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>seen</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c5_6" dur="4" pname="b" oct="4"><verse n="1"><syl>centre</syl></verse></note><note xml:id="c5_7" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c5_8" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c5_9" dur="4" pname="b" oct="4"><verse n="1"><syl>heart,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">D</harm><harm staff="1" place="above" tstamp="9">A</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>And</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>have</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl>heard</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c6_6" dur="4" pname="b" oct="4"><verse n="1"><syl>longing,</syl></verse></note><note xml:id="c6_7" dur="4" pname="b" oct="4"><verse n="1"><syl>longing</syl></verse></note><note xml:id="c6_8" dur="4" pname="b" oct="4"><verse n="1"><syl>call.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">D</harm><harm staff="1" place="above" tstamp="6">E</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Live</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl>act</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>by</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>your</syl></verse></note><note xml:id="c7_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">s</syl></verse></note><note xml:id="c7_7" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">pirit</syl></verse></note><note xml:id="c7_8" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">wonder</syl></verse></note><note xml:id="c7_9" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ful,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c7_1">4</dir><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="7">D</harm><harm staff="1" place="above" tstamp="9">A</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>By</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>Triune</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>God</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl>as</syl></verse></note><note xml:id="c8_6" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c8_7" dur="4" pname="b" oct="4"><verse n="1"><syl>wonderful</syl></verse></note><note xml:id="c8_8" dur="4" pname="b" oct="4"><verse n="1"><syl>Spirit.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">D</harm><harm staff="1" place="above" tstamp="7">E</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Only</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl>then</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl>can</syl></verse></note><note xml:id="c9_4" dur="4" pname="b" oct="4"><verse n="1"><syl>we</syl></verse></note><note xml:id="c9_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">experi</syl></verse></note><note xml:id="c9_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ence,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">A</harm><harm staff="1" place="above" tstamp="4">D</harm><harm staff="1" place="above" tstamp="6">A</harm></measure>
<measure n="10" metcon="false"><staff n="1"><layer n="1"><note xml:id="c10_1" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">En</syl></verse></note><note xml:id="c10_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">joy</syl></verse></note><note xml:id="c10_3" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c10_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Triune</syl></verse></note><note xml:id="c10_5" dur="4" pname="b" oct="4"><verse n="1"><syl>God</syl></verse></note><note xml:id="c10_6" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c10_7" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">ex</syl></verse></note><note xml:id="c10_8" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">press</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">D</harm><harm staff="1" place="above" tstamp="5">E</harm><harm staff="1" place="above" tstamp="8">E7</harm></measure>
<measure n="11" metcon="false"><staff n="1"><layer n="1"><note xml:id="c11_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Our</syl></verse></note><note xml:id="c11_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Triune</syl></verse></note><note xml:id="c11_3" dur="4" pname="b" oct="4"><verse n="1"><syl>God!</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">A</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>So we will run, rejoicing in His love,</l><l>Knowing He will come</l><l>And we’ll be fully Him;</l><l>Standing firm, joined in soul,</l><l>Thinking one thing,</l><l>Forbearing, not anxious, full of His peace—</l><l>Beyond understanding of any man.</l></lg>
<lg label="3."><l>Practice these things:</l><l>The things which you have learned,</l><l>The things which you have heard</l><l>And the things you’ve seen;</l><l>For some have learned in all and everything</l><l>To be content—this secret some have learned:</l><l>To live, magnify, gain Christ</l><l>And have the church.</l></lg>
</div>
</back></music></mei>
