<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Stretching</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>forward</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>that</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl>which</syl></verse></note><note xml:id="c2_6" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c2_7" dur="4" pname="b" oct="4"><verse n="1"><syl>before;</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D</harm><harm staff="1" place="above" tstamp="4">E</harm></measure>
