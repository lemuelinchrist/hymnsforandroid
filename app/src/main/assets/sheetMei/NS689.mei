</beam>
<note xml:id="n22" pname="b" oct="4" dur="4">
<verse n="1"><syl wordpos="i" con="d">an</syl></verse></note>
<note xml:id="n23" pname="e" oct="4" dur="4">
<verse n="1"><syl wordpos="t">ger,</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">A♭</harm>
<harm staff="1" tstamp="3" place="above">E♭/G</harm>
