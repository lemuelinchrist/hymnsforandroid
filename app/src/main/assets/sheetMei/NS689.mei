</measure>
<measure n="4"><staff n="1"><layer n="1">
<note xml:id="n11" pname="g" oct="4" dur="4" dots="1">
<verse n="1"><syl>see</syl></verse></note>
<note xml:id="n12" pname="f" oct="4" dur="8"/>
<note xml:id="n13" pname="f" oct="4" dur="2">
<verse n="1"><syl>You.</syl></verse></note>
