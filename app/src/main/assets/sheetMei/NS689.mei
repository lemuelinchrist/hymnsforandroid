</measure>
<measure n="7"><staff n="1"><layer n="1">
<note xml:id="n24" pname="c" oct="4" dur="4">
<verse n="1"><syl>Keep</syl></verse></note>
<beam>
<note xml:id="n25" pname="e" oct="4" dur="8">
<verse n="1"><syl>me</syl></verse></note>
