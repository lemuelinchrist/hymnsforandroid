<verse n="1"><syl wordpos="i" con="d">a</syl></verse></note>
<note xml:id="n16" pname="b" oct="4" dur="4">
<verse n="1"><syl wordpos="t">way</syl></verse></note>
<beam>
<note xml:id="n17" pname="g" oct="4" dur="8">
<verse n="1"><syl>my</syl></verse></note>
