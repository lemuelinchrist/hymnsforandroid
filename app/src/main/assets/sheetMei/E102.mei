<measure n="14"><staff n="1"><layer n="1">
<note xml:id="n33" pname="d" oct="5" dur="4">
<verse n="1"><syl>count</syl></verse></note>
<note xml:id="n34" pname="c" oct="5" dur="4"/>
<note xml:id="n35" pname="b" oct="4" dur="4">
