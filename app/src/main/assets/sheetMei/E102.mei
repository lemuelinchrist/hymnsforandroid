<meiHead><fileDesc><titleStmt><title type="main">We sing the praise of Him who died</title>
<title type="subordinate">Praise of the Lord—His Death</title>
</titleStmt><pubStmt><identifier type="hymn">E102</identifier><identifier type="number">102</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
