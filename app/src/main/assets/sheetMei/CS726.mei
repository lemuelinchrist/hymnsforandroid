<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
<meiHead><fileDesc><titleStmt><title type="main">召會實際是靈</title>
<title type="subordinate">教會的生活</title>
</titleStmt><pubStmt><identifier type="hymn">CS726</identifier><identifier type="number">Cs726</identifier><identifier type="source">Hymns For Android</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="4s" meter.count="4" meter.unit="4" meter.sym="common" midi.bpm="104"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1"><staff n="1"><layer n="1"><note xml:id="n0" dur="4" pname="e" oct="4"><verse n="1"><label>1.</label><syl>我</syl></verse></note><beam><note xml:id="n1" dur="8" pname="e" oct="4"><verse n="1"><syl>們</syl></verse></note><note xml:id="n2" dur="8" pname="e" oct="4"><verse n="1"><syl>同</syl></verse></note></beam><note xml:id="n3" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl>聲</syl></verse></note><note xml:id="n4" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl>阿</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">E</harm><harm staff="1" place="above" tstamp="2">E/D♯</harm><harm staff="1" place="above" tstamp="3">C♯m</harm><harm staff="1" place="above" tstamp="4">C♯m/B</harm></measure>
<measure n="2"><staff n="1"><layer n="1"><note xml:id="n5" dur="2" dots="1" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>們，</syl></verse></note><note xml:id="n6" dur="4" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>召</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">A</harm><harm staff="1" place="above" tstamp="4">B9/A</harm></measure>
<measure n="3"><staff n="1"><layer n="1"><note xml:id="n7" dur="4" pname="b" oct="4"><verse n="1"><syl>會</syl></verse></note><note xml:id="n8" dur="4" pname="e" oct="4"><verse n="1"><syl>實</syl></verse></note><note xml:id="n9" dur="4" pname="a" oct="4"><verse n="1"><syl>際</syl></verse></note><note xml:id="n10" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl>是</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G♯m7</harm><harm staff="1" place="above" tstamp="2">C♯m7</harm><harm staff="1" place="above" tstamp="3">F♯m</harm><harm staff="1" place="above" tstamp="4">A</harm></measure>
<measure n="4"><staff n="1"><layer n="1"><note xml:id="n11" dur="2" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>靈；</syl></verse></note><note xml:id="n12" dur="4" pname="f" oct="4" accid.ges="s"/><note xml:id="n13" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>不</syl></verse></note></layer></staff><tie startid="#n11" endid="#n12"/><harm staff="1" place="above" tstamp="1">Bsus2</harm><harm staff="1" place="above" tstamp="3">B</harm><harm staff="1" place="above" tstamp="4">B/A</harm></measure>
<measure n="5"><staff n="1"><layer n="1"><note xml:id="n14" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl>是</syl></verse></note><note xml:id="n15" dur="4" pname="b" oct="4"><verse n="1"><syl>儀</syl></verse></note><note xml:id="n16" dur="4" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>文、</syl></verse></note><note xml:id="n17" dur="4" pname="b" oct="4"><verse n="1"><syl>教</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">E/G♯</harm><harm staff="1" place="above" tstamp="2">E/D♯</harm><harm staff="1" place="above" tstamp="3">C♯m</harm><harm staff="1" place="above" tstamp="4">C♯m7</harm></measure>
<measure n="6"><staff n="1"><layer n="1"><note xml:id="n18" dur="4" pname="a" oct="4" accid="s"><verse n="1"><syl>訓、</syl></verse></note><beam><note xml:id="n19" dur="8" pname="g" oct="4" accid.ges="s"><verse n="1"><syl>辦</syl></verse></note><note xml:id="n20" dur="8" pname="f" oct="4" accid.ges="s"/></beam><note xml:id="n21" dur="4" pname="b" oct="4"><verse n="1"><syl>法，</syl></verse></note><note xml:id="n22" dur="4" pname="e" oct="5"><verse n="1"><syl>一</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F♯</harm><slur startid="#n19" endid="#n20"/><harm staff="1" place="above" tstamp="2">F♯/E</harm><harm staff="1" place="above" tstamp="3">B/D♯</harm><harm staff="1" place="above" tstamp="4">E</harm></measure>
<measure n="7"><staff n="1"><layer n="1"><note xml:id="n23" dur="4" pname="d" oct="5" accid.ges="s"><verse n="1"><syl>切</syl></verse></note><note xml:id="n24" dur="4" pname="e" oct="5"><verse n="1"><syl>都</syl></verse></note><note xml:id="n25" dur="4" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>在</syl></verse></note><note xml:id="n26" dur="4" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>乎</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">B/F♯</harm><harm staff="1" place="above" tstamp="2">E/G♯</harm><harm staff="1" place="above" tstamp="3">C♯m7</harm><harm staff="1" place="above" tstamp="4">F♯/A♯</harm></measure>
<measure n="8"><staff n="1"><layer n="1"><note xml:id="n27" dur="2" pname="b" oct="4"><verse n="1"><syl>靈。</syl></verse></note><note xml:id="n28" dur="4" pname="b" oct="4"/><note xml:id="n29" dur="4" pname="b" oct="4"><verse n="1"><syl>這</syl></verse></note></layer></staff><tie startid="#n27" endid="#n28"/><harm staff="1" place="above" tstamp="1">Bsus2</harm><harm staff="1" place="above" tstamp="3">B</harm><harm staff="1" place="above" tstamp="4">B/A</harm></measure>
<measure n="9"><staff n="1"><layer n="1"><note xml:id="n30" dur="4" pname="b" oct="4"><verse n="1"><syl>靈</syl></verse></note><note xml:id="n31" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl>浸</syl></verse></note><note xml:id="n32" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>透</syl></verse></note><note xml:id="n33" dur="4" pname="e" oct="4"><verse n="1"><syl>我</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">E/G♯</harm><harm staff="1" place="above" tstamp="2">E</harm><harm staff="1" place="above" tstamp="3">F♯m7</harm><harm staff="1" place="above" tstamp="4">E/G♯</harm></measure>
<measure n="10"><staff n="1"><layer n="1"><note xml:id="n34" dur="2" dots="1" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>們，</syl></verse></note><note xml:id="n35" dur="4" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>何</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">A</harm><harm staff="1" place="above" tstamp="4">C♯m/G♯</harm></measure>
<measure n="11"><staff n="1"><layer n="1"><note xml:id="n36" dur="4" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>等</syl></verse></note><note xml:id="n37" dur="4" pname="a" oct="4" accid="s"><verse n="1"><syl>輕</syl></verse></note><note xml:id="n38" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl>省</syl></verse></note><note xml:id="n39" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>便</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F♯</harm><harm staff="1" place="above" tstamp="3">E/G♯</harm><harm staff="1" place="above" tstamp="4">F♯/A♯</harm></measure>
<measure n="12"><staff n="1"><layer n="1"><note xml:id="n40" dur="2" dots="1" pname="d" oct="5" accid.ges="s"><verse n="1"><syl>利！</syl></verse></note><note xml:id="n41" dur="4" pname="d" oct="5" accid.ges="s"><verse n="1"><syl>純</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">B</harm><harm staff="1" place="above" tstamp="4">B/A</harm></measure>
<measure n="13"><staff n="1"><layer n="1"><note xml:id="n42" dur="4" dots="1" pname="e" oct="5"><verse n="1"><syl>潔</syl></verse></note><note xml:id="n43" dur="8" pname="d" oct="5" accid.ges="s"><verse n="1"><syl>自</syl></verse></note><note xml:id="n44" dur="4" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>己，</syl></verse></note><note xml:id="n45" dur="4" pname="b" oct="4"><verse n="1"><syl>脫</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">E/G♯</harm><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="4">E/G♯</harm></measure>
<measure n="14"><staff n="1"><layer n="1"><note xml:id="n46" dur="4" pname="a" oct="4"><verse n="1"><syl>舊</syl></verse></note><note xml:id="n47" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>更</syl></verse></note><note xml:id="n48" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl>新，</syl></verse></note><note xml:id="n49" dur="4" pname="b" oct="4"><verse n="1"><syl>成</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F♯m7</harm><harm staff="1" place="above" tstamp="2">B</harm><harm staff="1" place="above" tstamp="3">E</harm><harm staff="1" place="above" tstamp="4">E/G♯</harm></measure>
<measure n="15"><staff n="1"><layer n="1"><note xml:id="n50" dur="4" pname="a" oct="4"><verse n="1"><syl>為</syl></verse></note><note xml:id="n51" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl>神</syl></verse></note><note xml:id="n52" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>要</syl></verse></note><note xml:id="n53" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>的</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F♯m7</harm><harm staff="1" place="above" tstamp="2">AMaj7</harm><harm staff="1" place="above" tstamp="3">Bsus2</harm><harm staff="1" place="above" tstamp="4">B</harm></measure>
<measure n="16" right="end"><staff n="1"><layer n="1"><note xml:id="n54" dur="1" pname="e" oct="4"><verse n="1"><syl>人。</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">E</harm></measure>
</section></score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>新酒裝新皮袋，</l><l>一切老舊消除；</l><l>衝破自己所有束縛，</l><l>聖靈就有出路！</l><l>弟兄姊妹，釋放！</l><l>召會就必剛強！</l><l>我們的靈如火挑旺，</l><l>召會常青發旺。</l></lg>
</div>
</back>
</music></mei>
