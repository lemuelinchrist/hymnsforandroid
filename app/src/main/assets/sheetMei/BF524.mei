<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Alone</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>with</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Y</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ou,</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c1_6" dur="4" pname="b" oct="4"><verse n="1"><syl>taste</syl></verse></note><note xml:id="c1_7" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c1_8" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c1_9" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">l</syl></verse></note><note xml:id="c1_10" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ove,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="1">D</harm><harm staff="1" place="above" tstamp="4">A</harm><harm staff="1" place="above" tstamp="5">D</harm><harm staff="1" place="above" tstamp="10">A</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>And</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>bring</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">m</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">e</syl></verse></note><note xml:id="c2_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">t</syl></verse></note><note xml:id="c2_7" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">o</syl></verse></note><note xml:id="c2_8" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c2_9" dur="4" pname="b" oct="4"><verse n="1"><syl>heavens</syl></verse></note><note xml:id="c2_10" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">ab</syl></verse></note><note xml:id="c2_11" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ove.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D</harm><harm staff="1" place="above" tstamp="5">A</harm><harm staff="1" place="above" tstamp="7">Bm</harm><harm staff="1" place="above" tstamp="11">A</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>In</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">p</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">resence</syl></verse></note><note xml:id="c3_5" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c3_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">s</syl></verse></note><note xml:id="c3_7" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">oul</syl></verse></note><note xml:id="c3_8" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">del</syl></verse></note><note xml:id="c3_9" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ights.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="4">D</harm><harm staff="1" place="above" tstamp="5">Bm</harm><harm staff="1" place="above" tstamp="7">A</harm><harm staff="1" place="above" tstamp="9">G</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Oh,</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl>let</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">s</syl></verse></note><note xml:id="c4_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">tay</syl></verse></note><note xml:id="c4_6" dur="4" pname="b" oct="4"><verse n="1"><syl>here</syl></verse></note><note xml:id="c4_7" dur="4" pname="b" oct="4"><verse n="1"><syl>in</syl></verse></note><note xml:id="c4_8" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Y</syl></verse></note><note xml:id="c4_9" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ou,</syl></verse></note><note xml:id="c4_10" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">L</syl></verse></note><note xml:id="c4_11" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ord!</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="5">D</harm><harm staff="1" place="above" tstamp="9">A</harm><harm staff="1" place="above" tstamp="11">G</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>As I remain, Your intimate words</l><l>Impart to me Your concern for the church;</l><l>Your desires become my own.</l><l>My will and thoughts now match Yours,</l><l>Lord.</l></lg>
<lg label="3."><l>Then prayer bursts forth, I intercede</l><l>For all of those whose needs You see.</l><l>Grant them Your abundant grace!</l><l>Gain them and turn them to You, Lord!</l></lg>
<lg label="4."><l>Our High Priest brings our prayers to offer,</l><l>Burns incense on the golden altar;</l><l>Smoke ascends before the throne.</l><l>You act; God’s will’s done on earth, Lord.</l></lg>
</div>
</back></music></mei>
