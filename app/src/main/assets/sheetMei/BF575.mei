<music><body><mdiv><score>
<scoreDef key.sig="1s" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>This</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>common</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>faith</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>mine,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="1">G</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I’m</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>gonna</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>let</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>it</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl>shine</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="5">G7</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Bible</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl>God-breathed,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">C</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Second</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Tim</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">othy.</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>(3:16)</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">G</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>God</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>one</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>three,</syl></verse></note></layer></staff></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Triune</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>God</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">H</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">e!</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">B7</harm><harm staff="1" place="above" tstamp="5">Em</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>We</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">bel</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ieve,</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>we</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">bel</syl></verse></note><note xml:id="c7_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ieve,</syl></verse></note><note xml:id="c7_7" dur="4" pname="b" oct="4"><verse n="1"><syl>we</syl></verse></note><note xml:id="c7_8" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">bel</syl></verse></note><note xml:id="c7_9" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ieve!</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">Am7</harm><harm staff="1" place="above" tstamp="6">D</harm><harm staff="1" place="above" tstamp="9">G</harm><harm staff="1" place="above" tstamp="9">C</harm><harm staff="1" place="above" tstamp="9">G</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>He became a man,</l><l>Jesus is His name!</l><l>Christ died on the cross,</l><l>For all of our sins.</l><l>According to the Word,</l><l>The tomb couldn’t keep Him in;</l><l>He arose, He arose, He arose!</l></lg>
<lg label="3."><l>He was lifted up,</l><l>Now He’s on the throne.</l><l>Repent and believe,</l><l>Then you shall receive.</l><l>The Lord is coming back,</l><l>Coming back for us.</l><l>We believe, we believe, common faith!</l></lg>
</div>
</back></music></mei>
