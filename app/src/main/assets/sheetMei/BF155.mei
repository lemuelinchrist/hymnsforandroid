<measure n="31"><staff n="1"><layer n="1"><note xml:id="n96" dur="2" dots="1" pname="e" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="n97" dur="2" pname="e" oct="4"/><note xml:id="n98" dur="4" pname="d" oct="4"><verse n="1"><syl>the</syl></verse></note></layer></staff><tie startid="#n96" endid="#n97"/><harm staff="1" place="above" tstamp="1">A7</harm></measure>
