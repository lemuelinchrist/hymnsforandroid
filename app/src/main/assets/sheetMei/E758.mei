<layer n="2"><note xml:id="v319" dur="8" dots="1" pname="c" oct="4"/><note xml:id="v320" dur="16" pname="e" oct="3"/><note xml:id="v321" dur="8" dots="1" pname="c" oct="4"/><note xml:id="v322" dur="16" pname="b" oct="3"/><note xml:id="v323" dur="4" pname="g" oct="3"/><rest xml:id="v324" dur="4"/></layer></staff>
<staff n="2"><layer n="1"><note xml:id="v325" dur="8" dots="1" pname="g" oct="3"/><note xml:id="v326" dur="16" pname="e" oct="3"/><note xml:id="v327" dur="8" dots="1" pname="g" oct="3"/><note xml:id="v328" dur="16" pname="f" oct="3"/><note xml:id="v329" dur="4" pname="e" oct="3"/><rest xml:id="v330" dur="4"/></layer><layer n="2"><note xml:id="v331" dur="8" dots="1" pname="g" oct="3"/><note xml:id="v332" dur="16" pname="g" oct="2"/><note xml:id="v333" dur="8" dots="1" pname="g" oct="2"/><note xml:id="v334" dur="16" pname="g" oct="2"/><note xml:id="v335" dur="4" pname="c" oct="3"/><rest xml:id="v336" dur="4"/></layer></staff>
<harm type="medium-auto" staff="1" tstamp="1" place="above">C/G</harm>
<harm type="medium-auto" staff="1" tstamp="2.75" place="above">G7</harm>
<harm type="medium-auto" staff="1" tstamp="3" place="above">C</harm>
<harm staff="1" tstamp="1" place="above">C/G</harm>
<harm staff="1" tstamp="3" place="above">C</harm>
</measure>
</section></score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Consecrate your life to Jesus,</l><l>Spirit, soul, and body too;</l><l>For “the Lord is for the body,”</l><l>Every pow’r He gave to you.</l><l>Let there be no reservation,</l><l>Give the Lord full right of way;</l><l>He will come and heal His temple,</l><l>For He is the same today.</l></lg>
<lg label="3."><l>Do you doubt God’s will to heal you?</l><l>Take His word and ask for light;</l><l>If you seek in deep contrition,</l><l>He will guide your heart aright.</l><l>Do not fear to claim His promise,</l><l>He will not your trust betray;</l><l>When on earth He gladly healed them,</l><l>And He is the same today.</l></lg>
<lg label="4."><l>Oh! I’m glad to tell you, suff’rer,</l><l>Christ has more than healing too;</l><l>Life abundant overflowing,</l><l>He will gladly give to you.</l><l>Step out boldly, claim His fulness,</l><l>Let your sadness flee away;</l><l>When on earth He made them joyful,</l><l>And He is the same today.</l></lg>
</div>
</back>
</music></mei>
