<verse n="1"><syl>從</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">A♭</harm>
</measure>
<measure n="6"><staff n="1"><layer n="1">
<note xml:id="n10" pname="a" oct="4" dur="4">
<verse n="1"><syl>天</syl></verse></note>
<note xml:id="n11" pname="g" oct="4" dur="4">
<verse n="1"><syl>降</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">A♭7/C</harm>
</measure>
<measure n="7"><staff n="1"><layer n="1">
<note xml:id="n12" pname="f" oct="4" dur="4">
<verse n="1"><syl>下；</syl></verse></note>
<note xml:id="n13" pname="f" oct="4" dur="4">
<verse n="1"><syl>來</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">D♭</harm>
<harm staff="1" tstamp="2" place="above">D♭/A♭</harm>
<fermata startid="#n12" place="above"/>
</measure>
<sb/>
<measure n="8"><staff n="1"><layer n="1">
<note xml:id="n14" pname="f" oct="4" dur="4">
<verse n="1"><syl>作</syl></verse></note>
