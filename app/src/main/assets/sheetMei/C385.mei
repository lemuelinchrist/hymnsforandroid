</measure>
<scoreDef meter.count="3" meter.unit="4"/>
<measure n="11"><staff n="1"><layer n="1">
<note xml:id="n20" pname="f" oct="4" dur="4">
<verse n="1"><syl>我</syl></verse></note>
<note xml:id="n21" pname="a" oct="4" dur="4"/>
<note xml:id="n22" pname="f" oct="4" dur="4">
<verse n="1"><syl>得</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">D♭/A♭</harm>
<slur startid="#n20" endid="#n21"/>
</measure>
<measure n="12"><staff n="1"><layer n="1">
<note xml:id="n23" pname="e" oct="4" dur="4">
<verse n="1"><syl>著</syl></verse></note>
<note xml:id="n24" pname="g" oct="4" dur="4"/>
<note xml:id="n25" pname="e" oct="4" dur="4">
<verse n="1"><syl>飽</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">A♭7</harm>
<slur startid="#n23" endid="#n24"/>
</measure>
<measure n="13"><staff n="1"><layer n="1">
<note xml:id="n26" pname="e" oct="4" dur="2" dots="1">
<verse n="1"><syl>足。</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">G♭/D♭</harm>
<slur startid="#n26" endid="#n27"/>
