<harm staff="1" tstamp="1" place="above">D♭7/F</harm>
</measure>
<measure n="10"><staff n="1"><layer n="1">
<note xml:id="n18" pname="b" oct="4" dur="4">
<verse n="1"><syl>物，</syl></verse></note>
<note xml:id="n19" pname="g" oct="4" dur="4">
<verse n="1"><syl>使</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">G♭</harm>
<harm staff="1" tstamp="2" place="above">E♭m</harm>
