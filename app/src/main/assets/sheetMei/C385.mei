</layer></staff>
<harm staff="1" tstamp="1" place="above">D♭</harm>
</measure>
<measure n="9"><staff n="1"><layer n="1">
<note xml:id="n16" pname="g" oct="4" dur="4">
<verse n="1"><syl>的</syl></verse></note>
