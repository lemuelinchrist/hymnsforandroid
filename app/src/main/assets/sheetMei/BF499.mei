<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
<meiHead><fileDesc><titleStmt><title type="main">Blanket me dear Lord</title>
</titleStmt><pubStmt><identifier type="hymn">BF499</identifier><identifier type="number"></identifier><identifier type="kind">chords</identifier><identifier type="source">Chords: songbase.life</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="0" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Blanket</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>dear</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="1">C</harm><harm staff="1" place="above" tstamp="4">G</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>With</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="1">Dm</harm><harm staff="1" place="above" tstamp="3">F</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>heavenly</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>peace.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">C</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Love</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">tender</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ly,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">G</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Oh,</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="3">Dm</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Win</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">absolute</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ly.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">F</harm><harm staff="1" place="above" tstamp="4">C</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>’Cause</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl>can’t</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>love</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c7_1">Chorus</dir><harm staff="1" place="above" tstamp="1">Em</harm><harm staff="1" place="above" tstamp="4">Am</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Unless</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>You’re</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>real</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl>me.</syl></verse></note><note xml:id="c8_6" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="1">F</harm><harm staff="1" place="above" tstamp="3">G</harm><harm staff="1" place="above" tstamp="6">G7</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Touch my conscience daily,</l><l>Till I fall on my knees.</l><l>Keep me eating Your living bread,</l><l>Your Word enlightens my ways.</l><l> </l><l> ’Cause eating is the only way,</l><l> For me to grow, eating every day.</l></lg>
<lg label="3."><l>Tend my heart for rocks and thorns.</l><l>Crush the rocks,</l><l>And pull out the thorns.</l><l>Cause me to see You always,</l><l>Just look away,</l><l>Into Your face.</l><l> </l><l> ’Cause when I touch You soaring One,</l><l> You lift me up to soar in You.</l></lg>
<lg label="4."><l>You are my dear lover,</l><l>No one nears Your beauty.</l><l>And when my heart is loving You,</l><l>I am completely at rest.</l><l>Completely at rest.</l></lg>
</div>
</back></music></mei>
