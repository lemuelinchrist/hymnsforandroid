<meiHead><fileDesc><titleStmt><title type="main">Jesus, Thou alone art worthy</title>
<title type="subordinate">Praise of the Lord—His Worthiness</title>
</titleStmt><pubStmt><identifier type="hymn">E182</identifier><identifier type="number">182</identifier></pubStmt></fileDesc></meiHead>
