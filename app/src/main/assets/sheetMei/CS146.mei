<rest xml:id="r38" dur="4"/>
</layer></staff>
<harm staff="1" tstamp="1" place="above">F</harm>
<harm staff="1" tstamp="2" place="above">B♭/F</harm>
<harm staff="1" tstamp="4" place="above">F</harm>
