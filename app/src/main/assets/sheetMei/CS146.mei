<note xml:id="n30" pname="d" oct="4" dur="4">
<verse n="1"><syl>我</syl></verse></note>
<beam>
<note xml:id="n31" pname="b" oct="4" dur="8">
<verse n="1"><syl>重</syl></verse></note>
<note xml:id="n32" pname="b" oct="4" dur="8">
<verse n="1"><syl>生</syl></verse></note>
