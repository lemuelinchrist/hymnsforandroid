<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
<meiHead><fileDesc><titleStmt><title type="main">For You are my God, You alone are my joy</title>
</titleStmt><pubStmt><identifier type="hymn">BF502</identifier><identifier type="number"></identifier><identifier type="kind">chords</identifier><identifier type="source">Chords: songbase.life</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="1s" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>For</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>are</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>God,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">Chorus</dir><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="5">Em</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">a</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">lone</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>are</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c2_6" dur="4" pname="b" oct="4"><verse n="1"><syl>joy.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">C</harm><harm staff="1" place="above" tstamp="6">D</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>My</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>heart</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl>rests</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl>in</syl></verse></note><note xml:id="c3_5" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="5">Am</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl>want</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>nothing</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>but</syl></verse></note><note xml:id="c4_5" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c4_6" dur="4" pname="b" oct="4"><verse n="1"><syl>touch</syl></verse></note><note xml:id="c4_7" dur="4" pname="b" oct="4"><verse n="1"><syl>You.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">C</harm><harm staff="1" place="above" tstamp="4">D</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>You’re</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>best</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>love,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="4">Em</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>blend</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>our</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>hearts</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl>into</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl>one.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">C</harm><harm staff="1" place="above" tstamp="5">D</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">a</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">lone</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>do</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c7_6" dur="4" pname="b" oct="4"><verse n="1"><syl>choose,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">G</harm><harm staff="1" place="above" tstamp="6">Em</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>want</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>nothing</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>else</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl>but</syl></verse></note><note xml:id="c8_6" dur="4" pname="b" oct="4"><verse n="1"><syl>You.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">C</harm><harm staff="1" place="above" tstamp="4">D</harm><harm staff="1" place="above" tstamp="6">G</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Captured</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl>by</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c9_4" dur="4" pname="b" oct="4"><verse n="1"><syl>precious</syl></verse></note><note xml:id="c9_5" dur="4" pname="b" oct="4"><verse n="1"><syl>love,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c9_1">1</dir><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="4">Am</harm></measure>
<measure n="10" metcon="false"><staff n="1"><layer n="1"><note xml:id="c10_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I’m</syl></verse></note><note xml:id="c10_2" dur="4" pname="b" oct="4"><verse n="1"><syl>drawn</syl></verse></note><note xml:id="c10_3" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c10_4" dur="4" pname="b" oct="4"><verse n="1"><syl>follow</syl></verse></note><note xml:id="c10_5" dur="4" pname="b" oct="4"><verse n="1"><syl>You.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">Em</harm><harm staff="1" place="above" tstamp="5">D</harm></measure>
<measure n="11" metcon="false"><staff n="1"><layer n="1"><note xml:id="c11_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Call</syl></verse></note><note xml:id="c11_2" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c11_3" dur="4" pname="b" oct="4"><verse n="1"><syl>outward,</syl></verse></note><note xml:id="c11_4" dur="4" pname="b" oct="4"><verse n="1"><syl>call</syl></verse></note><note xml:id="c11_5" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c11_6" dur="4" pname="b" oct="4"><verse n="1"><syl>onward,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">Em</harm><harm staff="1" place="above" tstamp="4">Bm</harm></measure>
<measure n="12" metcon="false"><staff n="1"><layer n="1"><note xml:id="c12_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Till</syl></verse></note><note xml:id="c12_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I’m</syl></verse></note><note xml:id="c12_3" dur="4" pname="b" oct="4"><verse n="1"><syl>wholly</syl></verse></note><note xml:id="c12_4" dur="4" pname="b" oct="4"><verse n="1"><syl>lost</syl></verse></note><note xml:id="c12_5" dur="4" pname="b" oct="4"><verse n="1"><syl>in</syl></verse></note><note xml:id="c12_6" dur="4" pname="b" oct="4"><verse n="1"><syl>You.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">C</harm><harm staff="1" place="above" tstamp="4">D</harm><harm staff="1" place="above" tstamp="6">G</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>As I touch this living person,</l><l>My heart’s filled with joy,</l><l>For all You are is my portion,</l><l>My inheritance to enjoy.</l></lg>
<lg label="3."><l>Make me one who loves You, Lord,</l><l>To the uttermost.</l><l>Prepare my heart for Your return;</l><l>Match my heart’s desire to Yours.</l></lg>
</div>
</back></music></mei>
