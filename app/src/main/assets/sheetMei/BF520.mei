<meiHead><fileDesc><titleStmt><title type="main">Defend Me, O Lord</title>
</titleStmt><pubStmt><identifier type="hymn">BF520</identifier><identifier type="number"></identifier><identifier type="source">Hymns For Android</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="2s" meter.count="4" meter.unit="4" meter.sym="common" midi.bpm="103"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="n0" dur="4" pname="a" oct="3"><verse n="1"><syl wordpos="i" con="d">De</syl></verse></note><note xml:id="n1" dur="8" pname="a" oct="3"><verse n="1"><syl wordpos="t">fend</syl></verse></note><note xml:id="n2" dur="4" pname="d" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="n3" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>O</syl></verse></note></layer></staff></measure>
<measure n="2"><staff n="1"><layer n="1"><note xml:id="n4" dur="2" dots="1" pname="a" oct="4"><verse n="1"><syl>Lord</syl></verse></note><beam><note xml:id="n5" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>As</syl></verse></note><note xml:id="n6" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>the</syl></verse></note></beam></layer></staff><harm staff="1" place="above" tstamp="1">D</harm></measure>
<measure n="3"><staff n="1"><layer n="1"><note xml:id="n7" dur="4" dots="1" pname="g" oct="4"><verse n="1"><syl wordpos="i" con="d">shel</syl></verse></note><note xml:id="n8" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl wordpos="t">ter</syl></verse></note><note xml:id="n9" dur="4" pname="e" oct="4"><verse n="1"><syl>from</syl></verse></note><beam><note xml:id="n10" dur="8" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="n11" dur="8" pname="a" oct="4"><verse n="1"><syl>storm</syl></verse></note></beam></layer></staff><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="3">A</harm><tie startid="#n11" endid="#n12"/></measure>
<measure n="4"><staff n="1"><layer n="1"><note xml:id="n12" dur="2" dots="1" pname="a" oct="4"/><note xml:id="n13" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>I</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D</harm></measure>
<measure n="5"><staff n="1"><layer n="1"><note xml:id="n14" dur="4" dots="1" pname="g" oct="4"><verse n="1"><syl>ask</syl></verse></note><note xml:id="n15" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>for</syl></verse></note><note xml:id="n16" dur="4" pname="e" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="n17" dur="4" pname="c" oct="5" accid.ges="s"><verse n="1"><syl>to</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="3">A7</harm></measure>
<measure n="6"><staff n="1"><layer n="1"><note xml:id="n18" dur="4" dots="1" pname="a" oct="4"><verse n="1"><syl>fill</syl></verse></note><note xml:id="n19" dur="8" pname="g" oct="4"/><note xml:id="n20" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>me</syl></verse></note><beam><note xml:id="n21" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>As</syl></verse></note><note xml:id="n22" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>the</syl></verse></note></beam></layer></staff><slur startid="#n18" endid="#n19"/><harm staff="1" place="above" tstamp="1">Bm</harm></measure>
<measure n="7"><staff n="1"><layer n="1"><note xml:id="n23" dur="2" pname="g" oct="4"><verse n="1"><syl>joy</syl></verse></note><beam><note xml:id="n23_1" dur="8" pname="g" oct="4"/><note xml:id="n24" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>of</syl></verse></note><note xml:id="n25" dur="8" pname="e" oct="4"><verse n="1"><syl>all</syl></verse></note><note xml:id="n26" dur="8" pname="d" oct="4"><verse n="1"><syl>my</syl></verse></note></beam></layer></staff><tie startid="#n23" endid="#n23_1"/><harm staff="1" place="above" tstamp="1">C</harm></measure>
<measure n="8"><staff n="1"><layer n="1"><note xml:id="n27" dur="2" dots="1" pname="e" oct="4"><verse n="1"><syl>joys</syl></verse></note><beam><note xml:id="n28" dur="8" pname="d" oct="4"><verse n="1"><syl>For</syl></verse></note><note xml:id="n29" dur="8" pname="c" oct="4" accid.ges="s"><verse n="1"><syl>the</syl></verse></note></beam></layer></staff><harm staff="1" place="above" tstamp="1">A</harm></measure>
<measure n="9"><staff n="1"><layer n="1"><note xml:id="n30" dur="2" dots="1" pname="d" oct="4"><verse n="1"><syl>joy</syl></verse></note><beam><note xml:id="n31" dur="8" pname="e" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="n32" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>the</syl></verse></note></beam></layer></staff><harm staff="1" place="above" tstamp="1">Bm</harm></measure>
<measure n="10"><staff n="1"><layer n="1"><note xml:id="n33" dur="4" pname="g" oct="4"><verse n="1"><syl>Lord</syl></verse></note><note xml:id="n34" dur="4" pname="f" oct="4" accid.ges="s"/><note xml:id="n35" dur="4" dots="1" pname="e" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="n36" dur="8" pname="d" oct="4"><verse n="1"><syl>my</syl></verse></note></layer></staff><slur startid="#n33" endid="#n34"/><harm staff="1" place="above" tstamp="1">Em</harm><harm staff="1" place="above" tstamp="3">A</harm></measure>
<measure n="11" right="end"><staff n="1"><layer n="1"><note xml:id="n37" dur="1" pname="d" oct="4"><verse n="1"><syl>strength</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>I love You, Beloved.</l><l>I lay my future at Your feet,</l><l>To go wherever You may go.</l><l>I place my trust and rest my heart</l><l>Upon the rock of my salvation.</l></lg>
<lg label="3."><l>What joy I found</l><l>To lose myself in You,</l><l>I long to linger here in</l><l>The sweetness of Your grace,</l><l>Safe in the shadow of Your wings.</l></lg>
</div>
</back></music></mei>
