<meiHead><fileDesc><titleStmt><title type="main">Lie still, and let Him mould thee</title>
<title type="subordinate">Consecration—Yielding to the Lord</title>
</titleStmt><pubStmt><identifier type="hymn">E450</identifier><identifier type="number">450</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
