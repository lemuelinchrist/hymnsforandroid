<measure n="15"><staff n="1"><layer n="1">
<note xml:id="n40" pname="g" oct="4" dur="2">
<verse n="1"><syl>hand</syl></verse></note>
<note xml:id="n41" pname="f" oct="4" dur="2"/>
<note xml:id="n42" pname="e" oct="4" dur="2">
<verse n="1"><syl>I’m</syl></verse></note>
