<section>
<measure n="1"><staff n="1"><layer n="1"><note xml:id="n0" dur="4" pname="e" oct="4"><verse n="1"><syl>Crown</syl></verse></note><beam><note xml:id="n1" dur="8" pname="e" oct="4"><verse n="1"><syl>Him</syl></verse></note><note xml:id="n2" dur="8" pname="e" oct="4"><verse n="1"><syl>with</syl></verse></note></beam><note xml:id="n3" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl wordpos="i" con="d">man</syl></verse></note><note xml:id="n4" dur="4" pname="g" oct="4" accid.ges="s"><verse n="1"><syl wordpos="t">y</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">E</harm><harm staff="1" place="above" tstamp="2">E/D♯</harm><harm staff="1" place="above" tstamp="3">C♯m</harm><harm staff="1" place="above" tstamp="4">C♯m/B</harm></measure>
