<meiHead><fileDesc><titleStmt><title type="main">Crown Him with many crowns</title>
<title type="subordinate">Praise of the Lord—His Glory</title>
</titleStmt><pubStmt><identifier type="hymn">E142</identifier><identifier type="number">142</identifier><identifier type="source">Hymns For Android</identifier></pubStmt></fileDesc></meiHead>
