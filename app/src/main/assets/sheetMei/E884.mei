<staff n="2"><layer n="1"><note xml:id="v382" dur="4" pname="a" oct="3" accid.ges="f"/><note xml:id="v383" dur="8" pname="f" oct="3"/><rest xml:id="v384" dur="8"/><note xml:id="v385" dur="4" dots="1" pname="e" oct="3" accid.ges="f" tie="i"/><note xml:id="v386" dur="16" pname="e" oct="3" accid.ges="f" tie="t"/><rest xml:id="v387" dur="16"/></layer><layer n="2"><note xml:id="v388" dur="4" pname="a" oct="2" accid.ges="f"/><note xml:id="v389" dur="8" pname="f" oct="3"/><rest xml:id="v390" dur="8"/><note xml:id="v391" dur="4" dots="1" pname="a" oct="2" accid.ges="f" tie="i"/><note xml:id="v392" dur="16" pname="a" oct="2" accid.ges="f" tie="t"/><rest xml:id="v393" dur="16"/></layer></staff>
