<measure n="10"><staff n="1"><layer n="1"><note xml:id="n34" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>cheer</syl></verse></note><note xml:id="n35" dur="4" pname="e" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="n36" dur="4" pname="d" oct="4"><verse n="1"><syl>so</syl></verse></note><note xml:id="n37" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>no</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D</harm></measure>
<measure n="11"><staff n="1"><layer n="1"><note xml:id="n38" dur="4" pname="g" oct="4"><verse n="1"><syl wordpos="i" con="d">oth</syl></verse></note><note xml:id="n39" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl wordpos="t">er</syl></verse></note><note xml:id="n40" dur="4" pname="e" oct="4"><verse n="1"><syl>name</syl></verse></note><note xml:id="n41" dur="4" pname="d" oct="4"><verse n="1"><syl>as</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm></measure>
<measure n="12"><staff n="1"><layer n="1"><note xml:id="n42" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl wordpos="i" con="d">oint</syl></verse></note><note xml:id="n43" dur="4" pname="e" oct="4"><verse n="1"><syl wordpos="t">ment</syl></verse></note><note xml:id="n44" dur="4" pname="d" oct="4"><verse n="1"><syl eol="1">flows</syl></verse></note><note xml:id="n45" dur="4" pname="a" oct="3"><verse n="1"><syl>Heart’s</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D</harm></measure>
<measure n="13"><staff n="1"><layer n="1"><note xml:id="n46" dur="4" pname="b" oct="3"><verse n="1"><syl wordpos="i" con="d">deep</syl></verse></note><note xml:id="n47" dur="4" pname="c" oct="4" accid.ges="s"><verse n="1"><syl wordpos="t">est</syl></verse></note><note xml:id="n48" dur="4" pname="d" oct="4"><verse n="1"><syl>cry</syl></verse></note><note xml:id="n49" dur="4" pname="b" oct="3"><verse n="1"><syl>You</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm></measure>
<measure n="14"><staff n="1"><layer n="1"><note xml:id="n50" dur="4" pname="c" oct="4" accid.ges="s"><verse n="1"><syl wordpos="i" con="d">sat</syl></verse></note><note xml:id="n51" dur="4" pname="d" oct="4"><verse n="1"><syl wordpos="m" con="d">is</syl></verse></note><note xml:id="n52" dur="4" pname="e" oct="4"><verse n="1"><syl wordpos="t">fy</syl></verse></note><beam><note xml:id="n53" dur="8" pname="d" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="n54" dur="8" pname="c" oct="4" accid.ges="s"><verse n="1"><syl wordpos="i" con="d">pur</syl></verse></note></beam></layer></staff><harm staff="1" place="above" tstamp="1">A7</harm></measure>
<measure n="15"><staff n="1"><layer n="1"><note xml:id="n55" dur="1" pname="d" oct="4"><verse n="1"><syl eol="1" wordpos="t">sue</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D</harm></measure>
<measure n="16" right="end"><staff n="1"><layer n="1"><rest xml:id="n56" dur="2"/><rest xml:id="n57" dur="2"/></layer></staff><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="3">A7</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Here in the inner chambers, Lord, the Holiest within</l><l>With mingled spirit, I enjoy the Spirit consummate</l><l>Though I am black from Adam's sin, now I am lovely I'm in Him</l><l>For food and rest, follow the steps of the flock.</l></lg>
<lg label="3."><l>As by the Spirit I'm transformed, I'm transferred and renewed,</l><l>A self-reliant mare becomes a lily so subdued</l><l>Plaited with gold, with silver studs, necklace of jewels - the Triune God</l><l>Perfected by, Joints of supply, for your plan!</l></lg>
<lg label="4."><l>Here in the church the table's spread; the Triune God's my feast!</l><l>My spikenard's fragrance over all to Christ has been released.</l><l>Apple tree, shade and raisin cakes, banner of love and sweet embrace.</l><l>Mutual rest, and mutual peace — satisfied!</l></lg>
<lg label="5."><l>Now from my introspective self, You're calling me away</l><l>You are my resurrection pow'r, upon the cross to stay</l><l>Spring has begun, the winter's past, heaven and earth are joined at last</l><l>You're our gazelle, we're your Bethel, God and man!</l></lg>
</div>
</back></music></mei>