<meiHead><fileDesc><titleStmt><title type="main">Kissed with the kisses of Your mouth, so intimate and sweet</title>
<title type="subordinate">Experience of Christ—Loving Him</title>
</titleStmt><pubStmt><identifier type="hymn">BF154</identifier><identifier type="number">154</identifier><identifier type="source">Hymns For Android</identifier></pubStmt></fileDesc></meiHead>
