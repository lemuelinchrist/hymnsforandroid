<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>give</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">my</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">self</syl></verse></note><note xml:id="c2_6" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c2_7" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Y</syl></verse></note><note xml:id="c2_8" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ou.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">C♯m</harm><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="5">C♯m</harm><harm staff="1" place="above" tstamp="8">E</harm></measure>
