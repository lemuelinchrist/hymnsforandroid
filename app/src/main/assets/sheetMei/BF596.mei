<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Consti</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">tute</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>with</syl></verse></note><note xml:id="c4_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Y</syl></verse></note><note xml:id="c4_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ou.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G♯m</harm><harm staff="1" place="above" tstamp="2">C♯m</harm><harm staff="1" place="above" tstamp="4">A</harm><harm staff="1" place="above" tstamp="6">E</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>This</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>world</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>full</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c5_6" dur="4" pname="b" oct="4"><verse n="1"><syl>darkness,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c5_1">Chorus</dir><harm staff="1" place="above" tstamp="1">F♯m</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>But</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl>are</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c6_6" dur="4" pname="b" oct="4"><verse n="1"><syl>Light.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">C♯m</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>O</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl>prepare</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>Bride.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">A</harm><harm staff="1" place="above" tstamp="5">E</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>We</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>want</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>be</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c8_6" dur="4" pname="b" oct="4"><verse n="1"><syl>ones,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F♯m</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl>ones</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl>that</syl></verse></note><note xml:id="c9_4" dur="4" pname="b" oct="4"><verse n="1"><syl>bring</syl></verse></note><note xml:id="c9_5" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c9_6" dur="4" pname="b" oct="4"><verse n="1"><syl>back.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">C♯m</harm></measure>
<measure n="10" metcon="false"><staff n="1"><layer n="1"><note xml:id="c10_1" dur="4" pname="b" oct="4"><verse n="1"><syl>We</syl></verse></note><note xml:id="c10_2" dur="4" pname="b" oct="4"><verse n="1"><syl>long</syl></verse></note><note xml:id="c10_3" dur="4" pname="b" oct="4"><verse n="1"><syl>for</syl></verse></note><note xml:id="c10_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c10_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">return</syl></verse></note><note xml:id="c10_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">A</harm><harm staff="1" place="above" tstamp="6">E</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Lord, I just need You.</l><l>Lord, the world draws me away.</l><l>Keep me, Lord, close to You.</l><l>Only You satisfy.</l></lg>
<lg label="3."><l>Lord, give me the strength</l><l>To choose You again each day.</l><l>I give You my whole life,</l><l>Trusting Your plan, not mine.</l></lg>
</div>
</back></music></mei>
