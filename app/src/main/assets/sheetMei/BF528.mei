<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">L</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ord</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>will</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>still</syl></verse></note><note xml:id="c5_6" dur="4" pname="b" oct="4"><verse n="1"><syl>grow</syl></verse></note><note xml:id="c5_7" dur="4" pname="b" oct="4"><verse n="1"><syl>dearer,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">F</harm><harm staff="1" place="above" tstamp="7">Am-G</harm></measure>
