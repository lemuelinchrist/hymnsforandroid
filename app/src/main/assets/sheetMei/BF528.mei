<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">c</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">loser</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c7_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">s</syl></verse></note><note xml:id="c7_7" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">weeter</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">C</harm><harm staff="1" place="above" tstamp="7">Am</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Betw</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">een</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">L</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ord</syl></verse></note><note xml:id="c8_6" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c8_7" dur="4" pname="b" oct="4"><verse n="1"><syl>me.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">C</harm><harm staff="1" place="above" tstamp="5">G</harm><harm staff="1" place="above" tstamp="7">C</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>’Tis our dear Lord we wait for,</l><l>Our Hope! Our Joy! Our Friend!</l><l>Himself we long to welcome,</l><l>And just beyond the bend</l><l>Hidden, perchance to meet us</l><l>Before the day is done,</l><l>The waiting will be over</l><l>And rest will have begun.</l></lg>
</div>
</back></music></mei>
