<meiHead><fileDesc><titleStmt><title type="main">Bringing the infinite God into the finite man</title>
</titleStmt><pubStmt><identifier type="hymn">BF562</identifier><identifier type="number"></identifier><identifier type="kind">chords</identifier><identifier type="source">Chords: songbase.life</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="2s" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Brin</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ging</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>infinite</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>God</syl></verse></note><note xml:id="c1_6" dur="4" pname="b" oct="4"><verse n="1"><syl>into</syl></verse></note><note xml:id="c1_7" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c1_8" dur="4" pname="b" oct="4"><verse n="1"><syl>finite</syl></verse></note><note xml:id="c1_9" dur="4" pname="b" oct="4"><verse n="1"><syl>man.</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="2">D</harm><harm staff="1" place="above" tstamp="8">A7</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Uniting</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>mingling</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl>Triune</syl></verse></note><note xml:id="c2_6" dur="4" pname="b" oct="4"><verse n="1"><syl>God</syl></verse></note></layer></staff></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>With</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">tri</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">partite</syl></verse></note><note xml:id="c3_5" dur="4" pname="b" oct="4"><verse n="1"><syl>man.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">D</harm><harm staff="1" place="above" tstamp="4">A7</harm><harm staff="1" place="above" tstamp="5">D</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Ex</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">pressing</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>in</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>His</syl></verse></note><note xml:id="c4_5" dur="4" pname="b" oct="4"><verse n="1"><syl>humanity</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">G</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">boun</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">tiful</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>God</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">D</harm><harm staff="1" place="above" tstamp="3">F♯7</harm><harm staff="1" place="above" tstamp="4">Bm</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>In</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>His</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>rich</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">attri</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">butes</syl></verse></note><note xml:id="c6_6" dur="4" pname="b" oct="4"><verse n="1"><syl>through</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">G</harm><harm staff="1" place="above" tstamp="5">A7</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>His</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">aroma</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">tic</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">vir</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">tues:</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="3">A7</harm><harm staff="1" place="above" tstamp="5">D</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Expressing the bountiful God</l><l>In His human living.</l><l>Mainly expressing God</l><l>In His rich attributes,</l><l>That is, in the unsearchable riches</l><l>Of what God is.</l><l>That is, in the unsearchable</l><l>Riches of what God is.</l></lg>
<lg label="3."><l>Through His aromatic virtues by which He</l><l>Attracted and captivated people:</l><l>Not by living His human life in the flesh,</l><l>But by living His divine life in resurrection.</l></lg>
<lg label="4."><l>Finishing His all-inclusive</l><l>Judicial redemption:</l><l>Terminating all things of the old creation.</l><l>Redeeming all the things created by God</l><l>And fallen in sin.</l><l>Creating (conceiving) the new man</l><l>With His divine element.</l></lg>
<lg label="5."><l>Releasing His divine life</l><l>From the shell of His humanity.</l><l>Laying a foundation for</l><l>His organic salvation</l><l>And setting up the procedure</l><l>To attain His ministry</l><l>In the stage of His inclusion.</l></lg>
</div>
</back></music></mei>
