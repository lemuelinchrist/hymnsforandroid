<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
<meiHead><fileDesc><titleStmt><title type="main">Lord, I don’t want to love the world</title>
</titleStmt><pubStmt><identifier type="hymn">BF595</identifier><identifier type="number"></identifier><identifier type="kind">chords</identifier><identifier type="source">Chords: songbase.life</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="5f" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>don’t</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>want</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="2">D♭</harm><harm staff="1" place="above" tstamp="4">A♭</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>To</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>love</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>world,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">B♭m7</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Yet</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>still</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl>fail.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">G♭</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>And</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>don’t</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>want</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">D♭</harm><harm staff="1" place="above" tstamp="4">A♭</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>To</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>be</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>a</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>part</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">B♭m7</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Of</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>this</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>fallen</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl>age.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">G♭</harm><harm staff="1" place="above" tstamp="4">D♭</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>So</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>draw</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>You.</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c7_1">Chorus</dir><harm staff="1" place="above" tstamp="2">A♭</harm><harm staff="1" place="above" tstamp="5">G♭M7</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>beauty</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>sets</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl>free</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">D♭</harm><harm staff="1" place="above" tstamp="3">A♭</harm><harm staff="1" place="above" tstamp="5">B♭m7</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>To</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl>run</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl>after</syl></verse></note><note xml:id="c9_4" dur="4" pname="b" oct="4"><verse n="1"><syl>You.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">A♭</harm><harm staff="1" place="above" tstamp="4">G♭M7</harm></measure>
<measure n="10" metcon="false"><staff n="1"><layer n="1"><note xml:id="c10_1" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Re</syl></verse></note><note xml:id="c10_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">veal</syl></verse></note><note xml:id="c10_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Your</syl></verse></note><note xml:id="c10_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">self</syl></verse></note><note xml:id="c10_5" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c10_6" dur="4" pname="b" oct="4"><verse n="1"><syl>me.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">D♭</harm><harm staff="1" place="above" tstamp="4">A♭</harm><harm staff="1" place="above" tstamp="6">B♭m7</harm></measure>
<measure n="11" metcon="false"><staff n="1"><layer n="1"><note xml:id="c11_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c11_2" dur="4" pname="b" oct="4"><verse n="1"><syl>give</syl></verse></note><note xml:id="c11_3" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c11_4" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c11_5" dur="4" pname="b" oct="4"><verse n="1"><syl>heart</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">A♭</harm><harm staff="1" place="above" tstamp="5">G♭M7</harm></measure>
<measure n="12" metcon="false"><staff n="1"><layer n="1"><note xml:id="c12_1" dur="4" pname="b" oct="4"><verse n="1"><syl>’Cause</syl></verse></note><note xml:id="c12_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c12_3" dur="4" pname="b" oct="4"><verse n="1"><syl>You’re</syl></verse></note><note xml:id="c12_4" dur="4" pname="b" oct="4"><verse n="1"><syl>all</syl></verse></note><note xml:id="c12_5" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c12_6" dur="4" pname="b" oct="4"><verse n="1"><syl>need.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">G♭</harm><harm staff="1" place="above" tstamp="4">A♭</harm><harm staff="1" place="above" tstamp="6">D♭</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Lord, You have been</l><l>Dispensed in me,</l><l>Yet still I sway.</l><l>So I ask You</l><l>To spread in me,</l><l>Fill me all the way.</l><l> </l><l> So draw me away,</l><l> I want to see just You.</l><l> Attract me today.</l><l> I give myself to You.</l><l> Lord, You have Your way.</l><l> So Christ in me comes through.</l></lg>
</div>
</back></music></mei>
