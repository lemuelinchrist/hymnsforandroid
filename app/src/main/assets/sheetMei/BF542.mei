<measure n="3"><staff n="1"><layer n="1"><note xml:id="n7" dur="4" pname="c" oct="5"><verse n="1"><syl wordpos="m" con="d">reach</syl></verse></note><beam><note xml:id="n8" dur="8" pname="b" oct="4"><verse n="1"><syl eol="1" wordpos="t">ing</syl></verse></note><note xml:id="n9" dur="8" pname="c" oct="5"><verse n="1"><syl>Is</syl></verse></note></beam><note xml:id="n9_1" dur="4" pname="c" oct="5"/><note xml:id="n10" dur="4" pname="e" oct="4"><verse n="1"><syl>Thy</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">C</harm><tie startid="#n9" endid="#n9_1"/></measure>
<measure n="4"><staff n="1"><layer n="1"><note xml:id="n11" dur="4" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>love,</syl></verse></note><beam><note xml:id="n12" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>dear</syl></verse></note><note xml:id="n13" dur="8" pname="g" oct="4"><verse n="1"><syl>Lord,</syl></verse></note></beam><note xml:id="n13_1" dur="4" pname="g" oct="4"/><note xml:id="n14" dur="4" pname="a" oct="4"><verse n="1"><syl>to</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D7</harm><tie startid="#n13" endid="#n13_1"/></measure>
