<measure n="8"><staff n="1"><layer n="1"><note xml:id="n23" dur="4" pname="g" oct="4"><verse n="1"><syl wordpos="t">yond</syl></verse></note><beam><note xml:id="n24" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>my</syl></verse></note><note xml:id="n25" dur="8" pname="g" oct="4"><verse n="1"><syl>pow’r</syl></verse></note></beam><note xml:id="n25_1" dur="4" pname="g" oct="4"/><note xml:id="n26" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">Em</harm><tie startid="#n25" endid="#n25_1"/></measure>
<measure n="9"><staff n="1"><layer n="1"><note xml:id="n27" dur="4" pname="c" oct="5"><verse n="1"><syl wordpos="i" con="d">fath</syl></verse></note><beam><note xml:id="n28" dur="8" pname="b" oct="4"><verse n="1"><syl eol="1" wordpos="t">om,</syl></verse></note><note xml:id="n29" dur="8" pname="c" oct="5"><verse n="1"><syl wordpos="i" con="d">Deep</syl></verse></note></beam><note xml:id="n29_1" dur="4" pname="c" oct="5"/><note xml:id="n30" dur="4" pname="e" oct="4"><verse n="1"><syl wordpos="t">er</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">C</harm><tie startid="#n29" endid="#n29_1"/></measure>
<measure n="10"><staff n="1"><layer n="1"><note xml:id="n31" dur="4" dots="1" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>than</syl></verse></note><note xml:id="n32" dur="8" pname="f" oct="4" accid.ges="s"><verse n="1"><syl>the</syl></verse></note><note xml:id="n33" dur="4" pname="g" oct="4"><verse n="1"><syl wordpos="i" con="d">deep</syl></verse></note><note xml:id="n34" dur="4" pname="a" oct="4"><verse n="1"><syl wordpos="t">est</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">D7</harm></measure>
<measure n="11"><staff n="1"><layer n="1"><note xml:id="n35" dur="2" dots="1" pname="b" oct="4"><verse n="1"><syl eol="1">sea!</syl></verse></note><note xml:id="n36" dur="4" pname="b" oct="4"/></layer></staff><tie startid="#n35" endid="#n36"/><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="4">D/F♯</harm></measure>
<measure n="12"><staff n="1"><layer n="1"><rest xml:id="n37" dur="2" dots="1"/><rest xml:id="n38" dur="4"/></layer></staff><harm staff="1" place="above" tstamp="1">Em</harm><harm staff="1" place="above" tstamp="4">D7</harm></measure>
