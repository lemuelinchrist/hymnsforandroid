<meiHead><fileDesc><titleStmt><title type="main">O how deep and how far-reaching (New Tune)</title>
<title type="subordinate">Praise of the Lord—His Love</title>
</titleStmt><pubStmt><identifier type="hymn">BF542</identifier><identifier type="number">152</identifier><identifier type="source">Hymns For Android</identifier><identifier type="hands">guitar/folk/8</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="1s" meter.count="4" meter.unit="4" meter.sym="common" midi.bpm="129"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1"><staff n="1"><layer n="1"><note xml:id="n0" dur="2" dots="1" pname="d" oct="4"><verse n="1"><syl>O</syl></verse></note><beam><note xml:id="n1" dur="8" pname="e" oct="4"><verse n="1"><syl>how</syl></verse></note><note xml:id="n2" dur="8" pname="f" oct="4" accid.ges="s"/></beam></layer></staff><harm staff="1" place="above" tstamp="1">G</harm><slur startid="#n1" endid="#n2"/></measure>
