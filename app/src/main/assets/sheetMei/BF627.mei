<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>are</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>it!</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="2">F</harm><harm staff="1" place="above" tstamp="5">E♭</harm></measure>
