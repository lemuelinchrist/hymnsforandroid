<meiHead><fileDesc><titleStmt><title type="main">Come, let us sing the song of songs</title>
<title type="subordinate">Praise of the Lord—His Worthiness</title>
</titleStmt><pubStmt><identifier type="hymn">E184</identifier><identifier type="number">184</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
