<harm staff="1" tstamp="1" place="above">D/A</harm>
<harm staff="1" tstamp="3" place="above">A7</harm>
</measure>
<measure n="16" right="end"><staff n="1"><layer n="1">
<note xml:id="n38" pname="d" oct="4" dur="1">
<verse n="1"><syl>slain!</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">D</harm>
</measure>
</section></score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Slain to redeem us by His blood,</l><l>To cleanse from every sinful stain;</l><l>And make us kings and priests to God;</l><l>Worthy the Lamb, for He was slain!</l></lg>
<lg label="3."><l>Long as we live, and should we die,</l><l>And while in light with Him we reign,</l><l>This song our song of songs shall be:</l><l>Worthy the Lamb, for He was slain!</l></lg>
</div>
</back>
</music></mei>
