<music><body><mdiv><score>
<scoreDef key.sig="2f" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I’m</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>standing</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>on</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>shore!</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="1">B♭</harm><harm staff="1" place="above" tstamp="2">E♭</harm><harm staff="1" place="above" tstamp="5">B♭</harm><harm staff="1" place="above" tstamp="5">E♭</harm><harm staff="1" place="above" tstamp="5">B♭</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Yes!</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I’ve</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>crossed</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>over!</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">E♭</harm><harm staff="1" place="above" tstamp="4">B♭</harm><harm staff="1" place="above" tstamp="4">E♭</harm><harm staff="1" place="above" tstamp="4">B♭</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I’m</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>standing</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl>on</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c3_5" dur="4" pname="b" oct="4"><verse n="1"><syl>shore!</syl></verse></note><note xml:id="c3_6" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="5">Gm</harm><harm staff="1" place="above" tstamp="6">C7</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>My</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl>world</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>over!</syl></verse></note><note xml:id="c4_5" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="4">F</harm><harm staff="1" place="above" tstamp="5">F7</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Oh,</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>yes!</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>I’ve</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>passed!</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="4">B♭</harm><harm staff="1" place="above" tstamp="5">B♭7</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Through</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>Red,</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Red</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl>Sea</syl></verse></note><note xml:id="c6_6" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="5">E♭</harm><harm staff="1" place="above" tstamp="6">E♭7</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Those</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>judging</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl>waters</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="3">Gm</harm><harm staff="1" place="above" tstamp="4">F</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>That</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>separated</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>me!</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">B♭</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>I belong to the Lord!</l><l>I’m His forever!</l><l>I’ve died to the world!</l><l>Its ties I’ve severed!</l><l>All Pharaoh’s armies</l><l>Cannot catch me!</l><l>They’re sinking to the bottom</l><l>Of the Red, Red sea!</l></lg>
</div>
</back></music></mei>
