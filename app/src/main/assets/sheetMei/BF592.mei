<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>What</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>used</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>be</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c5_6" dur="4" pname="b" oct="4"><verse n="1"><syl>parents’</syl></verse></note><note xml:id="c5_7" dur="4" pname="b" oct="4"><verse n="1"><syl>God,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">CM7</harm><harm staff="1" place="above" tstamp="6">G</harm><harm staff="1" place="above" tstamp="7">D</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>So</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>distant</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">routin</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">e,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">CM7</harm><harm staff="1" place="above" tstamp="4">G</harm><harm staff="1" place="above" tstamp="5">D</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Be</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">came</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">Am7</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Very</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>God,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">CM7</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>My</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl>life,</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c9_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">every</syl></verse></note><note xml:id="c9_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="m">thing</syl></verse></note><note xml:id="c9_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">.</syl></verse></note><note xml:id="c9_7" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="2">Am7</harm><harm staff="1" place="above" tstamp="4">D</harm><harm staff="1" place="above" tstamp="5">G</harm><harm staff="1" place="above" tstamp="6">C</harm><harm staff="1" place="above" tstamp="7">D</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>I used to walk each day alone.</l><l>How dreary was that way.</l><l>And learning, growing steadily,</l><l>This realization came:</l><l>That Jesus wants to walk with me.</l><l>And if in Him I’m found,</l><l>Through highs and lows He</l><l>Will supply.</l><l>Thus comfort does abound.</l></lg>
<lg label="3."><l>You and I were in the furnace, yes.</l><l>But my companions too.</l><l>The yearning in my heart for them</l><l>Was planted, Lord, by You.</l><l>Oh, grow in each one day by day!</l><l>Together we pursue.</l><l>Young people praying</l><l>Desp’rately</l><l>For God’s own heart and move.</l></lg>
<lg label="4."><l>And as we grow up, O Lord, we pray</l><l>That we would all know You</l><l>As One Who works behind the scenes</l><l>Yet always guides us through.</l><l>Though outwardly we’re in the dark</l><l>Your shining leads the way.</l><l>We listen to Your</l><l>Gentle voice</l><l>And press on in this race.</l></lg>
<lg label="5."><l>We praise You, Lord,</l><l>You’ve placed us here</l><l>Within Your endless flow!</l><l>You’ve sovereignly arranged our lives</l><l>For us to daily grow.</l><l>We testify with passing days</l><l>We love You more and more.</l><l>While we have breath we’ll</l><l>Always praise.</l><l>Oh, come so quickly, Lord!</l></lg>
</div>
</back></music></mei>
