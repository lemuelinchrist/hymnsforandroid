<music><body><mdiv><score>
<scoreDef key.sig="0" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">A</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">mazing</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">inc</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">redible,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="2">C</harm><harm staff="1" place="above" tstamp="5">F</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Triune</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>God</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl>edible!</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">C</harm><harm staff="1" place="above" tstamp="5">F</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>can</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl>eat</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Him</syl></verse></note><note xml:id="c3_5" dur="4" pname="b" oct="4"><verse n="1"><syl>in</syl></verse></note><note xml:id="c3_6" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c3_7" dur="4" pname="b" oct="4"><verse n="1"><syl>morning</syl></verse></note><note xml:id="c3_8" dur="4" pname="b" oct="4"><verse n="1"><syl>for</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">C</harm><harm staff="1" place="above" tstamp="3">F</harm><harm staff="1" place="above" tstamp="7">C</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Breakfast.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>taste</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>cannot</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>be</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>imitated,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">C</harm><harm staff="1" place="above" tstamp="5">F</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>And</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>He</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">as</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">similated</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">C</harm><harm staff="1" place="above" tstamp="5">F</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Into</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>us.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G7</harm><harm staff="1" place="above" tstamp="2">C</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Triune</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>God,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c8_1">Chorus</dir><harm staff="1" place="above" tstamp="1">F</harm><harm staff="1" place="above" tstamp="2">C</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl>can</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl>eat</syl></verse></note><note xml:id="c9_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Him</syl></verse></note><note xml:id="c9_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">every</syl></verse></note><note xml:id="c9_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">day.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F</harm><harm staff="1" place="above" tstamp="6">C</harm></measure>
<measure n="10" metcon="false"><staff n="1"><layer n="1"><note xml:id="c10_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Triune</syl></verse></note><note xml:id="c10_2" dur="4" pname="b" oct="4"><verse n="1"><syl>God,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F</harm><harm staff="1" place="above" tstamp="2">C</harm></measure>
<measure n="11" metcon="false"><staff n="1"><layer n="1"><note xml:id="c11_1" dur="4" pname="b" oct="4"><verse n="1"><syl>We’re</syl></verse></note><note xml:id="c11_2" dur="4" pname="b" oct="4"><verse n="1"><syl>gonna</syl></verse></note><note xml:id="c11_3" dur="4" pname="b" oct="4"><verse n="1"><syl>eat</syl></verse></note><note xml:id="c11_4" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F</harm></measure>
<measure n="12" metcon="false"><staff n="1"><layer n="1"><note xml:id="c12_1" dur="4" pname="b" oct="4"><verse n="1"><syl>We’re</syl></verse></note><note xml:id="c12_2" dur="4" pname="b" oct="4"><verse n="1"><syl>gonna</syl></verse></note><note xml:id="c12_3" dur="4" pname="b" oct="4"><verse n="1"><syl>eat</syl></verse></note><note xml:id="c12_4" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm></measure>
<measure n="13" metcon="false"><staff n="1"><layer n="1"><note xml:id="c13_1" dur="4" pname="b" oct="4"><verse n="1"><syl>We’re</syl></verse></note><note xml:id="c13_2" dur="4" pname="b" oct="4"><verse n="1"><syl>gonna</syl></verse></note><note xml:id="c13_3" dur="4" pname="b" oct="4"><verse n="1"><syl>eat</syl></verse></note><note xml:id="c13_4" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c13_5" dur="4" pname="b" oct="4"><verse n="1"><syl>up.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">F</harm><harm staff="1" place="above" tstamp="3">G</harm><harm staff="1" place="above" tstamp="5">C</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Amazing and incredible,</l><l>The Triune God is edible!</l><l>You can eat Him anytime throughout the day.</l><l>Chew the Word, call on His name—</l><l>Nothing tastes quite the same</l><l>As the Triune God.</l></lg>
<lg label="3."><l>Amazing and incredible,</l><l>The Triune God is edible!</l><l>You can eat Him in the morning for</l><l>Breakfast.</l><l>The taste cannot be imitated,</l><l>And He is assimilated</l><l>Right into us.</l></lg>
</div>
</back></music></mei>
