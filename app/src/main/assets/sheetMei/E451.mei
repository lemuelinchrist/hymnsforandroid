<meiHead><fileDesc><titleStmt><title type="main">Not by wrestling, but by clinging</title>
<title type="subordinate">Consecration—Yielding to the Lord</title>
</titleStmt><pubStmt><identifier type="hymn">E451</identifier><identifier type="number">451</identifier></pubStmt></fileDesc></meiHead>
