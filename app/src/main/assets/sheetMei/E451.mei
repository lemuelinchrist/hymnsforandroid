</measure>
<sb/>
<measure n="8"><staff n="1"><layer n="1">
<note xml:id="n16" pname="a" oct="4" dur="4">
<verse n="1"><syl wordpos="i" con="d">Wrest</syl></verse></note>
<note xml:id="n17" pname="b" oct="4" dur="4"/>
