<measure n="12"><staff n="1"><layer n="1">
<note xml:id="n26" pname="f" oct="4" dur="4">
<verse n="1"><syl wordpos="i" con="d">Cling</syl></verse></note>
<note xml:id="n27" pname="e" oct="4" dur="4"/>
<note xml:id="n28" pname="f" oct="4" dur="4">
<verse n="1"><syl wordpos="t">ing</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">B♭</harm>
