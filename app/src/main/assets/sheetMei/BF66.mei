<meiHead><fileDesc><titleStmt><title type="main">My song is love unknown (New Tune)</title>
<title type="subordinate">Praise of the Lord—His Suffering</title>
</titleStmt><pubStmt><identifier type="hymn">BF66</identifier><identifier type="number">96</identifier><identifier type="source">Hymns For Android</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
