</measure>
<sb/>
<measure n="5"><staff n="1"><layer n="1">
<note xml:id="n17" pname="d" oct="5" dur="4">
<verse n="1"><syl wordpos="i" con="d">sin</syl></verse></note>
<note xml:id="n18" pname="d" oct="5" dur="4">
<verse n="1"><syl wordpos="m" con="d">re</syl></verse></note>
<note xml:id="n19" pname="c" oct="5" dur="4">
<verse n="1"><syl wordpos="m" con="d">mov</syl></verse></note>
<note xml:id="n20" pname="f" oct="4" dur="4">
<verse n="1"><syl wordpos="t">ing</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">B♭m</harm>
<harm staff="1" tstamp="3" place="above">Fm</harm>
</measure>
<measure n="6"><staff n="1"><layer n="1">
<note xml:id="n21" pname="b" oct="4" dur="2">
<verse n="1"><syl>tide!</syl></verse></note>
<note xml:id="n22" pname="a" oct="4" dur="4"/>
<note xml:id="n23" pname="d" oct="4" dur="4">
<verse n="1"><syl>We’re</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">G♭</harm>
<harm staff="1" tstamp="3" place="above">D♭</harm>
<slur startid="#n21" endid="#n22"/>
</measure>
<measure n="7"><staff n="1"><layer n="1">
<note xml:id="n24" pname="g" oct="4" dur="2">
<verse n="1"><syl wordpos="i" con="d">jus</syl></verse></note>
<note xml:id="n25" pname="g" oct="4" dur="4"/>
<note xml:id="n26" pname="g" oct="4" dur="4">
<verse n="1"><syl wordpos="m" con="d">ti</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">E♭m</harm>
<harm staff="1" tstamp="3" place="above">A♭7</harm>
<tie startid="#n24" endid="#n25"/>
<fermata startid="#n25" place="above"/>
</measure>
<measure n="8" right="end"><staff n="1"><layer n="1">
<note xml:id="n27" pname="f" oct="4" dur="2" dots="1">
<verse n="1"><syl wordpos="t">fied!</syl></verse></note>
<rest xml:id="r28" dur="4"/>
