</measure>
<measure n="3"><staff n="1"><layer n="1">
<note xml:id="n9" pname="f" oct="4" dur="4">
<verse n="1"><syl>Lo!</syl></verse></note>
<beam>
<note xml:id="n10" pname="f" oct="4" dur="8">
<verse n="1"><syl>From</syl></verse></note>
<note xml:id="n11" pname="f" oct="4" dur="8">
<verse n="1"><syl>His</syl></verse></note>
</beam>
<note xml:id="n12" pname="a" oct="4" dur="4">
<verse n="1"><syl wordpos="i" con="d">pier</syl></verse></note>
<note xml:id="n13" pname="a" oct="4" dur="4">
<verse n="1"><syl wordpos="t">céd</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">D♭</harm>
<harm staff="1" tstamp="3" place="above">A♭/C</harm>
</measure>
<measure n="4"><staff n="1"><layer n="1">
<note xml:id="n14" pname="b" oct="4" dur="2">
<verse n="1"><syl>side,</syl></verse></note>
<note xml:id="n15" pname="a" oct="4" dur="4"/>
<note xml:id="n16" pname="a" oct="4" dur="4">
<verse n="1"><syl>A</syl></verse></note>
