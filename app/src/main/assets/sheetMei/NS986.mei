<meiHead><fileDesc><titleStmt><title type="main">Christ came, the Lamb of God</title>
<title type="subordinate">Praise of the Lord — His Death</title>
</titleStmt><pubStmt><identifier type="hymn">NS986</identifier><identifier type="number"></identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
