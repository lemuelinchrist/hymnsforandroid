<meiHead><fileDesc><titleStmt><title type="main">Lord I give my heart again to You</title>
</titleStmt><pubStmt><identifier type="hymn">BF508</identifier><identifier type="number"></identifier><identifier type="kind">chords</identifier><identifier type="source">Chords: songbase.life</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="2s" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>give</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>heart</syl></verse></note><note xml:id="c1_6" dur="4" pname="b" oct="4"><verse n="1"><syl>again</syl></verse></note><note xml:id="c1_7" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c1_8" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="1">D</harm><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="5">Em</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">loveli</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ness</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>has</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl>drawn</syl></verse></note><note xml:id="c2_6" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c2_7" dur="4" pname="b" oct="4"><verse n="1"><syl>back</syl></verse></note><note xml:id="c2_8" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c2_9" dur="4" pname="b" oct="4"><verse n="1"><syl>You.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="5">D</harm><harm staff="1" place="above" tstamp="9">A</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Let</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>what</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl>I’ve</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl>seen</syl></verse></note><note xml:id="c3_5" dur="4" pname="b" oct="4"><verse n="1"><syl>be</syl></verse></note><note xml:id="c3_6" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c3_7" dur="4" pname="b" oct="4"><verse n="1"><syl>reality,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">D</harm><harm staff="1" place="above" tstamp="4">A</harm><harm staff="1" place="above" tstamp="6">G</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Don’t</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl>let</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>it</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>fade</syl></verse></note><note xml:id="c4_5" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c4_6" dur="4" pname="b" oct="4"><verse n="1"><syl>nothing.</syl></verse></note><note xml:id="c4_7" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="2">Em</harm><harm staff="1" place="above" tstamp="6">D</harm><harm staff="1" place="above" tstamp="7">A</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>One</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>heart</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>with</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c5_1">Chorus</dir><harm staff="1" place="above" tstamp="2">Bm</harm><harm staff="1" place="above" tstamp="4">Em</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Laying</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>hold</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">pur</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">sue</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">A</harm><harm staff="1" place="above" tstamp="5">Bm</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Christ</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl>who’s</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>all</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c7_6" dur="4" pname="b" oct="4"><verse n="1"><syl>me.</syl></verse></note><note xml:id="c7_7" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="4">A</harm><harm staff="1" place="above" tstamp="6">D</harm><harm staff="1" place="above" tstamp="7">A</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>You’re</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>truth,</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>You’re</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl>the</syl></verse></note><note xml:id="c8_6" dur="4" pname="b" oct="4"><verse n="1"><syl>way,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">Bm</harm><harm staff="1" place="above" tstamp="6">Em</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>The</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">per</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">fecter</syl></verse></note><note xml:id="c9_4" dur="4" pname="b" oct="4"><verse n="1"><syl>of</syl></verse></note><note xml:id="c9_5" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c9_6" dur="4" pname="b" oct="4"><verse n="1"><syl>faith,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="6">Bm</harm></measure>
<measure n="10" metcon="false"><staff n="1"><layer n="1"><note xml:id="c10_1" dur="4" pname="b" oct="4"><verse n="1"><syl>My</syl></verse></note><note xml:id="c10_2" dur="4" pname="b" oct="4"><verse n="1"><syl>precious,</syl></verse></note><note xml:id="c10_3" dur="4" pname="b" oct="4"><verse n="1"><syl>precious</syl></verse></note><note xml:id="c10_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="4">D</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Lord I ask grow more in me each day,</l><l>Let your life divine within me reign.</l><l>I want to know this Christ who’s wrought in me,</l><l>The lovely One who’s worthy.</l></lg>
<lg label="3."><l>Failures come but You’re my victory,</l><l>Lord You’re the overcoming One in me.</l><l>And I believe Your faithfulness in me,</l><l>To bring me through to glory.</l></lg>
</div>
</back></music></mei>
