<beam>
<note xml:id="n47" pname="c" oct="5" dur="8" dots="1">
<verse n="1"><syl>脫</syl></verse></note>
<note xml:id="n48" pname="b" oct="4" dur="16">
<verse n="1"><syl>離</syl></verse></note>
</beam>
<note xml:id="n49" pname="a" oct="4" dur="4">
<verse n="1"><syl>『地』，</syl></verse></note>
