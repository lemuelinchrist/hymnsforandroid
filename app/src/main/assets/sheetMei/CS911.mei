<beam>
<note xml:id="n51" pname="a" oct="4" dur="8">
<verse n="1"><syl>搶</syl></verse></note>
<note xml:id="n52" pname="b" oct="4" dur="8">
<verse n="1"><syl>救</syl></verse></note>
