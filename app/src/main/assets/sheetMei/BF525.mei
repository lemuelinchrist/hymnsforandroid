<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Jehovah,</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>Savior,</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">re</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">ach</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c5_6" dur="4" pname="b" oct="4"><verse n="1"><syl>with</syl></verse></note><note xml:id="c5_7" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c5_8" dur="4" pname="b" oct="4"><verse n="1"><syl>mercy</syl></verse></note><note xml:id="c5_9" dur="4" pname="b" oct="4"><verse n="1"><syl>now</syl></verse></note><note xml:id="c5_10" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">today</syl></verse></note><note xml:id="c5_11" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">.</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c5_1">Chorus</dir><harm staff="1" place="above" tstamp="2">Em</harm><harm staff="1" place="above" tstamp="4">Am</harm><harm staff="1" place="above" tstamp="8">C</harm><harm staff="1" place="above" tstamp="11">D</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>need</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>You,</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">Je</syl></verse></note><note xml:id="c6_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">sus,</syl></verse></note><note xml:id="c6_7" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c6_8" dur="4" pname="b" oct="4"><verse n="1"><syl>save</syl></verse></note><note xml:id="c6_9" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c6_10" dur="4" pname="b" oct="4"><verse n="1"><syl>from</syl></verse></note><note xml:id="c6_11" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c6_12" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">way</syl></verse></note><note xml:id="c6_13" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">Em</harm><harm staff="1" place="above" tstamp="6">Am</harm><harm staff="1" place="above" tstamp="8">C</harm><harm staff="1" place="above" tstamp="13">D</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>are</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">faithful</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">,</syl></verse></note><note xml:id="c7_5" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c7_6" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c7_7" dur="4" pname="b" oct="4"><verse n="1"><syl>hope</syl></verse></note><note xml:id="c7_8" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c7_9" dur="4" pname="b" oct="4"><verse n="1"><syl>in</syl></verse></note><note xml:id="c7_10" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c7_11" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">G</harm><harm staff="1" place="above" tstamp="4">Em</harm><harm staff="1" place="above" tstamp="7">Am</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>will</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>deliver</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>me,</syl></verse></note><note xml:id="c8_5" dur="4" pname="b" oct="4"><verse n="1"><syl>more</syl></verse></note><note xml:id="c8_6" dur="4" pname="b" oct="4"><verse n="1"><syl>and</syl></verse></note><note xml:id="c8_7" dur="4" pname="b" oct="4"><verse n="1"><syl>more.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">D</harm><harm staff="1" place="above" tstamp="7">G</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>My heart desires You, and yet there are those times,</l><l>I realize our hearts do not align.</l><l>Your heart’s for Zion, my heart’s not fully there,</l><l>But I come forward to declare.</l><l> </l><l> O Lord, I open wide to be drawn continually,</l><l> Remove the objects of affection by degree.</l><l> Substitute them with the interest of Your heart,</l><l> A heart for Zion in me You’d impart.</l></lg>
<lg label="3."><l>O how I thank You, Your faithfulness bestowed,</l><l>Within my being, Your blessing’s been outpoured.</l><l>It’s by Your mercy I have not been consumed.</l><l>Remind me Lord, it’s all by You.</l><l> </l><l> It’s not of him who wills, nor is it of him who runs,</l><l> But it is him to whom God’s mercies daily come.</l><l> Make us faithful to be emptied when we come,</l><l> A vision we’ll receive—more of Zion.</l></lg>
</div>
</back></music></mei>
