<staff n="2"><layer n="1"><note xml:id="v420" dur="8" pname="c" oct="3"/><note xml:id="v421" dur="16" pname="a" oct="3"/><rest xml:id="v422" dur="16"/><note xml:id="v423" dur="16" pname="g" oct="2"/><note xml:id="v424" dur="16" pname="c" oct="3"/><note xml:id="v425" dur="16" pname="b" oct="3" accid.ges="f"/><rest xml:id="v426" dur="16"/><note xml:id="v427" dur="2" pname="c" oct="3"/></layer><layer n="2"><note xml:id="v428" dur="8" pname="c" oct="2"/><note xml:id="v429" dur="16" pname="a" oct="3"/><rest xml:id="v430" dur="16"/><note xml:id="v431" dur="16" pname="c" oct="2"/><note xml:id="v432" dur="16" pname="c" oct="3"/><note xml:id="v433" dur="16" pname="b" oct="3" accid.ges="f"/><rest xml:id="v434" dur="16"/><note xml:id="v435" dur="2" pname="f" oct="2"/></layer></staff>



