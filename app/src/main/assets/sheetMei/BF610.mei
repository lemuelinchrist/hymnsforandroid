<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
<meiHead><fileDesc><titleStmt><title type="main">Hear me, O Lord</title>
</titleStmt><pubStmt><identifier type="hymn">BF610</identifier><identifier type="number"></identifier><identifier type="kind">chords</identifier><identifier type="source">Chords: songbase.life</identifier></pubStmt></fileDesc></meiHead>
<music><body><mdiv><score>
<scoreDef key.sig="2s" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Hear</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>me,</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>O</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>when</syl></verse></note><note xml:id="c1_6" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c1_7" dur="4" pname="b" oct="4"><verse n="1"><syl>cry,</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="1">D</harm><harm staff="1" place="above" tstamp="5">A</harm><harm staff="1" place="above" tstamp="7">Bm</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>My</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>heart</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl>is</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl>so</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl>cold.</syl></verse></note><note xml:id="c2_6" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="5">D</harm><harm staff="1" place="above" tstamp="6">D7</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>All</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>things</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">a</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">round</syl></verse></note><note xml:id="c3_5" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c3_6" dur="4" pname="b" oct="4"><verse n="1"><syl>cloud</syl></verse></note><note xml:id="c3_7" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c3_8" dur="4" pname="b" oct="4"><verse n="1"><syl>sight,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="4">G</harm><harm staff="1" place="above" tstamp="5">A</harm><harm staff="1" place="above" tstamp="6">F♯m</harm><harm staff="1" place="above" tstamp="8">Bm</harm></measure>
<measure n="4" metcon="false"><staff n="1"><layer n="1"><note xml:id="c4_1" dur="4" pname="b" oct="4"><verse n="1"><syl>But</syl></verse></note><note xml:id="c4_2" dur="4" pname="b" oct="4"><verse n="1"><syl>then</syl></verse></note><note xml:id="c4_3" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c4_4" dur="4" pname="b" oct="4"><verse n="1"><syl>hear</syl></verse></note><note xml:id="c4_5" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c4_6" dur="4" pname="b" oct="4"><verse n="1"><syl>say:</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">Em</harm><harm staff="1" place="above" tstamp="6">A</harm></measure>
<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Come</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>away</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>from</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>where</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>you</syl></verse></note><note xml:id="c5_6" dur="4" pname="b" oct="4"><verse n="1"><syl>are,</syl></verse></note><note xml:id="c5_7" dur="4" pname="b" oct="4"/></layer></staff><dir staff="1" place="above" startid="#c5_1">Chorus</dir><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="4">A</harm><harm staff="1" place="above" tstamp="6">D</harm><harm staff="1" place="above" tstamp="7">D7</harm></measure>
<measure n="6" metcon="false"><staff n="1"><layer n="1"><note xml:id="c6_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Come</syl></verse></note><note xml:id="c6_2" dur="4" pname="b" oct="4"><verse n="1"><syl>away,</syl></verse></note><note xml:id="c6_3" dur="4" pname="b" oct="4"><verse n="1"><syl>turn</syl></verse></note><note xml:id="c6_4" dur="4" pname="b" oct="4"><verse n="1"><syl>your</syl></verse></note><note xml:id="c6_5" dur="4" pname="b" oct="4"><verse n="1"><syl>heart,</syl></verse></note><note xml:id="c6_6" dur="4" pname="b" oct="4"/></layer></staff><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="5">D</harm><harm staff="1" place="above" tstamp="6">D7</harm></measure>
<measure n="7" metcon="false"><staff n="1"><layer n="1"><note xml:id="c7_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c7_2" dur="4" pname="b" oct="4"><verse n="1"><syl>hear</syl></verse></note><note xml:id="c7_3" dur="4" pname="b" oct="4"><verse n="1"><syl>You</syl></verse></note><note xml:id="c7_4" dur="4" pname="b" oct="4"><verse n="1"><syl>say,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">G</harm><harm staff="1" place="above" tstamp="4">A</harm></measure>
<measure n="8" metcon="false"><staff n="1"><layer n="1"><note xml:id="c8_1" dur="4" pname="b" oct="4"><verse n="1"><syl>“I</syl></verse></note><note xml:id="c8_2" dur="4" pname="b" oct="4"><verse n="1"><syl>am</syl></verse></note><note xml:id="c8_3" dur="4" pname="b" oct="4"><verse n="1"><syl>your</syl></verse></note><note xml:id="c8_4" dur="4" pname="b" oct="4"><verse n="1"><syl>way,</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">F♯</harm><harm staff="1" place="above" tstamp="4">Bm</harm></measure>
<measure n="9" metcon="false"><staff n="1"><layer n="1"><note xml:id="c9_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Come</syl></verse></note><note xml:id="c9_2" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">a</syl></verse></note><note xml:id="c9_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">way</syl></verse></note><note xml:id="c9_4" dur="4" pname="b" oct="4"><verse n="1"><syl>to</syl></verse></note><note xml:id="c9_5" dur="4" pname="b" oct="4"><verse n="1"><syl>Me.”</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="3">A</harm><harm staff="1" place="above" tstamp="5">D</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>As I call upon Your name,</l><l>You wipe my tears away.</l><l>Turning to You, I begin to praise,</l><l>All sorrow fades away.</l></lg>
<lg label="3."><l>How I need to learn to stay</l><l>In Your presence, dear Lord.</l><l>Draw my heart with Your hands of love,</l><l>And call me day by day.</l></lg>
<lg label="4."><l>When I see You face to face,</l><l>Your countenance captivates.</l><l>You transfuse me, I’m filled with grace,</l><l>It’s here I long to stay.</l></lg>
</div>
</back></music></mei>
