<measure n="5" metcon="false"><staff n="1"><layer n="1"><note xml:id="c5_1" dur="4" pname="b" oct="4"><verse n="1"><syl>But</syl></verse></note><note xml:id="c5_2" dur="4" pname="b" oct="4"><verse n="1"><syl>I</syl></verse></note><note xml:id="c5_3" dur="4" pname="b" oct="4"><verse n="1"><syl>trust</syl></verse></note><note xml:id="c5_4" dur="4" pname="b" oct="4"><verse n="1"><syl>now</syl></verse></note><note xml:id="c5_5" dur="4" pname="b" oct="4"><verse n="1"><syl>in</syl></verse></note><note xml:id="c5_6" dur="4" pname="b" oct="4"><verse n="1"><syl>Your</syl></verse></note><note xml:id="c5_7" dur="4" pname="b" oct="4"><verse n="1"><syl>cleansing</syl></verse></note><note xml:id="c5_8" dur="4" pname="b" oct="4"><verse n="1"><syl>pow’r.</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">C</harm><harm staff="1" place="above" tstamp="6">D</harm><harm staff="1" place="above" tstamp="8">G</harm></measure>
</section>
</score></mdiv></body>
<back><div type="verses">
<lg label="2."><l>Wash me from more than sin,</l><l>From the dryness and deadness within.</l><l>In Your life, in Your Word,</l><l>In Your Spirit, wash me, Lord,</l><l>And restore my love for You again.</l></lg>
</div>
</back></music></mei>
