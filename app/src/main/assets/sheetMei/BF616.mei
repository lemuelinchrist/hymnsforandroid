<music><body><mdiv><score>
<scoreDef key.sig="1s" meter.count="4" meter.unit="4"><staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef>
<section>
<measure n="1" metcon="false"><staff n="1"><layer n="1"><note xml:id="c1_1" dur="4" pname="b" oct="4"><verse n="1"><syl>Wash</syl></verse></note><note xml:id="c1_2" dur="4" pname="b" oct="4"><verse n="1"><syl>me,</syl></verse></note><note xml:id="c1_3" dur="4" pname="b" oct="4"><verse n="1"><syl>Lord,</syl></verse></note><note xml:id="c1_4" dur="4" pname="b" oct="4"><verse n="1"><syl>wash</syl></verse></note><note xml:id="c1_5" dur="4" pname="b" oct="4"><verse n="1"><syl>me</syl></verse></note><note xml:id="c1_6" dur="4" pname="b" oct="4"><verse n="1"><syl>now!</syl></verse></note></layer></staff><dir staff="1" place="above" startid="#c1_1">1</dir><harm staff="1" place="above" tstamp="1">G</harm><harm staff="1" place="above" tstamp="3">C</harm><harm staff="1" place="above" tstamp="6">G</harm></measure>
<measure n="2" metcon="false"><staff n="1"><layer n="1"><note xml:id="c2_1" dur="4" pname="b" oct="4"><verse n="1"><syl>I’ve</syl></verse></note><note xml:id="c2_2" dur="4" pname="b" oct="4"><verse n="1"><syl>been</syl></verse></note><note xml:id="c2_3" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">contami</syl></verse></note><note xml:id="c2_4" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">nated</syl></verse></note><note xml:id="c2_5" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="i">some</syl></verse></note><note xml:id="c2_6" dur="4" pname="b" oct="4"><verse n="1"><syl wordpos="t">how</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="2">C</harm><harm staff="1" place="above" tstamp="4">D</harm><harm staff="1" place="above" tstamp="6">G</harm></measure>
<measure n="3" metcon="false"><staff n="1"><layer n="1"><note xml:id="c3_1" dur="4" pname="b" oct="4"><verse n="1"><syl>In</syl></verse></note><note xml:id="c3_2" dur="4" pname="b" oct="4"><verse n="1"><syl>my</syl></verse></note><note xml:id="c3_3" dur="4" pname="b" oct="4"><verse n="1"><syl>walk</syl></verse></note><note xml:id="c3_4" dur="4" pname="b" oct="4"><verse n="1"><syl>on</syl></verse></note><note xml:id="c3_5" dur="4" pname="b" oct="4"><verse n="1"><syl>this</syl></verse></note><note xml:id="c3_6" dur="4" pname="b" oct="4"><verse n="1"><syl>earth;</syl></verse></note></layer></staff><harm staff="1" place="above" tstamp="3">C</harm><harm staff="1" place="above" tstamp="6">D</harm></measure>
