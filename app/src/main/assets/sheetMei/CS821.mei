</layer></staff>
<harm staff="1" tstamp="1" place="above">Gm</harm>
</measure>
<sb/>
<measure n="5"><staff n="1"><layer n="1">
<note xml:id="n9" pname="f" oct="4" dur="2">
<verse n="1"><syl>甚</syl></verse><verse n="2"><syl>祂</syl></verse></note>
<note xml:id="n10" pname="f" oct="4" dur="4">
<verse n="1"><syl>麼</syl></verse><verse n="2"><syl>曾</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">G</harm>
</measure>
<measure n="6"><staff n="1"><layer n="1">
<note xml:id="n11" pname="f" oct="4" dur="2">
<verse n="1"><syl>使</syl></verse><verse n="2"><syl>捨</syl></verse></note>
<note xml:id="n12" pname="f" oct="4" dur="4">
<verse n="1"><syl>你</syl></verse><verse n="2"><syl>命</syl></verse></note>
</layer></staff>
