<measure n="8"><staff n="1"><layer n="1">
<note xml:id="n15" pname="g" oct="4" dur="2" dots="1">
<verse n="1"><syl>行！</syl></verse></note>
</layer></staff>
<harm staff="1" tstamp="1" place="above">C7</harm>
