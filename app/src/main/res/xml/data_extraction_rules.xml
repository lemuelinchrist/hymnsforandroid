<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup and phone-to-phone transfer (Android 12 and newer). Same rules as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="hymns.sqlite" />
        <exclude domain="database" path="hymns.sqlite-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="hymns.sqlite" />
        <exclude domain="database" path="hymns.sqlite-journal" />
    </device-transfer>
</data-extraction-rules>
