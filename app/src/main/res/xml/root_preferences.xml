<?xml version="1.0" encoding="utf-8"?>
<!--
  The default value of every setting, and nothing else: HymnsActivity loads this file with
  PreferenceManager.setDefaultValues, so the keys have the same values everywhere in the app. The Settings screen
  itself (settings/SettingsActivity, layout/settings_activity.xml) does not show this file.
-->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference app:key="FontSize" app:defaultValue="18f"
            app:entries="@array/font_size" app:entryValues="@array/font_size_values"/>
    <!-- System default, Light, Dark or Black (style/Theme); replaces the Night Mode switch (nightMode) -->
    <ListPreference app:key="theme" app:defaultValue="system"
            app:entries="@array/theme_preference" app:entryValues="@array/theme_preference_values"/>
    <SwitchPreferenceCompat app:key="keepDisplayOn" app:defaultValue="false"/>
    <!-- the hidden books; the key keeps its old name so existing settings carry over (settings/HymnBooksDialog) -->
    <MultiSelectListPreference app:key="disableLanguages" app:defaultValue="@array/disabled_languages_default"
            app:entries="@array/disabled_languages_default" app:entryValues="@array/disabled_languages_default"/>
    <SwitchPreferenceCompat app:key="youtubeSearch" app:defaultValue="false"/>
    <SwitchPreferenceCompat app:key="similarTune" app:defaultValue="false"/>
    <ListPreference app:key="sheetMusicType" app:defaultValue="pianoSvg"
            app:entries="@array/sheet_music_type_preference" app:entryValues="@array/sheet_music_type_preference_values"/>
</PreferenceScreen>
