<?xml version="1.0" encoding="utf-8"?>
<!-- The About page of Settings (AboutActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/set_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/set_bg"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/set_bg"
            android:minHeight="?attr/actionBarSize"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight" />
    </com.google.android.material.appbar.AppBarLayout>

    <com.lemuelinchrist.android.hymns.settings.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        app:maxContentWidth="640dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_icon_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hymnsForAndroid"
                    android:textColor="@color/set_on_tint"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aboutVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/set_on_tint"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_bg"
            android:divider="@drawable/settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">

            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/aboutFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_mail"
                app:rowSummary="hymnsforandroid.support@gmail.com"
                app:rowTitle="Send feedback"
                app:rowTrailing="chevron" />

            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/aboutSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_code"
                app:rowSummary="github.com/lemuelinchrist/hymnsforandroid"
                app:rowTitle="Source code"
                app:rowTrailing="chevron" />
        </LinearLayout>
    </com.lemuelinchrist.android.hymns.settings.MaxWidthLinearLayout>
</LinearLayout>