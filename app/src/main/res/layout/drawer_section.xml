<?xml version="1.0" encoding="utf-8"?>
<!-- A heading in the drawer: RECENT, ALL BOOKS (the line only above the second) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">

    <View
            android:id="@+id/drawerSectionLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@color/drawer_line"/>

    <TextView
            android:id="@+id/drawerSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:textColor="@color/drawer_muted"/>
</LinearLayout>
