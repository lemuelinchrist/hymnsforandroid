<?xml version="1.0" encoding="utf-8"?>
<!-- one row of the details card: the label muted, the value wrapping in its own column (LyricsArea sets the size) -->
<TableRow xmlns:android="http://schemas.android.com/apk/res/android"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

    <TextView
            android:id="@+id/detailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingRight="16dp"
            android:textColor="?attr/hymnTextMuted"/>

    <TextView
            android:id="@+id/detailValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/hymnText"
            android:textIsSelectable="true"/>
</TableRow>
