<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings screen (v5.9): one scrolling page of cards; every choice is made on the page (SettingsActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/set_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/set_bg"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/set_bg"
            android:minHeight="?attr/actionBarSize"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <com.lemuelinchrist.android.hymns.settings.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="28dp"
            app:maxContentWidth="640dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="Text size" />
            <TextView android:id="@+id/textSizeValue" style="@style/SettingsHeaderValue" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sizeSteps"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/settings_card_bg"
            android:orientation="horizontal"
            android:padding="6dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="Theme" />
            <TextView android:id="@+id/themeValue" style="@style/SettingsHeaderValue" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/themeTiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="Sheet music" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sheetMusicSeg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/settings_seg_bg"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/sheetPiano"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_seg_item"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_set_piano"
                android:drawableTint="@color/settings_choice_text"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Piano"
                android:textColor="@color/settings_choice_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/sheetGuitar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_seg_item"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_set_guitar"
                android:drawableTint="@color/settings_choice_text"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Guitar"
                android:textColor="@color/settings_choice_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="On the hymn page" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_bg"
            android:divider="@drawable/settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/youtubeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_tv"
                app:rowTitle="YouTube button"
                app:rowSummary="Search YouTube for the hymn"
                app:rowTrailing="switcher" />
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/similarRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_tune"
                app:rowTitle="Similar tune button"
                app:rowSummary="Switch to hymns sung to the same tune"
                app:rowTrailing="switcher" />
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/keepOnRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_bulb"
                app:rowTitle="Keep screen on"
                app:rowSummary="The screen won't sleep while a hymn is open"
                app:rowTrailing="switcher" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="Hymn books" />
            <TextView android:id="@+id/booksValue" style="@style/SettingsHeaderValue" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_bg"
            android:divider="@drawable/settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/booksRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_books"
                app:rowTitle="Books to show"
                app:rowSummary=""
                app:rowTrailing="chevron" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="Your data" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_bg"
            android:divider="@drawable/settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/favoritesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_heart"
                app:rowTitle="Favorites"
                app:rowSummary="Back up, or move them to a new phone"
                app:rowTrailing="chevron" />
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/chordEditsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_chords"
                app:rowTitle="Chord edits"
                app:rowSummary=""
                app:rowTrailing="chevron" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="Share the app" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_bg"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="12dp"
                android:text="Let someone scan this with their phone's camera."
                android:textColor="@color/set_muted"
                android:textSize="13.5sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp">
        <LinearLayout
            android:id="@+id/shareSeg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/settings_seg_bg"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/shareAndroid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.75"
                android:background="@drawable/settings_seg_item"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_set_android"
                android:drawableTint="@color/settings_choice_text"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Android"
                android:textColor="@color/settings_choice_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/shareWeb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25"
                android:background="@drawable/settings_seg_item"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_set_devices"
                android:drawableTint="@color/settings_choice_text"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="iPhone and all devices"
                android:textColor="@color/settings_choice_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
            </FrameLayout>

            <ImageView
                android:id="@+id/shareQr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/settings_qr_bg"
                android:contentDescription="QR code to share the app"
                android:padding="10dp"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/shareUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:gravity="center"
                android:textColor="@color/set_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shareNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="18dp"
                android:gravity="center"
                android:textColor="@color/set_muted"
                android:textSize="13.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/shareCopy"
                    style="@style/SettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy link" />

                <Button
                    android:id="@+id/shareSend"
                    style="@style/SettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_button_filled"
                    android:text="Share link"
                    android:textColor="@color/set_on_primary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_bg"
            android:orientation="vertical">
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/aboutRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_info"
                app:rowTitle="About"
                app:rowSummary="Version, send feedback, source code"
                app:rowTrailing="chevron" />
        </LinearLayout>
        </com.lemuelinchrist.android.hymns.settings.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>
