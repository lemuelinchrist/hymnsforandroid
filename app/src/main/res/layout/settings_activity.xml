<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings screen (v5.9): one scrolling page of cards; every choice is made on the page (SettingsActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/set_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/set_bg"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/set_bg"
            android:minHeight="?attr/actionBarSize"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <com.lemuelinchrist.android.hymns.settings.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="28dp"
            app:maxContentWidth="640dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_bg"
            android:divider="@drawable/settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">
            <!-- plain rows that open a list of choices, like Language (text size and theme: SettingsActivity) -->
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/textSizeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_font"
                app:rowTitle="@string/settings_text_size"
                app:rowSummary=""
                app:rowTrailing="chevron" />
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/themeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_theme"
                app:rowTitle="@string/settings_theme"
                app:rowSummary=""
                app:rowTrailing="chevron" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="@string/settings_on_hymn_page" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_bg"
            android:divider="@drawable/settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/youtubeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_tv"
                app:rowTitle="@string/settings_youtube"
                app:rowSummary="@string/settings_youtube_summary"
                app:rowTrailing="switcher" />
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/similarRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_tune"
                app:rowTitle="@string/settings_similar"
                app:rowSummary="@string/settings_similar_summary"
                app:rowTrailing="switcher" />
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/keepOnRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_bulb"
                app:rowTitle="@string/settings_keep_on"
                app:rowSummary="@string/settings_keep_on_summary"
                app:rowTrailing="switcher" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="@string/settings_sheet_music" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sheetMusicSeg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/settings_seg_bg"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/sheetPiano"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_seg_item"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_set_piano"
                android:drawableTint="@color/settings_choice_text"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/settings_piano"
                android:textColor="@color/settings_choice_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/sheetGuitar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_seg_item"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_set_guitar"
                android:drawableTint="@color/settings_choice_text"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/settings_guitar"
                android:textColor="@color/settings_choice_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="@string/settings_language" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_bg"
            android:divider="@drawable/settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">
            <!-- the language of the app's own texts (not of the hymns): LanguageSetting -->
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/languageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_language"
                app:rowTitle="@string/settings_app_language"
                app:rowSummary=""
                app:rowTrailing="chevron" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="@string/settings_hymn_books" />
            <TextView android:id="@+id/booksValue" style="@style/SettingsHeaderValue" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_bg"
            android:divider="@drawable/settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/booksRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_books"
                app:rowTitle="@string/settings_books_to_show"
                app:rowSummary=""
                app:rowTrailing="chevron" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="@string/settings_your_data" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_bg"
            android:divider="@drawable/settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/favoritesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_heart"
                app:rowTitle="@string/settings_favorites"
                app:rowSummary="@string/settings_favorites_summary"
                app:rowTrailing="chevron" />
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/chordEditsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_chords"
                app:rowTitle="@string/chord_edits_title"
                app:rowSummary=""
                app:rowTrailing="chevron" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <TextView style="@style/SettingsHeader" android:text="@string/settings_share_app" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card_bg"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="12dp"
                android:text="@string/share_scan"
                android:textColor="@color/set_muted"
                android:textSize="13.5sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp">
        <LinearLayout
            android:id="@+id/shareSeg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/settings_seg_bg"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/shareAndroid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.75"
                android:background="@drawable/settings_seg_item"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_set_android"
                android:drawableTint="@color/settings_choice_text"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/share_android"
                android:textColor="@color/settings_choice_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/shareWeb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25"
                android:background="@drawable/settings_seg_item"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_set_devices"
                android:drawableTint="@color/settings_choice_text"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="44dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/share_web"
                android:textColor="@color/settings_choice_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
            </FrameLayout>

            <ImageView
                android:id="@+id/shareQr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/settings_qr_bg"
                android:contentDescription="@string/share_qr"
                android:padding="10dp"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/shareUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:gravity="center"
                android:textColor="@color/set_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shareNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="18dp"
                android:gravity="center"
                android:textColor="@color/set_muted"
                android:textSize="13.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/shareCopy"
                    style="@style/SettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copy_link" />

                <Button
                    android:id="@+id/shareSend"
                    style="@style/SettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_button_filled"
                    android:text="@string/share_link"
                    android:textColor="@color/set_on_primary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_bg"
            android:orientation="vertical">
            <com.lemuelinchrist.android.hymns.settings.SettingsRow
                android:id="@+id/aboutRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_set_info"
                app:rowTitle="@string/settings_about"
                app:rowSummary="@string/settings_about_summary"
                app:rowTrailing="chevron" />
        </LinearLayout>
        </com.lemuelinchrist.android.hymns.settings.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>
