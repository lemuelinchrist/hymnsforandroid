<?xml version="1.0" encoding="utf-8"?>
<!-- "OTHER LANGUAGES 18          Hide ▴" (OtherLanguagesSection); the count and Hide/Show are filled in by code,
     Hide/Show in the book's colour -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:paddingTop="4dp"
              android:paddingBottom="4dp"
              android:minHeight="36dp"
              android:background="@drawable/other_languages_row_ripple"
              android:clickable="true"
             >

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otherLanguages"
            style="@style/HymnLabel"/>

    <TextView
            android:id="@+id/otherLanguagesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:textSize="12sp"
            android:textColor="?attr/hymnTextMuted"
            android:background="@drawable/other_languages_badge"/>

    <TextView
            android:id="@+id/otherLanguagesAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"/>
</LinearLayout>
