<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"

        android:id="@+id/jellybeanContentScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/hymnPageBackground"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">


    <LinearLayout
            android:id="@+id/lyric_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
    >
        <!--This will solve the lyric autoscrolling problem but it blocks the lyrics from being selectable-->
        <!--android:descendantFocusability="blocksDescendants"-->

        <androidx.cardview.widget.CardView
                android:id="@+id/mainHeaderContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="5dp" app:cardElevation="?attr/hymnCardElevation" app:cardBackgroundColor="?attr/hymnCardBackground"
                android:layout_marginLeft="10dp" android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="0dp">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="25dp"
                    android:paddingRight="25dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp">
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:id="@+id/subjectHeader"
                        android:textColor="?attr/hymnText"
                        android:text="@string/subjectFiller"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_centerInParent="true"
                        android:layout_marginBottom="10dp"/>
                <!-- the other languages' numbers, filled by OtherLanguagesSection -->
                <LinearLayout
                        android:id="@+id/otherLanguagesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp"/>
                <androidx.cardview.widget.CardView android:layout_width="wrap_content"
                                                   android:layout_height="wrap_content" app:cardCornerRadius="25dp"
                                                   app:cardElevation="3dp"
                                                   android:layout_marginLeft="10dp"
                                                   android:layout_marginRight="10dp"
                                                   app:cardBackgroundColor="#000000"
                                                   android:layout_gravity="center"
                                                   android:id="@+id/buttonContainer">

                    <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_gravity="center"
                    >

                        <ImageButton
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:id="@+id/faveButton"
                                android:src="@drawable/ic_favorite_border_white_48dp"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_gravity="left"
                                android:layout_weight="1" android:scaleType="center"
                                android:adjustViewBounds="true"/>
                        <ImageButton
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:id="@+id/playButton"
                                android:src="@drawable/ic_play_arrow_white_48dp"
                                android:layout_gravity="left"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_weight="1" android:adjustViewBounds="true"/>
                        <ImageButton
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:id="@+id/sheetMusicButton"
                                android:src="@drawable/ic_queue_music_white_48dp"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_gravity="left"
                                android:layout_weight="1" android:adjustViewBounds="true"/>
                        <ImageButton
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:id="@+id/youtubeButton"
                                android:src="@drawable/ic_live_tv_white_28dp"
                                android:layout_gravity="left"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_weight="1" android:adjustViewBounds="true"/>
                        <ImageButton
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:id="@+id/similarTuneButton"
                                android:src="@drawable/ic_related_hymns_white_28dp"
                                android:layout_gravity="left"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_weight="1" android:adjustViewBounds="true"/>
                        <ImageButton
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:id="@+id/shareButton"
                                android:src="@drawable/ic_share_white_48dp"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_weight="1"
                                android:layout_gravity="left" android:adjustViewBounds="true"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/jukeboxCard"
                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="5dp" app:cardElevation="?attr/hymnCardElevation" app:cardBackgroundColor="?attr/hymnCardBackground"
                android:layout_marginLeft="10dp" android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="0dp"
                android:visibility="gone"
        >
            <!-- plays the hymn's sheet in a style picked from a list (JukeboxCard; gone until Play is pressed; the X closes it) -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="25dp" android:paddingRight="25dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                <!-- the title row: the X closes the card (and stops it) -->
                <LinearLayout
                        android:id="@+id/jukeboxHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="44dp">
                    <TextView
                            style="@style/HymnLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/jukebox"/>
                    <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                    <ImageButton
                            android:id="@+id/jukeboxClose"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="-10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_close_24dp"
                            android:contentDescription="@string/jukebox_close"/>
                </LinearLayout>
                <LinearLayout
                        android:id="@+id/jukeboxBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="2dp"
                        android:paddingBottom="6dp">
                <!-- Play, and beside it the active style and how far it has played -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                    <ImageButton
                            android:id="@+id/jukeboxPlay"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/jukebox_play_bg"
                            android:src="@drawable/ic_play_arrow_white_48dp"
                            android:scaleType="centerInside"
                            android:padding="10dp"
                            android:contentDescription="@string/jukebox_play"/>
                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                            <TextView
                                    android:id="@+id/jukeboxCurrent"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:singleLine="true"
                                    android:ellipsize="end"
                                    android:textSize="15sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="?attr/hymnText"/>
                            <TextView
                                    android:id="@+id/jukeboxBar"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:gravity="end"
                                    android:textSize="12sp"
                                    android:textColor="?attr/hymnTextMuted"/>
                        </LinearLayout>
                        <ProgressBar
                                android:id="@+id/jukeboxProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="8dp"
                                android:max="1"
                                android:progress="0"/>
                    </LinearLayout>
                </LinearLayout>
                <!-- Category pills and sub-style chips -->
                <com.lemuelinchrist.android.hymns.content.WrapLayout
                        android:id="@+id/jukeboxCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:contentDescription="@string/jukebox_category"/>
                <View
                        android:id="@+id/jukeboxSubDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="?attr/hymnBadgeBackground"/>
                <!-- the sub-style: a drop-down and a dice that picks one at random -->
                <LinearLayout
                        android:id="@+id/jukeboxSubstyles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="gone">
                    <Spinner
                            android:id="@+id/jukeboxSubSpinner"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:maxWidth="260dp"
                            android:spinnerMode="dropdown"
                            android:contentDescription="@string/jukebox_style"/>
                    <ImageButton
                            android:id="@+id/jukeboxDice"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_dice_24dp"
                            android:contentDescription="@string/jukebox_random"/>
                </LinearLayout>
                <!-- the tempo (a tap on it: the sheet's own again) and Loop -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">
                    <TextView
                            android:id="@+id/jukeboxTempo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="74dp"
                            android:minHeight="40dp"
                            android:gravity="center_vertical"
                            android:textSize="14sp"
                            android:textColor="?attr/hymnText"
                            android:background="?android:attr/selectableItemBackground"
                            android:contentDescription="@string/jukebox_tempo_reset"/>
                    <SeekBar
                            android:id="@+id/jukeboxSpeed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="20"
                            android:contentDescription="@string/jukebox_tempo_label"/>
                    <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/jukeboxLoop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text="@string/jukebox_loop"
                            android:textColor="?attr/hymnText"
                            android:textSize="14sp"
                            app:switchPadding="6dp"/>
                </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView

                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="5dp" app:cardElevation="?attr/hymnCardElevation" app:cardBackgroundColor="?attr/hymnCardBackground"
                android:layout_marginLeft="10dp" android:layout_marginRight="10dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="5dp"
        >
            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:paddingTop="15dp"
                    android:paddingBottom="10dp"
                    android:id="@+id/stanzaView"
            >
                <TextView
                        android:id="@+id/jellybeanLyrics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="10dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/lyricFiller"
                        android:textIsSelectable="true"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
                android:id="@+id/detailsCard"
                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="5dp" app:cardElevation="?attr/hymnCardElevation" app:cardBackgroundColor="?attr/hymnCardBackground"
                android:layout_marginLeft="10dp" android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
        >
            <!-- Meter, Time, Tune, Author, Composer -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="25dp" android:paddingRight="25dp" android:paddingTop="14dp" android:paddingBottom="16dp">
                <TextView
                        android:id="@+id/detailsLabel"
                        style="@style/HymnLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/details"
                        android:layout_marginBottom="6dp"/>
                <!-- one row per item: label | value (filled by LyricsArea); the value column wraps -->
                <TableLayout
                        android:id="@+id/detailsTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:shrinkColumns="1"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
                android:id="@+id/linksCard"
                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="5dp" app:cardElevation="?attr/hymnCardElevation" app:cardBackgroundColor="?attr/hymnCardBackground"
                android:layout_marginLeft="10dp" android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
        >
            <!-- piano videos and other links outside the app (filled by LinksSection; the card is hidden when there are none) -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="25dp" android:paddingRight="25dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                <!-- the title row: a tap folds the card into it (CardFold); Hide / Show in the book's colour -->
                <LinearLayout
                        android:id="@+id/linksHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:background="@drawable/other_languages_row_ripple"
                        android:clickable="true">
                    <TextView
                            style="@style/HymnLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/linksCard"/>
                    <TextView
                            android:id="@+id/linksFold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <LinearLayout
                        android:id="@+id/linksList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="10dp"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

