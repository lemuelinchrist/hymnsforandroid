<?xml version="1.0" encoding="utf-8"?>
<!-- the jukebox's style list: a field in the badge colour with its arrow on the right -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <solid android:color="?attr/hymnBadgeBackground"/>
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="8dp" android:width="24dp" android:height="24dp"
          android:drawable="@drawable/jukebox_arrow"/>
</layer-list>
