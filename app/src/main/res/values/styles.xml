<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="SearchTheme" parent="MyMaterialTheme.Base">

    </style>

    <style name="NoActionBar" parent="MyMaterialTheme.Base">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="MyMaterialTheme.Base" parent="Hymns.Colors">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@android:color/transparent</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">#44000000</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="SettingsTheme" parent="MyMaterialTheme.Base">
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="titleTextColor">@color/settings_text</item>
        <item name="colorControlNormal">@color/settings_text</item>
        <item name="colorPrimary">@color/settings_bar</item>
        <!-- the clock and battery stay visible on the white bar by day -->
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
    </style>

    <!-- FavoritesBackup's dialogs: the search screen's theme makes text white, which hid the dialog titles -->
    <style name="FavoritesDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@color/dialog_text</item>
    </style>

    <!-- Rows of the Share button's menu (layout/popup_share) -->
    <style name="ShareRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ShareRowIcon">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/settings_icon_bg</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/set_on_tint</item>
    </style>
    <style name="ShareRowText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:textColor">@color/set_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- RestoreFavoritesActivity: only its dialogs show, over whatever app opened the file -->
    <style name="Translucent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- the small capitals above a list on the hymn page: OTHER LANGUAGES, DETAILS -->
    <style name="HymnLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/hymnTextMuted</item>
    </style>

    <style name="dayMode" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name = "android:textColor">#4e4e4e</item>
        <item name = "android:background">#FFFFFF</item>
    </style>


    <!-- Settings screen: section titles, the value beside them, and the buttons of the Share card -->
    <style name="SettingsHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/set_primary</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SettingsHeaderValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/set_muted</item>
        <item name="android:textSize">13.5sp</item>
    </style>
    <style name="SettingsButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/set_primary</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>
</resources>
