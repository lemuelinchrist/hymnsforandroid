<?xml version="1.0" encoding="utf-8"?>
<!-- the screens' colours by day: the page is the Settings page's #f4f6f9 everywhere (the hymn page, the search lists,
     Settings) and what sits on it (cards, bars, the drawer) is white; values-night/colors.xml has the dark ones (Material's
     dark theme: dark grey, raised
     things lighter, off-white text). The hymn page takes its colours from style/Theme instead, which also has Black. -->
<resources>
    <color name="window_background">#f4f6f9</color>
    <color name="drawer_background">#ffffff</color>
    <color name="drawer_text">#1f2124</color>
    <color name="drawer_muted">#6b7078</color>
    <color name="drawer_line">#e3e6ea</color>
    <color name="search_bar">#000000</color>
    <color name="list_text">#4e4e4e</color>
    <color name="choices_bar">#ffffff</color>
    <color name="choice_on">#00796b</color>
    <color name="choice_off">#757575</color>
    <color name="settings_bar">#ffffff</color>
    <color name="settings_text">#000000</color>
    <color name="dialog_text">#de000000</color>
    <color name="sheet_background">#ffffff</color>
    <!-- Settings screen (v5.9): page, cards, text, accent and its tint -->
    <color name="set_bg">#f4f6f9</color>
    <color name="set_card">#ffffff</color>
    <color name="set_text">#1b1d21</color>
    <color name="set_muted">#5d636c</color>
    <color name="set_line">#e3e6ea</color>
    <color name="set_outline">#757b84</color>
    <color name="set_primary">#3d577a</color>
    <color name="set_on_primary">#ffffff</color>
    <color name="set_tint">#dbe4f0</color>
    <color name="set_on_tint">#1f3552</color>
    <color name="set_switch_off">#eaeef3</color>
</resources>
